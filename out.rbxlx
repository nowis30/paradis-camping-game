        <string name="Name">Woodcutting</string>
      </Properties>
      <Item class="Script" referent="48">
        <Properties>
          <string name="Name">AxeLegendaryPurchase</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- AxeLegendaryPurchase.server.lua
-- Gère l'achat Robux (Developer Product) pour la hache légendaire via MarketplaceService.ProcessReceipt.
-- Nécessite que ProductId dans AxeUpgradeConfig.Tiers (Power=5) soit correctement renseigné.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local AxeConfig = require(ReplicatedStorage.Config.AxeUpgradeConfig)
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local upgradeEvent = remotesFolder:WaitForChild("AxeUpgradeSucceeded")
local legendaryFailEvent = remotesFolder:WaitForChild("LegendaryPurchaseFailed")

local legendaryTier
for _, tier in ipairs(AxeConfig.Tiers) do
	if tier.Power == 5 then
		legendaryTier = tier
		break
	end
end

local PRODUCT_ID = legendaryTier and legendaryTier.ProductId or 0

if PRODUCT_ID == 0 then
	warn("[AxeLegendaryPurchase] ProductId légendaire non configuré.")
end

-- Fonction utilitaire pour appliquer la hache légendaire
local function grantLegendaryAxe(player)
	if not player then return end
	if (player:GetAttribute("AxePower") or 1) >= 5 then return end
	player:SetAttribute("AxePower", 5)
	upgradeEvent:FireAllClients(player, 5, legendaryTier and legendaryTier.Name or "Hache Légendaire")
end

-- ProcessReceipt callback
function MarketplaceService.ProcessReceipt(receiptInfo)
	-- Vérifie correspondance ProductId
	if receiptInfo.ProductId ~= PRODUCT_ID then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Laisse autres scripts gérer si ce n'est pas notre produit
	end
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	grantLegendaryAxe(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Sécurité: si un joueur rejoint après avoir acheté mais avant attribution (rare)
Players.PlayerAdded:Connect(function(player)
	-- On pourrait vérifier un DataStore séparé pour achats, laissé simple ici
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="49">
        <Properties>
          <string name="Name">AxeUpgradeData</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- AxeUpgradeData.server.lua
-- Sauvegarde et chargement de AxePower via DataStore.
-- Utilise un DataStore simple par UserId.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local STORE_NAME = "AxePowerStore_v1" -- Changer version si structure modifiée
local ds = DataStoreService:GetDataStore(STORE_NAME)

local SAVE_DELAY = 2 -- Anti-spam (pas utilisé intensivement ici)

local function loadAxePower(player)
	local key = "axe_" .. player.UserId
	local success, value = pcall(function()
		return ds:GetAsync(key)
	end)
	if success and typeof(value) == "number" then
		-- Ne baisse pas la puissance si déjà supérieure (sécurité)
		local current = player:GetAttribute("AxePower") or 1
		if value > current then
			player:SetAttribute("AxePower", value)
		elseif current == nil then
			player:SetAttribute("AxePower", value)
		end
	else
		-- Première fois ou erreur --> laisser valeur par défaut
	end
end

local pendingSaves = {}

local function saveAxePower(player)
	local power = player:GetAttribute("AxePower") or 1
	local key = "axe_" .. player.UserId
	local now = os.clock()
	if pendingSaves[player] and now - pendingSaves[player] < SAVE_DELAY then
		return -- Anti spam
	end
	pendingSaves[player] = now
	local success, err = pcall(function()
		ds:SetAsync(key, power)
	end)
	if not success then
		warn("Echec sauvegarde AxePower pour " .. player.Name .. ": " .. tostring(err))
	end
end

Players.PlayerAdded:Connect(function(player)
	player:GetAttributeChangedSignal("AxePower"):Connect(function()
		saveAxePower(player)
	end)
	-- Charge après un petit délai pour laisser PlayerSetup mettre valeur défaut
	loadAxePower(player)
end)

Players.PlayerRemoving:Connect(function(player)
	saveAxePower(player)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="50">
        <Properties>
          <string name="Name">AxeUpgradeService</string>
          <token name="RunContext">0</token>
          <string name="Source">-- AxeUpgradeService.server.lua
-- Gère les demandes d'amélioration de la hache (augmentation AxePower) contre de l'argent.
-- Utilise AxeUpgradeConfig pour déterminer le prochain palier.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Rewards = require(ServerScriptService.Utils.Rewards)
local AxeConfig = require(ReplicatedStorage.Config.AxeUpgradeConfig)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local requestFunction = remotesFolder:WaitForChild("RequestAxeUpgrade")
local upgradeEvent = remotesFolder:WaitForChild("AxeUpgradeSucceeded")
local requestLegendaryFunction = remotesFolder:WaitForChild("RequestLegendaryUpgrade")
local legendaryFailEvent = remotesFolder:WaitForChild("LegendaryPurchaseFailed")

-- Trouve l'index du palier correspondant à la puissance actuelle.
local function findCurrentTierIndex(power)
	for i, tier in ipairs(AxeConfig.Tiers) do
		if tier.Power == power then
			return i
		end
	end
	return nil
end

-- Renvoie le prochain palier si disponible.
local function getNextTier(power)
	local idx = findCurrentTierIndex(power)
	if not idx then
		-- Si la puissance actuelle ne correspond pas à un palier, on cherche le plus proche inférieur
		local candidate
		for i, tier in ipairs(AxeConfig.Tiers) do
			if power >= tier.Power then
				candidate = i
			end
		end
		if candidate and AxeConfig.Tiers[candidate + 1] then
			return AxeConfig.Tiers[candidate + 1]
		end
		return nil
	end
	return AxeConfig.Tiers[idx + 1]
end

-- Applique les changements visuels à l'outil (couleur/size) selon power
local function applyToolVisual(tool, power)
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	local colors = {
		[1] = Color3.fromRGB(92,64,51),      -- Basique
		[2] = Color3.fromRGB(110,80,55),     -- Renforcée
		[3] = Color3.fromRGB(140,100,70),    -- Acier (bois plus clair + fer?)
		[4] = Color3.fromRGB(170,120,60),    -- Mythique
		[5] = Color3.fromRGB(255,200,70),    -- Légendaire dorée
	}
	handle.Color = colors[power] or handle.Color
	-- Légère variation de taille pour feedback
	local baseSize = Vector3.new(1,4,1)
	local scaleFactor = 1 + (power - 1) * 0.08
	handle.Size = baseSize * scaleFactor
end

-- Met à jour tous les outils du joueur
local function ensureLegendaryTrail(tool, power)
	if power &lt; 5 then
		-- Supprime trail si présent
		local trail = tool:FindFirstChild("LegendaryTrail")
		if trail then trail:Destroy() end
		return
	end
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	local trail = tool:FindFirstChild("LegendaryTrail")
	if not trail then
		-- Création des attachments
		local att1 = handle:FindFirstChild("TrailAttachment1")
		if not att1 then
			att1 = Instance.new("Attachment")
			att1.Name = "TrailAttachment1"
			att1.Position = Vector3.new(0, handle.Size.Y/2, 0)
			att1.Parent = handle
		end
		local att2 = handle:FindFirstChild("TrailAttachment2")
		if not att2 then
			att2 = Instance.new("Attachment")
			att2.Name = "TrailAttachment2"
			att2.Position = Vector3.new(0, -handle.Size.Y/2, 0)
			att2.Parent = handle
		end
		trail = Instance.new("Trail")
		trail.Name = "LegendaryTrail"
		trail.Attachment0 = att1
		trail.Attachment1 = att2
		trail.Color = ColorSequence.new(Color3.fromRGB(255,230,120), Color3.fromRGB(255,180,60))
		trail.Lifetime = 0.3
		trail.LightInfluence = 0
		trail.MinLength = 0.02
		trail.Enabled = true
		trail.Parent = tool
	end
end

local function updatePlayerTools(player)
	local power = player:GetAttribute("AxePower") or 1
	-- Backpack
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and tool.Name == "Axe" or tool.Name == "AxeTemplate" then
				tool:SetAttribute("Power", power)
				applyToolVisual(tool, power)
				ensureLegendaryTrail(tool, power)
			end
		end
	end
	-- Character
	if player.Character then
		for _, tool in ipairs(player.Character:GetChildren()) do
			if tool:IsA("Tool") and (tool.Name == "Axe" or tool.Name == "AxeTemplate") then
				tool:SetAttribute("Power", power)
				applyToolVisual(tool, power)
				ensureLegendaryTrail(tool, power)
			end
		end
	end
end

-- Listener sur changement AxePower
local function onPlayerAdded(player)
	player.AttributeChanged:Connect(function(attr)
		if attr == "AxePower" then
			updatePlayerTools(player)
		end
	end)
end

for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
	onPlayerAdded(p)
end

game:GetService("Players").PlayerAdded:Connect(onPlayerAdded)

-- RemoteFunction handler
local function getFireLevel()
	local campfire = workspace:FindFirstChild("Campfire")
	if not campfire then return 0 end
	local fireLevel = campfire:FindFirstChild("FireLevel")
	if fireLevel and fireLevel:IsA("NumberValue") then
		return fireLevel.Value
	end
	return 0
end

function requestFunction.OnServerInvoke(player)
	-- Assure leaderstats
	local _, moneyValue = Rewards.ensureLeaderstats(player)
	local currentPower = player:GetAttribute("AxePower") or 1
	local nextTier = getNextTier(currentPower)
	if not nextTier then
		return false, "Aucun palier supérieur disponible."
	end
	-- Si palier Robux, refuser ici (utiliser RequestLegendaryUpgrade)
	if nextTier.CostRobux then
		return false, "Achetable uniquement avec des Robux."
	end
	-- Vérifie feu
	local fireLevel = getFireLevel()
	local required = nextTier.FireRequirement or 0
	if fireLevel &lt; required then
		return false, "Feu insuffisant (" .. fireLevel .. "/" .. required .. ")"
	end
	if moneyValue.Value &lt; (nextTier.Cost or 0) then
		return false, "Pas assez d'argent (" .. moneyValue.Value .. "/" .. nextTier.Cost .. ")"
	end
	-- Débit
	moneyValue.Value = moneyValue.Value - (nextTier.Cost or 0)
	player:SetAttribute("AxePower", nextTier.Power)
	updatePlayerTools(player)
	upgradeEvent:FireAllClients(player, nextTier.Power, nextTier.Name)
	return true, "Amélioration réussie: " .. nextTier.Name .. " (Puissance " .. nextTier.Power .. ")"
end

-- Demande d'achat légendaire (Robux) côté serveur: validation conditions puis renvoie ProductId
function requestLegendaryFunction.OnServerInvoke(player)
	local currentPower = player:GetAttribute("AxePower") or 1
	if currentPower >= 5 then
		return false, "Déjà légendaire." , nil
	end
	local nextTier = getNextTier(currentPower)
	if not nextTier or not nextTier.CostRobux then
		return false, "Palier légendaire indisponible." , nil
	end
	local fireLevel = getFireLevel()
	local required = nextTier.FireRequirement or 0
	if fireLevel &lt; required then
		return false, "Feu insuffisant (" .. fireLevel .. "/" .. required .. ")" , nil
	end
	if not nextTier.ProductId or nextTier.ProductId == 0 then
		return false, "ProductId non configuré." , nil
	end
	return true, "OK", nextTier.ProductId
end</string>
        </Properties>
      </Item>
      <Item class="Script" referent="51">
        <Properties>
          <string name="Name">CampfireService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- CampfireService.server.lua
-- Gère le feu de camp : diminution progressive, alimentation avec bûches, effets visuels

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local function waitForShared(key)
	while not shared[key] do
		RunService.Heartbeat:Wait()
	end
	return shared[key]
end

local EconomyService = waitForShared("ParadisEconomyService")

-- Configuration
local FIRE_DECREASE_RATE = 1 -- FireLevel diminue de 1 toutes les X secondes
local FIRE_DECREASE_INTERVAL = 15 -- secondes
local FIRE_MAX_LEVEL = 100
local FIRE_MIN_LEVEL = 0
local LOGS_PER_FUEL = 1 -- nombre de bûches consommées par alimentation
local FIRE_GAIN_PER_LOG = 20 -- augmentation de FireLevel par bûche

-- Configuration corde de bois
local WOODPILE_MAX_CAPACITY = 50 -- capacité maximale de la corde
local WOODPILE_POSITION_OFFSET = Vector3.new(30, 0, 0) -- position relative au feu (30 studs)

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local campfireFedEvent = remotesFolder:FindFirstChild("CampfireFed")
local logsUpdatedEvent = remotesFolder:FindFirstChild("LogsUpdated")

-- Références
local campfire = Workspace:WaitForChild("Campfire", 10)
if not campfire then
	warn("[CampfireService] Campfire introuvable dans Workspace")
	return
end

local fireLevel = campfire:FindFirstChild("FireLevel")
if not fireLevel then
	fireLevel = Instance.new("NumberValue")
	fireLevel.Name = "FireLevel"
	fireLevel.Value = 20 -- Niveau initial
	fireLevel.Parent = campfire
end

-- Corde de bois (WoodPile)
local woodPileStored = campfire:FindFirstChild("WoodPileStored")
if not woodPileStored then
	woodPileStored = Instance.new("IntValue")
	woodPileStored.Name = "WoodPileStored"
	woodPileStored.Value = 0
	woodPileStored.Parent = campfire
end

-- Trouver une part pour le feu (cherche FireBase, Fire, ou n'importe quelle BasePart)
local firePart = campfire:FindFirstChild("FireBase") 
	or campfire:FindFirstChild("Fire") 
	or campfire:FindFirstChildOfClass("BasePart")

if not firePart then
	warn("[CampfireService] Aucune part trouvée dans Campfire pour créer le ProximityPrompt!")
end

local fireEffect = campfire:FindFirstChildOfClass("Fire", true) -- cherche récursivement
local pointLight = campfire:FindFirstChildOfClass("PointLight", true)

-- Création visuelle de la corde de bois
local woodPileModel
local function createWoodPile()
	if campfire:FindFirstChild("WoodPile") then
		woodPileModel = campfire:FindFirstChild("WoodPile")
		return
	end
	
	woodPileModel = Instance.new("Model")
	woodPileModel.Name = "WoodPile"
	
	local basePos = campfire:GetPivot().Position + WOODPILE_POSITION_OFFSET
	
	-- Base de la corde
	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(4, 0.5, 3)
	base.Position = basePos
	base.Anchored = true
	base.Color = Color3.fromRGB(70, 50, 40)
	base.Material = Enum.Material.Wood
	base.CanCollide = false -- Ne pas gêner le joueur
	base.Parent = woodPileModel
	
	print(string.format("[CampfireService] WoodPile créé à position: %s", tostring(basePos)))
	
	-- ProximityPrompt pour déposer des bûches
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Déposer des bûches"
	prompt.ObjectText = "Corde de bois"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 12 -- Distance augmentée
	prompt.RequiresLineOfSight = false -- Visible même à travers objets
	prompt.Parent = base
	
	-- Label affichant le stock
	local billboardGui = Instance.new("BillboardGui")
	billboardGui.Size = UDim2.new(0, 200, 0, 50)
	billboardGui.StudsOffset = Vector3.new(0, 2, 0)
	billboardGui.AlwaysOnTop = true
	billboardGui.Parent = base
	
	-- Titre
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "TitleLabel"
	titleLabel.Size = UDim2.new(1, 0, 0.4, 0)
	titleLabel.Position = UDim2.new(0, 0, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 20
	titleLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
	titleLabel.Text = "📦 RÉSERVE DE BOIS"
	titleLabel.TextStrokeTransparency = 0.5
	titleLabel.Parent = billboardGui
	
	-- Stock
	local label = Instance.new("TextLabel")
	label.Name = "StockLabel"
	label.Size = UDim2.new(1, 0, 0.6, 0)
	label.Position = UDim2.new(0, 0, 0.4, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 28
	label.TextColor3 = Color3.fromRGB(150, 220, 100)
	label.Text = "🪵 0/" .. WOODPILE_MAX_CAPACITY
	label.TextStrokeTransparency = 0.5
	label.Parent = billboardGui
	
	woodPileModel.Parent = campfire
	woodPileModel:PivotTo(CFrame.new(basePos))
	
	print("[CampfireService] ✓ Corde de bois créée et visible avec BillboardGui '📦 RÉSERVE DE BOIS'")
end

-- Mise à jour visuelle de la corde selon le stock
local function updateWoodPileVisuals()
	if not woodPileModel then return end
	
	local stored = woodPileStored.Value
	local base = woodPileModel:FindFirstChild("Base")
	if not base then return end
	
	-- Mettre à jour le label
	local billboardGui = base:FindFirstChildOfClass("BillboardGui")
	if billboardGui then
		local label = billboardGui:FindFirstChild("StockLabel")
		if label then
			label.Text = string.format("🪵 %d/%d", stored, WOODPILE_MAX_CAPACITY)
		end
	end
	
	-- Supprimer anciens logs visuels
	for _, child in ipairs(woodPileModel:GetChildren()) do
		if child.Name == "LogVisual" then
			child:Destroy()
		end
	end
	
	-- Ajouter des bûches visuelles (par paquets de 5)
	local visualCount = math.min(math.floor(stored / 5), 10)
	for i = 1, visualCount do
		local log = Instance.new("Part")
		log.Name = "LogVisual"
		log.Size = Vector3.new(0.5, 0.5, 1.5)
		log.Color = Color3.fromRGB(92, 64, 51)
		log.Material = Enum.Material.Wood
		log.Anchored = true
		log.CanCollide = false
		
		-- Position aléatoire sur la pile
		local offsetX = (math.random() - 0.5) * 3
		local offsetZ = (math.random() - 0.5) * 2
		local offsetY = 0.5 + (i * 0.3)
		log.Position = base.Position + Vector3.new(offsetX, offsetY, offsetZ)
		log.Orientation = Vector3.new(0, math.random(0, 360), 90)
		
		log.Parent = woodPileModel
	end
end

-- Mise à jour visuelle du feu selon le niveau
local function updateFireVisuals()
	local level = fireLevel.Value
	local intensity = math.clamp(level / FIRE_MAX_LEVEL, 0, 1)
	
	if fireEffect then
		-- Diminution progressive de la flamme entre 10 et 0
		if level <= 10 then
			local smallIntensity = level / 10 -- 1.0 à 10, 0.0 à 0
			fireEffect.Size = 2 + (8 * smallIntensity) -- Taille entre 2 et 10
			fireEffect.Heat = 2 + (8 * smallIntensity)
			
			-- Flamme devient rouge faible puis s'éteint
			fireEffect.Color = Color3.fromRGB(255, 50 + (50 * smallIntensity), 20)
			fireEffect.SecondaryColor = Color3.fromRGB(150, 30 + (20 * smallIntensity), 10)
			
			fireEffect.Enabled = level > 0
		else
			-- Flamme normale au-dessus de 10
			fireEffect.Size = 5 + (15 * intensity)
			fireEffect.Heat = 5 + (20 * intensity)
			
			-- Couleur: rouge faible -> orange -> jaune vif
			if intensity < 0.3 then
				fireEffect.Color = Color3.fromRGB(255, 100, 50)
				fireEffect.SecondaryColor = Color3.fromRGB(150, 50, 20)
			elseif intensity < 0.7 then
				fireEffect.Color = Color3.fromRGB(255, 150, 50)
				fireEffect.SecondaryColor = Color3.fromRGB(200, 80, 30)
			else
				fireEffect.Color = Color3.fromRGB(255, 200, 50)
				fireEffect.SecondaryColor = Color3.fromRGB(255, 120, 40)
			end
			
			fireEffect.Enabled = true
		end
	end
	
	if pointLight then
		-- Lumière diminue progressivement entre 10 et 0
		if level <= 10 then
			local smallIntensity = level / 10
			pointLight.Brightness = 0.5 + (1.5 * smallIntensity)
			pointLight.Range = 5 + (15 * smallIntensity)
			pointLight.Enabled = level > 0
		else
			pointLight.Brightness = 1 + (3 * intensity)
			pointLight.Range = 10 + (30 * intensity)
			pointLight.Enabled = true
		end
	end
end

-- Calculer le multiplicateur de revenu basé sur le niveau du feu
local function getFireIncomeMultiplier()
	local level = fireLevel.Value
	if level >= 10 then
		return 1.0 -- Revenu normal
	else
		-- Entre 0 et 9: multiplicateur = level / 10
		-- 9 = 0.9, 5 = 0.5, 0 = 0.0
		return level / 10
	end
end

-- Appliquer la pénalité de revenu à tous les joueurs
local function applyFirePenaltyToAllPlayers()
	local multiplier = getFireIncomeMultiplier()
	
	for _, player in ipairs(Players:GetPlayers()) do
		if EconomyService and EconomyService.RecalculateIncome then
			local baseIncome = EconomyService.RecalculateIncome(player, nil)
			-- Stocker le multiplicateur comme attribut pour que EconomyService puisse l'utiliser
			player:SetAttribute("FirePenaltyMultiplier", multiplier)
		end
	end
end

-- Diminution progressive du feu
local function startFireDecay()
	while true do
		task.wait(FIRE_DECREASE_INTERVAL)
		
		if fireLevel.Value > FIRE_MIN_LEVEL then
			local oldLevel = fireLevel.Value
			fireLevel.Value = math.max(FIRE_MIN_LEVEL, fireLevel.Value - FIRE_DECREASE_RATE)
			updateFireVisuals()
			print(string.format("[CampfireService] Feu diminue -> FireLevel=%d", fireLevel.Value))
			
			-- Si on passe sous 10 ou qu'on change de niveau sous 10, recalculer les revenus
			if oldLevel >= 10 and fireLevel.Value < 10 then
				applyFirePenaltyToAllPlayers()
				print("[CampfireService] ⚠️ Feu faible! Revenus réduits.")
			elseif fireLevel.Value < 10 then
				applyFirePenaltyToAllPlayers()
			end
		end
	end
end

-- Connexion au ProximityPrompt de la corde pour déposer des bûches
local function connectWoodPilePrompt()
	task.wait(0.5) -- Attendre que la corde soit créée
	if not woodPileModel then return end
	
	local base = woodPileModel:FindFirstChild("Base")
	if not base then return end
	
	local prompt = base:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then return end
	
	prompt.Triggered:Connect(function(player)
		local currentLogs = player:GetAttribute("Logs") or 0
		
		if currentLogs < 1 then
			-- Pas de bûches
			return
		end
		
		if woodPileStored.Value >= WOODPILE_MAX_CAPACITY then
			-- Corde pleine
			return
		end
		
		-- Déposer bûches
		local toDeposit = math.min(currentLogs, WOODPILE_MAX_CAPACITY - woodPileStored.Value)
		player:SetAttribute("Logs", currentLogs - toDeposit)
		woodPileStored.Value = woodPileStored.Value + toDeposit
		
		updateWoodPileVisuals()
		
		print(string.format("[CampfireService] %s a déposé %d bûches -> Stock=%d", 
			player.Name, toDeposit, woodPileStored.Value))
		
		if logsUpdatedEvent then
			logsUpdatedEvent:FireAllClients(player, player:GetAttribute("Logs"))
		end
		
		-- Message flottant
		local character = player.Character
		if character then
			local head = character:FindFirstChild("Head")
			if head then
				local billboardGui = Instance.new("BillboardGui")
				billboardGui.Size = UDim2.new(0, 200, 0, 50)
				billboardGui.StudsOffset = Vector3.new(0, 3, 0)
				billboardGui.AlwaysOnTop = true
				billboardGui.Parent = head
				
				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 1, 0)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.GothamBold
				label.TextSize = 20
				label.TextColor3 = Color3.fromRGB(150, 220, 100)
				label.Text = "📦 +" .. toDeposit .. " stockées"
				label.TextStrokeTransparency = 0.5
				label.Parent = billboardGui
				
				task.delay(2, function()
					billboardGui:Destroy()
				end)
			end
		end
	end)
end

-- Connexion au ProximityPrompt pour alimenter le feu
local function connectFuelPrompt()
	if not firePart then
		warn("[CampfireService] Aucune part trouvée dans Campfire - impossible de créer ProximityPrompt")
		return
	end
	
	-- Supprimer tous les anciens ProximityPrompts pour éviter les conflits
	for _, oldPrompt in ipairs(firePart:GetChildren()) do
		if oldPrompt:IsA("ProximityPrompt") then
			print(string.format("[CampfireService] Suppression ancien ProximityPrompt: %s", oldPrompt.Name))
			oldPrompt:Destroy()
		end
	end
	
	-- Créer le nouveau prompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Alimenter le feu"
	prompt.ObjectText = "Feu de camp"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 25 -- Distance pour feu géant
	prompt.RequiresLineOfSight = false
	prompt.Parent = firePart
	print(string.format("[CampfireService] ProximityPrompt créé sur %s (distance: 25 studs)", firePart.Name))
	
	prompt.Triggered:Connect(function(player)
		-- Priorité 1: bûches magiques (bonus +50)
		local magicLogs = player:GetAttribute("MagicLogs") or 0
		if magicLogs >= LOGS_PER_FUEL then
			local oldLevel = fireLevel.Value
			player:SetAttribute("MagicLogs", magicLogs - LOGS_PER_FUEL)
			local ProShopConfig = require(ReplicatedStorage.Config.ProShopConfig)
			local magicBonus = ProShopConfig.MAGIC_LOG_FIRE_BONUS
			fireLevel.Value = math.min(FIRE_MAX_LEVEL, fireLevel.Value + magicBonus)
			updateFireVisuals()
			
			-- Restaurer revenus si on repasse au-dessus de 10
			if oldLevel < 10 and fireLevel.Value >= 10 then
				applyFirePenaltyToAllPlayers()
				print("[CampfireService] ✓ Feu ranimé! Revenus restaurés.")
			end
			
			print(string.format("[CampfireService] %s a alimenté avec bûche magique -> FireLevel=%d (+%d)", 
				player.Name, fireLevel.Value, magicBonus))
			
			-- Feedback visuel
			if campfireFedEvent then
				campfireFedEvent:FireAllClients(player, player:GetAttribute("Logs"))
			end
			
			-- Message flottant
			local character = player.Character
			if character then
				local head = character:FindFirstChild("Head")
				if head then
					local billboardGui = Instance.new("BillboardGui")
					billboardGui.Size = UDim2.new(0, 200, 0, 50)
					billboardGui.StudsOffset = Vector3.new(0, 3, 0)
					billboardGui.AlwaysOnTop = true
					billboardGui.Parent = head
					
					local label = Instance.new("TextLabel")
					label.Size = UDim2.new(1, 0, 1, 0)
					label.BackgroundTransparency = 1
					label.Font = Enum.Font.GothamBold
					label.TextSize = 20
					label.TextColor3 = Color3.fromRGB(138, 43, 226)
					label.Text = "✨ +" .. magicBonus .. " Feu (magique!)"
					label.TextStrokeTransparency = 0.5
					label.Parent = billboardGui
					
					task.delay(2, function()
						billboardGui:Destroy()
					end)
				end
			end
			return
		end
		
		-- Priorité 2: utiliser la corde de bois si disponible
		if woodPileStored.Value >= LOGS_PER_FUEL then
			local oldLevel = fireLevel.Value
			woodPileStored.Value = woodPileStored.Value - LOGS_PER_FUEL
			fireLevel.Value = math.min(FIRE_MAX_LEVEL, fireLevel.Value + FIRE_GAIN_PER_LOG)
			updateFireVisuals()
			updateWoodPileVisuals()
			
			-- Restaurer revenus si on repasse au-dessus de 10
			if oldLevel < 10 and fireLevel.Value >= 10 then
				applyFirePenaltyToAllPlayers()
				print("[CampfireService] ✓ Feu ranimé! Revenus restaurés.")
			end
			
			print(string.format("[CampfireService] %s a alimenté le feu depuis la corde -> FireLevel=%d, Stock=%d", 
				player.Name, fireLevel.Value, woodPileStored.Value))
			
			-- Feedback visuel
			if campfireFedEvent then
				campfireFedEvent:FireAllClients(player, player:GetAttribute("Logs"))
			end
			
			-- Message flottant
			local character = player.Character
			if character then
				local head = character:FindFirstChild("Head")
				if head then
					local billboardGui = Instance.new("BillboardGui")
					billboardGui.Size = UDim2.new(0, 200, 0, 50)
					billboardGui.StudsOffset = Vector3.new(0, 3, 0)
					billboardGui.AlwaysOnTop = true
					billboardGui.Parent = head
					
					local label = Instance.new("TextLabel")
					label.Size = UDim2.new(1, 0, 1, 0)
					label.BackgroundTransparency = 1
					label.Font = Enum.Font.GothamBold
					label.TextSize = 20
					label.TextColor3 = Color3.fromRGB(255, 150, 50)
					label.Text = "🔥 +" .. FIRE_GAIN_PER_LOG .. " Feu (corde)"
					label.TextStrokeTransparency = 0.5
					label.Parent = billboardGui
					
					task.delay(2, function()
						billboardGui:Destroy()
					end)
				end
			end
			return
		end
		
		-- Priorité 3: utiliser les bûches du joueur
		local currentLogs = player:GetAttribute("Logs") or 0
		
		if currentLogs < LOGS_PER_FUEL then
			-- Pas assez de bûches
			if campfireFedEvent then
				campfireFedEvent:FireClient(player, "❌ Pas assez de bûches! (Inventaire: " .. currentLogs .. ", Corde: " .. woodPileStored.Value .. ")")
			end
			return
		end
		
		-- Consommer bûches et augmenter feu
		local oldLevel = fireLevel.Value
		player:SetAttribute("Logs", currentLogs - LOGS_PER_FUEL)
		fireLevel.Value = math.min(FIRE_MAX_LEVEL, fireLevel.Value + FIRE_GAIN_PER_LOG)
		updateFireVisuals()
		
		-- Restaurer revenus si on repasse au-dessus de 10
		if oldLevel < 10 and fireLevel.Value >= 10 then
			applyFirePenaltyToAllPlayers()
			print("[CampfireService] ✓ Feu ranimé! Revenus restaurés.")
		end
		
		print(string.format("[CampfireService] %s a alimenté le feu -> FireLevel=%d, Logs=%d", 
			player.Name, fireLevel.Value, player:GetAttribute("Logs")))
		
		-- Feedback visuel
		if campfireFedEvent then
			campfireFedEvent:FireAllClients(player, player:GetAttribute("Logs"))
		end
		if logsUpdatedEvent then
			logsUpdatedEvent:FireAllClients(player, player:GetAttribute("Logs"))
		end
		
		-- Message flottant
		local character = player.Character
		if character then
			local head = character:FindFirstChild("Head")
			if head then
				local billboardGui = Instance.new("BillboardGui")
				billboardGui.Size = UDim2.new(0, 200, 0, 50)
				billboardGui.StudsOffset = Vector3.new(0, 3, 0)
				billboardGui.AlwaysOnTop = true
				billboardGui.Parent = head
				
				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 1, 0)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.GothamBold
				label.TextSize = 20
				label.TextColor3 = Color3.fromRGB(255, 150, 50)
				label.Text = "🔥 +" .. FIRE_GAIN_PER_LOG .. " Feu"
				label.TextStrokeTransparency = 0.5
				label.Parent = billboardGui
				
				task.delay(2, function()
					billboardGui:Destroy()
				end)
			end
		end
	end)
end

-- Initialisation
createWoodPile()
updateFireVisuals()
updateWoodPileVisuals()
connectFuelPrompt()
connectWoodPilePrompt()
task.spawn(startFireDecay)

print("[CampfireService] Service initialisé - FireLevel:", fireLevel.Value, "WoodPile:", woodPileStored.Value)

-- Mise à jour visuelle en continu si le niveau change manuellement
fireLevel:GetPropertyChangedSignal("Value"):Connect(updateFireVisuals)
woodPileStored:GetPropertyChangedSignal("Value"):Connect(updateWoodPileVisuals)
]]></string>
