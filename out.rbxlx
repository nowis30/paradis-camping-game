    <Item class="Script" referent="44">
      <Properties>
        <string name="Name">RemotesBootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- RemotesBootstrap.server.lua
-- Assure que tous les RemoteEvents/RemoteFunctions critiques existent tôt pour éviter les Infinite Yield.
-- Centralise la création au lieu de compter sur des ModuleScripts non requis.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function ensureFolder()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	return folder
end

local remotesFolder = ensureFolder()

local function ensureRemoteEvent(name)
	local r = remotesFolder:FindFirstChild(name)
	if r and r:IsA("RemoteEvent") then return r end
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = remotesFolder
	return ev
end

local function ensureRemoteFunction(name)
	local r = remotesFolder:FindFirstChild(name)
	if r and r:IsA("RemoteFunction") then return r end
	local rf = Instance.new("RemoteFunction")
	rf.Name = name
	rf.Parent = remotesFolder
	return rf
end

-- Liste des remotes requises par anciens et nouveaux scripts
local EVENT_NAMES = {
	"WoodcutHit",
	"WoodcutBreak",
	"CampfireFed",
	"LogsUpdated",
	"CollectLog",
	"FuelCampfire",
	"AxeUpgradeSucceeded",
	"LegendaryPurchaseFailed",
	"StartFishingMiniGame",
	"FishingMiniGameResult",
	"ProShopPurchaseResult",
	"ProShopRefresh",
	"MagicLogExpired",
}

local FUNCTION_NAMES = {
	"RequestAxeUpgrade",
	"RequestLegendaryUpgrade",
	"RequestProShopPurchase",
	"GetProShopData",
}

for _, n in ipairs(EVENT_NAMES) do
	ensureRemoteEvent(n)
end
for _, n in ipairs(FUNCTION_NAMES) do
	ensureRemoteFunction(n)
end

print("[RemotesBootstrap] Remotes initialisés:", #EVENT_NAMES, "events,", #FUNCTION_NAMES, "functions")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="45">
      <Properties>
        <string name="Name">Utils</string>
      </Properties>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Rewards</string>
          <string name="Source">-- Module de gestion des récompenses et de l'argent des joueurs
-- Fournit ensureLeaderstats(player) et addMoney(player, baseAmount)

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Rewards = {}

-- Assure que leaderstats/Money existent
function Rewards.ensureLeaderstats(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local money = leaderstats:FindFirstChild("Money")
	if not money then
		money = Instance.new("IntValue")
		money.Name = "Money"
		money.Value = 0
		money.Parent = leaderstats
	end
	return leaderstats, money
end

-- Ajoute de l'argent en appliquant le multiplicateur global du feu
function Rewards.addMoney(player, baseAmount)
	local _, money = Rewards.ensureLeaderstats(player)
	local multiplier = 1.0
	local globalMult = ReplicatedStorage:FindFirstChild("GlobalCoinMultiplier")
	if globalMult and globalMult:IsA("NumberValue") then
		multiplier = tonumber(globalMult.Value) or 1.0
	end
	local finalAmount = math.floor(baseAmount * multiplier + 0.5)
	money.Value = money.Value + finalAmount
	return finalAmount
end

return Rewards</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="47">
