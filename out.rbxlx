      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">EconomyFeedback</string>
          <string name="Source"><![CDATA[--[[
    EconomyFeedback
    Affiche des popups et joue un son léger pour les gains/pertes passifs.
]]

local TweenService = game:GetService("TweenService")

local EconomyFeedback = {}
EconomyFeedback.__index = EconomyFeedback

function EconomyFeedback.new(parent)
    local self = setmetatable({}, EconomyFeedback)
    self.Parent = parent

    local container = Instance.new("Folder")
    container.Name = "EconomyFeedback"
    container.Parent = parent
    self.Container = container

    local sound = Instance.new("Sound")
    sound.Name = "PassiveGainSound"
    sound.SoundId = "rbxassetid://3398620867" -- Son de pièce valide
    sound.Volume = 0.4
    sound.PlayOnRemove = false
    sound.Parent = container
    self.Sound = sound

    return self
end

local function formatAmount(amount)
    local prefix = amount >= 0 and "+" or "-"
    return string.format("%s%.2f $", prefix, math.abs(amount))
end

function EconomyFeedback:Show(amount, reason, multiplier)
    amount = tonumber(amount) or 0
    reason = reason or (amount >= 0 and "Revenu passif" or "Taxe")

    local label = Instance.new("TextLabel")
    label.Name = "EconomyPopup"
    label.Size = UDim2.new(0, 200, 0, 40)
    label.Position = UDim2.new(0, 20, 0, 140)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextWrapped = true
    label.TextStrokeTransparency = 0.6
    label.Parent = self.Parent

    if amount == 0 then
        label.Text = reason
        label.TextColor3 = Color3.fromRGB(230, 230, 255)
    else
        local text = formatAmount(amount)
        if multiplier and multiplier > 1.01 then
            text = string.format("%s (x%.2f)", text, multiplier)
        end
        label.Text = string.format("%s\n%s", text, reason)
        if amount >= 0 then
            label.TextColor3 = Color3.fromRGB(150, 255, 170)
            self.Sound:Stop()
            self.Sound.TimePosition = 0
            self.Sound:Play()
        else
            label.TextColor3 = Color3.fromRGB(255, 130, 130)
        end
    end

    local goal = { Position = label.Position + UDim2.new(0, 0, 0, -40), TextTransparency = 1 }
    local tween = TweenService:Create(label, TweenInfo.new(1.2), goal)
    tween:Play()
    tween.Completed:Connect(function()
        label:Destroy()
    end)
end

return EconomyFeedback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">HudEconomy</string>
          <string name="Source"><![CDATA[--[[
    HudEconomy
    Crée un panneau HUD minimaliste pour afficher l'argent et le revenu passif.
]]

local HudEconomy = {}

function HudEconomy.create(parent)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "HudEconomy"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Parent = parent

    local frame = Instance.new("Frame")
    frame.Name = "Panel"
    frame.Size = UDim2.new(0, 280, 0, 135)
    frame.Position = UDim2.new(0, 20, 0, 80) -- Descendu de 20 à 80 pour éviter les commandes Roblox
    frame.BackgroundTransparency = 0.2
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 16)
    padding.PaddingTop = UDim.new(0, 10)
    padding.Parent = frame

    local listLayout = Instance.new("UIListLayout")
    listLayout.FillDirection = Enum.FillDirection.Vertical
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Padding = UDim.new(0, 6)
    listLayout.Parent = frame

    local cashLabel = Instance.new("TextLabel")
    cashLabel.Name = "CashLabel"
    cashLabel.Size = UDim2.new(1, -10, 0, 24)
    cashLabel.BackgroundTransparency = 1
    cashLabel.Font = Enum.Font.GothamBold
    cashLabel.TextScaled = true
    cashLabel.TextXAlignment = Enum.TextXAlignment.Left
    cashLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    cashLabel.Text = "Argent : 0 $"
    cashLabel.Parent = frame

    local incomeLabel = Instance.new("TextLabel")
    incomeLabel.Name = "IncomeLabel"
    incomeLabel.Size = UDim2.new(1, -10, 0, 20)
    incomeLabel.BackgroundTransparency = 1
    incomeLabel.Font = Enum.Font.Gotham
    incomeLabel.TextScaled = true
    incomeLabel.TextXAlignment = Enum.TextXAlignment.Left
    incomeLabel.TextColor3 = Color3.fromRGB(150, 240, 150)
    incomeLabel.Text = "+0 $ / sec"
    incomeLabel.Parent = frame

    local boostLabel = Instance.new("TextLabel")
    boostLabel.Name = "BoostLabel"
    boostLabel.Size = UDim2.new(1, -10, 0, 18)
    boostLabel.BackgroundTransparency = 1
    boostLabel.Font = Enum.Font.Gotham
    boostLabel.TextScaled = true
    boostLabel.TextXAlignment = Enum.TextXAlignment.Left
    boostLabel.TextColor3 = Color3.fromRGB(255, 219, 120)
    boostLabel.Text = "Boost : Aucun"
    boostLabel.Parent = frame

    local logsLabel = Instance.new("TextLabel")
    logsLabel.Name = "LogsLabel"
    logsLabel.Size = UDim2.new(1, -10, 0, 20)
    logsLabel.BackgroundTransparency = 1
    logsLabel.Font = Enum.Font.GothamBold
    logsLabel.TextScaled = true
    logsLabel.TextXAlignment = Enum.TextXAlignment.Left
    logsLabel.TextColor3 = Color3.fromRGB(160, 120, 80)
    logsLabel.Text = "🪵 Bûches : 0"
    logsLabel.Parent = frame

    local saveButton = Instance.new("TextButton")
    saveButton.Name = "SaveButton"
    saveButton.Size = UDim2.new(0, 140, 0, 26)
    saveButton.BackgroundColor3 = Color3.fromRGB(55, 140, 85)
    saveButton.TextColor3 = Color3.new(1, 1, 1)
    saveButton.Font = Enum.Font.GothamBold
    saveButton.TextScaled = true
    saveButton.Text = "Sauvegarder"
    saveButton.Parent = frame

    return {
        ScreenGui = screenGui,
        CashLabel = cashLabel,
        IncomeLabel = incomeLabel,
        BoostLabel = boostLabel,
        LogsLabel = logsLabel,
        SaveButton = saveButton,
    }
end

return HudEconomy
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="62">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="63">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="64">
        <Properties>
          <string name="Name">AxeUpgradeClient</string>
          <string name="Source">-- AxeUpgradeClient.client.lua
-- Interface minimale (temporaire) pour demander une upgrade de hache.
-- Appelle RemoteFunction RequestAxeUpgrade et affiche le résultat dans l'Output + petite notification.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local requestFunc = remotesFolder:WaitForChild("RequestAxeUpgrade")
local upgradeEvent = remotesFolder:WaitForChild("AxeUpgradeSucceeded")
local requestLegendaryFunc = remotesFolder:WaitForChild("RequestLegendaryUpgrade")
local legendaryFailEvent = remotesFolder:WaitForChild("LegendaryPurchaseFailed")
local MarketplaceService = game:GetService("MarketplaceService")
local axeConfig = require(ReplicatedStorage.Config.AxeUpgradeConfig)

-- Crée un ScreenGui léger si absent
local gui = Instance.new("ScreenGui")
gui.Name = "AxeUpgradeGui"
gui.ResetOnSpawn = false
pcall(function() gui.DisplayOrder = 100 end)

gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(250, 170)
frame.Position = UDim2.fromOffset(20, 200)
frame.BackgroundColor3 = Color3.fromRGB(30,30,35)
frame.BorderSizePixel = 0
frame.Parent = gui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0,6)
uiCorner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.fromOffset(220, 24)
title.Position = UDim2.fromOffset(0,0)
title.BackgroundTransparency = 1
title.Text = "Amélioration Hache"
title.TextColor3 = Color3.fromRGB(255,220,160)
title.Font = Enum.Font.GothamBold
title.TextSize = 16
title.Parent = frame

local info = Instance.new("TextLabel")
info.Size = UDim2.fromOffset(250, 74)
info.Position = UDim2.fromOffset(0,28)
info.BackgroundTransparency = 1
info.TextWrapped = true
info.TextColor3 = Color3.new(1,1,1)
info.Font = Enum.Font.Gotham
info.TextSize = 14
info.Text = "Puissance actuelle: ?\nProchain coût: ?"
info.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.fromOffset(230, 32)
button.Position = UDim2.fromOffset(10, 110)
button.BackgroundColor3 = Color3.fromRGB(70,50,40)
button.TextColor3 = Color3.new(1,1,1)
button.Font = Enum.Font.GothamBold
button.TextSize = 16
button.Text = "Acheter upgrade"
button.AutoButtonColor = true
button.Parent = frame
local cornerBtn = Instance.new("UICorner")
cornerBtn.CornerRadius = UDim.new(0,6)
cornerBtn.Parent = button

local function findTier(power)
	for _, tier in ipairs(axeConfig.Tiers) do
		if tier.Power == power then return tier end
	end
	return nil
end

local function nextTier(power)
	local idx
	for i, tier in ipairs(axeConfig.Tiers) do
		if tier.Power == power then idx = i break end
	end
	if not idx then return nil end
	return axeConfig.Tiers[idx+1]
end

local function getFireLevel()
	local campfire = workspace:FindFirstChild("Campfire")
	if not campfire then return 0 end
	local fireLevel = campfire:FindFirstChild("FireLevel")
	if fireLevel and fireLevel:IsA("NumberValue") then return fireLevel.Value end
	return 0
end

local function refresh()
	local power = player:GetAttribute("AxePower") or 1
	local nTier = nextTier(power)
	local fireLevel = getFireLevel()
	if nTier then
		if nTier.CostRobux then
			info.Text = string.format("Puissance: %d\nLégendaire: %s\nFeu requis: %d (Actuel %d)\nRobux uniquement", power, nTier.Name, nTier.FireRequirement or 0, fireLevel)
			button.Text = "Acheter Robux" -- Bouton déclenche purchase
			button.Active = fireLevel >= (nTier.FireRequirement or 0)
			button.AutoButtonColor = button.Active
		else
			info.Text = string.format("Puissance: %d\nSuivant: %s (Cost %d)\nFeu requis: %d (Actuel %d)", power, nTier.Name, nTier.Cost, nTier.FireRequirement or 0, fireLevel)
			button.Text = "Acheter upgrade"
			button.Active = fireLevel >= (nTier.FireRequirement or 0)
			button.AutoButtonColor = button.Active
		end
	else
		info.Text = string.format("Puissance: %d\nDernier palier atteint", power)
		button.Text = "Max atteint"
		button.Active = false
		button.AutoButtonColor = false
	end
end

button.MouseButton1Click:Connect(function()
	local power = player:GetAttribute("AxePower") or 1
	local nTier = nextTier(power)
	if not nTier then return end
	if nTier.CostRobux then
		local ok, msg, productId = requestLegendaryFunc:InvokeServer()
		print("Demande légendaire:", ok, msg, productId)
		if ok and productId then
			MarketplaceService:PromptProductPurchase(player, productId)
		else
			button.BackgroundColor3 = Color3.fromRGB(140,40,40)
			task.delay(0.25, function()
				button.BackgroundColor3 = Color3.fromRGB(70,50,40)
			end)
		end
	else
		local success, msg = requestFunc:InvokeServer()
		print("Upgrade hache:", success, msg)
		if success then
			refresh()
		else
			button.BackgroundColor3 = Color3.fromRGB(140,40,40)
			task.delay(0.25, function()
				button.BackgroundColor3 = Color3.fromRGB(70,50,40)
			end)
		end
	end
end)

upgradeEvent.OnClientEvent:Connect(function(p, newPower, name)
	if p == player then
		print("Nouvelle hache:", name, "Puissance", newPower)
	end
end)

player:GetAttributeChangedSignal("AxePower"):Connect(refresh)
-- Mise à jour régulière du feu
task.spawn(function()
	while true do
		refresh()
		wait(2)
	end
end)
refresh()

-- Billboard sur hache pour coût suivant
local function updateAxeBillboard(tool)
	if not tool then return end
	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	local bb = handle:FindFirstChild("UpgradeBillboard")
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name = "UpgradeBillboard"
		bb.Size = UDim2.fromOffset(120,50)
		bb.StudsOffset = Vector3.new(0, handle.Size.Y/2 + 0.5,0)
		bb.AlwaysOnTop = true
		bb.Parent = handle
		local tl = Instance.new("TextLabel")
		tl.Name = "Text"
		tl.Size = UDim2.fromScale(1,1)
		tl.BackgroundTransparency = 1
		tl.Font = Enum.Font.GothamBold
		tl.TextScaled = true
		tl.TextColor3 = Color3.fromRGB(255,240,200)
		tl.Parent = bb
	end
	local textLabel = bb:FindFirstChild("Text")
	if textLabel then
		local power = player:GetAttribute("AxePower") or 1
		local nTier = nextTier(power)
		if nTier then
			if nTier.CostRobux then
				textLabel.Text = "Légendaire\nRobux"
			else
				textLabel.Text = "Next: " .. nTier.Cost
			end
		else
			textLabel.Text = "Max"
		end
	end
end

local function hookTool(tool)
	if tool:IsA("Tool") then
		updateAxeBillboard(tool)
		tool.AncestryChanged:Connect(function()
			if tool.Parent == player.Character then
				updateAxeBillboard(tool)
			end
		end)
	end
end

player.CharacterAdded:Connect(function(char)
	for _, child in ipairs(char:GetChildren()) do
		hookTool(child)
	end
	char.ChildAdded:Connect(hookTool)
end)

if player.Character then
	for _, child in ipairs(player.Character:GetChildren()) do
		hookTool(child)
	end
	player.Character.ChildAdded:Connect(hookTool)
end</string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="65">
        <Properties>
          <string name="Name">BuildClient</string>
          <string name="Source"><![CDATA[--[[
    BuildClient
    Gère le mode aménagement côté client : interface, sélection d'objet et aperçu fantôme.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local mouse = LocalPlayer:GetMouse()

local configFolder = ReplicatedStorage:WaitForChild("Config")
local ObjectsConfig = require(configFolder:WaitForChild("ObjectsConfig"))
local CampConfig = require(configFolder:WaitForChild("CampConfig"))
local TrailerPartsConfig = require(configFolder:WaitForChild("TrailerPartsConfig"))
local ConstructionRuntime = require(configFolder:WaitForChild("ConstructionObjectsRuntime"))
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))
local BuildRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuildRemotes"))
local GuiFactory = require(playerGui:WaitForChild("ParadisGui"):WaitForChild("BuildScreenGui"))

local GRID_SIZE = CampConfig.BUILD_GRID_SIZE or 2
local ui = GuiFactory.create(playerGui, ObjectsConfig, TrailerPartsConfig)

local currentPlot
local buildMode = false
local deleteMode = false
local selectedObject
local currentRotation = 0
local ghostPart
local deleteSelection
local plotHighlight
local hoveredObjectId
local lastPlacement = 0
local placementCooldown = 0.3
local hoverPosition
local tutorialDismissed = false
local placedObjects = {}
local trailerMode = false
local selectedTrailerPart
local trailerRotation = 0
local trailerHoverPosition
local trailerGridPosition
local trailerParts = {}
local lastTrailerPlacement = 0
local setBuildMode
local setTrailerMode
local selectConstruction
local currentCash = 0
local currentIncome = 0
-- Déplacement
local movingObjectId
local moveGhost
local moveHighlight
local function getPlotBaseHeight()
    if not currentPlot then
        return CampConfig.CAMP_CENTER.Y
    end
    if currentPlot.BaseHeight then
        return currentPlot.BaseHeight
    end
    if currentPlot.Center then
        return currentPlot.Center.Y + 1
    end
    return CampConfig.CAMP_CENTER.Y
end
local TRAILER_BUTTON_COLOR = Color3.fromRGB(34, 98, 148)
local TRAILER_BUTTON_ACTIVE = Color3.fromRGB(58, 140, 190)
local selectedCatalog = "Objects"
local selectedConstructionId
local selectedConstructionDef
local constructionButtons = {}
local constructionDefs = {}
local CONSTRUCTION_LAYOUT_OFFSET = 200

local function getConstructionButtonParent()
    return (ui and ui.ButtonContainer) or ui.Toolbar or ui.ScreenGui
end

local function getEconomyEntry(objectId, catalog)
    if not EconomyConfig then
        return { Cost = 0, IncomePerSecond = 0, UnlockAtIncome = 0 }
    end
    if catalog == "Construction" then
        return EconomyConfig.GetConstructionEconomy(objectId)
    end
    return EconomyConfig.GetObjectEconomy(objectId)
end

local function updateObjectButton(objectType)
    local button = ui.Buttons and ui.Buttons[objectType]
    if not button then
        return
    end
    local entry = getEconomyEntry(objectType, "Objects")
    local def = ObjectsConfig[objectType]
    local label = def and def.Label or objectType
    local unlockRequirement = entry.UnlockAtIncome or 0
    local unlocked = currentIncome >= unlockRequirement
    local baseText = string.format("%s\n%d $ → +%.2f $/s", label, entry.Cost or 0, entry.IncomePerSecond or 0)
    if unlocked then
        button.Text = baseText
        button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        button.Text = string.format("🔒 %s\nRequis : %.2f $/s", label, unlockRequirement)
        button.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
        button.TextColor3 = Color3.fromRGB(170, 170, 170)
    end
    button:SetAttribute("IsUnlocked", unlocked)
    button:SetAttribute("Cost", entry.Cost or 0)
    button:SetAttribute("IncomePerSecond", entry.IncomePerSecond or 0)
    button:SetAttribute("UnlockAtIncome", unlockRequirement)
end

local function updateAllObjectButtons()
    if not ui.Buttons then
        return
    end
    for objectType in pairs(ui.Buttons) do
        updateObjectButton(objectType)
    end
end

local function getSelectedEconomyEntry()
    if selectedCatalog == "Construction" and selectedConstructionId then
        return getEconomyEntry(selectedConstructionId, "Construction")
    elseif selectedCatalog == "Objects" and selectedObject then
        return getEconomyEntry(selectedObject, "Objects")
    end
end

local function isConstructionSelected()
    return selectedCatalog == "Construction" and selectedConstructionId ~= nil
end

local function roundToGrid(value, grid)
    if grid <= 0 then
        return value
    end
    return math.round(value / grid) * grid
end

local function resizeObjectList()
    if ui.ObjectList and ui.ObjectListLayout then
        local contentY = ui.ObjectListLayout.AbsoluteContentSize.Y
        ui.ObjectList.CanvasSize = UDim2.new(0, 0, 0, contentY + 10)
    end
end

if ui.ObjectListLayout then
    ui.ObjectListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resizeObjectList)
end

local function resizeTrailerList()
    if ui.TrailerObjectList and ui.TrailerObjectListLayout then
        local contentY = ui.TrailerObjectListLayout.AbsoluteContentSize.Y
        ui.TrailerObjectList.CanvasSize = UDim2.new(0, 0, 0, contentY + 10)
    end
end

if ui.TrailerObjectListLayout then
    ui.TrailerObjectListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resizeTrailerList)
end

local function updateStatus(text)
    if ui.StatusLabel then
        ui.StatusLabel.Text = text
    end
end

local function updateTrailerStatus(text)
    if ui.TrailerStatusLabel then
        ui.TrailerStatusLabel.Text = text
    end
end

local function rebuildObjectList()
    if not ui.ObjectList then
        return
    end
    for _, child in ipairs(ui.ObjectList:GetChildren()) do
        if child:IsA("Frame") and child.Name == "ObjectEntry" then
            child:Destroy()
        end
    end

    local count = 0
    for _, record in ipairs(placedObjects) do
        if typeof(record) == "table" and record.Id then
            count += 1
            local def = ObjectsConfig[record.Type]
            local labelText = def and def.Label or record.Type or "Objet"
            if record.Type == "Construction" or record.Catalog == "Construction" then
                labelText = record.DisplayName or record.ConstructionId or "Bloc"
            end
            local entry = Instance.new("Frame")
            entry.Name = "ObjectEntry"
            entry.BackgroundColor3 = Color3.fromRGB(32, 34, 44)
            entry.BackgroundTransparency = 0.1
            entry.Size = UDim2.new(1, -4, 0, 36)
            entry.BorderSizePixel = 0
            entry.Parent = ui.ObjectList

            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(0.6, -10, 1, 0)
            label.Position = UDim2.new(0, 6, 0, 0)
            label.Font = Enum.Font.Gotham
            label.TextSize = 16
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Text = labelText
            label.Parent = entry

            local removeButton = Instance.new("TextButton")
            removeButton.Name = "RemoveButton"
            removeButton.Size = UDim2.new(0.35, -10, 0.8, 0)
            removeButton.Position = UDim2.new(0.65, 0, 0.1, 0)
            removeButton.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
            removeButton.TextColor3 = Color3.new(1, 1, 1)
            removeButton.Font = Enum.Font.GothamBold
            removeButton.TextSize = 16
            removeButton.Text = "Supprimer"
            removeButton.Parent = entry

            local objectId = record.Id
            removeButton.MouseButton1Click:Connect(function()
                BuildRemotes.RequestRemove:InvokeServer(objectId)
            end)

                -- Bouton déplacer
                local moveButton = Instance.new("TextButton")
                moveButton.Name = "MoveButton"
                moveButton.Size = UDim2.new(0.35, -10, 0.8, 0)
                moveButton.Position = UDim2.new(0.3, 0, 0.1, 0)
                moveButton.BackgroundColor3 = Color3.fromRGB(60, 140, 200)
                moveButton.TextColor3 = Color3.new(1, 1, 1)
                moveButton.Font = Enum.Font.GothamBold
                moveButton.TextSize = 16
                moveButton.Text = "Déplacer"
                moveButton.Parent = entry
                moveButton.MouseButton1Click:Connect(function()
                    -- active le mode déplacement pour cet objet
                    print("[BuildClient] Bouton Déplacer cliqué pour objet ID:", objectId)
                    movingObjectId = objectId
                    
                    -- Activer buildMode si pas déjà actif
                    if not buildMode then
                        setBuildMode(true)
                    end
                    
                    if moveGhost then moveGhost:Destroy() end
                    moveGhost = Instance.new("Part")
                    moveGhost.Name = "MoveGhost"
                    moveGhost.Anchored = true
                    moveGhost.CanCollide = false
                    moveGhost.Material = Enum.Material.Neon
                    moveGhost.Transparency = 0.5
                    moveGhost.Color = Color3.fromRGB(80, 180, 255)
                    moveGhost.Size = Vector3.new(6, 0.2, 6)
                    moveGhost.Parent = workspace
                    
                    -- Highlight l'objet en cours de déplacement et le rendre semi-transparent
                    if moveHighlight then moveHighlight:Destroy() end
                    local worldFolder = currentPlot and currentPlot.Container
                    if worldFolder then
                        for _, m in ipairs(worldFolder:GetChildren()) do
                            if m:GetAttribute("PlotObjectId") == objectId then
                                -- Rendre l'objet semi-transparent (Brillance)
                                for _, part in ipairs(m:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part:SetAttribute("OriginalTransparency", part.Transparency)
                                        part.Transparency = 0.5
                                    end
                                end
                                
                                local highlight = Instance.new("Highlight")
                                highlight.Name = "MoveHighlight"
                                highlight.FillColor = Color3.fromRGB(80, 180, 255)
                                highlight.FillTransparency = 0.5
                                highlight.OutlineColor = Color3.fromRGB(120, 200, 255)
                                highlight.OutlineTransparency = 0
                                highlight.Adornee = m
                                highlight.Parent = m
                                moveHighlight = highlight
                                break
                            end
                        end
                    end
                    
                    print("[BuildClient] Mode déplacement activé. movingObjectId:", movingObjectId)
                    updateStatus("Mode déplacement : cliquez pour poser (R pivote)")
                end)
        end
    end

    if ui.ObjectListEmptyLabel then
        ui.ObjectListEmptyLabel.Visible = count == 0
    end
    resizeObjectList()
end

local function rebuildTrailerList()
    if not ui.TrailerObjectList then
        return
    end
    for _, child in ipairs(ui.TrailerObjectList:GetChildren()) do
        if child:IsA("Frame") and child.Name == "TrailerEntry" then
            child:Destroy()
        end
    end

    local count = 0
    for _, record in ipairs(trailerParts) do
        if typeof(record) == "table" and record.Id then
            count += 1
            local def = TrailerPartsConfig[record.PartId]
            local entry = Instance.new("Frame")
            entry.Name = "TrailerEntry"
            entry.BackgroundColor3 = Color3.fromRGB(28, 36, 50)
            entry.BackgroundTransparency = 0.1
            entry.Size = UDim2.new(1, -4, 0, 40)
            entry.BorderSizePixel = 0
            entry.Parent = ui.TrailerObjectList

            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(0.6, -10, 1, 0)
            label.Position = UDim2.new(0, 6, 0, 0)
            label.Font = Enum.Font.Gotham
            label.TextSize = 15
            label.TextColor3 = Color3.fromRGB(240, 240, 255)
            label.TextXAlignment = Enum.TextXAlignment.Left
            local labelParts = { def and def.DisplayName or record.PartId or "Pièce" }
            table.insert(labelParts, string.format("(%d,%d)", record.OriginX or 0, record.OriginZ or 0))
            label.Text = table.concat(labelParts, " ")
            label.Parent = entry

            local removeButton = Instance.new("TextButton")
            removeButton.Name = "RemoveTrailer"
            removeButton.Size = UDim2.new(0.35, -10, 0.75, 0)
            removeButton.Position = UDim2.new(0.65, 0, 0.125, 0)
            removeButton.BackgroundColor3 = Color3.fromRGB(170, 70, 70)
            removeButton.TextColor3 = Color3.new(1, 1, 1)
            removeButton.Font = Enum.Font.GothamBold
            removeButton.TextSize = 15
            removeButton.Text = "Retirer"
            removeButton.Parent = entry

            local partId = record.Id
            removeButton.MouseButton1Click:Connect(function()
                BuildRemotes.TrailerRequestRemove:InvokeServer(partId)
            end)
        end
    end

    if ui.TrailerListEmptyLabel then
        ui.TrailerListEmptyLabel.Visible = count == 0
    end
    resizeTrailerList()
end

local function ensureGhost(size)
    if not ghostPart then
        ghostPart = Instance.new("Part")
        ghostPart.Name = "PlacementGhost"
        ghostPart.CanCollide = false
        ghostPart.Anchored = true
        ghostPart.Material = Enum.Material.Neon
        ghostPart.Color = Color3.fromRGB(120, 220, 255)
        ghostPart.Transparency = 0.5
        ghostPart.Parent = workspace
    end
    ghostPart.Size = size or Vector3.new(6, 4, 6)
end

local function destroyGhost()
    if ghostPart then
        ghostPart:Destroy()
        ghostPart = nil
    end
end

local function createConstructionButton()
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 120, 0, 60)
    button.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.Gotham
    button.TextSize = 16
    button.Parent = getConstructionButtonParent()
    button.MouseButton1Click:Connect(function()
        local constructionId = button:GetAttribute("ConstructionId")
        local def = constructionId and constructionDefs[constructionId]
        if def then
            selectConstruction(def)
        end
    end)
    return button
end

local function applyConstructionDefinitions(definitions)
    local seen = {}
    constructionDefs = {}
    local displayIndex = 0
    for _, def in ipairs(definitions) do
        constructionDefs[def.Id] = def
        if string.lower(def.Category or "") == "deco" then
            displayIndex += 1
            seen[def.Id] = true
            local button = constructionButtons[def.Id]
            if not button then
                button = createConstructionButton()
                constructionButtons[def.Id] = button
            end
            button.Name = "Construction_" .. def.Id
            button.Text = def.DisplayName or def.Id
            button.LayoutOrder = CONSTRUCTION_LAYOUT_OFFSET + displayIndex
            button:SetAttribute("ConstructionId", def.Id)
            button.Parent = getConstructionButtonParent()
        end
    end

    for id, button in pairs(constructionButtons) do
        if not seen[id] then
            if isConstructionSelected() and selectedConstructionId == id then
                selectedConstructionId = nil
                selectedConstructionDef = nil
                selectedCatalog = "Objects"
                destroyGhost()
            end
            button:Destroy()
            constructionButtons[id] = nil
        end
    end
end

local function clampToPlot(position, objectHeight)
    if not currentPlot then
        return nil
    end
    local grid = GRID_SIZE
    local halfX = (currentPlot.Size.X / 2) - (grid / 2)
    local halfZ = (currentPlot.Size.Y / 2) - (grid / 2)
    if halfX <= 0 or halfZ <= 0 then
        return nil
    end
    local relativeX = math.clamp(position.X - currentPlot.Center.X, -halfX, halfX)
    local relativeZ = math.clamp(position.Z - currentPlot.Center.Z, -halfZ, halfZ)
    local snappedX = math.clamp(roundToGrid(relativeX, grid), -halfX, halfX)
    local snappedZ = math.clamp(roundToGrid(relativeZ, grid), -halfZ, halfZ)
    local height = objectHeight or grid
    local baseY = getPlotBaseHeight()
    local y = baseY + math.max(height / 2, 0)
    return Vector3.new(currentPlot.Center.X + snappedX, y, currentPlot.Center.Z + snappedZ)
end

local function isInsidePlot(position)
    if not currentPlot then
        return false
    end
    local halfX = currentPlot.Size.X / 2
    local halfZ = currentPlot.Size.Y / 2
    local dx = math.abs(position.X - currentPlot.Center.X)
    local dz = math.abs(position.Z - currentPlot.Center.Z)
    return dx <= halfX and dz <= halfZ
end

local function getTrailerGridBase()
    if not currentPlot then
        return nil
    end
    return Vector3.new(
        currentPlot.Center.X - (currentPlot.Size.X / 2),
        currentPlot.Center.Y,
        currentPlot.Center.Z - (currentPlot.Size.Y / 2)
    )
end

local function getTrailerGridLimits()
    if not currentPlot then
        return nil, nil
    end
    local cell = CampConfig.TRAILER_CELL_SIZE or 4
    local cellsX = math.floor(currentPlot.Size.X / cell)
    local cellsZ = math.floor(currentPlot.Size.Y / cell)
    return cellsX, cellsZ, cell
end

local function getTrailerFootprint(partId, rotation)
    local def = TrailerPartsConfig[partId]
    if not def then
        return nil
    end
    local gridSize = def.GridSize or Vector2.new(1, 1)
    local sizeX = math.max(1, math.floor(gridSize.X + 0.0001))
    local sizeZ = math.max(1, math.floor(gridSize.Y + 0.0001))
    if rotation % 180 ~= 0 then
        sizeX, sizeZ = sizeZ, sizeX
    end
    return sizeX, sizeZ, def
end

local function snapTrailerPlacement(worldPosition, partId, rotation)
    local base = getTrailerGridBase()
    local maxX, maxZ, cell = getTrailerGridLimits()
    if not base or not maxX or not cell then
        return nil
    end
    local footprintX, footprintZ, def = getTrailerFootprint(partId, rotation)
    if not footprintX then
        return nil
    end
    if footprintX > maxX or footprintZ > maxZ then
        return nil
    end
    local gridX = math.floor((worldPosition.X - base.X) / cell)
    local gridZ = math.floor((worldPosition.Z - base.Z) / cell)
    gridX = math.clamp(gridX, 0, math.max(0, maxX - footprintX))
    gridZ = math.clamp(gridZ, 0, math.max(0, maxZ - footprintZ))

    local width = footprintX * cell
    local depth = footprintZ * cell
    local centerX = base.X + (gridX * cell) + (width / 2)
    local centerZ = base.Z + (gridZ * cell) + (depth / 2)
    local levelMap = CampConfig.TRAILER_CATEGORY_LEVEL or {}
    local level = levelMap[def.Category] or 0
    local baseHeights = CampConfig.TRAILER_LEVEL_BASE or { [0] = 0 }
    local yBase = (baseHeights[level] or 0) + currentPlot.Center.Y
    local centerY = yBase + (def.Height / 2)
    local cframe = CFrame.new(centerX, centerY, centerZ) * CFrame.Angles(0, math.rad(rotation), 0)
    local worldSize = Vector3.new(width, def.Height, depth)
    return {
        Grid = { x = gridX, z = gridZ },
        CFrame = cframe,
        Size = worldSize,
        Level = level,
    }
end

local function ensureDeleteSelection()
    if not deleteSelection then
        deleteSelection = Instance.new("SelectionBox")
        deleteSelection.LineThickness = 0.08
        deleteSelection.Color3 = Color3.fromRGB(255, 120, 120)
        deleteSelection.SurfaceColor3 = Color3.fromRGB(255, 180, 180)
        deleteSelection.SurfaceTransparency = 0.5
        deleteSelection.Parent = workspace
    end
    return deleteSelection
end

local function clearDeleteSelection()
    if deleteSelection then
        deleteSelection.Adornee = nil
    end
    hoveredObjectId = nil
end

local function setDeleteMode(state)
    deleteMode = state and buildMode
    if ui.DeleteButton then
        ui.DeleteButton.BackgroundColor3 = deleteMode and Color3.fromRGB(220, 90, 60) or Color3.fromRGB(200, 120, 40)
    end
    if deleteMode then
        destroyGhost()
        updateStatus("Mode suppression : cliquez sur un objet")
    else
        clearDeleteSelection()
    end
end

local function attachPlotHighlight(plotId)
    if plotHighlight then
        plotHighlight:Destroy()
        plotHighlight = nil
    end
    if not plotId then
        return
    end
    local base = workspace:FindFirstChild("Plot_" .. plotId)
    if base and base:IsA("BasePart") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "PlotHighlight"
        highlight.FillColor = Color3.fromRGB(80, 200, 140)
        highlight.FillTransparency = 1
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0.7
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = base
        highlight.Parent = base
        plotHighlight = highlight
    end
end

local function updatePlotHighlight(inside)
    if not plotHighlight then
        return
    end
    plotHighlight.FillTransparency = inside and 0.75 or 1
    plotHighlight.OutlineTransparency = inside and 0.2 or 0.7
end

local function selectObject(objectType)
    selectedCatalog = "Objects"
    selectedConstructionId = nil
    selectedConstructionDef = nil
    selectedObject = objectType
    currentRotation = 0
    local def = ObjectsConfig[objectType]
    local previewSize = def and def.PreviewSize or Vector3.new(6, 4, 6)
    local entry = getEconomyEntry(objectType, "Objects")
    local label = def and def.Label or objectType
    ensureGhost(previewSize)
    updateStatus(string.format("%s : %d$ → +%.2f$/s (R pour pivoter)", label, entry.Cost or 0, entry.IncomePerSecond or 0))
    setDeleteMode(false)
end

selectConstruction = function(def)
    if not def then
        return
    end
    selectedCatalog = "Construction"
    selectedObject = nil
    selectedConstructionId = def.Id
    selectedConstructionDef = def
    currentRotation = 0
    local previewSize = def.PreviewSize or Vector3.new(6, 4, 6)
    local entry = getEconomyEntry(def.Id, "Construction")
    ensureGhost(previewSize)
    updateStatus(string.format("%s : %d$ → +%.2f$/s (R pour pivoter)", def.DisplayName or def.Id, entry.Cost or 0, entry.IncomePerSecond or 0))
    setDeleteMode(false)
end

setBuildMode = function(state)
    if not currentPlot then
        return
    end
    if state then
        setTrailerMode(false)
    end
    buildMode = state
    ui.Toolbar.Visible = state
    if ui.PlacedListFrame then
        ui.PlacedListFrame.Visible = state
    end
    if not state then
        destroyGhost()
        selectedObject = nil
        selectedCatalog = "Objects"
        selectedConstructionId = nil
        selectedConstructionDef = nil
        hoverPosition = nil
        setDeleteMode(false)
        updateStatus("Mode construction désactivé")
    else
        updateStatus("Sélectionnez un objet")
    end
end

setTrailerMode = function(state)
    if not currentPlot then
        return
    end
    if state and not trailerMode then
        setBuildMode(false)
        setDeleteMode(false)
    end
    trailerMode = state
    if ui.TrailerToolbar then
        ui.TrailerToolbar.Visible = state
    end
    if ui.TrailerListFrame then
        ui.TrailerListFrame.Visible = state
    end
    if ui.TrailerButton then
        ui.TrailerButton.BackgroundColor3 = state and TRAILER_BUTTON_ACTIVE or TRAILER_BUTTON_COLOR
    end
    if not state then
        selectedTrailerPart = nil
        trailerHoverPosition = nil
        trailerGridPosition = nil
        trailerRotation = 0
        updateTrailerStatus("Mode roulotte désactivé")
        destroyGhost()
    else
        updateTrailerStatus("Sélectionnez un module (R pour pivoter)")
    end
end

local function selectTrailerPart(partId)
    selectedTrailerPart = partId
    trailerRotation = 0
    if not trailerMode then
        setTrailerMode(true)
    end
    local def = TrailerPartsConfig[partId]
    updateTrailerStatus(string.format("Pièce : %s (R pour pivoter)", def and def.DisplayName or partId))
end

local function observeLeaderstat(statName, callback)
    local function attach(stat)
        callback(stat.Value)
        stat:GetPropertyChangedSignal("Value"):Connect(function()
            callback(stat.Value)
        end)
    end

    local function inspect(folder)
        local stat = folder:FindFirstChild(statName)
        if stat then
            attach(stat)
        end
        folder.ChildAdded:Connect(function(child)
            if child.Name == statName then
                attach(child)
            end
        end)
    end

    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        inspect(leaderstats)
    end

    LocalPlayer.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then
            inspect(child)
        end
    end)
end

observeLeaderstat("Cash", function(value)
    currentCash = tonumber(value) or 0
end)

observeLeaderstat("IncomePerSecond", function(value)
    currentIncome = tonumber(value) or 0
    updateAllObjectButtons()
end)

local function tryPlace()
    if not buildMode or not hoverPosition then
        return
    end
    if selectedCatalog == "Objects" and not selectedObject then
        return
    end
    if selectedCatalog == "Construction" and not selectedConstructionId then
        return
    end
    if tick() - lastPlacement < placementCooldown then
        return
    end

    local payload
    if selectedCatalog == "Construction" then
        payload = {
            Catalog = "Construction",
            ConstructionId = selectedConstructionId,
            Position = hoverPosition,
            Rotation = currentRotation,
        }
    else
        payload = {
            ObjectType = selectedObject,
            Position = hoverPosition,
            Rotation = currentRotation,
        }
    end

    local success, message = BuildRemotes.RequestPlacement:InvokeServer(payload)

    if success then
        lastPlacement = tick()
        updateStatus(selectedCatalog == "Construction" and "Bloc placé !" or "Objet placé !")
    else
        updateStatus(message or "Placement refusé")
    end
end

local function tryPlaceTrailer()
    if not trailerMode or not selectedTrailerPart or not trailerGridPosition then
        return
    end
    if tick() - lastTrailerPlacement < placementCooldown then
        return
    end

    local success, message = BuildRemotes.TrailerRequestPlacement:InvokeServer({
        PartId = selectedTrailerPart,
        GridPosition = {
            x = trailerGridPosition.x,
            z = trailerGridPosition.z,
        },
        Rotation = trailerRotation,
    })

    if success then
        lastTrailerPlacement = tick()
        updateTrailerStatus("Pièce placée !")
    else
        updateTrailerStatus(message or "Placement refusé")
    end
end

local function tryDelete()
    if not deleteMode or not hoveredObjectId then
        return
    end
    local success, message = BuildRemotes.RequestRemove:InvokeServer(hoveredObjectId)
    if success then
        updateStatus("Objet supprimé")
        clearDeleteSelection()
    else
        updateStatus(message or "Suppression refusée")
    end
end

ui.BuildButton.MouseButton1Click:Connect(function()
    setBuildMode(not buildMode)
end)

ui.CancelButton.MouseButton1Click:Connect(function()
    setBuildMode(false)
end)

if ui.TrailerButton then
    ui.TrailerButton.MouseButton1Click:Connect(function()
        setTrailerMode(not trailerMode)
    end)
end

if ui.TrailerCancelButton then
    ui.TrailerCancelButton.MouseButton1Click:Connect(function()
        setTrailerMode(false)
    end)
end

if ui.DeleteButton then
    ui.DeleteButton.MouseButton1Click:Connect(function()
        if buildMode then
            setDeleteMode(not deleteMode)
        end
    end)
end

if ui.TutorialClose then
    ui.TutorialClose.MouseButton1Click:Connect(function()
        tutorialDismissed = true
        ui.TutorialFrame.Visible = false
    end)
end

for objectType, button in pairs(ui.Buttons) do
    button.MouseButton1Click:Connect(function()
        if not buildMode then
            return
        end
        local unlocked = button:GetAttribute("IsUnlocked") ~= false
        if not unlocked then
            local requirement = button:GetAttribute("UnlockAtIncome") or 0
            updateStatus(string.format("Débloqué à %.2f $/s", requirement))
            return
        end
        selectObject(objectType)
    end)
end

updateAllObjectButtons()

for partId, button in pairs(ui.TrailerButtons) do
    button.MouseButton1Click:Connect(function()
        selectTrailerPart(partId)
    end)
end

applyConstructionDefinitions(ConstructionRuntime.GetDefinitions())
ConstructionRuntime.OnDefinitionsChanged(applyConstructionDefinitions)

BuildRemotes.PlotAssigned.OnClientEvent:Connect(function(plotData)
    currentPlot = plotData
    ui.BuildButton.Visible = true
    if ui.TrailerButton then
        ui.TrailerButton.Visible = true
    end
    updateStatus("Parcelle attribuée !")
    attachPlotHighlight(plotData.PlotId)
    if ui.TutorialFrame and not tutorialDismissed then
        ui.TutorialFrame.Visible = true
    end
end)

BuildRemotes.ToggleBuildMode.OnClientEvent:Connect(function(state)
    setBuildMode(state)
end)

BuildRemotes.PlacedObjectsUpdated.OnClientEvent:Connect(function(objects)
    placedObjects = objects or {}
    rebuildObjectList()
end)

BuildRemotes.TrailerStateUpdated.OnClientEvent:Connect(function(records)
    trailerParts = records or {}
    rebuildTrailerList()
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end
    if trailerMode then
        if input.KeyCode == Enum.KeyCode.R then
            trailerRotation = (trailerRotation + 90) % 360
        elseif input.KeyCode == Enum.KeyCode.Escape then
            setTrailerMode(false)
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            tryPlaceTrailer()
        end
        return
    end
    if not buildMode then
        return
    end
    if input.KeyCode == Enum.KeyCode.R and not deleteMode then
        currentRotation = (currentRotation + 45) % 360
    elseif input.KeyCode == Enum.KeyCode.Escape then
        setBuildMode(false)
        -- quitter le mode déplacement si actif et restaurer transparence
        if moveHighlight and moveHighlight.Adornee then
            for _, part in ipairs(moveHighlight.Adornee:GetDescendants()) do
                if part:IsA("BasePart") then
                    local originalTrans = part:GetAttribute("OriginalTransparency")
                    if originalTrans then
                        part.Transparency = originalTrans
                        part:SetAttribute("OriginalTransparency", nil)
                    end
                end
            end
        end
        movingObjectId = nil
        if moveGhost then moveGhost:Destroy() moveGhost = nil end
        if moveHighlight then moveHighlight:Destroy() moveHighlight = nil end
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        if deleteMode then
            tryDelete()
        elseif movingObjectId then
            print("[BuildClient] Clic détecté en mode déplacement pour objet:", movingObjectId)
            local hit = mouse.Hit
            if hit then
                if tick() - lastPlacement >= placementCooldown then
                    local target = clampToPlot(hit.Position, 2)
                    if target then
                        if not isInsidePlot(target) then
                            updateStatus("⚠️ Position hors de la parcelle")
                            return
                        end
                        print("[BuildClient] Envoi RequestMove pour objet:", movingObjectId, "position:", target)
                        local success, message = BuildRemotes.RequestMove:InvokeServer({
                            ObjectId = movingObjectId,
                            CFrame = { x = target.X, y = target.Y, z = target.Z },
                            Rotation = currentRotation,
                        })
                        print("[BuildClient] RequestMove résultat:", success, message)
                        if success then
                            lastPlacement = tick()
                            updateStatus("Objet déplacé")
                            
                            -- Restaurer la transparence originale
                            if moveHighlight and moveHighlight.Adornee then
                                for _, part in ipairs(moveHighlight.Adornee:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        local originalTrans = part:GetAttribute("OriginalTransparency")
                                        if originalTrans then
                                            part.Transparency = originalTrans
                                            part:SetAttribute("OriginalTransparency", nil)
                                        end
                                    end
                                end
                            end
                            
                            movingObjectId = nil
                            if moveGhost then moveGhost:Destroy() moveGhost = nil end
                            if moveHighlight then moveHighlight:Destroy() moveHighlight = nil end
                            -- Rafraîchir la liste des objets
                            task.wait(0.1)
                            rebuildObjectList()
                        else
                            updateStatus(message or "Déplacement refusé")
                        end
                    else
                        print("[BuildClient] clampToPlot a retourné nil")
                    end
                else
                    print("[BuildClient] Cooldown actif")
                end
            else
                print("[BuildClient] mouse.Hit est nil")
            end
        else
            tryPlace()
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if deleteMode then
        local target = mouse.Target
        if target and target:GetAttribute("PlotObjectId") then
            ensureDeleteSelection().Adornee = target
            hoveredObjectId = target:GetAttribute("PlotObjectId")
        else
            clearDeleteSelection()
        end
    end

    if trailerMode and selectedTrailerPart and currentPlot then
        local hit = mouse.Hit
        if hit then
            local snap = snapTrailerPlacement(hit.Position, selectedTrailerPart, trailerRotation)
            if snap then
                trailerHoverPosition = snap.CFrame.Position
                trailerGridPosition = snap.Grid
                ensureGhost(snap.Size)
                ghostPart.Color = Color3.fromRGB(255, 170, 120)
                ghostPart.Transparency = 0.35
                ghostPart.CFrame = snap.CFrame
            elseif ghostPart then
                ghostPart.Transparency = 1
                trailerGridPosition = nil
            end
        end
    elseif buildMode and currentPlot then
        local previewSize
        if selectedCatalog == "Construction" and selectedConstructionDef then
            previewSize = selectedConstructionDef.PreviewSize or Vector3.new(6, 4, 6)
        elseif selectedCatalog == "Objects" and selectedObject then
            local def = ObjectsConfig[selectedObject]
            previewSize = (def and def.PreviewSize) or Vector3.new(6, 4, 6)
        end

        if previewSize then
            local hit = mouse.Hit
            if hit then
                local clamped = clampToPlot(hit.Position, previewSize.Y)
                if clamped then
                    hoverPosition = clamped
                    ensureGhost(previewSize)
                    ghostPart.Color = Color3.fromRGB(120, 220, 255)
                    ghostPart.Transparency = 0.5
                    ghostPart.CFrame = CFrame.new(clamped) * CFrame.Angles(0, math.rad(currentRotation), 0)
                end
            end
        elseif ghostPart then
            ghostPart.Transparency = 1
            hoverPosition = nil
        end
        -- Mise à jour du fantôme de déplacement
        if movingObjectId and moveGhost then
            local hit = mouse.Hit
            if hit then
                local clamped = clampToPlot(hit.Position, moveGhost.Size.Y)
                if clamped then
                    local inside = isInsidePlot(clamped)
                    moveGhost.CFrame = CFrame.new(clamped) * CFrame.Angles(0, math.rad(currentRotation), 0)
                    if inside then
                        moveGhost.Color = Color3.fromRGB(80, 180, 255)
                        moveGhost.Transparency = 0.5
                    else
                        moveGhost.Color = Color3.fromRGB(255, 100, 100)
                        moveGhost.Transparency = 0.3
                    end
                end
            end
        end
    elseif ghostPart then
        ghostPart.Transparency = 1
        hoverPosition = nil
    end

    if currentPlot then
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            updatePlotHighlight(isInsidePlot(root.Position))
        end
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    buildMode = false
    trailerMode = false
    destroyGhost()
    hoverPosition = nil
    trailerHoverPosition = nil
    trailerGridPosition = nil
    selectedTrailerPart = nil
    selectedConstructionId = nil
    selectedConstructionDef = nil
    selectedCatalog = "Objects"
    setDeleteMode(false)
    if ui.Toolbar then
        ui.Toolbar.Visible = false
    end
    if ui.PlacedListFrame then
        ui.PlacedListFrame.Visible = false
    end
    if ui.TrailerToolbar then
        ui.TrailerToolbar.Visible = false
    end
    if ui.TrailerListFrame then
        ui.TrailerListFrame.Visible = false
    end
    if ui.TrailerButton then
        ui.TrailerButton.BackgroundColor3 = TRAILER_BUTTON_COLOR
    end
    updateTrailerStatus("Sélectionnez un module")
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="66">
        <Properties>
          <string name="Name">EconomyClient</string>
          <string name="Source"><![CDATA[--[[
    EconomyClient
    Affiche l'argent et le revenu passif du joueur via un petit HUD.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

local EconomyRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EconomyRemotes"))
local HudEconomy = require(playerGui:WaitForChild("ParadisGui"):WaitForChild("HudEconomy"))
local EconomyFeedback = require(playerGui:WaitForChild("ParadisGui"):WaitForChild("EconomyFeedback"))

local hud = HudEconomy.create(playerGui)
local feedback = EconomyFeedback.new(hud.ScreenGui)
local currentBoostMultiplier = 1
local latestIncomeValue = 0

local function formatNumber(value)
    value = tonumber(value) or 0
    return math.floor(value * 100 + 0.5) / 100
end

local function formatText(value)
    return string.format("%.2f", formatNumber(value))
end

local function updateCash(value)
    hud.CashLabel.Text = string.format("Argent : %s $", formatText(value))
end

local function updateIncome(value)
    latestIncomeValue = tonumber(value) or 0
    local baseText = string.format("+%s $ / sec", formatText(latestIncomeValue))
    if currentBoostMultiplier and currentBoostMultiplier > 1.01 then
        baseText = string.format("%s (x%.2f)", baseText, currentBoostMultiplier)
    end
    hud.IncomeLabel.Text = baseText
end

local function updateBoost(payload)
    payload = payload or {}
    currentBoostMultiplier = payload.Multiplier or 1
    if payload.Active then
        local label = payload.Name or "Boost actif"
        local timeLeft = payload.TimeLeft or 0
        hud.BoostLabel.Text = string.format("Boost : %s (%.0fs)", label, math.max(0, math.floor(timeLeft)))
    else
        hud.BoostLabel.Text = "Boost : Aucun"
    end
    updateIncome(latestIncomeValue)
end

local success, snapshot = pcall(function()
    return EconomyRemotes.RequestSnapshot:InvokeServer()
end)
if success and snapshot then
    updateCash(snapshot.Cash)
    updateIncome(snapshot.IncomePerSecond)
    updateBoost(snapshot.Boost)
else
    updateCash(0)
    updateIncome(0)
end

EconomyRemotes.CashUpdated.OnClientEvent:Connect(updateCash)
EconomyRemotes.IncomeUpdated.OnClientEvent:Connect(updateIncome)
EconomyRemotes.BoostUpdated.OnClientEvent:Connect(updateBoost)
EconomyRemotes.PassiveTick.OnClientEvent:Connect(function(amount, reason, multiplier)
    feedback:Show(amount, reason, multiplier)
end)

if hud.SaveButton then
    local saving = false
    hud.SaveButton.MouseButton1Click:Connect(function()
        if saving then
            return
        end
        saving = true
        hud.SaveButton.Text = "Sauvegarde..."
        local ok, result = pcall(function()
            return EconomyRemotes.RequestManualSave:InvokeServer()
        end)
        if ok and result and result.Success then
            feedback:Show(0, "Sauvegarde réussie")
        else
            feedback:Show(0, "Erreur de sauvegarde")
        end
        task.delay(2, function()
            hud.SaveButton.Text = "Sauvegarder"
            saving = false
        end)
    end)
end

local function bindLeaderstat(statName, callback)
    local function attach(stat)
        callback(stat.Value)
        stat:GetPropertyChangedSignal("Value"):Connect(function()
            callback(stat.Value)
        end)
    end

    local function inspect(folder)
        local stat = folder:FindFirstChild(statName)
        if stat then
            attach(stat)
        end
        folder.ChildAdded:Connect(function(child)
            if child.Name == statName then
                attach(child)
            end
        end)
    end

    local existing = LocalPlayer:FindFirstChild("leaderstats")
    if existing then
        inspect(existing)
    end

    LocalPlayer.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then
            inspect(child)
        end
    end)
end

bindLeaderstat("Cash", updateCash)
bindLeaderstat("IncomePerSecond", updateIncome)

-- Afficher le nombre de bûches transportées
local function updateLogs()
    local logs = LocalPlayer:GetAttribute("Logs") or 0
    if hud.LogsLabel then
        hud.LogsLabel.Text = string.format("🪵 Bûches : %d", logs)
    end
end

-- Mise à jour initiale
updateLogs()

-- Écouter les changements d'attribut Logs
LocalPlayer:GetAttributeChangedSignal("Logs"):Connect(updateLogs)
]]></string>
        </Properties>
      </Item>
