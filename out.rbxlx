    <Item class="Folder" referent="23">
      <Properties>
        <string name="Name">ParadisServer</string>
      </Properties>
      <Item class="Script" referent="24">
        <Properties>
          <string name="Name">BackgroundMusic</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- BackgroundMusic.server.lua
-- Joue une musique d'ambiance dans tout le jeu

local SoundService = game:GetService("SoundService")

-- ====================================
-- CONFIGURATION MUSIQUE
-- ====================================
local MUSIC_PLAYLIST = {
	"rbxassetid://115222151625604", -- Je spawn encore dans mon petit coin de paradis
	"rbxassetid://115905909512113", -- La vie est belle
	"rbxassetid://117790257108974"  -- Chanson roblox
}
local MUSIC_VOLUME = 0.5 -- Volume (0 à 1)
local MUSIC_FADE_TIME = 2 -- Temps de fondu en secondes

-- ====================================
-- CRÉATION DE LA MUSIQUE
-- ====================================

-- Créer le SoundGroup pour la musique (optionnel, pour contrôler le volume global)
local musicGroup = SoundService:FindFirstChild("MusicGroup")
if not musicGroup then
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "MusicGroup"
	musicGroup.Volume = 1
	musicGroup.Parent = SoundService
end

-- Créer le son de fond
local backgroundMusic = Instance.new("Sound")
backgroundMusic.Name = "BackgroundMusic"
backgroundMusic.Volume = 0 -- Commence à 0 pour le fondu
backgroundMusic.SoundGroup = musicGroup
backgroundMusic.Parent = SoundService

local currentTrackIndex = 1

-- Fonction pour jouer une chanson avec fondu
local function playTrackWithFade(trackIndex)
	local assetId = MUSIC_PLAYLIST[trackIndex]
	if not assetId then
		trackIndex = 1
		assetId = MUSIC_PLAYLIST[1]
	end
	
	currentTrackIndex = trackIndex
	backgroundMusic.SoundId = assetId
	backgroundMusic:Play()
	
	-- Fondu d'entrée
	local targetVolume = MUSIC_VOLUME
	local steps = 20
	local stepTime = MUSIC_FADE_TIME / steps
	local volumeIncrement = targetVolume / steps
	
	for i = 1, steps do
		task.wait(stepTime)
		backgroundMusic.Volume = math.min(backgroundMusic.Volume + volumeIncrement, targetVolume)
	end
	
	print(string.format("[BackgroundMusic] Musique démarrée (Piste %d/%d, ID: %s, Volume: %.2f)", 
		currentTrackIndex, #MUSIC_PLAYLIST, assetId, MUSIC_VOLUME))
end

-- Démarrer la première piste
playTrackWithFade(1)

-- Passer à la piste suivante quand une chanson se termine
backgroundMusic.Ended:Connect(function()
	local nextIndex = currentTrackIndex + 1
	if nextIndex > #MUSIC_PLAYLIST then
		nextIndex = 1
	end
	playTrackWithFade(nextIndex)
end)

-- ====================================
-- CONTRÔLE OPTIONNEL (Commandes)
-- ====================================

-- Fonction pour ajuster le volume
local function setMusicVolume(volume)
	backgroundMusic.Volume = math.clamp(volume, 0, 1)
	print(string.format("[BackgroundMusic] Volume ajusté: %.2f", volume))
end

-- Fonction pour mettre en pause/reprendre
local function toggleMusic()
	if backgroundMusic.IsPlaying then
		backgroundMusic:Pause()
		print("[BackgroundMusic] Musique en pause")
	else
		backgroundMusic:Resume()
		print("[BackgroundMusic] Musique reprise")
	end
end

-- Exposer les fonctions globalement (optionnel, pour debug)
_G.SetMusicVolume = setMusicVolume
_G.ToggleMusic = toggleMusic

print("[BackgroundMusic] Service initialisé - Commandes disponibles: _G.SetMusicVolume(0.5), _G.ToggleMusic()")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">CampingWorldGenerator</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local CampLayoutConfig = require(ConfigFolder:WaitForChild("CampLayoutConfig"))
local MiniGamesConfig = require(ConfigFolder:WaitForChild("MiniGamesConfig"))

local CampingWorldGenerator = {}

local worldFolders = {}
local roadsByName = {}
local generatedPlots = {}
local hasGenerated = false
local transform = CampLayoutConfig.Transform or {}
local offset = transform.Offset

local function applyPosition(vec)
    if not vec then
        return vec
    end
    local x, y, z = vec.X, vec.Y, vec.Z
    if transform.MirrorX then
        x = -x
    end
    if offset then
        x += offset.X or 0
        y += offset.Y or 0
        z += offset.Z or 0
    end
    return Vector3.new(x, y, z)
end

local function getOrCreateWorkspaceFolder(name)
    if worldFolders[name] then
        return worldFolders[name]
    end
    local folder = Workspace:FindFirstChild(name)
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = Workspace
    end
    folder:ClearAllChildren()
    worldFolders[name] = folder
    return folder
end

local function createGround()
    local cfg = CampLayoutConfig.Ground
    if not cfg then
        return
    end
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local part = Instance.new("Part")
    part.Name = "Ground"
    part.Anchored = true
    part.Size = cfg.Size or Vector3.new(400, 1, 400)
    part.Position = applyPosition(cfg.Position or Vector3.new())
    part.Material = cfg.Material or Enum.Material.Grass
    part.Color = cfg.Color or Color3.fromRGB(90, 170, 90)
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    print("[Paradis][CampingWorldGenerator] Sol posé.")
end

local function createSurroundingWater()
    local cfg = CampLayoutConfig.SurroundingWater
    if not cfg then
        return
    end
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local part = Instance.new("Part")
    part.Name = "IslandWater"
    part.Anchored = true
    part.Size = cfg.Size or Vector3.new(1200, 2, 900)
    part.Position = applyPosition(cfg.Position or Vector3.new())
    part.Material = cfg.Material or Enum.Material.Water
    part.Color = cfg.Color or Color3.fromRGB(40, 130, 170)
    part.Transparency = cfg.Transparency or 0.2
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    print("[Paradis][CampingWorldGenerator] Eaux périphériques posées.")
end

local function createLake()
    local cfg = CampLayoutConfig.Lake
    if not cfg then
        return
    end
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local part = Instance.new("Part")
    part.Name = "Lake"
    part.Anchored = true
    part.Size = cfg.Size or Vector3.new(200, 2, 100)
    part.Position = applyPosition(cfg.Position or Vector3.new(0, 0.5, 0))
    part.Material = cfg.Material or Enum.Material.Water
    part.Color = cfg.Color or Color3.fromRGB(20, 120, 150)
    part.Transparency = cfg.Transparency or 0.1
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    print("[Paradis][CampingWorldGenerator] Lac créé.")
end

local function createFishingSpots()
    local fishingCfg = MiniGamesConfig and MiniGamesConfig.FishingGame
    if not fishingCfg then
        return
    end

    local fishingFolder = getOrCreateWorkspaceFolder("FishingArea")
    for _, spotCfg in ipairs(fishingCfg.Spots or {}) do
        local spot = Instance.new("Part")
        spot.Name = spotCfg.Name or "FishingSpot"
        spot.Anchored = true
        spot.Size = Vector3.new(4, 1, 4)
        spot.Position = applyPosition(spotCfg.Position)
        spot.Material = Enum.Material.WoodPlanks
        spot.Color = Color3.fromRGB(180, 140, 90)
        spot.Parent = fishingFolder

        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "FishPrompt"
        prompt.ObjectText = "Jeu de pêche"
        prompt.ActionText = "Pêcher"
        prompt.MaxActivationDistance = 10
        prompt.Parent = spot
    end

    print(string.format("[Paradis][World] Spots de pêche générés : %d", #fishingCfg.Spots))
end

local function buildRoadSegments(roadCfg)
        local rawPoints = roadCfg.Points or {}
        local points = table.create(#rawPoints)
        for i, point in ipairs(rawPoints) do
		points[i] = applyPosition(point)
        end
    local totalLength = 0
    local segments = {}
    local roadsFolder = getOrCreateWorkspaceFolder("Roads")
    for i = 1, #points - 1 do
        local a = points[i]
        local b = points[i + 1]
        local delta = b - a
        local length = delta.Magnitude
        if length > 1 then
            local forward = delta.Unit
            local right = Vector3.new(forward.Z, 0, -forward.X)
            if right.Magnitude < 1e-3 then
                right = Vector3.new(-forward.Y, forward.X, 0)
            end
            right = right.Unit

            local segmentPart = Instance.new("Part")
            segmentPart.Name = string.format("%s_%02d", roadCfg.Name or "Road", i)
            segmentPart.Anchored = true
            segmentPart.Material = Enum.Material.Asphalt
            segmentPart.Color = Color3.fromRGB(35, 35, 35)
            segmentPart.Size = Vector3.new(roadCfg.Width or 8, 1, length)
            segmentPart.CFrame = CFrame.lookAt(a + delta / 2, a + delta / 2 + forward)
            segmentPart.Parent = roadsFolder

            table.insert(segments, {
                StartPoint = a,
                Length = length,
                Direction = forward,
                Right = right,
                Accumulated = totalLength,
                EndPoint = b,
            })
            totalLength += length
        end
    end

    roadsByName[roadCfg.Name] = {
        Name = roadCfg.Name,
        Width = roadCfg.Width or 8,
        Segments = segments,
        TotalLength = totalLength,
        PointCount = #points,
    }
end

local function createRoads()
    roadsByName = {}
    local polylines = CampLayoutConfig.RoadPolylines or {}
    for _, roadCfg in ipairs(polylines) do
        buildRoadSegments(roadCfg)
    end
    print(string.format("[Paradis][CampingWorldGenerator] %d routes générées.", #polylines))
end

local function getDistanceForPointIndex(road, index)
    if not road or not road.PointCount then
        return 0
    end
    local clamped = math.clamp(index, 1, road.PointCount)
    local dist = 0
    for segIndex = 1, math.max(0, clamped - 1) do
        local seg = road.Segments[segIndex]
        if not seg then
            break
        end
        dist += seg.Length
    end
    return dist
end

local function getPointAlong(road, distance)
    if not road then
        return Vector3.new(), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
    end
    local target = math.clamp(distance, 0, road.TotalLength)
    for _, segment in ipairs(road.Segments) do
        if target <= segment.Length then
            local point = segment.StartPoint + segment.Direction * target
            return point, segment.Direction, segment.Right
        else
            target -= segment.Length
        end
    end
    local lastSegment = road.Segments[#road.Segments]
    if lastSegment then
        return lastSegment.EndPoint, lastSegment.Direction, lastSegment.Right
    end
    return Vector3.new(), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
end

local function resolveIndex(pointCount, indexValue, default)
    if not indexValue then
        return default
    end
    local result = indexValue
    if indexValue < 0 then
        result = pointCount + indexValue
    end
    return math.clamp(result, 1, pointCount)
end

local function getSideMultipliers(side)
    if side == "Both" then
        return { -1, 1 }
    elseif side == "Left" or side == "Lake" then
        return { -1 }
    elseif side == "Right" or side == "Inside" then
        return { 1 }
    else
        return { 1 }
    end
end

local function createPlotPart(plotFolder, center, forward, right, band, plotIndex, sideTag)
    local appearance = CampLayoutConfig.PlotAppearance or {}
    local size = band.PlotSize or Vector2.new(12, 8)
    local thickness = appearance.Thickness or 0.6
    local base = Instance.new("Part")
    base.Anchored = true
    base.Name = string.format("Plot_%s_%s_%02d", band.RoadName, sideTag or "Side", plotIndex)
    base.Size = Vector3.new(size.X, thickness, size.Y)
    base.Material = appearance.Material or Enum.Material.Grass
    base.Color = appearance.Color or Color3.fromRGB(92, 180, 115)
    base.CFrame = CFrame.fromMatrix(center + Vector3.new(0, thickness / 2, 0), forward.Unit, Vector3.new(0, 1, 0), -right.Unit)
    base.Parent = plotFolder

    local border = Instance.new("SelectionBox")
    border.Name = "PlotBorder"
    border.LineThickness = 0.03
    border.Color3 = appearance.BorderColor or Color3.fromRGB(240, 210, 120)
    border.Adornee = base
    border.Parent = base

    -- Pancartes désactivées (signPost et signBoard commentés)
    --[[
    local signPost = Instance.new("Part")
    signPost.Name = base.Name .. "_Post"
    signPost.Anchored = true
    signPost.Size = Vector3.new(0.8, 6, 0.8)
    signPost.Material = Enum.Material.WoodPlanks
    signPost.Color = appearance.SignPostColor or Color3.fromRGB(170, 120, 70)
    local outward = right.Unit
    signPost.CFrame = CFrame.new(center - outward * (size.Y / 2 + 2) + Vector3.new(0, 3, 0))
    signPost.Parent = plotFolder

    local signBoard = Instance.new("Part")
    signBoard.Name = base.Name .. "_Sign"
    signBoard.Anchored = true
    signBoard.Size = Vector3.new(4.5, 2.4, 0.4)
    signBoard.Material = Enum.Material.Wood
    signBoard.Color = appearance.SignBoardColor or Color3.fromRGB(120, 80, 40)
    signBoard.CFrame = signPost.CFrame * CFrame.new(0, 1, -1.2)
    signBoard.Parent = plotFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlotBillboard"
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = signBoard

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = "Parcelle libre"
    label.TextColor3 = Color3.fromRGB(220, 255, 200)
    label.Parent = billboard
    ]]

    return base, size
end

local function createPlots()
    table.clear(generatedPlots)
    local plotsFolder = getOrCreateWorkspaceFolder("CampingPlots")
    local total = 0

    for _, band in ipairs(CampLayoutConfig.PlotBands or {}) do
        local road = roadsByName[band.RoadName]
        if road and road.TotalLength > 0 then
            local startIndex = resolveIndex(road.PointCount, band.StartIndex or 1, 1)
            local endIndex = resolveIndex(road.PointCount, band.EndIndex or road.PointCount, road.PointCount)
            local startDistance = getDistanceForPointIndex(road, startIndex) + (band.StartOffset or 0)
            local endDistance = getDistanceForPointIndex(road, endIndex)
            endDistance = math.max(endDistance - (band.EndOffset or 0), startDistance + 10)

            local usableLength = math.max(0, endDistance - startDistance)
            local iterationCount = math.max(0, band.PairCount or band.PlotCount or 0)
            if iterationCount > 0 and usableLength > 5 then
                local spacing = band.SpacingAlongRoad or ((band.PlotSize and band.PlotSize.X) or 12) + 4
                spacing = math.max(10, math.min(spacing, usableLength / iterationCount))
                local offset = startDistance + spacing * 0.5
                local sides = getSideMultipliers(band.Side)
                local depth = (band.PlotSize and band.PlotSize.Y) or 8

                for i = 1, iterationCount do
                    local distance = offset + (i - 1) * spacing
                    if distance > endDistance then
                        break
                    end
                    for _, sideMultiplier in ipairs(sides) do
                        local point, forward, right = getPointAlong(road, distance)
                        local outward = right.Unit * sideMultiplier
                        local center = point + outward * ((band.OffsetFromRoad or 8) + depth / 2)
                        local base, footprintSize = createPlotPart(plotsFolder, center, forward, outward, band, i, sideMultiplier > 0 and "Right" or "Left")
                        table.insert(generatedPlots, {
                            Id = base.Name,
                            Center = center,
                            Forward = forward,
                            Right = outward,
                            BasePart = base,
                            FootprintCFrame = base.CFrame,
                            Size = Vector2.new(footprintSize.X, footprintSize.Y),
                            Band = band.RoadName,
                        })
                        total += 1
                    end
                end
            end
        else
            warn(string.format("[Paradis][CampingWorldGenerator] Route '%s' introuvable pour bande de parcelles.", tostring(band.RoadName)))
        end
    end

    print(string.format("[Paradis][CampingWorldGenerator] %d parcelles créées.", total))
end

local function createSpawn()
    local cfg = CampLayoutConfig.Spawn or {}
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "CampingSpawn"
    spawn.Anchored = true
    spawn.Size = cfg.Size or Vector3.new(8, 1, 8)
    spawn.Position = applyPosition(cfg.Position or Vector3.new(0, 3, 0))
    spawn.Orientation = cfg.Orientation or Vector3.new()
    spawn.Transparency = 0.2
    spawn.Neutral = true
    spawn.Parent = folder
end

function CampingWorldGenerator.GetGeneratedPlots()
    if not hasGenerated then
        CampingWorldGenerator.Generate()
    end
    return generatedPlots
end

function CampingWorldGenerator.Generate()
    if hasGenerated then
        return generatedPlots
    end

    print("[Paradis][CampingWorldGenerator] Génération du camping Soleil Levant...")
    local baseplate = Workspace:FindFirstChild("Baseplate")
    if baseplate then
        baseplate:Destroy()
    end
    createSurroundingWater()
    createGround()
    createLake()
    createRoads()
    createPlots()
    createSpawn()
    -- createFishingSpots() -- Désactivé : spots de pêche placés manuellement
    hasGenerated = true
    print("[Paradis][CampingWorldGenerator] Génération terminée.")
    return generatedPlots
end

return CampingWorldGenerator
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="26">
        <Properties>
          <string name="Name">ConfigValidator</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    ConfigValidator
    Vérifie au démarrage que chaque objet plaçable possède une entrée économie.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TestService = game:GetService("TestService")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local ObjectsConfig = require(configFolder:WaitForChild("ObjectsConfig"))
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))

local missingEconomy = {}
for objectName in pairs(ObjectsConfig) do
    if not EconomyConfig.Objects[objectName] then
        table.insert(missingEconomy, objectName)
    end
end

if #missingEconomy > 0 then
    warn("[Paradis][Config] Objets sans configuration d'économie:", table.concat(missingEconomy, ", "))
else
    TestService:Message("[Paradis] Tous les objets ont une configuration d'économie.")
end

for econName in pairs(EconomyConfig.Objects) do
    if not ObjectsConfig[econName] then
        TestService:Message("[Paradis] Entrée économie inutilisée: " .. econName)
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="27">
        <Properties>
          <string name="Name">DataService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    DataService
    Responsable de la persistance simple des aménagements en DataStore.
    Les autres scripts y accèdent via shared.ParadisDataService.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local CampConfig = require(configFolder:WaitForChild("CampConfig"))
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))

local STORE_NAME = "ParadisPlots_v2"
local cache = {}
local store

local DEFAULT_CASH = (EconomyConfig.General and EconomyConfig.General.StartingCash) or 0

local DEFAULT_DATA = {
    Objects = {},
    TrailerParts = {},
    Cash = DEFAULT_CASH,
    FishingGear = {
        CurrentRod = "Basic",
        CurrentBait = "Standard",
        BaitUses = 5,
        OwnedRods = {Basic = true},
        FishInventory = {Common = 0, rare = 0, legendaire = 0},
    },
}

local function deepCopyTable(tbl)
    local clone = {}
    for key, value in pairs(tbl) do
        if type(value) == "table" then
            clone[key] = deepCopyTable(value)
        else
            clone[key] = value
        end
    end
    return clone
end

local function logDataStoreError(action, userId, err)
    warn(string.format("[Paradis][DataStore][%s][User:%s] %s", action, tostring(userId), tostring(err)))
end

local STUDIO_READ_ONLY = RunService:IsStudio()
local success, result = pcall(function()
    if STUDIO_READ_ONLY then return nil end -- On ne crée pas de DataStore effectif en Studio si API désactivé
    return DataStoreService:GetDataStore(STORE_NAME)
end)
if success then
    store = result
    if STUDIO_READ_ONLY then
        warn("[Paradis][DataStore] Mode Studio détecté: lecture/écriture DataStore désactivées (utilisation cache seulement).")
    end
else
    logDataStoreError("Init", "-", result)
end

local function normalizeData(data)
    if type(data) ~= "table" then
        data = deepCopyTable(DEFAULT_DATA)
    end
    data.Objects = type(data.Objects) == "table" and data.Objects or {}
    data.TrailerParts = type(data.TrailerParts) == "table" and data.TrailerParts or {}
    local cash = tonumber(data.Cash)
    if cash == nil then
        cash = DEFAULT_CASH
    end
    data.Cash = cash
    
    -- Normaliser FishingGear
    if type(data.FishingGear) ~= "table" then
        data.FishingGear = deepCopyTable(DEFAULT_DATA.FishingGear)
    else
        data.FishingGear.CurrentRod = data.FishingGear.CurrentRod or "Basic"
        data.FishingGear.CurrentBait = data.FishingGear.CurrentBait or "Standard"
        data.FishingGear.BaitUses = tonumber(data.FishingGear.BaitUses) or 5
        if type(data.FishingGear.OwnedRods) ~= "table" then
            data.FishingGear.OwnedRods = {Basic = true}
        end
        if type(data.FishingGear.FishInventory) ~= "table" then
            data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
        end
    end
    
    return data
end

local function loadPlayerData(userId)
    if cache[userId] then
        return cache[userId]
    end

    local data
    if store and not STUDIO_READ_ONLY then
        local ok, resultData = pcall(function()
            return store:GetAsync(tostring(userId))
        end)
        if ok then
            data = normalizeData(resultData)
        else
            logDataStoreError("Load", userId, resultData)
            data = deepCopyTable(DEFAULT_DATA)
        end
    else
        data = deepCopyTable(DEFAULT_DATA)
    end

    cache[userId] = data
    return data
end

local function savePlayerData(userId, data)
    data = normalizeData(data)
    cache[userId] = data
    if not store or STUDIO_READ_ONLY then
        return
    end

    local ok, err = pcall(function()
        store:SetAsync(tostring(userId), data)
    end)
    if not ok then
        logDataStoreError("Save", userId, err)
    end
end

local function getDefaultData()
    return deepCopyTable(DEFAULT_DATA)
end

shared.ParadisDataService = {
    LoadPlayerData = loadPlayerData,
    SavePlayerData = savePlayerData,
    GetDefaultData = getDefaultData,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="28">
        <Properties>
          <string name="Name">EconomyService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    EconomyService
    Gère la monnaie des campeurs, les déblocages, les boosts et la persistance.
    Les autres scripts y accèdent via shared.ParadisEconomyService.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))
local EconomyRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EconomyRemotes"))

local STARTING_CASH = (EconomyConfig.General and EconomyConfig.General.StartingCash) or 150
local CASH_CAP = (EconomyConfig.General and EconomyConfig.General.CashCap) or math.huge
local MAINTENANCE_RATE = (EconomyConfig.General and EconomyConfig.General.MaintenanceTaxRate) or 0
local MAINTENANCE_INTERVAL = (EconomyConfig.General and EconomyConfig.General.MaintenanceIntervalSeconds) or 0
local AUTOSAVE_INTERVAL = 120

if CASH_CAP <= 0 then
    CASH_CAP = math.huge
end

local BOOST_SETTINGS = EconomyConfig.Boosts or {}

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local DataService = waitForShared("ParadisDataService")
local PlotService
task.spawn(function()
    PlotService = waitForShared("ParadisPlotService")
end)

local playerEconomy = {}

local boostState = {
    Active = false,
    Name = nil,
    Multiplier = 1,
    EndsAt = 0,
    NextStart = os.clock() + ((BOOST_SETTINGS.IntervalSeconds or 420)),
}

local function getBoostPayload()
    return {
        Active = boostState.Active,
        Name = boostState.Name,
        Multiplier = boostState.Multiplier,
        TimeLeft = boostState.Active and math.max(0, boostState.EndsAt - os.clock()) or 0,
    }
end

local function broadcastBoost()
    local payload = getBoostPayload()
    for _, player in ipairs(Players:GetPlayers()) do
        EconomyRemotes.BoostUpdated:FireClient(player, payload)
    end
end

local function ensureLeaderstats(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end

    local cashValue = stats:FindFirstChild("Cash")
    if not cashValue then
        cashValue = Instance.new("NumberValue")
        cashValue.Name = "Cash"
        cashValue.Value = 0
        cashValue.Parent = stats
    end

    local incomeValue = stats:FindFirstChild("IncomePerSecond")
    if not incomeValue then
        incomeValue = Instance.new("NumberValue")
        incomeValue.Name = "IncomePerSecond"
        incomeValue.Value = 0
        incomeValue.Parent = stats
    end

    return cashValue, incomeValue
end

local function roundCurrency(amount)
    return math.floor((amount or 0) * 100 + 0.5) / 100
end

local function ensureState(player)
    local state = playerEconomy[player]
    if state then
        return state
    end

    local data = DataService.LoadPlayerData(player.UserId)
    local currentCash = tonumber(data.Cash)
    if currentCash == nil then
        currentCash = STARTING_CASH
        data.Cash = currentCash
    end

    state = {
        Cash = currentCash,
        IncomePerSecond = 0,
        Data = data,
        LastMaintenance = os.clock(),
    }
    playerEconomy[player] = state
    return state
end

local function syncLeaderstats(player, state)
    local cashValue, incomeValue = ensureLeaderstats(player)
    cashValue.Value = roundCurrency(state.Cash)
    incomeValue.Value = roundCurrency(state.IncomePerSecond)
end

local function broadcastEconomy(player, state)
    EconomyRemotes.CashUpdated:FireClient(player, roundCurrency(state.Cash))
    EconomyRemotes.IncomeUpdated:FireClient(player, roundCurrency(state.IncomePerSecond))
end

local function persistPlayer(player, state)
    if not state or not state.Data then
        return
    end
    state.Data.Cash = roundCurrency(state.Cash)
    DataService.SavePlayerData(player.UserId, state.Data)
end

local function getEconomyEntry(catalog, objectId)
    catalog = catalog == "Construction" and "Construction" or "Objects"
    return EconomyConfig.Resolve(catalog, objectId)
end

local function resolveRecordIncome(record)
    if type(record) ~= "table" then
        return 0
    end
    local catalog = record.Catalog
    local objectId

    if catalog == "Construction" or record.Type == "Construction" then
        catalog = "Construction"
        objectId = record.ConstructionId or record.ObjectId or record.Type
    else
        catalog = "Objects"
        objectId = record.Type or record.ObjectId
    end

    if not objectId then
        return tonumber(record.IncomePerSecond) or 0
    end

    local entry = getEconomyEntry(catalog, objectId)
    if (entry.IncomePerSecond or 0) == 0 then
        return tonumber(record.IncomePerSecond) or 0
    end
    return entry.IncomePerSecond
end

local EconomyAPI = {}

function EconomyAPI.GetEconomyForObject(catalog, objectId)
    if not objectId then
        return EconomyConfig.Defaults or { Cost = 0, IncomePerSecond = 0, UnlockAtIncome = 0 }
    end
    return EconomyConfig.Resolve(catalog == "Construction" and "Construction" or "Objects", objectId)
end

function EconomyAPI.GetCash(player)
    local state = ensureState(player)
    return state.Cash
end

function EconomyAPI.GetIncomePerSecond(player)
    local state = ensureState(player)
    return state.IncomePerSecond
end

function EconomyAPI.HasEnoughCash(player, cost)
    local state = ensureState(player)
    return state.Cash >= (cost or 0)
end

function EconomyAPI.GetUnlockRequirement(catalog, objectId)
    local entry = EconomyAPI.GetEconomyForObject(catalog, objectId)
    return entry.UnlockAtIncome or 0
end

function EconomyAPI.CanUseObject(player, catalog, objectId)
    local required = EconomyAPI.GetUnlockRequirement(catalog, objectId)
    local state = ensureState(player)
    return state.IncomePerSecond >= required, required
end

function EconomyAPI.AddCash(player, amount)
    if not player or not amount or amount == 0 then
        return 0
    end
    local state = ensureState(player)
    local target = roundCurrency(state.Cash + amount)
    target = math.clamp(target, 0, CASH_CAP)
    local applied = roundCurrency(target - state.Cash)
    if applied == 0 and amount ~= 0 then
        return 0
    end
    state.Cash = target
    state.Data.Cash = state.Cash
    syncLeaderstats(player, state)
    broadcastEconomy(player, state)
    return applied
end

function EconomyAPI.AddIncomeSource(player, amount)
    if not player or not amount or amount == 0 then
        return
    end
    local state = ensureState(player)
    state.IncomePerSecond = roundCurrency(math.max(0, state.IncomePerSecond + amount))
    syncLeaderstats(player, state)
    EconomyRemotes.IncomeUpdated:FireClient(player, state.IncomePerSecond)
end

function EconomyAPI.RemoveIncomeSource(player, amount)
    if not amount or amount == 0 then
        return
    end
    EconomyAPI.AddIncomeSource(player, -amount)
end

function EconomyAPI.RecalculateIncome(player, objectList)
    local state = ensureState(player)
    local total = 0

    local list = objectList
    if not list and PlotService and PlotService.GetPlotForPlayer then
        local plot = PlotService.GetPlotForPlayer(player)
        list = plot and plot.PlacedObjects
    end

    if type(list) == "table" then
        for _, record in ipairs(list) do
            total += resolveRecordIncome(record)
        end
    end

    state.IncomePerSecond = roundCurrency(total)
    syncLeaderstats(player, state)
    EconomyRemotes.IncomeUpdated:FireClient(player, state.IncomePerSecond)
    return state.IncomePerSecond
end

function EconomyAPI.GetBoost()
    return getBoostPayload()
end

EconomyRemotes.RequestSnapshot.OnServerInvoke = function(player)
    local state = ensureState(player)
    return {
        Cash = roundCurrency(state.Cash),
        IncomePerSecond = roundCurrency(state.IncomePerSecond),
        Boost = getBoostPayload(),
    }
end

EconomyRemotes.RequestManualSave.OnServerInvoke = function(player)
    local state = ensureState(player)
    persistPlayer(player, state)
    return {
        Success = true,
        Cash = roundCurrency(state.Cash),
        Timestamp = os.time(),
    }
end

local function handlePlayerAdded(player)
    local state = ensureState(player)
    syncLeaderstats(player, state)
    broadcastEconomy(player, state)
    EconomyRemotes.BoostUpdated:FireClient(player, getBoostPayload())
end

local function handlePlayerRemoving(player)
    local state = playerEconomy[player]
    if state then
        persistPlayer(player, state)
        playerEconomy[player] = nil
    end
end

Players.PlayerAdded:Connect(handlePlayerAdded)
Players.PlayerRemoving:Connect(handlePlayerRemoving)

local function triggerPassiveGain(player, amount)
    if amount == 0 then
        return
    end
    EconomyRemotes.PassiveTick:FireClient(player, amount, boostState.Active and boostState.Name or nil, boostState.Multiplier)
end

local function tryApplyMaintenance(player, state)
    if MAINTENANCE_RATE <= 0 or MAINTENANCE_INTERVAL <= 0 then
        return
    end
    local now = os.clock()
    if now - (state.LastMaintenance or now) < MAINTENANCE_INTERVAL then
        return
    end
    state.LastMaintenance = now
    local tax = roundCurrency(state.Cash * MAINTENANCE_RATE)
    if tax > 0 then
        local applied = EconomyAPI.AddCash(player, -tax)
        if applied ~= 0 then
            EconomyRemotes.PassiveTick:FireClient(player, applied, "Taxe d'entretien", 1)
        end
    end
end

task.spawn(function()
    local lastTick = os.clock()
    while true do
        task.wait(1)
        local now = os.clock()
        local delta = now - lastTick
        lastTick = now
        local multiplier = boostState.Multiplier or 1
        for player, state in pairs(playerEconomy) do
            if state.IncomePerSecond > 0 then
                -- Appliquer le multiplicateur du feu (pénalité si feu < 10)
                local firePenalty = player:GetAttribute("FirePenaltyMultiplier") or 1.0
                local earned = state.IncomePerSecond * multiplier * firePenalty * delta
                local applied = EconomyAPI.AddCash(player, earned)
                if applied ~= 0 then
                    triggerPassiveGain(player, applied)
                end
            end
            tryApplyMaintenance(player, state)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(AUTOSAVE_INTERVAL)
        for player, state in pairs(playerEconomy) do
            persistPlayer(player, state)
        end
    end
end)

local function scheduleNextBoost()
    local interval = BOOST_SETTINGS.IntervalSeconds or 420
    local jitter = BOOST_SETTINGS.RandomJitterSeconds or 0
    if jitter > 0 then
        interval += math.random(-jitter, jitter)
    end
    boostState.NextStart = os.clock() + math.max(60, interval)
end

local function activateBoost()
    if not BOOST_SETTINGS.Enabled then
        return
    end
    local events = BOOST_SETTINGS.Events or {}
    if #events == 0 then
        return
    end
    local event = events[math.random(1, #events)]
    boostState.Active = true
    boostState.Name = event.Name or "Boost"
    boostState.Multiplier = event.Multiplier or 1.5
    local duration = event.DurationSeconds or 45
    boostState.EndsAt = os.clock() + duration
    broadcastBoost()
end

local function clearBoost()
    if not boostState.Active then
        return
    end
    boostState.Active = false
    boostState.Name = nil
    boostState.Multiplier = 1
    boostState.EndsAt = 0
    broadcastBoost()
    scheduleNextBoost()
end

scheduleNextBoost()

task.spawn(function()
    while true do
        task.wait(1)
        local now = os.clock()
        if boostState.Active then
            if now >= boostState.EndsAt then
                clearBoost()
            end
        elseif BOOST_SETTINGS.Enabled and now >= (boostState.NextStart or now + 9999) then
            activateBoost()
        end
    end
end)

shared.ParadisEconomyService = EconomyAPI
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">FishModelsBootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function ensureFolder(parent, name)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end

-- Crée le dossier racine FishModels + sous-dossiers si manquants
local root = ensureFolder(ReplicatedStorage, "FishModels")
ensureFolder(root, "Common")
ensureFolder(root, "Rare")
ensureFolder(root, "Legendaire")

print("[Paradis][FishModelsBootstrap] Dossier ReplicatedStorage/FishModels prêt (Common/Rare/Legendaire)")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">FishingShopService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    FishingShopService
    Gère les achats de cannes à pêche et d'appâts dans le Pro Shop.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local FishingGearConfig = require(ConfigFolder:WaitForChild("FishingGearConfig"))
local FishPrices = require(ConfigFolder:WaitForChild("FishPricesConfig"))
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local FishingShopRemotes = require(RemotesFolder:WaitForChild("FishingShopRemotes"))

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local DataApi = waitForShared("ParadisDataService")
local EconomyService = waitForShared("ParadisEconomyService")

local FishingShopService = {}

-- Acheter une canne
FishingShopRemotes.BuyRod.OnServerEvent:Connect(function(player, rodId)
    local rodDef = FishingGearConfig.Rods[rodId]
    if not rodDef then
        warn("[FishingShop] Canne inconnue:", rodId)
        return
    end
    
    -- Si achat Robux uniquement, bloquer ici (achat via MarketplaceService côté client)
    if rodDef.RobuxPrice and rodDef.RobuxPrice > 0 then
        warn("[FishingShop] Canne Robux, achat doit passer par MarketplaceService:", rodId)
        return
    end
    
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    
    -- Vérifier si déjà possédée
    if data.FishingGear.OwnedRods[rodId] then
        warn("[FishingShop] Canne déjà possédée:", rodId)
        return
    end
    
    -- Vérifier le cash
    local cost = rodDef.Cost
    if data.Cash < cost then
        warn("[FishingShop] Pas assez de cash pour la canne:", rodId)
        return
    end
    
    -- Déduire et ajouter la canne
    data.Cash = data.Cash - cost
    data.FishingGear.OwnedRods[rodId] = true
    data.FishingGear.CurrentRod = rodId
    DataApi.SavePlayerData(userId, data)
    
    -- Mettre à jour le HUD
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local cashValue = leaderstats:FindFirstChild("Cash")
        if cashValue then
            cashValue.Value = data.Cash
        end
    end
    
    print(string.format("[FishingShop] %s a acheté la canne %s pour %d$", player.Name, rodDef.DisplayName, cost))
end)

-- Équiper une canne déjà possédée
FishingShopRemotes.SetCurrentRod.OnServerEvent:Connect(function(player, rodId)
    local rodDef = FishingGearConfig.Rods[rodId]
    if not rodDef then
        warn("[FishingShop] SetCurrentRod: canne inconnue:", rodId)
        return
    end
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not (data.FishingGear.OwnedRods and data.FishingGear.OwnedRods[rodId]) then
        warn("[FishingShop] SetCurrentRod: non possédée:", rodId)
        return
    end
    data.FishingGear.CurrentRod = rodId
    DataApi.SavePlayerData(userId, data)
    print(string.format("[FishingShop] %s a équipé la canne %s", player.Name, rodDef.DisplayName))
end)

-- Acheter un appât
FishingShopRemotes.BuyBait.OnServerEvent:Connect(function(player, baitId)
    local baitDef = FishingGearConfig.Baits[baitId]
    if not baitDef then
        warn("[FishingShop] Appât inconnu:", baitId)
        return
    end
    
    if baitId == "None" then
        return -- aucun achat nécessaire
    end
    
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    
    -- Vérifier le cash
    local cost = baitDef.Cost
    if data.Cash < cost then
        warn("[FishingShop] Pas assez de cash pour l'appât:", baitId)
        return
    end
    
    -- Déduire et ajouter les utilisations
    data.Cash = data.Cash - cost
    data.FishingGear.CurrentBait = baitId
    data.FishingGear.BaitUses = (data.FishingGear.BaitUses or 0) + baitDef.UsesPerPurchase
    DataApi.SavePlayerData(userId, data)
    
    -- Mettre à jour le HUD
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local cashValue = leaderstats:FindFirstChild("Cash")
        if cashValue then
            cashValue.Value = data.Cash
        end
    end
    
    print(string.format("[FishingShop] %s a acheté %s pour %d$ (%d utilisations)", player.Name, baitDef.DisplayName, cost, baitDef.UsesPerPurchase))
end)

-- Obtenir l'équipement actuel
FishingShopRemotes.GetGear.OnServerInvoke = function(player)
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
    end
    return {
        CurrentRod = data.FishingGear.CurrentRod,
        CurrentBait = data.FishingGear.CurrentBait,
        BaitUses = data.FishingGear.BaitUses,
        OwnedRods = data.FishingGear.OwnedRods,
        Cash = data.Cash,
        FishInventory = data.FishingGear.FishInventory,
    }
end

FishingShopService.GetPlayerGear = function(userId)
    local data = DataApi.LoadPlayerData(userId)
    return {
        CurrentRod = data.FishingGear.CurrentRod,
        CurrentBait = data.FishingGear.CurrentBait,
        BaitUses = data.FishingGear.BaitUses,
    }
end

FishingShopService.ConsumeBait = function(userId)
    local data = DataApi.LoadPlayerData(userId)
    if data.FishingGear.CurrentBait == "None" or data.FishingGear.CurrentBait == "Standard" then
        return
    end
    
    data.FishingGear.BaitUses = math.max(0, (data.FishingGear.BaitUses or 0) - 1)
    
    -- Si plus d'utilisations, revenir à "Standard"
    if data.FishingGear.BaitUses <= 0 then
        data.FishingGear.CurrentBait = "Standard"
        data.FishingGear.BaitUses = 5
    end
    
    DataApi.SavePlayerData(userId, data)
end

FishingShopService.AddFishToInventory = function(userId, fishType)
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
    end
    
    data.FishingGear.FishInventory[fishType] = (data.FishingGear.FishInventory[fishType] or 0) + 1
    -- Marquer comme vu dans le codex
    data.FishingGear.CodexSeen = data.FishingGear.CodexSeen or {}
    data.FishingGear.CodexSeen[fishType] = true
    DataApi.SavePlayerData(userId, data)
    return data.FishingGear.FishInventory[fishType]
end

FishingShopService.UseFishAsBait = function(userId, fishType)
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
    end
    
    local count = data.FishingGear.FishInventory[fishType] or 0
    if count <= 0 then
        return false
    end
    
    -- Consommer le poisson et équiper l'appât correspondant
    data.FishingGear.FishInventory[fishType] = count - 1
    
    local baitId = "Fish" .. fishType
    local baitDef = FishingGearConfig.Baits[baitId]
    if baitDef then
        data.FishingGear.CurrentBait = baitId
        data.FishingGear.BaitUses = baitDef.UsesPerPurchase
    end
    
    DataApi.SavePlayerData(userId, data)
    return true
end

-- Remote pour utiliser un poisson comme appât
FishingShopRemotes.UseFishAsBait.OnServerEvent:Connect(function(player, fishType)
    local userId = player.UserId
    local success = FishingShopService.UseFishAsBait(userId, fishType)
    
    if success then
        print(string.format("[FishingShop] %s utilise un poisson %s comme appât", player.Name, fishType))
    else
        warn(string.format("[FishingShop] %s n'a pas de poisson %s en stock", player.Name, fishType))
    end
end)

-- Vente poissonnerie: vendre une quantité d'une rareté (par défaut tout)
FishingShopRemotes.SellFish.OnServerEvent:Connect(function(player, fishType, amount)
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        return
    end
    if FishPrices[fishType] == nil then
        warn("[FishingShop] SellFish: type inconnu:", fishType)
        return
    end
    local have = data.FishingGear.FishInventory[fishType] or 0
    amount = math.clamp(tonumber(amount) or have, 0, have)
    if amount <= 0 then return end
    local gain = amount * (FishPrices[fishType] or 0)
    data.FishingGear.FishInventory[fishType] = have - amount
    data.Cash = (data.Cash or 0) + gain
    DataApi.SavePlayerData(userId, data)
    -- Mettre à jour leaderstats
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local cash = ls:FindFirstChild("Cash")
        if cash then cash.Value = data.Cash end
    end
    print(string.format("[FishingShop] %s a vendu %d x %s pour %d$", player.Name, amount, fishType, gain))
end)

-- Vente tout
FishingShopRemotes.SellAllFish.OnServerEvent:Connect(function(player)
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then return end
    local total = 0
    for t, cnt in pairs(data.FishingGear.FishInventory) do
        local price = FishPrices[t] or 0
        total = total + (cnt or 0) * price
        data.FishingGear.FishInventory[t] = 0
    end
    if total > 0 then
        data.Cash = (data.Cash or 0) + total
        DataApi.SavePlayerData(userId, data)
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            local cash = ls:FindFirstChild("Cash")
            if cash then cash.Value = data.Cash end
        end
        print(string.format("[FishingShop] %s a vendu tout pour %d$", player.Name, total))
    end
end)

-- Codex: renvoyer flags vus
FishingShopRemotes.GetCodex.OnServerInvoke = function(player)
    local data = DataApi.LoadPlayerData(player.UserId)
    data.FishingGear.CodexSeen = data.FishingGear.CodexSeen or {}
    return data.FishingGear.CodexSeen
end

-- Fonction appelée après achat Robux réussi (Developer Product callback)
function FishingShopService.GrantMasterRod(userId)
    local data = DataApi.LoadPlayerData(userId)
    if data.FishingGear.OwnedRods.Master then
        return true -- Déjà possédée
    end
    data.FishingGear.OwnedRods.Master = true
    data.FishingGear.CurrentRod = "Master"
    DataApi.SavePlayerData(userId, data)
    print("[FishingShop] Canne Master accordée via Robux pour userId:", userId)
    return true
end

shared.ParadisFishingShopService = FishingShopService
print("[Paradis][FishingShop] Service initialisé")

return FishingShopService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="31">
        <Properties>
          <string name="Name">FishingSystem</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- FishingSystem.server.lua

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local FishingGearConfig = require(ConfigFolder:WaitForChild("FishingGearConfig"))

-- Nom du dossier qui contient tes 5 spots dans Workspace
local FISHING_FOLDER_NAME = "FishingArea"

-- Animation IDs - Animations de pêche Roblox par défaut
local CAST_ANIMATION_ID = "rbxassetid://3541114300"   -- animation lancer la ligne
local REEL_ANIMATION_ID = "rbxassetid://3541114300"   -- animation remonter le poisson (même anim pour l'instant)

-- Types de poissons et récompenses
local fishTypes = {
    { name = "Common", reward = 10, weight = 50 },
    { name = "rare", reward = 25, weight = 35 },
    { name = "legendaire", reward = 100, weight = 15 },
}

-- Assure qu'on a leaderstats.Money pour un joueur
-- Utilise le service d’économie central pour ajouter du cash
local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local EconomyService = shared.ParadisEconomyService or waitForShared("ParadisEconomyService")
local FishingShopService = waitForShared("ParadisFishingShopService")

-- Joue une animation sur le personnage (si un ID est fourni)
local function playAnimation(character, animationId)
    if not animationId or animationId == "" then
        return nil
    end

    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = animationId

    local track = humanoid:LoadAnimation(anim)
    track:Play()
    return track
end

-- Petit texte au-dessus de la tête du joueur (style Money GUI)
local function showFloatingText(character, text)
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(4, 0, 1, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 24
    label.TextColor3 = Color3.fromRGB(150, 240, 150)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Text = text
    label.Parent = billboard

    Debris:AddItem(billboard, 2.5)
end

-- Empêche un joueur de lancer 40 pêches en même temps
local activeFishing = {} -- [player] = true pendant la pêche

-- Création ou clonage d'un modèle de poisson depuis ReplicatedStorage/FishModels
local FISH_MODELS_ROOT = "FishModels"
local fishModelMap = {
    ["Common"] = "Common",
    ["rare"] = "Rare",
    ["legendaire"] = "Legendaire",
}

local function pickModelFromFolder(folder)
    if not folder then return nil end
    local modelCandidates = {}
    local partCandidates = {}
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            table.insert(modelCandidates, child)
        elseif child:IsA("Folder") then
            -- Cherche d'abord un Model
            local m = child:FindFirstChildWhichIsA("Model")
            if m then
                table.insert(modelCandidates, m)
            end
            -- Sinon, accepte un BasePart/MeshPart à l'intérieur
            local p = child:FindFirstChildWhichIsA("BasePart", true)
            if p then
                table.insert(partCandidates, p)
            end
        elseif child:IsA("BasePart") then
            table.insert(partCandidates, child)
        end
    end
    if #modelCandidates > 0 then
        return modelCandidates[math.random(1, #modelCandidates)]
    end
    if #partCandidates > 0 then
        return partCandidates[math.random(1, #partCandidates)]
    end
    return nil
end

local function getFishModelsRoot()
    local replicated = game:GetService("ReplicatedStorage")
    local root = replicated:FindFirstChild(FISH_MODELS_ROOT)
    if root then return root end
    local ok, waited = pcall(function()
        return replicated:WaitForChild(FISH_MODELS_ROOT, 3)
    end)
    if ok then return waited end
    return nil
end

local function createFishVisual(fishInfo)
    print("[FishingSystem] Création visuelle pour:", fishInfo.name)
    local root = getFishModelsRoot()
    if not root then
        warn("[FishingSystem] ❌ Dossier FishModels introuvable après attente !")
    else
        print("[FishingSystem] ✅ FishModels disponible")
    end
    
    local groupName = fishModelMap[fishInfo.name]
    print("[FishingSystem] Recherche du dossier:", groupName)
    local groupFolder = root and root:FindFirstChild(groupName)
    -- Recherche insensible à la casse si non trouvé exactement
    if root and not groupFolder then
        for _, child in ipairs(root:GetChildren()) do
            if string.lower(child.Name) == string.lower(groupName) then
                groupFolder = child
                break
            end
        end
    end
    if root and not groupFolder then
        -- Essayer une attente courte si la réplication du dossier est tardive
        local ok, gf = pcall(function()
            return root:WaitForChild(groupName, 1)
        end)
        if ok then groupFolder = gf end
    end
    if not groupFolder and root then
        warn("[FishingSystem] ❌ Dossier", groupName, "introuvable (après retry). Contenu de FishModels:")
        for _, child in ipairs(root:GetChildren()) do
            warn("  -", child.Name, "(", child.ClassName, ")")
        end
    elseif groupFolder then
        print("[FishingSystem] ✅ Dossier prêt:", groupFolder.Name, "—", #groupFolder:GetChildren(), "enfants")
    end
    
    local template = pickModelFromFolder(groupFolder)
    if template then
        print("[FishingSystem] ✅ Modèle sélectionné:", template.Name)
        local clone
        if template:IsA("Model") then
            clone = template:Clone()
        else
            -- Si c'est un MeshPart/BasePart, l'envelopper dans un Model
            local partClone = template:Clone()
            clone = Instance.new("Model")
            clone.Name = template.Name .. "_Model"
            partClone.Anchored = true
            partClone.CanCollide = false
            partClone.Parent = clone
            clone.PrimaryPart = partClone
        end
        -- Assurer une PrimaryPart, y compris si les pièces sont imbriquées (recherche récursive)
        if not clone.PrimaryPart then
            local primary = clone:FindFirstChildWhichIsA("BasePart", true)
            if primary then
                clone.PrimaryPart = primary
            else
                warn("[FishingSystem] ⚠️ Aucun BasePart trouvé dans le modèle:", clone.Name, "— création d'un Root invisible")
                local root = Instance.new("Part")
                root.Name = "Root"
                root.Size = Vector3.new(1, 1, 1)
                root.Transparency = 1
                root.Anchored = true
                root.CanCollide = false
                root.Parent = clone
                clone.PrimaryPart = root
            end
        end
        -- Rendre toutes les parties non collidables pour l’animation de sortie
        for _, desc in ipairs(clone:GetDescendants()) do
            if desc:IsA("BasePart") then
                desc.Anchored = true
                desc.CanCollide = false
            end
        end
        -- Effets brillants si légendaire
        if fishInfo.name == "legendaire" then
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Material = Enum.Material.Neon
                    part.Color = Color3.fromRGB(255, 215, 80)
                end
            end
            if clone.PrimaryPart then
                local glow = Instance.new("PointLight")
                glow.Range = 12
                glow.Brightness = 2.5
                glow.Color = Color3.fromRGB(255, 230, 120)
                glow.Parent = clone.PrimaryPart
                local sparkle = Instance.new("ParticleEmitter")
                sparkle.Texture = "rbxassetid://258128463"
                sparkle.Rate = 18
                sparkle.Lifetime = NumberRange.new(0.5, 1)
                sparkle.Speed = NumberRange.new(0.2, 0.6)
                sparkle.Size = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.25),
                    NumberSequenceKeypoint.new(0.5, 0.35),
                    NumberSequenceKeypoint.new(1, 0)
                })
                sparkle.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.05),
                    NumberSequenceKeypoint.new(0.8, 0.4),
                    NumberSequenceKeypoint.new(1, 1)
                })
                sparkle.Parent = clone.PrimaryPart
            end
        end
        return clone, 1
    end
    -- Fallback procédural si aucun modèle
    warn("[FishingSystem] ⚠️ Utilisation du fallback procédural pour:", fishInfo.name)
    local sizeScale
    local color
    if fishInfo.name == "Common" then
        sizeScale = 1.0
        color = Color3.fromRGB(180, 200, 220)
    elseif fishInfo.name == "rare" then
        sizeScale = 1.4
        color = Color3.fromRGB(255, 165, 80)
    else
        sizeScale = 2.2
        color = Color3.fromRGB(255, 215, 0)
    end

    local model = Instance.new("Model")
    model.Name = "FishVisual"

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(1.6 * sizeScale, 0.8 * sizeScale, 0.9 * sizeScale)
    body.Material = Enum.Material.SmoothPlastic
    body.Color = color
    body.Anchored = true
    body.CanCollide = false
    body.Parent = model
    if fishInfo.name == "legendaire" then
        body.Material = Enum.Material.Neon
        body.Color = Color3.fromRGB(255, 215, 80)
        local glow = Instance.new("PointLight")
        glow.Range = 12
        glow.Brightness = 2.5
        glow.Color = body.Color
        glow.Parent = body
        local sparkle = Instance.new("ParticleEmitter")
        sparkle.Texture = "rbxassetid://258128463"
        sparkle.Rate = 16
        sparkle.Lifetime = NumberRange.new(0.5, 0.9)
        sparkle.Speed = NumberRange.new(0.3, 0.7)
        sparkle.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.22),
            NumberSequenceKeypoint.new(0.5, 0.3),
            NumberSequenceKeypoint.new(1, 0)
        })
        sparkle.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.05),
            NumberSequenceKeypoint.new(0.7, 0.45),
            NumberSequenceKeypoint.new(1, 1)
        })
        sparkle.Parent = body
    end

    local tail = Instance.new("WedgePart")
    tail.Name = "Tail"
    tail.Size = Vector3.new(0.8 * sizeScale, 0.6 * sizeScale, 0.2 * sizeScale)
    tail.Material = Enum.Material.SmoothPlastic
    tail.Color = color:Lerp(Color3.fromRGB(250, 250, 250), 0.2)
    tail.Anchored = true
    tail.CanCollide = false
    tail.Parent = model

    local finTop = Instance.new("WedgePart")
    finTop.Name = "TopFin"
    finTop.Size = Vector3.new(0.5 * sizeScale, 0.3 * sizeScale, 0.2 * sizeScale)
    finTop.Material = Enum.Material.SmoothPlastic
    finTop.Color = color:Lerp(Color3.fromRGB(255, 255, 255), 0.3)
    finTop.Anchored = true
    finTop.CanCollide = false
    finTop.Parent = model

    local finBottom = Instance.new("WedgePart")
    finBottom.Name = "BottomFin"
    finBottom.Size = Vector3.new(0.5 * sizeScale, 0.3 * sizeScale, 0.2 * sizeScale)
    finBottom.Material = Enum.Material.SmoothPlastic
    finBottom.Color = color:Lerp(Color3.fromRGB(255, 255, 255), 0.3)
    finBottom.Anchored = true
    finBottom.CanCollide = false
    finBottom.Parent = model

    model.PrimaryPart = body
    return model, sizeScale
end

local function positionFishParts(model)
    local body = model:FindFirstChild("Body")
    local tail = model:FindFirstChild("Tail")
    local finTop = model:FindFirstChild("TopFin")
    local finBottom = model:FindFirstChild("BottomFin")
    if not body then return end
    local cf = body.CFrame
    if tail then tail.CFrame = cf * CFrame.new(0.9, 0, 0) end
    if finTop then finTop.CFrame = cf * CFrame.new(0, 0.4, 0) end
    if finBottom then finBottom.CFrame = cf * CFrame.new(0, -0.35, 0) end
end

local function startFishing(player)
    if activeFishing[player] then
        return
    end
    activeFishing[player] = true

    local character = player.Character
    if not character then
        activeFishing[player] = nil
        return
    end

    -- Création visuelle de la canne à pêche (couleur selon le niveau)
    local fishingRod = Instance.new("Tool")
    fishingRod.Name = "CannePeche"
    fishingRod.RequiresHandle = true
    fishingRod.CanBeDropped = false
    fishingRod.Grip = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(90), 0, 0)
    
    -- Manche de la canne (partie basse)
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.2, 3, 0.2)
    handle.Material = Enum.Material.Wood
    -- Couleur par défaut (Basic) avant application réelle
    handle.Color = Color3.fromRGB(101, 67, 33)
    handle.Parent = fishingRod
    
    -- Partie haute de la canne (plus fine)
    local rodTop = Instance.new("Part")
    rodTop.Name = "RodTop"
    rodTop.Size = Vector3.new(0.15, 2.5, 0.15)
    rodTop.Material = Enum.Material.SmoothPlastic
    rodTop.Color = Color3.fromRGB(150, 150, 150)
    rodTop.CanCollide = false
    rodTop.Parent = fishingRod
    
    local weld1 = Instance.new("WeldConstraint")
    weld1.Part0 = handle
    weld1.Part1 = rodTop
    weld1.Parent = rodTop
    
    rodTop.CFrame = handle.CFrame * CFrame.new(0, 2.75, 0)
    
    -- Moulinet
    local reel = Instance.new("Part")
    reel.Name = "Reel"
    reel.Size = Vector3.new(0.4, 0.4, 0.4)
    reel.Shape = Enum.PartType.Cylinder
    reel.Material = Enum.Material.Metal
    reel.Color = Color3.fromRGB(192, 192, 192)
    reel.CanCollide = false
    reel.Parent = fishingRod
    
    local weld2 = Instance.new("WeldConstraint")
    weld2.Part0 = handle
    weld2.Part1 = reel
    weld2.Parent = reel
    
    reel.CFrame = handle.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90))
    
    fishingRod.Parent = character
    character.Humanoid:EquipTool(fishingRod)

    -- Appliquer la couleur spécifique de la canne choisie (après Equip pour éviter latence)
    local gearForColor = FishingShopService.GetPlayerGear(player.UserId)
    local rodDefColor = FishingGearConfig.Rods[gearForColor.CurrentRod]
    if rodDefColor and rodDefColor.Color then
        local col = rodDefColor.Color
        -- Appliquer sur toutes les parties (on laisse le moulinet métallique mais on peut teinter légèrement)
        handle.Color = col
        rodTop.Color = col:lerp(Color3.new(1,1,1), 0.25) -- partie haute légèrement éclaircie
        -- Moulinet : conserver métal, option : teinte légère
        reel.Color = col:lerp(Color3.fromRGB(192,192,192), 0.6)
    end

    -- Effets spéciaux pour canne Master brillante
    if rodDefColor and rodDefColor.Shiny then
        -- Ajuster dimensions
        handle.Size = Vector3.new(0.25, 3.3, 0.25)
        rodTop.Size = Vector3.new(0.18, 3.1, 0.18)
        rodTop.Material = Enum.Material.Neon
        -- Lumière
        local light = Instance.new("PointLight")
        light.Name = "MasterGlow"
        light.Range = 10
        light.Brightness = 2.2
        light.Color = rodTop.Color
        light.Parent = rodTop
        -- Particules scintillantes
        local sparkles = Instance.new("ParticleEmitter")
        sparkles.Name = "MasterSparkle"
        sparkles.LightEmission = 0.7
        sparkles.Texture = "rbxassetid://258128463"
        sparkles.Rate = 12
        sparkles.Lifetime = NumberRange.new(0.4, 0.8)
        sparkles.Speed = NumberRange.new(0.5, 1.2)
        sparkles.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.15),
            NumberSequenceKeypoint.new(0.4, 0.25),
            NumberSequenceKeypoint.new(1, 0)
        })
        sparkles.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(0.8, 0.4),
            NumberSequenceKeypoint.new(1, 1)
        })
        sparkles.Parent = rodTop
    end

    -- Animation de lancer
    local castTrack = playAnimation(character, CAST_ANIMATION_ID)
    task.wait(1.2)

    -- Récupérer l'équipement du joueur pour le temps d'attente
    local gear = FishingShopService.GetPlayerGear(player.UserId)
    local rodDef = FishingGearConfig.Rods[gear.CurrentRod] or FishingGearConfig.Rods.Basic
    
    -- Temps d'attente modifié par la canne (1.5 à 3.5 secondes * speedMultiplier)
    local baseWaitTime = math.random(15, 35) / 10
    local waitTime = baseWaitTime * rodDef.SpeedMultiplier
    task.wait(waitTime)
    
    local baitDef = FishingGearConfig.Baits[gear.CurrentBait] or FishingGearConfig.Baits.None
    
    -- Consommer un appât si utilisé
    if gear.CurrentBait ~= "None" and gear.BaitUses > 0 then
        FishingShopService.ConsumeBait(player.UserId)
    end
    
    -- Calculer les chances avec bonus de canne et appât
    local legendaryChance = rodDef.LegendaryChance + baitDef.LegendaryBoost
    local rareBonus = rodDef.RareBonus
    
    -- Déterminer le type de poisson avec chances modifiées
    local fishInfo
    local roll = math.random(1, 100)
    
    if roll <= (legendaryChance * 100) then
        -- Légendaire
        fishInfo = fishTypes[3]
    elseif roll <= (legendaryChance * 100 + 35 + rareBonus) then
        -- Rare
        fishInfo = fishTypes[2]
    else
        -- Common
        fishInfo = fishTypes[1]
    end
    
    -- Appliquer multiplicateur de récompense de l'appât
    local reward = math.floor(fishInfo.reward * baitDef.RewardMultiplier)

    -- ===== MINI-JEU DE TENSION DE LIGNE (côté client) =====
    local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
    local startMiniGameEvent = remotesFolder:WaitForChild("StartFishingMiniGame")
    local resultEvent = remotesFolder:WaitForChild("FishingMiniGameResult")
    
    -- Envoie au client pour démarrer le mini-jeu
    startMiniGameEvent:FireClient(player, fishInfo.name)
    
    -- Attente du résultat (timeout 60s)
    local miniGameSuccess = false
    local resultReceived = false
    
    local connection
    connection = resultEvent.OnServerEvent:Connect(function(plr, success)
        if plr == player and not resultReceived then
            resultReceived = true
            miniGameSuccess = success
            connection:Disconnect()
        end
    end)
    
    local timeoutTask = task.delay(60, function()
        if not resultReceived then
            resultReceived = true
            miniGameSuccess = false
            connection:Disconnect()
        end
    end)
    
    -- Attend résultat
    while not resultReceived do
        task.wait(0.1)
    end
    
    if not miniGameSuccess then
        -- Échec du mini-jeu : ligne cassée, pas de poisson
        if castTrack then castTrack:Stop() end
        if fishingRod and fishingRod.Parent then
            fishingRod:Destroy()
        end
        activeFishing[player] = nil
        showFloatingText(character, "💔 La ligne a cassé!")
        return
    end
    
    -- Animation de remonter avec effet visuel du poisson
    local reelTrack = playAnimation(character, REEL_ANIMATION_ID)
    task.wait(0.5)
    
    -- Crée un poisson visuel "réaliste" sortant de l'eau
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if fishingRod then fishingRod:Destroy() end
        activeFishing[player] = nil
        return
    end
    
    local fishModel, scale = createFishVisual(fishInfo)
    local body = fishModel.PrimaryPart
    
    -- Trouver la surface de l'eau (lac généré)
    local lake
    local terrainFolder = workspace:FindFirstChild("CampingTerrain")
    if terrainFolder then
        lake = terrainFolder:FindFirstChild("Lake")
    end
    lake = lake or workspace:FindFirstChild("Lake")

    local surfaceY
    if lake and lake:IsA("BasePart") then
        surfaceY = lake.Position.Y + (lake.Size.Y / 2)
    else
        surfaceY = hrp.Position.Y - 2 -- fallback
    end

    -- Point d’émergence devant le joueur, à la surface de l’eau
    local emergePos = (hrp.CFrame * CFrame.new(0, 0, -6)).Position
    emergePos = Vector3.new(emergePos.X, surfaceY - 0.8, emergePos.Z)
    body.CFrame = CFrame.new(emergePos) * CFrame.Angles(0, math.rad(180), 0)
    fishModel.Parent = workspace
    positionFishParts(fishModel)

    -- Effet d’éclaboussure
    local splash = Instance.new("ParticleEmitter")
    splash.Texture = "rbxassetid://241876227"
    splash.Speed = NumberRange.new(6, 10)
    splash.Lifetime = NumberRange.new(0.3, 0.7)
    splash.Rate = 150
    splash.EmissionDirection = Enum.NormalId.Top
    splash.Parent = body
    
    -- Tween d’émergence (monte puis arc vers le joueur)
    local infoRise = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local targetRise = { CFrame = body.CFrame * CFrame.new(0, 2.2, 0) }
    local tweenRise = TweenService:Create(body, infoRise, targetRise)
    tweenRise:Play()
    tweenRise.Completed:Wait()

    positionFishParts(fishModel)
    local infoArc = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local arcTargetPos = (hrp.CFrame * CFrame.new(0, 2.5, -2)).Position
    local tweenArc = TweenService:Create(body, infoArc, { CFrame = CFrame.new(arcTargetPos) * CFrame.Angles(0, math.rad(160), 0) })
    tweenArc:Play()
    tweenArc.Completed:Wait()
    positionFishParts(fishModel)

    -- Arrêt des particules
    splash.Enabled = false
    Debris:AddItem(splash, 1)

    -- Donne l'argent au joueur via le service d'économie (met à jour le GUI Cash)
    EconomyService.AddCash(player, reward)
    
    -- Ajouter le poisson à l'inventaire pour utilisation future comme appât
    local fishCount = FishingShopService.AddFishToInventory(player.UserId, fishInfo.name)

    -- Feedback visuel
    local message = string.format("%s (+%d$) [%d en stock]", fishInfo.name, reward, fishCount)
    showFloatingText(character, message)
    
    -- Nettoyage
    fishModel:Destroy()
    
    task.wait(0.5)
    
    if castTrack then castTrack:Stop() end
    if reelTrack then reelTrack:Stop() end
    
    if fishingRod and fishingRod.Parent then
        fishingRod:Destroy()
    end

    activeFishing[player] = nil
end

-- Ajoute leaderstats/Money pour les nouveaux joueurs
-- La création des leaderstats (Cash/Income) est gérée par EconomyService

-- Ajoute un ProximityPrompt "Pêcher" à chaque spot dans Workspace.FishingSpots
local function setupFishingSpots()
    local fishingFolder = workspace:FindFirstChild(FISHING_FOLDER_NAME)
    if not fishingFolder then
        print("[FishingSystem] Dossier '" .. FISHING_FOLDER_NAME .. "' introuvable, attente...")
        fishingFolder = workspace:WaitForChild(FISHING_FOLDER_NAME, 10)
        if not fishingFolder then
            print("[FishingSystem] Création du dossier '" .. FISHING_FOLDER_NAME .. "' vide.")
            fishingFolder = Instance.new("Folder")
            fishingFolder.Name = FISHING_FOLDER_NAME
            fishingFolder.Parent = workspace
        end
    end

    for _, spot in ipairs(fishingFolder:GetChildren()) do
        if spot:IsA("Model") or spot:IsA("BasePart") then
            local targetPart
            if spot:IsA("BasePart") then
                targetPart = spot
            else
                targetPart = spot.PrimaryPart or spot:FindFirstChildWhichIsA("BasePart")
            end

            if targetPart then
                local prompt = targetPart:FindFirstChildOfClass("ProximityPrompt")
                if not prompt then
                    prompt = Instance.new("ProximityPrompt")
                    prompt.ObjectText = "Pêche"
                    prompt.ActionText = "Pêcher"
                    prompt.HoldDuration = 0.5
                    prompt.MaxActivationDistance = 10
                    prompt.Parent = targetPart
                end

                prompt.Triggered:Connect(function(player)
                    startFishing(player)
                end)
            else
                warn("Impossible de trouver une partie cible pour un spot de pêche: " .. spot.Name)
            end
        end
    end
end

setupFishingSpots()
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="32">
        <Properties>
          <string name="Name">Leaderstats</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Leaderstats for Paradis
-- Creates leaderstats/Money for each player and reuses the same value for all game systems

local Players = game:GetService("Players")

local function setupLeaderstats(player: Player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local money = leaderstats:FindFirstChild("Money")
	if not money then
		money = Instance.new("IntValue")
		money.Name = "Money"
		money.Value = 0
		money.Parent = leaderstats
	end
end

Players.PlayerAdded:Connect(setupLeaderstats)
for _, plr in ipairs(Players:GetPlayers()) do
	setupLeaderstats(plr)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">MiniGamesConfigDefaults.module</string>
          <string name="Source"><![CDATA[local MiniGamesConfigDefaults = {}

MiniGamesConfigDefaults.SwingGame = {
    PivotPosition = Vector3.new(-120, 8, 60),
    SeatOffset = Vector3.new(0, -6, 0),
    RewardPerFullLoop = 5,
    MinRadius = 3,
    PushAngularImpulse = 4,
    ForwardKeys = { Enum.KeyCode.W, Enum.KeyCode.Up },
    BackwardKeys = { Enum.KeyCode.S, Enum.KeyCode.Down },
    ModelName = "Swing",
    PivotName = "SwingPivot",
    SeatName = "Seat",
    AutoCreateModel = false,
    Swings = {
        {
            ModelName = "Swing",
            PivotName = "SwingPivot",
            SeatName = "Seat",
        },
        {
            ModelName = "Swing2",
            PivotName = "SwingPivot",
            SeatName = "Seat",
        },
    },
    ComboWindowSeconds = 3,
    ComboBonusPerLoop = 2,
}

MiniGamesConfigDefaults.FishingGame = {
    Spots = {
        { Name = "FishingSpot1", Position = Vector3.new(-60, 1, -150) },
        { Name = "FishingSpot2", Position = Vector3.new(-20, 1, -170) },
        { Name = "FishingSpot3", Position = Vector3.new(20, 1, -180) },
        { Name = "FishingSpot4", Position = Vector3.new(60, 1, -170) },
        { Name = "FishingSpot5", Position = Vector3.new(100, 1, -160) },
    },

    FishRewards = {
        Small = { Label = "Petit poisson", MinReward = 3, MaxReward = 7 },
        Medium = { Label = "Poisson moyen", MinReward = 8, MaxReward = 15 },
        Large = { Label = "Gros poisson", MinReward = 16, MaxReward = 30 },
        Rare = { Label = "Poisson rare", MinReward = 31, MaxReward = 60 },
    },

    FishProbabilities = {
        Small = 0.45,
        Medium = 0.30,
        Large = 0.20,
        Rare = 0.05,
    },

    CooldownSeconds = 5,
}

return MiniGamesConfigDefaults
]]></string>
