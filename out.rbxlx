end

local function createModel(objectType)
    local def = ObjectsConfig[objectType]
    if not def then
        return nil, "Objet inconnu"
    end
    if def.ModelFolder and def.ModelName then
        local model, err = cloneConfiguredModel(def)
        if not model then
            return nil, err or "Modèle introuvable"
        end
        model.Name = objectType
        return model, nil
    end
    local builder = builders[def.ModelType]
    if not builder then
        return nil, "ModelType non géré"
    end
    local model = builder(def)
    model.Name = objectType
    return model, nil
end

local function ensurePlotState(plot)
    plot.PlayerData = plot.PlayerData or {
        Objects = plot.PlacedObjects or {},
    }
    plot.PlayerData.Objects = plot.PlayerData.Objects or {}
    plot.PlacedObjects = plot.PlayerData.Objects
end

local function countObjectsOfType(plot, objectType)
    ensurePlotState(plot)
    local count = 0
    for _, entry in ipairs(plot.PlacedObjects) do
        if entry.Type == objectType then
            count += 1
        end
    end
    return count
end

local function resolveEconomyValues(catalog, objectType, constructionId)
    if not EconomyService then
        return { Cost = 0, IncomePerSecond = 0, UnlockAtIncome = 0 }
    end
    local id = objectType
    if catalog == "Construction" then
        id = constructionId or objectType
    end
    local values = EconomyService.GetEconomyForObject(catalog, id) or {}
    return {
        Cost = tonumber(values.Cost) or 0,
        IncomePerSecond = tonumber(values.IncomePerSecond) or 0,
        UnlockAtIncome = tonumber(values.UnlockAtIncome) or 0,
    }
end

local function applyEconomyOnRecord(player, record, cost, income)
    record.Cost = cost
    record.IncomePerSecond = income
    if cost > 0 then
        EconomyService.AddCash(player, -cost)
    end
    if income > 0 then
        EconomyService.AddIncomeSource(player, income)
    end
end

local function serializeVector(v)
    return { x = v.X, y = v.Y, z = v.Z }
end

local function deserializeVector(tbl)
    return Vector3.new(tbl.x, tbl.y, tbl.z)
end

local function toVector(value)
    if typeof(value) == "Vector3" then
        return value
    elseif typeof(value) == "table" and value.x and value.y and value.z then
        return deserializeVector(value)
    end
    return nil
end

local function spawnModelInPlot(plot, record)
    if record.Type == "Construction" or record.Catalog == "Construction" then
        local templateId = record.ConstructionId or record.ObjectId or record.Type
        local template = templateId and ConstructionRuntime.GetTemplate(templateId)
        if not template then
            warn("[Paradis] Modèle de construction introuvable", templateId)
            return
        end
        local position = toVector(record.Position)
        if not position then
            return
        end
        local cframe = CFrame.new(position)
        if record.Rotation then
            cframe *= CFrame.Angles(0, math.rad(record.Rotation), 0)
        end
        local clone = template:Clone()
        setAnchored(clone, false)
        pivotModelToCFrame(clone, cframe)
        setAnchored(clone, true)
        applyObjectId(clone, record.Id)
        clone.Parent = plot.Container
        return
    end

    local model, err = createModel(record.Type)
    if not model then
        warn("[Paradis] Impossible de créer l'objet", record.Type, err)
        return
    end
    local position = toVector(record.Position)
    if not position then
        return
    end
    local cframe = CFrame.new(position)
    if record.Rotation then
        cframe *= CFrame.Angles(0, math.rad(record.Rotation), 0)
    end
    setAnchored(model, false)
    pivotModelToCFrame(model, cframe)
    setAnchored(model, true)
    applyObjectId(model, record.Id)
    model.Parent = plot.Container
end

local function savePlotData(plot)
    if not plot.OwnerUserId then
        return
    end
    ensurePlotState(plot)
    if DataApi and DataApi.SavePlayerData then
        plot.PlayerData.Objects = plot.PlacedObjects
        DataApi.SavePlayerData(plot.OwnerUserId, plot.PlayerData)
    end
end

local function handlePlacement(player, payload)
    local plot = PlotApi.GetPlotForPlayer(player)
    if not plot then
        return false, "Aucune parcelle réservée"
    end
    ensurePlotState(plot)

    local objectType = payload.ObjectType
    local catalog = payload.Catalog or "Objects"
    local constructionId = payload.ConstructionId
    local position = payload.Position
    local rotation = payload.Rotation or 0

    if typeof(position) ~= "Vector3" then
        return false, "Position invalide"
    end

    local snappedPosition = snapPositionToPlotGrid(plot, position)
    if not snappedPosition then
        return false, "Position invalide"
    end

    if not PlotApi.IsPositionInsidePlot(plot, snappedPosition) then
        return false, "Position hors parcelle"
    end

    if math.abs(snappedPosition.Y - plot.Center.Y) > 20 then
        return false, "Altitude suspecte"
    end

    if CampConfig.MAX_OBJECTS_PER_PLOT and #plot.PlacedObjects >= CampConfig.MAX_OBJECTS_PER_PLOT then
        return false, "Trop d'objets sur la parcelle"
    end

    local economyValues = resolveEconomyValues(catalog, objectType, constructionId)
    local objectKey = catalog == "Construction" and constructionId or objectType
    local unlocked, requirement = EconomyService.CanUseObject(player, catalog, objectKey)
    if objectKey and not unlocked then
        return false, string.format("Débloqué à %.2f $/s", requirement or 0)
    end

    local cost = economyValues.Cost
    local incomePerSecond = economyValues.IncomePerSecond
    if cost > 0 and not EconomyService.HasEnoughCash(player, cost) then
        return false, "Pas assez d'argent"
    end

    if catalog == "Construction" then
        if typeof(constructionId) ~= "string" or constructionId == "" then
            return false, "Bloc inconnu"
        end
        local template = ConstructionRuntime.GetTemplate(constructionId)
        if not template then
            return false, "Bloc introuvable"
        end
        local definition = ConstructionRuntime.GetDefinitionById(constructionId)
        local clone = template:Clone()
        local cframe = CFrame.new(snappedPosition) * CFrame.Angles(0, math.rad(rotation), 0)
        setAnchored(clone, false)
        pivotModelToCFrame(clone, cframe)
        setAnchored(clone, true)
        local record = {
            Id = HttpService:GenerateGUID(false),
            Type = "Construction",
            Catalog = "Construction",
            ConstructionId = constructionId,
            DisplayName = definition and definition.DisplayName or constructionId,
            Position = serializeVector(snappedPosition),
            Rotation = rotation,
        }
        applyEconomyOnRecord(player, record, cost, incomePerSecond)
        applyObjectId(clone, record.Id)
        clone.Parent = plot.Container
        table.insert(plot.PlacedObjects, record)
        BuildRemotes.PlacedObjectsUpdated:FireClient(player, plot.PlacedObjects)
        savePlotData(plot)
        return true
    end

    local def = ObjectsConfig[objectType]
    if not def then
        return false, "Objet inconnu"
    end

    if def.MaxPerPlot and countObjectsOfType(plot, objectType) >= def.MaxPerPlot then
        return false, "Limite atteinte pour " .. objectType
    end

    local model, err = createModel(objectType)
    if not model then
        return false, err or "Erreur de modèle"
    end

    local cframe = CFrame.new(snappedPosition) * CFrame.Angles(0, math.rad(rotation), 0)
    setAnchored(model, false)
    pivotModelToCFrame(model, cframe)
    setAnchored(model, true)
    model.Parent = plot.Container

    local record = {
        Id = HttpService:GenerateGUID(false),
        Type = objectType,
        Catalog = catalog,
        Position = serializeVector(snappedPosition),
        Rotation = rotation,
    }
    applyEconomyOnRecord(player, record, cost, incomePerSecond)
    applyObjectId(model, record.Id)
    table.insert(plot.PlacedObjects, record)
    BuildRemotes.PlacedObjectsUpdated:FireClient(player, plot.PlacedObjects)
    savePlotData(plot)

    return true
end


local function handleMove(player, payload)
    -- payload: { ObjectId = number, CFrame = CFrame or {x,y,z}, Rotation = number }
    print("[PlacementService] handleMove appelé pour", player.Name, "payload:", payload)
    local plot = PlotApi and PlotApi.GetPlotForPlayer and PlotApi.GetPlotForPlayer(player)
    if not plot then
        warn("[PlacementService] Parcelle introuvable pour", player.Name)
        return false, "Parcelle introuvable"
    end
    local objectId = payload and payload.ObjectId
    print("[PlacementService] ObjectId demandé:", objectId)
    if not objectId then
        warn("[PlacementService] Objet introuvable (objectId nil)")
        return false, "Objet introuvable"
    end
    local record, index
    for i, rec in ipairs(plot.PlacedObjects or {}) do
        if rec.Id == objectId then
            record, index = rec, i
            break
        end
    end
    if not record then
        warn("[PlacementService] Objet introuvable dans PlacedObjects. ObjectId:", objectId)
        return false, "Objet introuvable sur la parcelle"
    end
    print("[PlacementService] Record trouvé:", record.Type, "index:", index)

    -- Compute target position from payload (X,Z only, preserve original Y)
    local targetPos
    if typeof(payload.CFrame) == "CFrame" then
        targetPos = payload.CFrame.Position
    elseif type(payload.CFrame) == "table" and payload.CFrame.x and payload.CFrame.z then
        targetPos = Vector3.new(payload.CFrame.x, payload.CFrame.y or 0, payload.CFrame.z)
    else
        return false, "Position invalide"
    end
    
    -- Snap X and Z to grid, use plot base height for Y
    local grid = 2
    local snappedX = math.floor(targetPos.X / grid + 0.5) * grid
    local snappedZ = math.floor(targetPos.Z / grid + 0.5) * grid
    
    -- Use plot base height (same as initial placement)
    local baseY = getPlotBaseHeight(plot)
    local snappedPos = Vector3.new(snappedX, baseY, snappedZ)
    print("[PlacementService] Position avec baseY:", snappedPos)

    -- Validate inside plot
    if PlotApi and PlotApi.IsPositionInsidePlot then
        if not PlotApi.IsPositionInsidePlot(plot, snappedPos) then
            return false, "Déplacement hors de la parcelle"
        end
    end

    local rotation = tonumber(payload.Rotation or 0) or 0
    local targetCFrame = CFrame.new(snappedPos) * CFrame.Angles(0, math.rad(rotation), 0)

    -- Locate instance by PlotObjectId attribute
    local instance = record.Instance
    print("[PlacementService] Instance depuis record:", instance)
    if not instance or not instance.Parent then
        local worldFolder = plot.Container
        print("[PlacementService] Recherche instance dans plot.Container:", worldFolder)
        if worldFolder then
            for _, m in ipairs(worldFolder:GetChildren()) do
                if m:GetAttribute("PlotObjectId") == objectId then
                    print("[PlacementService] Instance trouvée via PlotObjectId:", m.Name)
                    instance = m
                    break
                end
            end
        end
    end
    
    if not instance or not instance.Parent then
        warn("[PlacementService] Instance de l'objet introuvable pour objectId:", objectId)
        return false, "Instance de l'objet introuvable"
    end

    print("[PlacementService] Déplacement de l'instance:", instance.Name, "vers", targetCFrame.Position)
    -- Move the instance
    if instance:IsA("Model") then
        instance:PivotTo(targetCFrame)
    elseif instance:IsA("BasePart") then
        instance.CFrame = targetCFrame
    end

    -- Update record with CFrame as table for consistency
    record.CFrame = {
        X = targetCFrame.Position.X,
        Y = targetCFrame.Position.Y,
        Z = targetCFrame.Position.Z
    }
    record.Rotation = rotation
    record.Instance = instance
    
    -- Notify data save
    if DataApi and DataApi.SavePlotData then
        task.defer(function()
            DataApi.SavePlotData(player)
        end)
    end

    print("[PlacementService] Déplacement réussi pour objectId:", objectId)
    return true, "Objet déplacé"
end

BuildRemotes.RequestPlacement.OnServerInvoke = function(player, payload)
    return handlePlacement(player, payload or {})
end

local function findObjectRecord(plot, objectId)
    ensurePlotState(plot)
    for index, entry in ipairs(plot.PlacedObjects) do
        if entry.Id == objectId then
            return entry, index
        end
    end
    return nil
end

local function handleRemoval(player, objectId)
    local plot = PlotApi.GetPlotForPlayer(player)
    if not plot then
        return false, "Aucune parcelle"
    end
    ensurePlotState(plot)
    if typeof(objectId) ~= "string" or objectId == "" then
        return false, "Id invalide"
    end

    local record, index = findObjectRecord(plot, objectId)
    if not record then
        return false, "Objet introuvable"
    end

    if plot.Container then
        local destroyedModels = {}
        for _, descendant in ipairs(plot.Container:GetDescendants()) do
            if descendant:GetAttribute("PlotObjectId") == objectId then
                local model = descendant:IsA("BasePart") and descendant.Parent or descendant
                if model and model:IsA("Model") and not destroyedModels[model] then
                    destroyedModels[model] = true
                    model:Destroy()
                elseif not model then
                    descendant:Destroy()
                elseif not model:IsA("Model") then
                    descendant:Destroy()
                end
            end
        end
    end

    EconomyService.RemoveIncomeSource(player, record.IncomePerSecond or 0)
    table.remove(plot.PlacedObjects, index)
    BuildRemotes.PlacedObjectsUpdated:FireClient(player, plot.PlacedObjects)
    savePlotData(plot)
    return true
end

BuildRemotes.RequestRemove.OnServerInvoke = function(player, objectId)
    return handleRemoval(player, objectId)
end

BuildRemotes.RequestMove.OnServerInvoke = function(player, payload)
    return handleMove(player, payload or {})
end

local PlacementAPI = {}

function PlacementAPI.OnPlotClaimed(player, plot, savedData)
    plot.Container:ClearAllChildren()
    plot.PlayerData = savedData or plot.PlayerData or {
        Objects = {},
    }
    ensurePlotState(plot)
    for _, entry in ipairs(plot.PlacedObjects) do
        entry.Id = entry.Id or HttpService:GenerateGUID(false)
        spawnModelInPlot(plot, entry)
    end
    if player then
        EconomyService.RecalculateIncome(player, plot.PlacedObjects)
    end
    savePlotData(plot)
end

shared.ParadisPlacementService = PlacementAPI
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="36">
        <Properties>
          <string name="Name">PlotService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    PlotService
    Génère le camping, gère les parcelles et le processus de réservation côté serveur.
    Toutes les informations sont exposées via shared.ParadisPlotService pour les autres scripts.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local CampConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("CampConfig"))
local BuildRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuildRemotes"))

local ParadisServerFolder = ServerScriptService:FindFirstChild("ParadisServer") or script.Parent
local WorldGenerator = require(ParadisServerFolder:WaitForChild("CampingWorldGenerator"))

local plotsById = {}
local playerToPlot = {}

local function getDataService()
    return shared.ParadisDataService
end

local function getPlacementService()
    return shared.ParadisPlacementService
end

local function getTrailerService()
    return shared.ParadisTrailerService
end

local function getPlotSurfaceY(plot)
    if plot then
        if plot.BaseHeight then
            return plot.BaseHeight
        end
        if plot.BasePart then
            local base = plot.BasePart
            return base.Position.Y + (base.Size.Y / 2)
        end
    end
    return plot and plot.Center and plot.Center.Y or 0
end

local function clearPlot(plot)
    if plot.Container then
        plot.Container:ClearAllChildren()
    end
    plot.PlacedObjects = {}
    plot.PlayerData = nil
    plot.TrailerParts = {}
    plot.TrailerFolder = nil
    plot.TrailerCells = nil
    plot.TrailerModels = nil
    destroyOwnerSign(plot)
    if plot.Prompt then
        plot.Prompt.Enabled = true
    end
end

local function ensureOwnerSign(plot)
    if plot.SignBoard and plot.SignBoard.Parent then
        return plot.SignBoard
    end

    local signage = CampConfig.Signage or {}
    local postHeight = signage.PostHeight or (signage.PostSize and signage.PostSize.Y) or 6
    local postSize = signage.PostSize or Vector3.new(1.5, postHeight, 1.5)

    local signPost = Instance.new("Part")
    signPost.Name = "PlotSign_" .. plot.Id
    signPost.Size = postSize
    signPost.Material = Enum.Material.WoodPlanks
    signPost.Color = Color3.fromRGB(150, 112, 66)
    signPost.Anchored = true
    signPost.CanCollide = false
    signPost.Parent = Workspace

    local board = Instance.new("Part")
    board.Name = "SignBoard"
    board.Size = signage.BoardSize or Vector3.new(8, 4, 0.6)
    board.Material = Enum.Material.Wood
    board.Color = Color3.fromRGB(120, 80, 40)
    board.Anchored = true
    board.CanCollide = false
    board.Parent = Workspace

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlotBillboard"
    billboard.Size = signage.BillboardSize or UDim2.new(0, 220, 0, 80)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2, 0)
    billboard.MaxDistance = 140
    billboard.AlwaysOnTop = true
    billboard.Parent = board

    local label = Instance.new("TextLabel")
    label.Name = "StatusLabel"
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Size = UDim2.new(1, 0, 1, 0)
    label.TextColor3 = Color3.fromRGB(200, 255, 200)
    label.Parent = billboard

    plot.SignPost = signPost
    plot.SignBoard = board
    plot.SignBillboard = billboard
    return board
end

local function destroyOwnerSign(plot)
    if plot.SignBoard then
        plot.SignBoard:Destroy()
        plot.SignBoard = nil
    end
    if plot.SignPost then
        plot.SignPost:Destroy()
        plot.SignPost = nil
    end
    plot.SignBillboard = nil
end

local function positionOwnerSign(plot)
    if not plot.SignPost then
        return
    end
    local cframe = plot.FootprintCFrame or (plot.BasePart and plot.BasePart.CFrame) or CFrame.new(plot.Center or Vector3.new())
    local sizeZ = (plot.Size and plot.Size.Y) or (plot.BasePart and plot.BasePart.Size.Z) or 0
    local signage = CampConfig.Signage or {}
    local offset = signage.OwnerOffset or 6
    local forward = cframe.LookVector
    local center = cframe.Position
    local halfDepth = sizeZ / 2
    local distance = halfDepth + offset
    local baseHeight = getPlotSurfaceY(plot)
    local postHeight = signage.PostHeight or (signage.PostSize and signage.PostSize.Y) or 6
    local postThickness = (signage.PostSize and signage.PostSize.Z) or 1.5

    local postPosition = Vector3.new(center.X, baseHeight + postHeight / 2, center.Z) + forward * distance
    plot.SignPost.CFrame = CFrame.lookAt(postPosition, postPosition + forward)
    plot.SignBoard.CFrame = plot.SignPost.CFrame * CFrame.new(0, postHeight * 0.35, -postThickness / 2 - 0.3)
end

local function updateSignDisplay(plot)
    if plot.OwnerUserId then
        ensureOwnerSign(plot)
        positionOwnerSign(plot)
        if plot.Prompt then
            plot.Prompt.Enabled = false
        end
        local statusLabel = plot.SignBillboard and plot.SignBillboard:FindFirstChild("StatusLabel")
        if statusLabel then
            local player = Players:GetPlayerByUserId(plot.OwnerUserId)
            local ownerName = player and player.DisplayName or "?"
            statusLabel.Text = string.format("Parcelle de %s", ownerName)
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 150)
        end
    else
        if plot.Prompt then
            plot.Prompt.Enabled = true
        end
        destroyOwnerSign(plot)
    end
end

local function isPositionInsidePlot(plot, position)
    if not (plot and plot.FootprintCFrame and plot.Size) then
        return false
    end
    local localPos = plot.FootprintCFrame:PointToObjectSpace(position)
    local halfWidth = plot.Size.X / 2
    local halfDepth = plot.Size.Y / 2
    return math.abs(localPos.X) <= halfWidth and math.abs(localPos.Z) <= halfDepth
end

local function attemptClaim(player, plotId)
    local plot = plotsById[plotId]
    if not plot then
        return false, "Parcelle inconnue"
    end
    if plot.OwnerUserId and plot.OwnerUserId ~= player.UserId then
        return false, "Parcelle déjà occupée"
    end

    -- Libère l'ancienne parcelle du joueur
    local previousPlot = playerToPlot[player]
    if previousPlot and previousPlot ~= plot then
        previousPlot.OwnerUserId = nil
        clearPlot(previousPlot)
        updateSignDisplay(previousPlot)
    end

    plot.OwnerUserId = player.UserId
    playerToPlot[player] = plot

    local dataService = getDataService()
    local playerData
    if dataService and dataService.LoadPlayerData then
        playerData = dataService.LoadPlayerData(player.UserId)
    end
    if not playerData and dataService and dataService.GetDefaultData then
        playerData = dataService.GetDefaultData()
    end
    playerData = playerData or {
        Objects = {},
        TrailerParts = {},
    }
    playerData.Objects = playerData.Objects or {}
    playerData.TrailerParts = playerData.TrailerParts or {}

    plot.PlayerData = playerData
    plot.PlacedObjects = playerData.Objects
    plot.TrailerParts = playerData.TrailerParts
    plot.TrailerCells = nil
    plot.TrailerFolder = nil
    plot.TrailerModels = nil

    local placementService = getPlacementService()
    if placementService and placementService.OnPlotClaimed then
        placementService.OnPlotClaimed(player, plot, playerData)
    elseif plot.Container then
        plot.Container:ClearAllChildren()
    end

    local trailerService = getTrailerService()
    local trailerHandled = false
    if trailerService and trailerService.OnPlotClaimed then
        trailerService.OnPlotClaimed(player, plot, playerData)
        trailerHandled = true
    end

    updateSignDisplay(plot)

    BuildRemotes.PlotAssigned:FireClient(player, {
        PlotId = plot.Id,
        Center = plot.Center,
        Size = plot.Size,
        BaseHeight = getPlotSurfaceY(plot),
    })
    BuildRemotes.PlacedObjectsUpdated:FireClient(player, plot.PlacedObjects)
    if not trailerHandled then
        BuildRemotes.TrailerStateUpdated:FireClient(player, plot.TrailerParts)
    end

    return true, "Parcelle attribuée"
end

local function createPlotFromDefinition(definition)
    local defaults = CampConfig.PlotDefaults or {}
    local plotId = definition.Id
    local basePart = definition.BasePart
    if not (plotId and basePart) then
        warn("[Paradis] Définition de parcelle invalide", definition)
        return
    end

    basePart.Name = "Plot_" .. plotId

    local border = Instance.new("SelectionBox")
    border.Color3 = defaults.SelectionColor or Color3.fromRGB(245, 203, 66)
    border.LineThickness = 0.02
    border.Adornee = basePart
    border.Parent = basePart

    local container = Instance.new("Folder")
    container.Name = "PlotContainer_" .. plotId
    container.Parent = basePart

    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Réserver"
    prompt.ObjectText = "Parcelle"
    prompt.HoldDuration = 0.25
    prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
    prompt.RequiresLineOfSight = false
    prompt.Parent = basePart

    local plotData = {
        Id = plotId,
        Center = definition.Center,
        Size = definition.Size,
        FootprintCFrame = definition.FootprintCFrame,
        BasePart = basePart,
        BaseHeight = definition.BaseHeight or (basePart.Position.Y + basePart.Size.Y / 2),
        Container = container,
        OwnerUserId = nil,
        SignBoard = nil,
        SignBillboard = nil,
        Prompt = prompt,
        PlacedObjects = {},
        PlayerData = nil,
        TrailerParts = {},
        TrailerFolder = nil,
        TrailerCells = nil,
        TrailerModels = nil,
    }

    prompt.Triggered:Connect(function(player)
        attemptClaim(player, plotId)
    end)

    plotsById[plotId] = plotData
    updateSignDisplay(plotData)
end

BuildRemotes.RequestClaim.OnServerInvoke = function(player, plotId)
    return attemptClaim(player, plotId)
end

Players.PlayerRemoving:Connect(function(player)
    local plot = playerToPlot[player]
    if plot and plot.OwnerUserId == player.UserId then
        plot.OwnerUserId = nil
        clearPlot(plot)
        updateSignDisplay(plot)
    end
    playerToPlot[player] = nil
end)

local function init()
    local generated = WorldGenerator.GetGeneratedPlots()
    if #generated == 0 then
        warn("[Paradis] Aucun plot généré. Vérifier CampConfig.PlotBands.")
        return
    end

    for _, plotDefinition in ipairs(generated) do
        createPlotFromDefinition(plotDefinition)
    end
end

init()

shared.ParadisPlotService = {
    GetPlotForPlayer = function(player)
        return playerToPlot[player]
    end,
    GetPlotById = function(plotId)
        return plotsById[plotId]
    end,
    IsPositionInsidePlot = isPositionInsidePlot,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="37">
        <Properties>
          <string name="Name">ProShopService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- ProShopService.server.lua
-- Gère les achats dans la boutique ProShop (haches permanentes et bûches magiques temporaires)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local ProShopConfig = require(ReplicatedStorage.Config.ProShopConfig)
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")

local requestPurchaseFunc = remotesFolder:WaitForChild("RequestProShopPurchase")
local getDataFunc = remotesFolder:WaitForChild("GetProShopData")
local purchaseResultEvent = remotesFolder:WaitForChild("ProShopPurchaseResult")
local magicLogExpiredEvent = remotesFolder:WaitForChild("MagicLogExpired")

-- Stockage des bûches magiques actives par joueur
-- Structure: playerMagicLogs[userId] = {count = N, expiryTime = tick() + duration}
local playerMagicLogs = {}

-- Fonction pour initialiser les attributs du joueur
local function initializePlayerAttributes(player)
	if not player:GetAttribute("Money") then
		player:SetAttribute("Money", 0)
	end
	if not player:GetAttribute("MagicLogs") then
		player:SetAttribute("MagicLogs", 0)
	end
	
	-- Restaurer les bûches magiques si elles existent encore
	local userId = player.UserId
	if playerMagicLogs[userId] then
		local data = playerMagicLogs[userId]
		if data.expiryTime > tick() then
			player:SetAttribute("MagicLogs", data.count)
		else
			-- Expirées, nettoyer
			playerMagicLogs[userId] = nil
			player:SetAttribute("MagicLogs", 0)
		end
	end
end

-- Fonction pour obtenir les données de la boutique pour un joueur
local function getProShopData(player)
	return {
		products = ProShopConfig.Products,
		playerMoney = player:GetAttribute("Money") or 0,
		playerAxePower = player:GetAttribute("AxePower") or 1,
		playerMagicLogs = player:GetAttribute("MagicLogs") or 0,
		magicLogExpiry = playerMagicLogs[player.UserId] and playerMagicLogs[player.UserId].expiryTime or nil
	}
end

-- Fonction pour traiter l'achat d'une hache
local function purchaseAxe(player, product)
	local currentAxePower = player:GetAttribute("AxePower") or 1
	
	-- Vérifier si le joueur a déjà cette hache ou mieux
	if currentAxePower >= product.AxePower then
		return false, "Vous possédez déjà cette hache ou une meilleure!"
	end
	
	-- Vérifier l'argent
	local playerMoney = player:GetAttribute("Money") or 0
	if playerMoney < product.Price then
		return false, "Argent insuffisant! Il vous faut " .. product.Price .. " pièces."
	end
	
	-- Déduire l'argent et donner la hache
	player:SetAttribute("Money", playerMoney - product.Price)
	player:SetAttribute("AxePower", product.AxePower)
	
	print("[ProShopService] " .. player.Name .. " a acheté " .. product.Name .. " (Power: " .. product.AxePower .. ")")
	return true, "Hache achetée avec succès! ✨"
end

-- Fonction pour traiter l'achat de bûches magiques
local function purchaseMagicLogs(player, product)
	-- Vérifier l'argent
	local playerMoney = player:GetAttribute("Money") or 0
	if playerMoney < product.Price then
		return false, "Argent insuffisant! Il vous faut " .. product.Price .. " pièces."
	end
	
	-- Déduire l'argent
	player:SetAttribute("Money", playerMoney - product.Price)
	
	-- Ajouter les bûches magiques
	local currentMagicLogs = player:GetAttribute("MagicLogs") or 0
	local newTotal = currentMagicLogs + product.Quantity
	player:SetAttribute("MagicLogs", newTotal)
	
	-- Initialiser ou mettre à jour le timer d'expiration (24h à partir de maintenant)
	local userId = player.UserId
	local expiryTime = tick() + ProShopConfig.MAGIC_LOG_DURATION
	
	if not playerMagicLogs[userId] then
		playerMagicLogs[userId] = {count = newTotal, expiryTime = expiryTime}
		
		-- Démarrer un timer pour notifier l'expiration
		task.delay(ProShopConfig.MAGIC_LOG_DURATION, function()
			if Players:FindFirstChild(player.Name) then
				player:SetAttribute("MagicLogs", 0)
				magicLogExpiredEvent:FireClient(player)
				print("[ProShopService] Bûches magiques de " .. player.Name .. " ont expiré")
			end
			playerMagicLogs[userId] = nil
		end)
	else
		-- Mettre à jour le count, garder le timer existant
		playerMagicLogs[userId].count = newTotal
	end
	
	print("[ProShopService] " .. player.Name .. " a acheté " .. product.Quantity .. " bûche(s) magique(s)")
	return true, product.Quantity .. " bûche(s) magique(s) ajoutée(s)! ✨ (24h)"
end

-- Handler pour les demandes d'achat
requestPurchaseFunc.OnServerInvoke = function(player, productId)
	local product = ProShopConfig.GetProductById(productId)
	
	if not product then
		return {success = false, message = "Produit introuvable!"}
	end
	
	local success, message
	
	if product.ProductType == ProShopConfig.ProductTypes.AXE then
		success, message = purchaseAxe(player, product)
	elseif product.ProductType == ProShopConfig.ProductTypes.MAGIC_LOG then
		success, message = purchaseMagicLogs(player, product)
	else
		return {success = false, message = "Type de produit inconnu!"}
	end
	
	-- Notifier le client du résultat
	purchaseResultEvent:FireClient(player, {
		success = success,
		message = message,
		productId = productId
	})
	
	return {success = success, message = message}
end

-- Handler pour obtenir les données de la boutique
getDataFunc.OnServerInvoke = function(player)
	return getProShopData(player)
end

-- Initialiser les joueurs déjà présents
for _, player in ipairs(Players:GetPlayers()) do
	initializePlayerAttributes(player)
end

-- Initialiser les nouveaux joueurs
Players.PlayerAdded:Connect(function(player)
	initializePlayerAttributes(player)
end)

-- Nettoyer les données quand un joueur quitte
Players.PlayerRemoving:Connect(function(player)
	-- Note: Dans un vrai jeu, sauvegarder playerMagicLogs[userId] dans DataStore
	-- Pour l'instant, les bûches magiques sont perdues à la déconnexion
end)

print("[ProShopService] Service initialisé - " .. #ProShopConfig.Products .. " produits disponibles")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="38">
        <Properties>
          <string name="Name">ShopService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    ShopService
    Gère l'achat et le placement d'objets décoratifs sur la parcelle du joueur.
    Les modèles référencés doivent se trouver dans ReplicatedStorage.ShopObjects.
    DÉSACTIVÉ: fonctionnalité retirée.
]]

do return end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local ShopObjects = ReplicatedStorage:FindFirstChild("ShopObjects")
if not ShopObjects then
    ShopObjects = Instance.new("Folder")
    ShopObjects.Name = "ShopObjects"
    ShopObjects.Parent = ReplicatedStorage
    warn("[Paradis][Shop] Dossier 'ShopObjects' manquant, créé vide par défaut.")
end

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local ShopConfig = require(ConfigFolder:WaitForChild("ShopConfig"))
local BuildRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuildRemotes"))

local RemotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not RemotesFolder then
    RemotesFolder = Instance.new("Folder")
    RemotesFolder.Name = "Remotes"
    RemotesFolder.Parent = ReplicatedStorage
end

local ShopRemotes = RemotesFolder:FindFirstChild("ShopRemotes")
if not ShopRemotes then
    ShopRemotes = Instance.new("Folder")
    ShopRemotes.Name = "ShopRemotes"
    ShopRemotes.Parent = RemotesFolder
end

local PlaceShopItem = ShopRemotes:FindFirstChild("PlaceShopItem")
if not PlaceShopItem then
    PlaceShopItem = Instance.new("RemoteEvent")
    PlaceShopItem.Name = "PlaceShopItem"
    PlaceShopItem.Parent = ShopRemotes
end

local PlotService = waitForShared("ParadisPlotService")
local EconomyService = shared.ParadisEconomyService

local function getCashValue(player)
    local stats = player:FindFirstChild("leaderstats")
    return stats and stats:FindFirstChild("Cash")
end

local function getItemDefinition(itemId)
    local def = ShopConfig.Items[itemId]
    if def then
        return def
    end
    warn("[Paradis][Shop] Item inconnu demandé:", itemId)
    return nil
end

local function ensurePlotOwnership(player)
    if not PlotService or not PlotService.GetPlotForPlayer then
        return nil
    end
    return PlotService.GetPlotForPlayer(player)
end

local function isInsidePlot(plot, position)
    if PlotService and PlotService.IsPositionInsidePlot then
        return PlotService.IsPositionInsidePlot(plot, position)
    end
    return false
end

local function chargePlayer(player, cost)
    cost = math.max(0, cost or 0)
    if cost == 0 then
        return true
    end

    if EconomyService and EconomyService.HasEnoughCash and EconomyService.AddCash then
        if not EconomyService.HasEnoughCash(player, cost) then
            return false
        end
        EconomyService.AddCash(player, -cost)
        return true
    end

    local cashValue = getCashValue(player)
    if not cashValue or cashValue.Value < cost then
        return false
    end
    cashValue.Value -= cost
    return true
end

local function recordPlacement(plot, itemDef, targetCFrame)
    plot.PlacedObjects = plot.PlacedObjects or {}
    table.insert(plot.PlacedObjects, {
        Type = "ShopItem",
        ItemId = itemDef.Id,
        Category = itemDef.Category,
        Position = targetCFrame.Position,
        YRotation = select(2, targetCFrame:ToEulerAnglesYXZ()),
        Cost = itemDef.Cost,
        Timestamp = os.time(),
    })
end

local function placeModelInPlot(plot, modelTemplate, targetCFrame)
    local clone = modelTemplate:Clone()
    if clone.PrimaryPart then
        clone:PivotTo(targetCFrame)
    else
        local primary = clone:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            local offset = primary.CFrame:ToObjectSpace(clone:GetPivot())
            clone:PivotTo(targetCFrame * offset)
        else
            clone:PivotTo(targetCFrame)
        end
    end

    local container = plot.Container
    if not container then
        container = Instance.new("Folder")
        container.Name = "PlotContainer_" .. tostring(plot.Id)
        container.Parent = plot.BasePart or workspace
        plot.Container = container
    end

    clone.Parent = container
    return clone
end

local function sanitizeCFrame(cf)
    if typeof(cf) ~= "CFrame" then
        return nil
    end
    local position = cf.Position
    local _, yaw = cf:ToEulerAnglesYXZ()
    return CFrame.new(position) * CFrame.Angles(0, yaw, 0)
end

PlaceShopItem.OnServerEvent:Connect(function(player, itemId, requestedCFrame)
    if typeof(itemId) ~= "string" then
        return
    end

    local itemDef = getItemDefinition(itemId)
    if not itemDef then
        return
    end

    local modelTemplate = ShopObjects:FindFirstChild(itemDef.ModelName)
    if not modelTemplate then
        warn("[Paradis][Shop] Model introuvable pour l'item:", itemId, itemDef.ModelName)
        return
    end

    local targetCFrame = sanitizeCFrame(requestedCFrame)
    if not targetCFrame then
        warn("[Paradis][Shop] CFrame invalide pour", player.Name)
        return
    end

    local plot = ensurePlotOwnership(player)
    if not plot then
        warn("[Paradis][Shop] Le joueur n'a pas de parcelle:", player.Name)
        return
    end

    if not isInsidePlot(plot, targetCFrame.Position) then
        warn("[Paradis][Shop] Placement refusé hors parcelle pour", player.Name)
        return
    end

    local cost = itemDef.Cost or (ShopConfig.Defaults and ShopConfig.Defaults.Cost) or 0
    if not chargePlayer(player, cost) then
        warn("[Paradis][Shop] Pas assez d'argent pour", player.Name, "item", itemId)
        return
    end

    placeModelInPlot(plot, modelTemplate, targetCFrame)
    recordPlacement(plot, itemDef, targetCFrame)
    BuildRemotes.PlacedObjectsUpdated:FireClient(player, plot.PlacedObjects)

    if shared.ParadisEconomyService and shared.ParadisEconomyService.RecalculateIncome then
        shared.ParadisEconomyService.RecalculateIncome(player, plot.PlacedObjects)
    end

    print("[Paradis][Shop] Objet placé:", itemId, "par", player.Name)
end)

Players.PlayerRemoving:Connect(function(player)
    -- Rien de spécifique pour l'instant, la persistance sera gérée via PlotService/DataService.
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="39">
        <Properties>
          <string name="Name">SwingGameService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")

local function buildDefaultMiniGamesConfig()
    return {
        SwingGame = {
            PivotPosition = Vector3.new(-120, 8, 60),
            SeatOffset = Vector3.new(0, -6, 0),
            RewardPerFullLoop = 5,
            MinRadius = 3,
            PushAngularImpulse = 4,
            ForwardKeys = { Enum.KeyCode.W, Enum.KeyCode.Up },
            BackwardKeys = { Enum.KeyCode.S, Enum.KeyCode.Down },
            ModelName = "Swing",
            PivotName = "SwingPivot",
            SeatName = "Seat",
            AutoCreateModel = false,
            Swings = {
                {
                    ModelName = "Swing",
                    PivotName = "SwingPivot",
                    SeatName = "Seat",
                },
                {
                    ModelName = "Swing2",
                    PivotName = "SwingPivot",
                    SeatName = "Seat",
                },
            },
            ComboWindowSeconds = 3,
            ComboBonusPerLoop = 2,
        },
        FishingGame = {
            Spots = {
                { Name = "FishingSpot1", Position = Vector3.new(-60, 1, -150) },
                { Name = "FishingSpot2", Position = Vector3.new(-20, 1, -170) },
                { Name = "FishingSpot3", Position = Vector3.new(20, 1, -180) },
                { Name = "FishingSpot4", Position = Vector3.new(60, 1, -170) },
                { Name = "FishingSpot5", Position = Vector3.new(100, 1, -160) },
            },
            FishRewards = {
                Small = { Label = "Petit poisson", MinReward = 3, MaxReward = 7 },
                Medium = { Label = "Poisson moyen", MinReward = 8, MaxReward = 15 },
                Large = { Label = "Gros poisson", MinReward = 16, MaxReward = 30 },
                Rare = { Label = "Poisson rare", MinReward = 31, MaxReward = 60 },
            },
            FishProbabilities = {
                Small = 0.45,
                Medium = 0.30,
                Large = 0.20,
                Rare = 0.05,
            },
            CooldownSeconds = 5,
        },
    }
end

local function loadMiniGamesDefaults()
    local paradisFolder = ServerScriptService:FindFirstChild("ParadisServer") or script.Parent
    local module = paradisFolder and paradisFolder:FindFirstChild("MiniGamesConfigDefaults")
    if module and module:IsA("ModuleScript") then
        local ok, data = pcall(require, module)
        if ok and type(data) == "table" then
            return data
        end
        warn("[Paradis][SwingGame] MiniGamesConfigDefaults require a échoué, utilisation des valeurs par défaut locales.", data)
    else
        warn("[Paradis][SwingGame] MiniGamesConfigDefaults absent, utilisation des valeurs par défaut locales.")
    end
    return buildDefaultMiniGamesConfig()
end

local MiniGamesDefaults = loadMiniGamesDefaults()

local function resolveConfigModule(folder, childName, contextLabel)
    local container = folder:WaitForChild(childName)
    local className = container.ClassName
    -- Résolution silencieuse du module de configuration (logs réduits)
    if container:IsA("ModuleScript") then
        return container
    end

    if className == "ModuleScript" then
        return container
    end

    local descendant = container:FindFirstChildWhichIsA("ModuleScript", true)
    if descendant then
        print(string.format("[Paradis][%s] ModuleScript imbriqué utilisé (%s)", contextLabel, descendant:GetFullName()))
        return descendant
    end

    error(string.format("[Paradis][%s] %s doit contenir un ModuleScript", contextLabel, childName))
end

local miniGamesModule = resolveConfigModule(ConfigFolder, "MiniGamesConfig", "SwingGame")
local moduleClone = miniGamesModule
if not miniGamesModule:IsDescendantOf(ServerScriptService) then
    moduleClone = miniGamesModule:Clone()
    moduleClone.Name = "MiniGamesConfig_ServerCopy"
    moduleClone.Parent = ServerScriptService
end

local success, moduleResult = pcall(require, moduleClone)
if not success then
    warn("[Paradis][SwingGame] Impossible de require MiniGamesConfig:", moduleResult)
end
if moduleClone ~= miniGamesModule then
    moduleClone:Destroy()
end
local MiniGamesConfig = success and moduleResult or MiniGamesDefaults
local swingCfg = (MiniGamesConfig and MiniGamesConfig.SwingGame) or MiniGamesDefaults.SwingGame or {}

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local EconomyService = shared.ParadisEconomyService
if not EconomyService then
    task.spawn(function()
        EconomyService = waitForShared("ParadisEconomyService")
    end)
end

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "Remotes"
    remotesFolder.Parent = ReplicatedStorage
end

local swingFolder = remotesFolder:FindFirstChild("SwingGame")
if not swingFolder then
    swingFolder = Instance.new("Folder")
    swingFolder.Name = "SwingGame"
    swingFolder.Parent = remotesFolder
end

local pushEvent = swingFolder:FindFirstChild("PushSwing")
if not pushEvent then
    pushEvent = Instance.new("RemoteEvent")
    pushEvent.Name = "PushSwing"
    pushEvent.Parent = swingFolder
end

local comboEvent = swingFolder:FindFirstChild("SwingComboUpdate")
if not comboEvent then
    comboEvent = Instance.new("RemoteEvent")
    comboEvent.Name = "SwingComboUpdate"
    comboEvent.Parent = swingFolder
end

local function addCash(player, amount)
    if not player or amount == 0 then
        return
    end

    if EconomyService and typeof(EconomyService.AddCash) == "function" then
        EconomyService.AddCash(player, amount)
        return
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashValue = leaderstats and leaderstats:FindFirstChild("Cash")
    if cashValue then
        cashValue.Value += amount
    else
        warn("[Paradis][SwingGame] Impossible d'ajouter du Cash à", player.Name)
    end
end

local swingConfigs = {}
if typeof(swingCfg.Swings) == "table" and #swingCfg.Swings > 0 then
    for _, cfg in ipairs(swingCfg.Swings) do
        table.insert(swingConfigs, cfg)
    end
else
    table.insert(swingConfigs, swingCfg)
end

local function getValue(cfg, key)
    if cfg[key] ~= nil then
        return cfg[key]
    end
    return swingCfg[key]
end

local function createRig(cfg)
    return {
        config = cfg,
        model = nil,
        pivot = nil,
        axis = nil,
        forwardBasis = nil,
        upBasis = nil,
        state = {},
        welds = {},
    }
end

local swingRigs = {}
for _, cfg in ipairs(swingConfigs) do
    table.insert(swingRigs, createRig(cfg))
end

local function refreshRig(rig)
    local cfg = rig.config
    local modelName = getValue(cfg, "ModelName") or "SwingGame"
    local model = Workspace:FindFirstChild(modelName, true)
    if not model and modelName ~= "SwingGame" then
        model = Workspace:FindFirstChild("SwingGame", true)
    end
    if not model then
        model = Workspace:FindFirstChild("Swing", true)
    end

    if model and model:IsA("Model") then
        rig.model = model
    else
        rig.model = nil
        rig.pivot = nil
        return
    end

    local pivotName = getValue(cfg, "PivotName")
    local pivot
    if pivotName and pivotName ~= "" then
        pivot = rig.model:FindFirstChild(pivotName, true)
        if pivot and not pivot:IsA("BasePart") then
            pivot = nil
        end
    end
    if not pivot then
        for _, descendant in ipairs(rig.model:GetDescendants()) do
            if descendant:IsA("BasePart") and descendant.Anchored then
                pivot = descendant
                break
            end
        end
    end
    rig.pivot = pivot

    if rig.pivot then
        local axis = rig.pivot.CFrame.RightVector
        if axis.Magnitude < 1e-3 then
            axis = Vector3.new(1, 0, 0)
        else
            axis = axis.Unit
        end

        local function orthonormalize(reference)
            reference = reference - axis * reference:Dot(axis)
            if reference.Magnitude < 1e-3 then
                return nil
            end
            return reference.Unit
        end

        local forward = orthonormalize(rig.pivot.CFrame.LookVector)
        if not forward then
            forward = orthonormalize(rig.pivot.CFrame.UpVector)
        end
        if not forward then
            local fallback = axis:Cross(Vector3.new(0, 1, 0))
            if fallback.Magnitude < 1e-3 then
                fallback = axis:Cross(Vector3.new(1, 0, 0))
            end
            forward = orthonormalize(fallback) or Vector3.new(0, 0, 1)
        end

        local up = axis:Cross(forward)
        if up.Magnitude < 1e-3 then
            local fallback = axis:Cross(Vector3.new(0, 1, 0))
            if fallback.Magnitude < 1e-3 then
                fallback = axis:Cross(Vector3.new(1, 0, 0))
            end
            up = fallback.Unit
        else
            up = up.Unit
        end

        rig.axis = axis
        rig.forwardBasis = forward
        rig.upBasis = up
    else
        rig.axis = nil
        rig.forwardBasis = nil
        rig.upBasis = nil
    end
end

local function ensureRigReady(rig)
    if not rig.model or not rig.model.Parent then
        refreshRig(rig)
    elseif not rig.pivot or not rig.pivot.Parent then
        refreshRig(rig)
    end
    return rig.model ~= nil and rig.model.Parent ~= nil and rig.pivot ~= nil and rig.pivot.Parent ~= nil
end

local function getSeatForPlayerOnRig(player, rig)
    local character = player.Character
    if not character then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil
    end
    local seatPart = humanoid.SeatPart
    if not seatPart then
        return nil
    end
    if rig.model and seatPart:IsDescendantOf(rig.model) then
        return seatPart
    end
    local seatName = getValue(rig.config, "SeatName")
    if seatName and seatName ~= "" and seatPart.Name == seatName then
        return seatPart
    end
    return nil
end

local function resetSwingState(rig, player)
    local state = rig.state[player]
    if state then
        state.lastAngle = nil
        state.accumulated = 0
        state.comboCount = 0
        state.lastLoopTime = nil
    end
end

local function resetAllStates(rig)
    for player in pairs(rig.state) do
        resetSwingState(rig, player)
    end
end

local function detachPlayerFromSeat(rig, player)
    local weld = rig.welds[player]
    if weld then
        weld:Destroy()
        rig.welds[player] = nil
    end
end

local function attachPlayerToSeat(rig, player, seatPart)
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return
    end

    rootPart.Anchored = false
    local existing = rig.welds[player]
    if existing then
        if existing.Part0 == seatPart and existing.Part1 == rootPart then
            return
        end
        existing:Destroy()
        rig.welds[player] = nil
    end

    local weld = Instance.new("WeldConstraint")
    weld.Name = "SwingSeatWeld"
    weld.Part0 = seatPart
    weld.Part1 = rootPart
    weld.Parent = seatPart
    rig.welds[player] = weld
end

local function getRigAndSeatForPlayer(player)
    for _, rig in ipairs(swingRigs) do
        if ensureRigReady(rig) then
            local seatPart = getSeatForPlayerOnRig(player, rig)
            if seatPart then
                attachPlayerToSeat(rig, player, seatPart)
                return rig, seatPart
            end
        end
    end
    return nil, nil
end

pushEvent.OnServerEvent:Connect(function(player, direction)
    if direction ~= 1 and direction ~= -1 then
        return
    end

    local rig, seatPart = getRigAndSeatForPlayer(player)
    if not rig or not seatPart then
        return
    end

    local impulseMagnitude = getValue(rig.config, "PushAngularImpulse") or getValue(swingCfg, "PushAngularImpulse") or 0
    if impulseMagnitude <= 0 then
        return
    end

    local axis = rig.axis or (rig.pivot and rig.pivot.CFrame.RightVector)
    local targetPart = seatPart.AssemblyRootPart or seatPart
    if not targetPart then
        return
    end

    local impulse = axis * (impulseMagnitude * direction)
    targetPart:ApplyAngularImpulse(impulse)
end)

RunService.Heartbeat:Connect(function()
    for _, rig in ipairs(swingRigs) do
        if not ensureRigReady(rig) then
            resetAllStates(rig)
            for player in pairs(rig.welds) do
                detachPlayerFromSeat(rig, player)
            end
            continue
        end

        for _, player in ipairs(Players:GetPlayers()) do
            local seatPart = getSeatForPlayerOnRig(player, rig)
            if not seatPart then
                resetSwingState(rig, player)
                detachPlayerFromSeat(rig, player)
                continue
            end

            attachPlayerToSeat(rig, player, seatPart)

            local axis = rig.axis
            local forward = rig.forwardBasis
            local up = rig.upBasis
            if not axis or not forward or not up then
                resetSwingState(rig, player)
                continue
            end

            local pivotPos = rig.pivot.Position
            local seatPos = seatPart.Position
            local relative = seatPos - pivotPos
            local planar = relative - axis * relative:Dot(axis)
            local radius = planar.Magnitude
            if radius < (getValue(rig.config, "MinRadius") or swingCfg.MinRadius or 0) then
                resetSwingState(rig, player)
                continue
            end

            local x = planar:Dot(forward)
            local y = planar:Dot(up)
            local angle = math.atan2(y, x)
            local state = rig.state[player]
            if not state then
                rig.state[player] = {
                    lastAngle = angle,
                    accumulated = 0,
                    comboCount = 0,
                    lastLoopTime = nil,
                }
            else
                local delta = angle - (state.lastAngle or angle)
                if delta > math.pi then
                    delta -= 2 * math.pi
                elseif delta < -math.pi then
                    delta += 2 * math.pi
                end

                state.accumulated += math.deg(math.abs(delta))
                state.lastAngle = angle

                if state.accumulated >= 360 then
                    state.accumulated -= 360
                    local baseReward = getValue(rig.config, "RewardPerFullLoop") or swingCfg.RewardPerFullLoop or 0
                    local comboWindow = getValue(rig.config, "ComboWindowSeconds") or swingCfg.ComboWindowSeconds or 0
                    local comboBonus = getValue(rig.config, "ComboBonusPerLoop") or swingCfg.ComboBonusPerLoop or 0
                    local now = os.clock()

                    if comboWindow > 0 and state.lastLoopTime and (now - state.lastLoopTime) <= comboWindow then
                        state.comboCount = (state.comboCount or 1) + 1
                    else
                        state.comboCount = 1
                    end
                    state.lastLoopTime = now

                    local reward = baseReward
                    if comboBonus > 0 and state.comboCount > 1 then
                        reward += comboBonus * (state.comboCount - 1)
                    end

                    if reward > 0 then
                        addCash(player, reward)
                        comboEvent:FireClient(player, state.comboCount or 1, reward)
                    end
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    for _, rig in ipairs(swingRigs) do
        rig.state[player] = nil
        detachPlayerFromSeat(rig, player)
    end
end)

print("[Paradis][SwingGame] Service de balançoire initialisé.")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="40">
        <Properties>
          <string name="Name">SwingLoops</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Simple swing loop tracker for Paradis
-- Counts full 360° rotations of a swing and awards +5 Money to each seated player per loop
-- NOTE: Adjust the model name and pivot selection below if needed

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- CONFIG
local SWING_MODEL_NAME = "Swing" -- Change this if your swing is named differently
local PIVOT_NAME = "Attachment1" -- The rotating part (cordes/ropes attachment)
local REWARD_PER_LOOP = 5 -- Adjust reward here

-- Debug: liste tous les enfants de Workspace
print("[SwingLoops] Recherche du modèle '" .. SWING_MODEL_NAME .. "' dans Workspace...")
print("[SwingLoops] Enfants actuels de Workspace:")
for _, child in ipairs(Workspace:GetChildren()) do
	print("  - " .. child.Name .. " (" .. child.ClassName .. ")")
end

-- Locate swing model (or wait for it to be created in Studio)
local swing: Instance? = Workspace:FindFirstChild(SWING_MODEL_NAME)
if not swing then
	print("[SwingLoops] '" .. SWING_MODEL_NAME .. "' pas trouvé, attente...")
	swing = Workspace:WaitForChild(SWING_MODEL_NAME)
end
print("[SwingLoops] Swing trouvé: " .. swing.Name)

-- Collect Seat instances directly under the swing (or descendants)
local seats: { Seat } = {}
for _, inst in ipairs(swing:GetDescendants()) do
	if inst:IsA("Seat") then
		table.insert(seats, inst)
	end
end

-- Identify pivot part used for rotation measurement
local function findFirstBasePart(container: Instance): BasePart?
	if container:IsA("BasePart") then
		return container
	end
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("BasePart") then
			return d
		end
	end
	return nil
end

local pivotPart: BasePart? = nil
local pivotCandidate = swing:FindFirstChild(PIVOT_NAME)
if pivotCandidate then
	pivotPart = findFirstBasePart(pivotCandidate)
end
if not pivotPart then
	-- fallback: use the swing's PrimaryPart or first BasePart we can find
	if (swing :: any).PrimaryPart then
		pivotPart = (swing :: any).PrimaryPart
	else
		pivotPart = findFirstBasePart(swing)
	end
end

if not pivotPart then
	warn("[SwingLoops] Could not find a pivot BasePart. Please set PIVOT_NAME or swing.PrimaryPart")
	return
end

-- Track rotation angle around Y by default. If your swing rotates around a different axis,
-- swap angle extraction (X/Y/Z) below.
local _, lastAngleY, _ = pivotPart.CFrame:ToEulerAnglesYXZ()
local accumulated = 0.0

local TWO_PI = math.pi * 2

local function rewardSeatedPlayers()
	for _, seat in ipairs(seats) do
		local humanoid = seat.Occupant
		if humanoid then
			local character = humanoid.Parent
			local player = Players:GetPlayerFromCharacter(character)
			if player and player:FindFirstChild("leaderstats") then
				local ls = player.leaderstats
				local money = ls and ls:FindFirstChild("Money")
				if money and money:IsA("IntValue") then
					money.Value += REWARD_PER_LOOP
				end
			end
		end
	end
end

RunService.Heartbeat:Connect(function()
	if not pivotPart or not pivotPart.Parent then return end
	local _, angleY, _ = pivotPart.CFrame:ToEulerAnglesYXZ()
	local delta = angleY - lastAngleY
	-- normalize to [-pi, pi]
	if delta > math.pi then
		delta -= TWO_PI
	elseif delta < -math.pi then
		delta += TWO_PI
	end
	accumulated += math.abs(delta)
	lastAngleY = angleY

	if accumulated >= TWO_PI then
		accumulated -= TWO_PI
		rewardSeatedPlayers()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="41">
        <Properties>
          <string name="Name">TemplateService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Paradis Template Service
-- Ensures ReplicatedStorage.Paradis.{Templates,Remotes} exist and exposes Remote API
-- RemoteFunction: GetParadisTemplates -> returns { {name, category, price}, ... }
-- RemoteEvent: RequestPlaceTemplate(player, templateName) -> clones model a few studs ahead of player

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

-- Create/get Paradis root in ReplicatedStorage
local paradisFolder = ReplicatedStorage:FindFirstChild("Paradis")
if not paradisFolder then
	paradisFolder = Instance.new("Folder")
	paradisFolder.Name = "Paradis"
	paradisFolder.Parent = ReplicatedStorage
end

-- Create/get Templates folder (models to drop in Studio)
local templatesFolder = paradisFolder:FindFirstChild("Templates")
if not templatesFolder then
	templatesFolder = Instance.new("Folder")
	templatesFolder.Name = "Templates"
	templatesFolder.Parent = paradisFolder
end

-- Create/get Remotes folder
local remotesFolder = paradisFolder:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = paradisFolder
end

-- RemoteFunction: GetParadisTemplates
local getTemplatesFn = remotesFolder:FindFirstChild("GetParadisTemplates")
if not getTemplatesFn then
	getTemplatesFn = Instance.new("RemoteFunction")
	getTemplatesFn.Name = "GetParadisTemplates"
	getTemplatesFn.Parent = remotesFolder
end

-- RemoteEvent: RequestPlaceTemplate
local requestPlaceEvt = remotesFolder:FindFirstChild("RequestPlaceTemplate")
if not requestPlaceEvt then
	requestPlaceEvt = Instance.new("RemoteEvent")
	requestPlaceEvt.Name = "RequestPlaceTemplate"
	requestPlaceEvt.Parent = remotesFolder
end

-- Optional future feedback channel
local feedbackEvt = remotesFolder:FindFirstChild("TemplateFeedback")
if not feedbackEvt then
	feedbackEvt = Instance.new("RemoteEvent")
	feedbackEvt.Name = "TemplateFeedback"
	feedbackEvt.Parent = remotesFolder
end

-- Load registry (shared) lazily to ensure folders are ready
local TemplateRegistry
local function getRegistry()
	if not TemplateRegistry then
		TemplateRegistry = require(paradisFolder:WaitForChild("TemplateRegistry"))
	end
	return TemplateRegistry
end

-- Anti-spam per player (simple cooldown)
local lastPlaceAt: { [number]: number } = {}
local PLACE_COOLDOWN = 0.75 -- seconds

-- Utility: find ground position by raycasting down
local function getGroundPositionNear(pos: Vector3, ignoreInstances: { Instance }?)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = ignoreInstances or {}
	rayParams.IgnoreWater = false
	local origin = pos + Vector3.new(0, 50, 0)
	local dir = Vector3.new(0, -500, 0)
	local result = Workspace:Raycast(origin, dir, rayParams)
	if result then
		return result.Position
	end
	return pos
end

-- Return simplified list to clients
getTemplatesFn.OnServerInvoke = function(player)
	local reg = getRegistry()
	local out = {}
	for _, info in reg.getAll() do
		out[#out+1] = {
			name = info.name,
			category = info.category,
			price = info.price,
		}
	end
	return out
end

-- Handle placement requests
requestPlaceEvt.OnServerEvent:Connect(function(player, templateName)
	if typeof(templateName) ~= "string" then return end
	if #templateName == 0 or #templateName > 100 then return end
	local now = os.clock()
	local last = lastPlaceAt[player.UserId]
	if last and (now - last) < PLACE_COOLDOWN then
		return -- ignore spam
	end
	lastPlaceAt[player.UserId] = now

	local reg = getRegistry()
	local info = reg.getByName(templateName)
	if not info or typeof(info.model) ~= "Instance" then
		return
	end

	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	-- Place a few studs ahead of the player, projected to ground.
	local ahead = hrp.CFrame.Position + hrp.CFrame.LookVector * 8
	local groundPos = getGroundPositionNear(ahead, { character })

	local clone: Model = info.model:Clone()
	clone.Name = info.name
	clone.Parent = Workspace

	-- If model has a PrimaryPart, pivot to the ground position; otherwise try best-effort
	if clone.PrimaryPart then
		clone:PivotTo(CFrame.new(groundPos))
	else
		-- Try to find a BasePart to position
		local firstPart: BasePart? = clone:FindFirstChildWhichIsA("BasePart", true)
		if firstPart then
			local offset = groundPos - firstPart.Position
			for _, part in clone:GetDescendants() do
				if part:IsA("BasePart") then
					part.Position += offset
				end
			end
		end
	end

	-- TODO: Later, replace world placement with logic to place inside player's owned parcel
	-- You can also enforce parcel boundaries here when the parcel system is ready.
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="42">
        <Properties>
          <string name="Name">TrailerBuildService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    TrailerBuildService
    Gère le mode de construction de roulotte modulaire (solage, murs, toit).
    Dispose d'une grille par parcelle et applique les règles d'empilement/rotation.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local CampConfig = require(configFolder:WaitForChild("CampConfig"))
local TrailerPartsConfig = require(configFolder:WaitForChild("TrailerPartsConfig"))
local BuildRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuildRemotes"))

local CELL_SIZE = CampConfig.TRAILER_CELL_SIZE or 4
local CATEGORY_LEVEL = CampConfig.TRAILER_CATEGORY_LEVEL or { Foundation = 0, Wall = 1, Roof = 2 }
local LEVEL_BASE = CampConfig.TRAILER_LEVEL_BASE or { [0] = 0 }

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local PlotApi = waitForShared("ParadisPlotService")
local DataApi = waitForShared("ParadisDataService")

local TrailerService = {}

local function clampRotation(value)
    local snapped = math.floor((tonumber(value) or 0) / 90 + 0.5) * 90
    snapped %= 360
    if snapped < 0 then
        snapped += 360
    end
    return snapped
end

local function getGridOrigin(plot)
    return Vector3.new(
        plot.Center.X - (plot.Size.X / 2),
        plot.Center.Y,
        plot.Center.Z - (plot.Size.Y / 2)
    )
end

local function getGridLimits(plot)
    local cellsX = math.floor(plot.Size.X / CELL_SIZE)
    local cellsZ = math.floor(plot.Size.Y / CELL_SIZE)
    return cellsX, cellsZ
end

local function getCellKey(x, z)
    return string.format("%d:%d", x, z)
end

local function getFootprint(def, rotation)
    local gridSize = def.GridSize or Vector2.new(1, 1)
    local sizeX = math.max(1, math.floor(gridSize.X + 0.0001))
    local sizeZ = math.max(1, math.floor(gridSize.Y + 0.0001))
    if rotation % 180 ~= 0 then
        sizeX, sizeZ = sizeZ, sizeX
    end
    return sizeX, sizeZ
end

local function computeWorldTransform(plot, originX, originZ, def, rotation)
    local sizeX, sizeZ = getFootprint(def, rotation)
    local origin = getGridOrigin(plot)
    local width = sizeX * CELL_SIZE
    local depth = sizeZ * CELL_SIZE
    local centerX = origin.X + (originX * CELL_SIZE) + (width / 2)
    local centerZ = origin.Z + (originZ * CELL_SIZE) + (depth / 2)
    local level = CATEGORY_LEVEL[def.Category] or 0
    local baseHeight = (LEVEL_BASE and LEVEL_BASE[level]) or 0
    local centerY = plot.Center.Y + baseHeight + (def.Height / 2)
    local cframe = CFrame.new(centerX, centerY, centerZ) * CFrame.Angles(0, math.rad(rotation), 0)
    local worldSize = Vector3.new(width, def.Height, depth)
    return cframe, worldSize, sizeX, sizeZ, level
end

local function ensureTrailerFolder(plot)
    if not plot.Container then
        return nil
    end
    if plot.TrailerFolder and plot.TrailerFolder.Parent == plot.Container then
        return plot.TrailerFolder
    end
    local folder = Instance.new("Folder")
    folder.Name = "TrailerParts"
    folder.Parent = plot.Container
    plot.TrailerFolder = folder
    return folder
end

local function ensurePlotState(plot)
    plot.PlayerData = plot.PlayerData or {}
    plot.PlayerData.TrailerParts = plot.PlayerData.TrailerParts or plot.TrailerParts or {}
    plot.TrailerParts = plot.PlayerData.TrailerParts
    plot.TrailerCells = plot.TrailerCells or {}
    plot.TrailerModels = plot.TrailerModels or {}
    ensureTrailerFolder(plot)
end

local function resetOccupancy(plot)
    plot.TrailerCells = {}
end

local function addOccupancy(plot, record)
    plot.TrailerCells = plot.TrailerCells or {}
    local levelCells = plot.TrailerCells[record.Level]
    if not levelCells then
        levelCells = {}
        plot.TrailerCells[record.Level] = levelCells
    end
    for x = 0, record.SizeX - 1 do
        for z = 0, record.SizeZ - 1 do
            local key = getCellKey(record.OriginX + x, record.OriginZ + z)
            levelCells[key] = record
        end
    end
end

local function removeOccupancy(plot, record)
    if not plot.TrailerCells or not plot.TrailerCells[record.Level] then
        return
    end
    local levelCells = plot.TrailerCells[record.Level]
    for x = 0, record.SizeX - 1 do
        for z = 0, record.SizeZ - 1 do
            local key = getCellKey(record.OriginX + x, record.OriginZ + z)
            if levelCells[key] == record then
                levelCells[key] = nil
            end
        end
    end
end

local function rebuildOccupancy(plot)
    resetOccupancy(plot)
    for _, record in ipairs(plot.TrailerParts) do
        local def = TrailerPartsConfig[record.PartId]
        if def then
            local rotation = clampRotation(record.Rotation or 0)
            local sizeX, sizeZ = getFootprint(def, rotation)
            record.Rotation = rotation
            record.SizeX = sizeX
            record.SizeZ = sizeZ
            record.Level = CATEGORY_LEVEL[def.Category] or 0
            record.Category = def.Category
            addOccupancy(plot, record)
        end
    end
end

local function finalizeModel(model)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = true
            descendant.CanCollide = true
            descendant.TopSurface = Enum.SurfaceType.Smooth
            descendant.BottomSurface = Enum.SurfaceType.Smooth
        end
    end
end

local builders = {}

local function createBaseModel(def, size, thicknessScale)
    local model = Instance.new("Model")
    model.Name = def.DisplayName or def.Id
    local primary = Instance.new("Part")
    primary.Name = "Segment"
    local thickness = thicknessScale and math.max(0.5, size.Z * thicknessScale) or size.Z
    primary.Size = Vector3.new(size.X, size.Y, thickness)
    primary.Material = def.Material or Enum.Material.Metal
    primary.Color = def.Color or Color3.fromRGB(255, 255, 255)
    primary.Parent = model
    model.PrimaryPart = primary
    finalizeModel(model)
    return model, primary
end

builders.FoundationFloor = function(def, size)
    local model = Instance.new("Model")
    model.Name = def.DisplayName or def.Id
    local base = Instance.new("Part")
    base.Name = "Foundation"
    base.Size = size
    base.Material = def.Material or Enum.Material.Concrete
    base.Color = def.Color or Color3.fromRGB(200, 200, 200)
    base.Parent = model
    model.PrimaryPart = base
    finalizeModel(model)
    return model
end

builders.WallSimple = function(def, size)
    local model, primary = createBaseModel(def, size, 0.35)
    primary.Color = def.Color or Color3.fromRGB(235, 212, 170)
    return model
end

builders.WallWindow = function(def, size)
    local model, primary = createBaseModel(def, size, 0.35)
    primary.Color = def.Color or Color3.fromRGB(220, 220, 235)
    local window = Instance.new("Part")
    window.Name = "Window"
    window.Size = Vector3.new(math.max(2, size.X - 2), math.max(2, size.Y - 2), math.max(0.5, primary.Size.Z * 0.6))
    window.Material = Enum.Material.Glass
    window.Color = def.SecondaryColor or Color3.fromRGB(150, 200, 255)
    window.Transparency = 0.4
    window.Parent = model
    model.PrimaryPart = primary
    finalizeModel(model)
    return model
end

builders.WallDoor = function(def, size)
    local model, primary = createBaseModel(def, size, 0.35)
    primary.Color = def.Color or Color3.fromRGB(240, 220, 180)
    local door = Instance.new("Part")
    door.Name = "Door"
    door.Size = Vector3.new(math.max(2, size.X * 0.35), math.max(3, size.Y - 2), math.max(0.5, primary.Size.Z * 0.9))
    door.Color = def.SecondaryColor or Color3.fromRGB(120, 120, 120)
    door.Material = Enum.Material.Wood
    door.Parent = model
    model.PrimaryPart = primary
    finalizeModel(model)
    return model
end

builders.RoofSimple = function(def, size)
    local model = Instance.new("Model")
    model.Name = def.DisplayName or def.Id
    local wedge = Instance.new("WedgePart")
    wedge.Name = "Roof"
    wedge.Size = size
    wedge.Material = def.Material or Enum.Material.Metal
    wedge.Color = def.Color or Color3.fromRGB(210, 90, 70)
    wedge.Parent = model
    model.PrimaryPart = wedge
    finalizeModel(model)
    return model
end

local function spawnRecordModel(plot, record)
    local def = TrailerPartsConfig[record.PartId]
    if not def then
        return
    end
    local folder = ensureTrailerFolder(plot)
    if not folder then
        return
    end
    local rotation = clampRotation(record.Rotation or 0)
    local cframe, worldSize = computeWorldTransform(plot, record.OriginX, record.OriginZ, def, rotation)
    local builder = builders[def.ModelType]
    if not builder then
        warn("[Paradis] Aucun builder pour", def.ModelType)
        return
    end
    local model = builder(def, worldSize)
    if not model.PrimaryPart then
        return
    end
    model.Parent = folder
    model:PivotTo(cframe)
    model:SetAttribute("TrailerPartId", record.Id)
    for _, descendant in ipairs(model:GetDescendants()) do
        descendant:SetAttribute("TrailerPartId", record.Id)
    end
    plot.TrailerModels[record.Id] = model
end

local function destroyRecordModel(plot, recordId)
    if not plot.TrailerModels then
        return
    end
    local model = plot.TrailerModels[recordId]
    if model then
        model:Destroy()
        plot.TrailerModels[recordId] = nil
    end
end

local function broadcastState(player, plot)
    BuildRemotes.TrailerStateUpdated:FireClient(player, plot.TrailerParts)
end

local function savePlot(plot)
    if not plot.OwnerUserId then
        return
    end
    if DataApi and DataApi.SavePlayerData then
        plot.PlayerData.Objects = plot.PlacedObjects
        plot.PlayerData.TrailerParts = plot.TrailerParts
        DataApi.SavePlayerData(plot.OwnerUserId, plot.PlayerData)
    end
end

local function findRecord(plot, recordId)
    if not plot.TrailerParts then
        return nil
    end
    for index, record in ipairs(plot.TrailerParts) do
        if record.Id == recordId then
            return record, index
        end
    end
    return nil
end

local function validateOverlap(plot, level, originX, originZ, sizeX, sizeZ)
    if not plot.TrailerCells or not plot.TrailerCells[level] then
        return true
    end
    local levelCells = plot.TrailerCells[level]
    for x = 0, sizeX - 1 do
        for z = 0, sizeZ - 1 do
            local key = getCellKey(originX + x, originZ + z)
            if levelCells[key] then
                return false
            end
        end
    end
    return true
end

local function validateSupport(plot, def, level, originX, originZ, sizeX, sizeZ)
    if level == 0 then
        return true
    end
    if not def.CanStackOn or #def.CanStackOn == 0 then
        return false
    end
    local allowed = {}
    for _, category in ipairs(def.CanStackOn) do
        allowed[category] = true
    end
    local below = plot.TrailerCells and plot.TrailerCells[level - 1]
    if not below then
        return false
    end
    for x = 0, sizeX - 1 do
        for z = 0, sizeZ - 1 do
            local key = getCellKey(originX + x, originZ + z)
            local supportRecord = below[key]
            if not supportRecord or not allowed[supportRecord.Category] then
                return false
            end
        end
    end
    return true
end

local function hasDependentsAbove(plot, record)
    if not plot.TrailerCells then
        return false
    end
    local aboveLevel = plot.TrailerCells[record.Level + 1]
    if not aboveLevel then
        return false
    end
    for x = 0, record.SizeX - 1 do
        for z = 0, record.SizeZ - 1 do
            local key = getCellKey(record.OriginX + x, record.OriginZ + z)
            if aboveLevel[key] then
                return true
            end
        end
    end
    return false
end

local function handleTrailerPlacement(player, payload)
    local plot = PlotApi.GetPlotForPlayer(player)
    if not plot then
        return false, "Aucune parcelle"
    end
    ensurePlotState(plot)

    if type(payload) ~= "table" then
        return false, "Requête invalide"
    end

    local partId = payload.PartId
    local def = TrailerPartsConfig[partId]
    if not def then
        return false, "Pièce inconnue"
    end

    local gridPosition = payload.GridPosition
    if type(gridPosition) ~= "table" then
        return false, "Position invalide"
    end
    local originX = math.floor(tonumber(gridPosition.x) or math.huge)
    local originZ = math.floor(tonumber(gridPosition.z) or math.huge)
    if originX == math.huge or originZ == math.huge then
        return false, "Coordonnées invalides"
    end

    local rotation = clampRotation(payload.Rotation or 0)
    local _, _, sizeX, sizeZ, level = computeWorldTransform(plot, originX, originZ, def, rotation)
    local maxX, maxZ = getGridLimits(plot)
    if originX < 0 or originZ < 0 or originX + sizeX > maxX or originZ + sizeZ > maxZ then
        return false, "En dehors de la parcelle"
    end

    if not validateOverlap(plot, level, originX, originZ, sizeX, sizeZ) then
        return false, "Une pièce occupe déjà cet emplacement"
    end
    if not validateSupport(plot, def, level, originX, originZ, sizeX, sizeZ) then
        return false, "Structure insuffisante pour empiler"
    end

    local record = {
        Id = HttpService:GenerateGUID(false),
        PartId = def.Id,
        OriginX = originX,
        OriginZ = originZ,
        Rotation = rotation,
        Level = level,
        SizeX = sizeX,
        SizeZ = sizeZ,
        Category = def.Category,
    }

    table.insert(plot.TrailerParts, record)
    addOccupancy(plot, record)
    spawnRecordModel(plot, record)

    savePlot(plot)
    broadcastState(player, plot)
    return true
end

local function handleTrailerRemoval(player, recordId)
    local plot = PlotApi.GetPlotForPlayer(player)
    if not plot then
        return false, "Aucune parcelle"
    end
    ensurePlotState(plot)

    if type(recordId) ~= "string" or recordId == "" then
        return false, "Id invalide"
    end

    local record, index = findRecord(plot, recordId)
    if not record then
        return false, "Pièce introuvable"
    end

    if hasDependentsAbove(plot, record) then
        return false, "Retirez d'abord les éléments supérieurs"
    end

    removeOccupancy(plot, record)
    destroyRecordModel(plot, record.Id)
    table.remove(plot.TrailerParts, index)

    savePlot(plot)
    broadcastState(player, plot)
    return true
end

function TrailerService.OnPlotClaimed(player, plot, playerData)
    ensurePlotState(plot)
    local folder = ensureTrailerFolder(plot)
    if folder then
        folder:ClearAllChildren()
    end
    plot.TrailerModels = {}
    rebuildOccupancy(plot)
    for _, record in ipairs(plot.TrailerParts) do
        spawnRecordModel(plot, record)
    end
    broadcastState(player, plot)
end

BuildRemotes.TrailerRequestPlacement.OnServerInvoke = function(player, payload)
    return handleTrailerPlacement(player, payload or {})
end

BuildRemotes.TrailerRequestRemove.OnServerInvoke = function(player, recordId)
    return handleTrailerRemoval(player, recordId)
end

shared.ParadisTrailerService = TrailerService
]]></string>
        </Properties>
      </Item>
