      <Item class="Script" referent="29">
        <Properties>
          <string name="Name">BackgroundMusic</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- BackgroundMusic.server.lua
-- Joue une musique d'ambiance dans tout le jeu

local SoundService = game:GetService("SoundService")

-- ====================================
-- CONFIGURATION MUSIQUE
-- ====================================
local MUSIC_PLAYLIST = {
	"rbxassetid://115222151625604", -- Je spawn encore dans mon petit coin de paradis
	"rbxassetid://115905909512113", -- La vie est belle
	"rbxassetid://117790257108974"  -- Chanson roblox
}
local MUSIC_VOLUME = 0.5 -- Volume (0 à 1)
local MUSIC_FADE_TIME = 2 -- Temps de fondu en secondes

-- ====================================
-- CRÉATION DE LA MUSIQUE
-- ====================================

-- Créer le SoundGroup pour la musique (optionnel, pour contrôler le volume global)
local musicGroup = SoundService:FindFirstChild("MusicGroup")
if not musicGroup then
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "MusicGroup"
	musicGroup.Volume = 1
	musicGroup.Parent = SoundService
end

-- Créer le son de fond
local backgroundMusic = Instance.new("Sound")
backgroundMusic.Name = "BackgroundMusic"
backgroundMusic.Volume = 0 -- Commence à 0 pour le fondu
backgroundMusic.SoundGroup = musicGroup
backgroundMusic.Parent = SoundService

local currentTrackIndex = 1

-- Fonction pour jouer une chanson avec fondu
local function playTrackWithFade(trackIndex)
	local assetId = MUSIC_PLAYLIST[trackIndex]
	if not assetId then
		trackIndex = 1
		assetId = MUSIC_PLAYLIST[1]
	end
	
	currentTrackIndex = trackIndex
	backgroundMusic.SoundId = assetId
	backgroundMusic:Play()
	
	-- Fondu d'entrée
	local targetVolume = MUSIC_VOLUME
	local steps = 20
	local stepTime = MUSIC_FADE_TIME / steps
	local volumeIncrement = targetVolume / steps
	
	for i = 1, steps do
		task.wait(stepTime)
		backgroundMusic.Volume = math.min(backgroundMusic.Volume + volumeIncrement, targetVolume)
	end
	
	print(string.format("[BackgroundMusic] Musique démarrée (Piste %d/%d, ID: %s, Volume: %.2f)", 
		currentTrackIndex, #MUSIC_PLAYLIST, assetId, MUSIC_VOLUME))
end

-- Démarrer la première piste
playTrackWithFade(1)

-- Passer à la piste suivante quand une chanson se termine
backgroundMusic.Ended:Connect(function()
	local nextIndex = currentTrackIndex + 1
	if nextIndex > #MUSIC_PLAYLIST then
		nextIndex = 1
	end
	playTrackWithFade(nextIndex)
end)

-- ====================================
-- CONTRÔLE OPTIONNEL (Commandes)
-- ====================================

-- Fonction pour ajuster le volume
local function setMusicVolume(volume)
	backgroundMusic.Volume = math.clamp(volume, 0, 1)
	print(string.format("[BackgroundMusic] Volume ajusté: %.2f", volume))
end

-- Fonction pour mettre en pause/reprendre
local function toggleMusic()
	if backgroundMusic.IsPlaying then
		backgroundMusic:Pause()
		print("[BackgroundMusic] Musique en pause")
	else
		backgroundMusic:Resume()
		print("[BackgroundMusic] Musique reprise")
	end
end

-- Exposer les fonctions globalement (optionnel, pour debug)
_G.SetMusicVolume = setMusicVolume
_G.ToggleMusic = toggleMusic

print("[BackgroundMusic] Service initialisé - Commandes disponibles: _G.SetMusicVolume(0.5), _G.ToggleMusic()")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="30">
        <Properties>
          <string name="Name">CampingDetailsService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    CampingDetailsService.server.lua
    Service serveur qui fournit les détails du camping aux clients
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")

-- Attendre les services nécessaires
local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local PlayerProgressService = waitForShared("PlayerProgressService")
local EconomyService = waitForShared("ParadisEconomyService")
local PlotService = waitForShared("ParadisPlotService")
local CampingProgressionService = waitForShared("ParadisCampingProgressionService")

local CampingItemsConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("CampingItemsConfig"))
local CampingDetailsRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CampingDetailsRemotes"))

local CampingDetailsService = {}

-- Helper: Obtenir le nom d'achievement en français
local function getAchievementName(achievementId)
    local names = {
        CaughtRareFish = "Pêcher un poisson rare",
        CaughtLegendaryFish = "Pêcher un poisson légendaire",
        CompletedMaze = "Terminer le labyrinthe",
        CompletedSwingLoops = "Faire 10 tours de balançoire",
        WoodMaster = "Couper 100 bûches",
    }
    return names[achievementId] or achievementId
end

-- Helper: Calculer l'income total du joueur
local function calculateTotalIncome(player)
    local ownedItems = PlayerProgressService.GetAllOwnedItems(player)
    if not ownedItems then
        warn("[CampingDetailsService] ⚠️ OwnedItems nil pour", player.Name)
        return 0
    end
    
    local totalIncome = 0
    
    for category, itemId in pairs(ownedItems) do
        local itemData = CampingItemsConfig.Items[itemId]
        if itemData and itemData.BaseIncome then
            totalIncome = totalIncome + itemData.BaseIncome
            print(string.format("[CampingDetailsService] 💵 %s - %s: +%d$/tick", player.Name, itemData.DisplayName, itemData.BaseIncome))
        end
    end
    
    print(string.format("[CampingDetailsService] 💰 Revenu total de %s: %d$/tick", player.Name, totalIncome))
    return totalIncome
end

-- Helper: Obtenir tous les upgrades possibles pour un joueur
local function getAvailableUpgrades(player)
    local ownedItems = PlayerProgressService.GetAllOwnedItems(player)
    local upgrades = {}
    
    -- Parcourir toutes les catégories
    for category, _ in pairs(CampingItemsConfig.Categories) do
        local currentItemId = ownedItems[category]
        local currentLevel = 0
        
        -- Trouver le niveau actuel
        if currentItemId then
            local currentItem = CampingItemsConfig.Items[currentItemId]
            if currentItem then
                currentLevel = currentItem.Level
            end
        end
        
        -- Chercher le prochain niveau
        local nextLevel = currentLevel + 1
        local nextItemId = nil
        
        -- Trouver l'item du prochain niveau dans cette catégorie
        for itemId, itemData in pairs(CampingItemsConfig.Items) do
            if itemData.Category == category and itemData.Level == nextLevel then
                nextItemId = itemId
                break
            end
        end
        
        if nextItemId then
            local nextItem = CampingItemsConfig.Items[nextItemId]
            if nextItem then
                -- Vérifier les prérequis
                local cash = EconomyService.GetCash and EconomyService.GetCash(player) or 0
                local hasEnoughCash = cash >= nextItem.Cost
                local hasMinCash = cash >= nextItem.Prerequisites.MinCash
                
                local missingAchievements = {}
                local hasAllAchievements = true
                
                for _, achievementId in ipairs(nextItem.Prerequisites.Achievements or {}) do
                    if not PlayerProgressService.HasAchievement(player, achievementId) then
                        hasAllAchievements = false
                        table.insert(missingAchievements, {
                            Id = achievementId,
                            Name = getAchievementName(achievementId),
                            Completed = false,
                        })
                    else
                        table.insert(missingAchievements, {
                            Id = achievementId,
                            Name = getAchievementName(achievementId),
                            Completed = true,
                        })
                    end
                end
                
                table.insert(upgrades, {
                    ItemId = nextItemId,
                    Category = category,
                    Level = nextLevel,
                    DisplayName = nextItem.DisplayName,
                    Cost = nextItem.Cost,
                    Income = nextItem.BaseIncome,
                    CanAfford = hasEnoughCash,
                    HasMinCash = hasMinCash,
                    HasAllAchievements = hasAllAchievements,
                    Achievements = missingAchievements,
                })
            end
        end
    end
    
    return upgrades
end

-- Fonction principale : Obtenir les détails du camping pour un joueur
function CampingDetailsService.GetCampingDetails(player)
    print("[CampingDetailsService] 📋 GetCampingDetails appelé pour", player.Name)
    
    if not player or not player:IsA("Player") then
        warn("[CampingDetailsService] ❌ Joueur invalide")
        return nil
    end
    
    local plot = PlotService.GetPlotForPlayer(player)
    if not plot then
        warn("[CampingDetailsService] ❌ Parcelle introuvable pour", player.Name)
        -- Retourner des données par défaut au lieu de nil
        return {
            PlayerName = player.Name,
            PlotId = "None",
            Cash = 0,
            TotalIncome = 0,
            OwnedItems = {},
            AvailableUpgrades = {},
        }
    end
    
    print("[CampingDetailsService] ✅ Parcelle trouvée:", plot.Id, "pour", player.Name)
    
    local ownedItems = PlayerProgressService.GetAllOwnedItems(player)
    if not ownedItems then
        warn("[CampingDetailsService] ❌ OwnedItems nil pour", player.Name)
        ownedItems = {}
    end
    
    local totalIncome = calculateTotalIncome(player)
    local cash = EconomyService.GetCash and EconomyService.GetCash(player) or 0
    
    -- Construire la liste des objets possédés avec détails
    local ownedItemsDetails = {}
    for category, itemId in pairs(ownedItems) do
        local itemData = CampingItemsConfig.Items[itemId]
        if itemData then
            table.insert(ownedItemsDetails, {
                Category = category,
                ItemId = itemId,
                Level = itemData.Level,
                DisplayName = itemData.DisplayName,
                Income = itemData.BaseIncome,
            })
        end
    end
    
    -- Obtenir les upgrades disponibles
    local availableUpgrades = getAvailableUpgrades(player)
    
    local result = {
        PlayerName = player.Name,
        PlotId = plot.Id,
        Cash = cash,
        TotalIncome = totalIncome,
        OwnedItems = ownedItemsDetails,
        AvailableUpgrades = availableUpgrades,
    }
    
    print(string.format("[CampingDetailsService] 📊 Détails envoyés à %s: %d objets, %d upgrades disponibles, %d$ cash, +%d$/tick", 
        player.Name, #ownedItemsDetails, #availableUpgrades, cash, totalIncome))
    
    return result
end

-- Initialiser le RemoteFunction
CampingDetailsRemotes.GetCampingDetails.OnServerInvoke = function(player)
    return CampingDetailsService.GetCampingDetails(player)
end

-- Initialiser le RemoteEvent pour les achats
CampingDetailsRemotes.RequestPurchaseItem.OnServerEvent:Connect(function(player, itemId)
    if not itemId then
        warn("[CampingDetailsService] RequestPurchaseItem reçu sans itemId")
        return
    end
    
    -- Appeler le service de progression pour l'achat
    local success, message = CampingProgressionService.PurchaseItem(player, itemId)
    
    if success then
        print(string.format("[CampingDetailsService] ✅ %s a acheté %s", player.Name, itemId))
        
        -- Notifier le client pour rafraîchir la GUI
        CampingDetailsRemotes.CampingDetailsUpdated:FireClient(player)
    else
        warn(string.format("[CampingDetailsService] ❌ Échec achat pour %s: %s", player.Name, message or "Erreur inconnue"))
        
        -- Optionnel : envoyer l'erreur au client (pourrait être ajouté plus tard)
        -- Pour l'instant le client va simplement rafraîchir et voir que rien n'a changé
        CampingDetailsRemotes.CampingDetailsUpdated:FireClient(player)
    end
end)

-- Exposer le service
shared.ParadisCampingDetailsService = CampingDetailsService

print("[CampingDetailsService] ✅ Service initialisé")

return CampingDetailsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">CampingProgressionService</string>
          <string name="Source"><![CDATA[--[[
    CampingProgressionService.lua
    Gère les achats/upgrades d'objets de camping et l'income automatique
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local RunService = game:GetService("RunService")

-- Attendre les services nécessaires
local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local PlayerProgressService = waitForShared("PlayerProgressService")
local EconomyService = shared.ParadisEconomyService or waitForShared("ParadisEconomyService")
local PlotService = shared.ParadisPlotService or waitForShared("ParadisPlotService")

local CampingItemsConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("CampingItemsConfig"))

-- Remotes
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local campingProgressionRemote = remotesFolder:FindFirstChild("CampingProgressionRemote")
if not campingProgressionRemote then
    campingProgressionRemote = Instance.new("RemoteEvent")
    campingProgressionRemote.Name = "CampingProgressionRemote"
    campingProgressionRemote.Parent = remotesFolder
end

local CampingProgressionService = {}

-- ============ INITIALISATION DES OBJETS DE DÉPART ============

function CampingProgressionService.InitializePlayerObjects(player)
    print("[CampingProgression] 🔄 Début initialisation pour", player.Name)
    
    -- Attendre que le joueur ait une parcelle
    local plot = PlotService.GetPlotForPlayer(player)
    if not plot then
        print("[CampingProgression] ⏳ Attente de la parcelle pour", player.Name)
        task.wait(1)
        plot = PlotService.GetPlotForPlayer(player)
        if not plot then
            warn("[CampingProgression] ❌ Parcelle introuvable pour", player.Name)
            return
        end
    end
    
    print("[CampingProgression] ✓ Parcelle trouvée:", plot.Id, "pour", player.Name)
    
    -- Récupérer tous les objets possédés
    local ownedItems = PlayerProgressService.GetAllOwnedItems(player)
    if not ownedItems then
        warn("[CampingProgression] ❌ OwnedItems introuvable pour", player.Name)
        return
    end
    
    print("[CampingProgression] ✓ OwnedItems récupérés:", #ownedItems, "objets pour", player.Name)
    print("[CampingProgression] 🏭 Initialisation des objets pour", player.Name)
    
    -- Placer chaque objet possédé
    local placedCount = 0
    for category, itemId in pairs(ownedItems) do
        print("[CampingProgression] 📦 Tentative placement:", itemId, "dans catégorie", category)
        local itemData = CampingItemsConfig.Items[itemId]
        if itemData then
            local success = updateItemOnPlot(player, itemData)
            if success then
                placedCount = placedCount + 1
                print("[CampingProgression] ✅", itemData.DisplayName, "placé pour", player.Name)
            else
                warn("[CampingProgression] ⚠️ Échec placement de", itemData.DisplayName)
            end
        else
            warn("[CampingProgression] ❌ ItemData introuvable pour", itemId)
        end
    end
    
    print(string.format("[CampingProgression] ✅ Objets initialisés pour %s: %d/%d placés", player.Name, placedCount, #ownedItems))
end

-- ============ VÉRIFICATIONS ============

local function canAffordItem(player, itemData)
    local cash = EconomyService.GetCash and EconomyService.GetCash(player) or 0
    return cash >= itemData.Cost
end

local function hasAllAchievements(player, requiredAchievements)
    for _, achievementId in ipairs(requiredAchievements) do
        if not PlayerProgressService.HasAchievement(player, achievementId) then
            return false, achievementId
        end
    end
    return true
end

local function meetsPrerequisites(player, itemData)
    -- Vérifier le cash minimum
    local cash = EconomyService.GetCash and EconomyService.GetCash(player) or 0
    if cash < itemData.Prerequisites.MinCash then
        return false, string.format("Argent minimum requis: %d$", itemData.Prerequisites.MinCash)
    end
    
    -- Vérifier les achievements
    local hasAchievements, missingAchievement = hasAllAchievements(player, itemData.Prerequisites.Achievements)
    if not hasAchievements then
        return false, string.format("Achievement requis: %s", missingAchievement or "inconnu")
    end
    
    return true
end

-- ============ PLACEMENT VISUEL ============

local function getPlaceholderModel(itemData)
    local model = Instance.new("Model")
    model.Name = itemData.Id .. "_Placeholder"
    
    local part = Instance.new("Part")
    part.Name = "Root"
    part.Size = Vector3.new(4, 4, 4)
    part.Color = Color3.fromRGB(150, 150, 150)
    part.Material = Enum.Material.SmoothPlastic
    part.Anchored = true
    part.CanCollide = true
    part.Parent = model
    
    -- BillboardGui avec le nom
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = part
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = itemData.DisplayName
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard
    
    model.PrimaryPart = part
    return model
end

local function getModelForItem(itemData)
    -- Chercher d'abord dans AmenagementCamping (priorité)
    local amenagementCamping = ReplicatedStorage:FindFirstChild("AmenagementCamping")
    if amenagementCamping then
        local model = amenagementCamping:FindFirstChild(itemData.ModelName)
        if model and model:IsA("Model") then
            print("[CampingProgression] ✓ Modèle trouvé:", itemData.ModelName, "dans AmenagementCamping")
            return model:Clone()
        end
    end
    
    -- Fallback: chercher dans ConstructionObjet
    local constructionObjet = ReplicatedStorage:FindFirstChild("ConstructionObjet")
    if constructionObjet then
        local model = constructionObjet:FindFirstChild(itemData.ModelName)
        if model and model:IsA("Model") then
            print("[CampingProgression] ✓ Modèle trouvé:", itemData.ModelName, "dans ConstructionObjet")
            return model:Clone()
        end
    end
    
    -- Fallback: créer un placeholder
    warn(string.format("[CampingProgression] ⚠️ Modèle introuvable: %s, utilisation placeholder", itemData.ModelName))
    return getPlaceholderModel(itemData)
end

local function updateItemOnPlot(player, itemData)
    local plot = PlotService.GetPlotForPlayer(player)
    if not plot then
        warn("[CampingProgression] Parcelle introuvable pour", player.Name)
        return false
    end
    
    local container = plot.Container
    if not container then
        warn("[CampingProgression] Container introuvable pour parcelle", plot.Id)
        return false
    end
    
    -- Trouver le dossier CampsiteObjects (créé par CampsiteDefaultsService)
    local campsiteObjects = container:FindFirstChild("CampsiteObjects")
    if not campsiteObjects then
        warn("[CampingProgression] CampsiteObjects introuvable, création...")
        campsiteObjects = Instance.new("Folder")
        campsiteObjects.Name = "CampsiteObjects"
        campsiteObjects.Parent = container
    end
    
    -- Déterminer la position du slot
    local category = itemData.Category
    local categoryInfo = CampingItemsConfig.Categories[category]
    if not categoryInfo then
        warn("[CampingProgression] Catégorie inconnue:", category)
        return false
    end
    
    -- Supprimer l'ancien objet de cette catégorie
    for _, child in ipairs(campsiteObjects:GetChildren()) do
        if child:GetAttribute("CampsiteObjectId") == category then
            child:Destroy()
        end
    end
    
    -- Créer le nouveau modèle
    local model = getModelForItem(itemData)
    if not model then
        return false
    end
    
    -- Positionner sur la parcelle
    local rootPart = plot.BasePart
    if not rootPart then
        warn("[CampingProgression] BasePart introuvable pour parcelle", plot.Id)
        return false
    end
    
    local offset = categoryInfo.DefaultOffset
    local targetCFrame = rootPart.CFrame * offset
    
    -- Ancrer toutes les parts
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored = true
            desc.CanCollide = true
        end
    end
    
    -- Positionner le modèle
    if model.PrimaryPart then
        model:SetPrimaryPartCFrame(targetCFrame)
    else
        model:MoveTo(targetCFrame.Position)
    end
    
    -- Ajouter des attributs
    model:SetAttribute("CampsiteObjectId", category)
    model:SetAttribute("ItemId", itemData.Id)
    model:SetAttribute("ItemLevel", itemData.Level)
    model:SetAttribute("IsDefaultCampsiteObject", true)
    model:SetAttribute("IsLocked", false) -- Déverrouillé car possédé par le joueur
    model:SetAttribute("OwnerUserId", player.UserId)
    
    model.Parent = campsiteObjects
    
    print(string.format("[CampingProgression] ✅ Objet placé: %s pour %s", itemData.DisplayName, player.Name))
    return true
end

-- ============ ACHAT/UPGRADE ============

function CampingProgressionService.PurchaseItem(player, itemId)
    local itemData = CampingItemsConfig.GetItem(itemId)
    if not itemData then
        return false, "Objet inconnu"
    end
    
    -- Vérifier les prérequis
    local meetsPrerequis, prereqMessage = meetsPrerequisites(player, itemData)
    if not meetsPrerequis then
        return false, prereqMessage
    end
    
    -- Vérifier l'upgrade cohérent (doit posséder le niveau précédent)
    local currentItemId = PlayerProgressService.GetOwnedItem(player, itemData.Category)
    if itemData.Level > 1 then
        if not currentItemId then
            return false, "Vous devez d'abord acheter le niveau 1"
        end
        
        local currentItem = CampingItemsConfig.GetItem(currentItemId)
        if not currentItem or currentItem.Level ~= itemData.Level - 1 then
            return false, string.format("Vous devez d'abord avoir le niveau %d", itemData.Level - 1)
        end
    end
    
    -- Vérifier le cash
    if not canAffordItem(player, itemData) then
        return false, string.format("Pas assez d'argent (%d$ requis)", itemData.Cost)
    end
    
    -- Retirer le cash
    if EconomyService.AddCash then
        EconomyService.AddCash(player, -itemData.Cost)
    end
    
    -- Mettre à jour l'objet possédé
    PlayerProgressService.SetOwnedItem(player, itemData.Category, itemData.Id)
    
    -- Placer visuellement sur la parcelle
    updateItemOnPlot(player, itemData)
    
    print(string.format("[CampingProgression] ✅ %s a acheté: %s (-%d$)", player.Name, itemData.DisplayName, itemData.Cost))
    return true, string.format("Acheté: %s", itemData.DisplayName)
end

-- ============ REMOTE EVENT HANDLER ============

campingProgressionRemote.OnServerEvent:Connect(function(player, action, ...)
    if action == "PurchaseItem" then
        local itemId = ...
        local success, message = CampingProgressionService.PurchaseItem(player, itemId)
        
        -- Renvoyer le résultat au client (via autre remote si nécessaire)
        if success then
            print(string.format("[CampingProgression] ✅ Achat réussi pour %s", player.Name))
        else
            warn(string.format("[CampingProgression] ❌ Achat échoué pour %s: %s", player.Name, message))
        end
    end
end)

-- ============ VÉRIFICATION FEU DE CAMP ============

local function isCampfireActive()
    -- Chercher le feu de camp dans Workspace
    local campfire = game.Workspace:FindFirstChild("Campfire")
    if not campfire then
        return false -- Pas de feu = pas de revenu
    end
    
    local fireLevel = campfire:FindFirstChild("FireLevel")
    if not fireLevel or not fireLevel:IsA("NumberValue") then
        return false
    end
    
    -- Le feu est actif si le niveau est > 10 (seuil critique)
    return fireLevel.Value > 10
end

-- ============ INCOME AUTOMATIQUE ============

local INCOME_TICK_INTERVAL = 5 -- secondes entre chaque tick d'income

task.spawn(function()
    print("[CampingProgression] 🔥 Boucle de revenu TIC démarrée (intervalle:", INCOME_TICK_INTERVAL, "secondes)")
    while true do
        task.wait(INCOME_TICK_INTERVAL)
        
        -- Vérifier l'état du feu AVANT de distribuer les revenus
        local fireActive = isCampfireActive()
        print("[CampingProgression] 💰 Tick de revenu - Feu actif:", fireActive)
        
        for _, player in ipairs(Players:GetPlayers()) do
            local income = PlayerProgressService.GetTotalIncomePerTick(player)
            if income > 0 then
                if fireActive then
                    -- Feu actif → donner le revenu
                    if EconomyService.AddCash then
                        EconomyService.AddCash(player, income)
                        print(string.format("[CampingProgression] ✅ %s reçoit %d$ (revenu TIC)", player.Name, income))
                        
                        -- Notifier le client via RemoteEvent
                        local economyRemotes = remotesFolder:FindFirstChild("EconomyRemotes")
                        if economyRemotes then
                            local grantIncome = economyRemotes:FindFirstChild("GrantIncome")
                            if grantIncome and grantIncome:IsA("RemoteEvent") then
                                grantIncome:FireClient(player, income)
                            end
                        end
                    end
                else
                    -- Feu éteint → notifier le joueur
                    print(string.format("[CampingProgression] ⚠️ Feu éteint! Pas de revenu pour %s", player.Name))
                end
            end
        end
    end
end)

-- ============ INITIALISATION DES JOUEURS ============

-- Initialiser les objets pour les joueurs qui rejoignent
Players.PlayerAdded:Connect(function(player)
    -- Attendre que le joueur ait une parcelle (PlotService s'en occupe)
    task.spawn(function()
        -- Attendre un peu que PlotService attribue la parcelle
        task.wait(2)
        CampingProgressionService.InitializePlayerObjects(player)
    end)
end)

-- Initialiser pour les joueurs déjà présents
for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(function()
        task.wait(2)
        CampingProgressionService.InitializePlayerObjects(player)
    end)
end

print("[CampingProgression] ✅ Service initialisé - Income tick:", INCOME_TICK_INTERVAL, "secondes")

shared.CampingProgressionService = CampingProgressionService
return CampingProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">CampingWorldGenerator</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local CampLayoutConfig = require(ConfigFolder:WaitForChild("CampLayoutConfig"))
local MiniGamesConfig = require(ConfigFolder:WaitForChild("MiniGamesConfig"))

local CampingWorldGenerator = {}

local worldFolders = {}
local roadsByName = {}
local generatedPlots = {}
local hasGenerated = false
local transform = CampLayoutConfig.Transform or {}
local offset = transform.Offset

local function applyPosition(vec)
    if not vec then
        return vec
    end
    local x, y, z = vec.X, vec.Y, vec.Z
    if transform.MirrorX then
        x = -x
    end
    if offset then
        x += offset.X or 0
        y += offset.Y or 0
        z += offset.Z or 0
    end
    return Vector3.new(x, y, z)
end

local function getOrCreateWorkspaceFolder(name)
    if worldFolders[name] then
        return worldFolders[name]
    end
    local folder = Workspace:FindFirstChild(name)
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = Workspace
    end
    folder:ClearAllChildren()
    worldFolders[name] = folder
    return folder
end

local function createGround()
    local cfg = CampLayoutConfig.Ground
    if not cfg then
        return
    end
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local part = Instance.new("Part")
    part.Name = "Ground"
    part.Anchored = true
    part.Size = cfg.Size or Vector3.new(400, 1, 400)
    part.Position = applyPosition(cfg.Position or Vector3.new())
    part.Material = cfg.Material or Enum.Material.Grass
    part.Color = cfg.Color or Color3.fromRGB(90, 170, 90)
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    print("[Paradis][CampingWorldGenerator] Sol posé.")
end

local function createSurroundingWater()
    local cfg = CampLayoutConfig.SurroundingWater
    if not cfg then
        return
    end
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local part = Instance.new("Part")
    part.Name = "IslandWater"
    part.Anchored = true
    part.Size = cfg.Size or Vector3.new(1200, 2, 900)
    part.Position = applyPosition(cfg.Position or Vector3.new())
    part.Material = cfg.Material or Enum.Material.Water
    part.Color = cfg.Color or Color3.fromRGB(40, 130, 170)
    part.Transparency = cfg.Transparency or 0.2
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    print("[Paradis][CampingWorldGenerator] Eaux périphériques posées.")
end

local function createLake()
    local cfg = CampLayoutConfig.Lake
    if not cfg then
        return
    end
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local part = Instance.new("Part")
    part.Name = "Lake"
    part.Anchored = true
    part.Size = cfg.Size or Vector3.new(200, 2, 100)
    part.Position = applyPosition(cfg.Position or Vector3.new(0, 0.5, 0))
    part.Material = cfg.Material or Enum.Material.Water
    part.Color = cfg.Color or Color3.fromRGB(20, 120, 150)
    part.Transparency = cfg.Transparency or 0.1
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = folder
    print("[Paradis][CampingWorldGenerator] Lac créé.")
end

local function createFishingSpots()
    local fishingCfg = MiniGamesConfig and MiniGamesConfig.FishingGame
    if not fishingCfg then
        return
    end

    local fishingFolder = getOrCreateWorkspaceFolder("FishingArea")
    for _, spotCfg in ipairs(fishingCfg.Spots or {}) do
        local spot = Instance.new("Part")
        spot.Name = spotCfg.Name or "FishingSpot"
        spot.Anchored = true
        spot.Size = Vector3.new(4, 1, 4)
        spot.Position = applyPosition(spotCfg.Position)
        spot.Material = Enum.Material.WoodPlanks
        spot.Color = Color3.fromRGB(180, 140, 90)
        spot.Parent = fishingFolder

        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "FishPrompt"
        prompt.ObjectText = "Jeu de pêche"
        prompt.ActionText = "Pêcher"
        prompt.MaxActivationDistance = 10
        prompt.Parent = spot
    end

    print(string.format("[Paradis][World] Spots de pêche générés : %d", #fishingCfg.Spots))
end

local function buildRoadSegments(roadCfg)
        local rawPoints = roadCfg.Points or {}
        local points = table.create(#rawPoints)
        for i, point in ipairs(rawPoints) do
		points[i] = applyPosition(point)
        end
    local totalLength = 0
    local segments = {}
    local roadsFolder = getOrCreateWorkspaceFolder("Roads")
    for i = 1, #points - 1 do
        local a = points[i]
        local b = points[i + 1]
        local delta = b - a
        local length = delta.Magnitude
        if length > 1 then
            local forward = delta.Unit
            local right = Vector3.new(forward.Z, 0, -forward.X)
            if right.Magnitude < 1e-3 then
                right = Vector3.new(-forward.Y, forward.X, 0)
            end
            right = right.Unit

            local segmentPart = Instance.new("Part")
            segmentPart.Name = string.format("%s_%02d", roadCfg.Name or "Road", i)
            segmentPart.Anchored = true
            segmentPart.Material = Enum.Material.Asphalt
            segmentPart.Color = Color3.fromRGB(35, 35, 35)
            segmentPart.Size = Vector3.new(roadCfg.Width or 8, 1, length)
            segmentPart.CFrame = CFrame.lookAt(a + delta / 2, a + delta / 2 + forward)
            segmentPart.Parent = roadsFolder

            table.insert(segments, {
                StartPoint = a,
                Length = length,
                Direction = forward,
                Right = right,
                Accumulated = totalLength,
                EndPoint = b,
            })
            totalLength += length
        end
    end

    roadsByName[roadCfg.Name] = {
        Name = roadCfg.Name,
        Width = roadCfg.Width or 8,
        Segments = segments,
        TotalLength = totalLength,
        PointCount = #points,
    }
end

local function createRoads()
    roadsByName = {}
    local polylines = CampLayoutConfig.RoadPolylines or {}
    for _, roadCfg in ipairs(polylines) do
        buildRoadSegments(roadCfg)
    end
    print(string.format("[Paradis][CampingWorldGenerator] %d routes générées.", #polylines))
end

local function getDistanceForPointIndex(road, index)
    if not road or not road.PointCount then
        return 0
    end
    local clamped = math.clamp(index, 1, road.PointCount)
    local dist = 0
    for segIndex = 1, math.max(0, clamped - 1) do
        local seg = road.Segments[segIndex]
        if not seg then
            break
        end
        dist += seg.Length
    end
    return dist
end

local function getPointAlong(road, distance)
    if not road then
        return Vector3.new(), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
    end
    local target = math.clamp(distance, 0, road.TotalLength)
    for _, segment in ipairs(road.Segments) do
        if target <= segment.Length then
            local point = segment.StartPoint + segment.Direction * target
            return point, segment.Direction, segment.Right
        else
            target -= segment.Length
        end
    end
    local lastSegment = road.Segments[#road.Segments]
    if lastSegment then
        return lastSegment.EndPoint, lastSegment.Direction, lastSegment.Right
    end
    return Vector3.new(), Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
end

local function resolveIndex(pointCount, indexValue, default)
    if not indexValue then
        return default
    end
    local result = indexValue
    if indexValue < 0 then
        result = pointCount + indexValue
    end
    return math.clamp(result, 1, pointCount)
end

local function getSideMultipliers(side)
    if side == "Both" then
        return { -1, 1 }
    elseif side == "Left" or side == "Lake" then
        return { -1 }
    elseif side == "Right" or side == "Inside" then
        return { 1 }
    else
        return { 1 }
    end
end

local function createPlotPart(plotFolder, center, forward, right, band, plotIndex, sideTag)
    local appearance = CampLayoutConfig.PlotAppearance or {}
    local size = band.PlotSize or Vector2.new(12, 8)
    local thickness = appearance.Thickness or 0.6
    local base = Instance.new("Part")
    base.Anchored = true
    base.Name = string.format("Plot_%s_%s_%02d", band.RoadName, sideTag or "Side", plotIndex)
    base.Size = Vector3.new(size.X, thickness, size.Y)
    base.Material = appearance.Material or Enum.Material.Grass
    base.Color = appearance.Color or Color3.fromRGB(92, 180, 115)
    base.CFrame = CFrame.fromMatrix(center + Vector3.new(0, thickness / 2, 0), forward.Unit, Vector3.new(0, 1, 0), -right.Unit)
    base.Parent = plotFolder

    local border = Instance.new("SelectionBox")
    border.Name = "PlotBorder"
    border.LineThickness = 0.03
    border.Color3 = appearance.BorderColor or Color3.fromRGB(240, 210, 120)
    border.Adornee = base
    border.Parent = base

    -- Pancartes désactivées (signPost et signBoard commentés)
    --[[
    local signPost = Instance.new("Part")
    signPost.Name = base.Name .. "_Post"
    signPost.Anchored = true
    signPost.Size = Vector3.new(0.8, 6, 0.8)
    signPost.Material = Enum.Material.WoodPlanks
    signPost.Color = appearance.SignPostColor or Color3.fromRGB(170, 120, 70)
    local outward = right.Unit
    signPost.CFrame = CFrame.new(center - outward * (size.Y / 2 + 2) + Vector3.new(0, 3, 0))
    signPost.Parent = plotFolder

    local signBoard = Instance.new("Part")
    signBoard.Name = base.Name .. "_Sign"
    signBoard.Anchored = true
    signBoard.Size = Vector3.new(4.5, 2.4, 0.4)
    signBoard.Material = Enum.Material.Wood
    signBoard.Color = appearance.SignBoardColor or Color3.fromRGB(120, 80, 40)
    signBoard.CFrame = signPost.CFrame * CFrame.new(0, 1, -1.2)
    signBoard.Parent = plotFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "PlotBillboard"
    billboard.Size = UDim2.new(0, 200, 0, 60)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 1.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = signBoard

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = "Parcelle libre"
    label.TextColor3 = Color3.fromRGB(220, 255, 200)
    label.Parent = billboard
    ]]

    return base, size
end

local function createPlots()
    table.clear(generatedPlots)
    local plotsFolder = getOrCreateWorkspaceFolder("CampingPlots")
    local total = 0

    for _, band in ipairs(CampLayoutConfig.PlotBands or {}) do
        local road = roadsByName[band.RoadName]
        if road and road.TotalLength > 0 then
            local startIndex = resolveIndex(road.PointCount, band.StartIndex or 1, 1)
            local endIndex = resolveIndex(road.PointCount, band.EndIndex or road.PointCount, road.PointCount)
            local startDistance = getDistanceForPointIndex(road, startIndex) + (band.StartOffset or 0)
            local endDistance = getDistanceForPointIndex(road, endIndex)
            endDistance = math.max(endDistance - (band.EndOffset or 0), startDistance + 10)

            local usableLength = math.max(0, endDistance - startDistance)
            local iterationCount = math.max(0, band.PairCount or band.PlotCount or 0)
            if iterationCount > 0 and usableLength > 5 then
                local spacing = band.SpacingAlongRoad or ((band.PlotSize and band.PlotSize.X) or 12) + 4
                spacing = math.max(10, math.min(spacing, usableLength / iterationCount))
                local offset = startDistance + spacing * 0.5
                local sides = getSideMultipliers(band.Side)
                local depth = (band.PlotSize and band.PlotSize.Y) or 8

                for i = 1, iterationCount do
                    local distance = offset + (i - 1) * spacing
                    if distance > endDistance then
                        break
                    end
                    for _, sideMultiplier in ipairs(sides) do
                        local point, forward, right = getPointAlong(road, distance)
                        local outward = right.Unit * sideMultiplier
                        local center = point + outward * ((band.OffsetFromRoad or 8) + depth / 2)
                        local base, footprintSize = createPlotPart(plotsFolder, center, forward, outward, band, i, sideMultiplier > 0 and "Right" or "Left")
                        table.insert(generatedPlots, {
                            Id = base.Name,
                            Center = center,
                            Forward = forward,
                            Right = outward,
                            BasePart = base,
                            FootprintCFrame = base.CFrame,
                            Size = Vector2.new(footprintSize.X, footprintSize.Y),
                            Band = band.RoadName,
                        })
                        total += 1
                    end
                end
            end
        else
            warn(string.format("[Paradis][CampingWorldGenerator] Route '%s' introuvable pour bande de parcelles.", tostring(band.RoadName)))
        end
    end

    print(string.format("[Paradis][CampingWorldGenerator] %d parcelles créées.", total))
end

local function createSpawn()
    local cfg = CampLayoutConfig.Spawn or {}
    local folder = getOrCreateWorkspaceFolder("CampingTerrain")
    local spawn = Instance.new("SpawnLocation")
    spawn.Name = "CampingSpawn"
    spawn.Anchored = true
    spawn.Size = cfg.Size or Vector3.new(8, 1, 8)
    spawn.Position = applyPosition(cfg.Position or Vector3.new(0, 3, 0))
    spawn.Orientation = cfg.Orientation or Vector3.new()
    spawn.Transparency = 0.2
    spawn.Neutral = true
    spawn.Parent = folder
end

function CampingWorldGenerator.GetGeneratedPlots()
    if not hasGenerated then
        CampingWorldGenerator.Generate()
    end
    return generatedPlots
end

function CampingWorldGenerator.Generate()
    if hasGenerated then
        return generatedPlots
    end

    print("[Paradis][CampingWorldGenerator] Génération du camping Soleil Levant...")
    local baseplate = Workspace:FindFirstChild("Baseplate")
    if baseplate then
        baseplate:Destroy()
    end
    createSurroundingWater()
    createGround()
    createLake()
    createRoads()
    createPlots()
    createSpawn()
    -- createFishingSpots() -- Désactivé : spots de pêche placés manuellement
    hasGenerated = true
    print("[Paradis][CampingWorldGenerator] Génération terminée.")
    return generatedPlots
end

return CampingWorldGenerator
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="33">
        <Properties>
          <string name="Name">CampsiteDefaultsService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    CampsiteDefaultsService
    Service qui génère automatiquement le kit de camping par défaut sur les parcelles
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CampsiteDefaultsConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("CampsiteDefaultsConfig"))
local CampsiteDefaultsService = {}

-- Cache du dossier de construction
local constructionFolder = nil

local function getConstructionFolder()
    if constructionFolder and constructionFolder.Parent then
        return constructionFolder
    end
    local folder = ReplicatedStorage:FindFirstChild("ConstructionObjet")
        or ReplicatedStorage:FindFirstChild("Construction Objet")
    if not folder then
        warn("[Paradis][CampsiteDefaults] Dossier 'ConstructionObjet' introuvable")
    end
    constructionFolder = folder
    return constructionFolder
end

-- Crée un placeholder simple si le modèle n'existe pas
local function createPlaceholder(def)
    local size = CampsiteDefaultsConfig.PlaceholderSizes[def.Id] or Vector3.new(4, 2, 4)
    local color = CampsiteDefaultsConfig.PlaceholderColors[def.Id] or Color3.fromRGB(150, 150, 150)
    local material = CampsiteDefaultsConfig.PlaceholderMaterials[def.Id] or Enum.Material.SmoothPlastic
    
    local model = Instance.new("Model")
    model.Name = def.Id
    
    local part = Instance.new("Part")
    part.Name = "Base"
    part.Size = size
    part.Anchored = true
    part.CanCollide = true
    part.Color = color
    part.Material = material
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = model
    
    model.PrimaryPart = part
    
    return model
end

-- Fonction principale : génère le kit de camping pour une parcelle
function CampsiteDefaultsService.SpawnDefaultCampsiteForPlot(plotModel, ownerPlayer)
    if not plotModel then
        warn("[Paradis][CampsiteDefaults] PlotModel nil")
        return false
    end
    
    print("[Paradis][CampsiteDefaults] Génération du kit de camping pour", plotModel.Name)
    
    -- 1) Trouver le centre/root de la parcelle
    local rootPart
    if typeof(plotModel) == "Instance" and plotModel:IsA("BasePart") then
        rootPart = plotModel
    elseif plotModel:IsA("Folder") then
        -- Si c'est un Folder (Container), chercher le parent qui a un BasePart
        local parent = plotModel.Parent
        if parent and parent:IsA("BasePart") then
            rootPart = parent
        else
            rootPart = parent and parent:FindFirstChildWhichIsA("BasePart", true)
        end
    else
        rootPart = plotModel:FindFirstChild("PlotCenter") 
            or plotModel:FindFirstChild("BasePart")
            or plotModel:FindFirstChildWhichIsA("BasePart", true)
    end
    
    if not rootPart then
        warn("[Paradis][CampsiteDefaults] Pas de root pour la parcelle:", plotModel.Name)
        return false
    end
    
    -- 2) Créer ou trouver le dossier pour les objets de camping
    local campsiteFolder = plotModel:FindFirstChild("CampsiteObjects")
    if not campsiteFolder then
        campsiteFolder = Instance.new("Folder")
        campsiteFolder.Name = "CampsiteObjects"
        campsiteFolder.Parent = plotModel
    end
    
    -- 3) Parcourir chaque objet par défaut
    local constructFolder = getConstructionFolder()
    
    -- ⚠️ DÉSACTIVÉ: Le système de progression via PlayerProgressService gère maintenant les objets
    -- Les objets de départ sont donnés via PlayerProgressService.OwnedItems
    print("[Paradis][CampsiteDefaults] ⚠️ Génération automatique désactivée - utiliser le système de progression")
    return true
    
    --[[ ANCIEN CODE DÉSACTIVÉ
    for _, def in ipairs(CampsiteDefaultsConfig.DefaultObjects) do
        -- Vérifier si l'objet existe déjà
        if campsiteFolder:FindFirstChild(def.Id) then
            print("[Paradis][CampsiteDefaults] Objet déjà existant:", def.Id)
            continue
        end
        
        -- Chercher le template ou créer un placeholder
        local template = nil
        if constructFolder then
            template = constructFolder:FindFirstChild(def.ModelName)
        end
        
        local newModel
        if template and template:IsA("Model") then
            newModel = template:Clone()
            print("[Paradis][CampsiteDefaults] Objet cloné depuis template:", def.ModelName)
        else
            newModel = createPlaceholder(def)
            print("[Paradis][CampsiteDefaults] Placeholder créé pour:", def.Id)
        end
        
        newModel.Name = def.Id
        newModel.Parent = campsiteFolder
        
        -- Positionner le modèle
        local targetCFrame = rootPart.CFrame * def.Offset
        
        if newModel.PrimaryPart then
            newModel:SetPrimaryPartCFrame(targetCFrame)
        else
            -- Fallback avec PivotTo
            local basePart = newModel:FindFirstChildWhichIsA("BasePart", true)
            if basePart then
                newModel:PivotTo(targetCFrame)
            end
        end
        
        -- Sécurité : tous les objets sont ancrés
        for _, part in ipairs(newModel:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = true
            end
        end
        
        -- Ajouter les attributs pour le système
        newModel:SetAttribute("CampsiteObjectId", def.Id)
        newModel:SetAttribute("UpgradeLevel", 1)
        newModel:SetAttribute("IsDefaultCampsiteObject", true)
        newModel:SetAttribute("IsLocked", true)
        
        if ownerPlayer then
            newModel:SetAttribute("OwnerUserId", ownerPlayer.UserId)
        end
        
        print("[Paradis][CampsiteDefaults] ✅ Objet créé:", def.Id, "à la position", targetCFrame.Position)
    end
    
    print("[Paradis][CampsiteDefaults] ✅ Kit de camping généré avec succès pour", plotModel.Name)
    return true
    --]]
end

-- Fonction pour vérifier si un objet fait partie du kit de camping par défaut
function CampsiteDefaultsService.IsDefaultCampsiteObject(model)
    if not model then return false end
    
    -- Vérifier si c'est dans le dossier CampsiteObjects
    local parent = model.Parent
    if parent and parent.Name == "CampsiteObjects" then
        return true
    end
    
    -- Vérifier l'attribut
    return model:GetAttribute("IsDefaultCampsiteObject") == true
end

-- Fonction pour vérifier si un objet est verrouillé
function CampsiteDefaultsService.IsLockedObject(model)
    if not model then return false end
    return model:GetAttribute("IsLocked") == true
end

-- Exposer l'API au reste du jeu (scripts et modules)
shared.ParadisCampsiteDefaultsService = CampsiteDefaultsService

return CampsiteDefaultsService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="34">
        <Properties>
          <string name="Name">ConfigValidator</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    ConfigValidator
    Vérifie au démarrage que chaque objet plaçable possède une entrée économie.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TestService = game:GetService("TestService")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local ObjectsConfig = require(configFolder:WaitForChild("ObjectsConfig"))
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))

local missingEconomy = {}
for objectName in pairs(ObjectsConfig) do
    if not EconomyConfig.Objects[objectName] then
        table.insert(missingEconomy, objectName)
    end
end

if #missingEconomy > 0 then
    warn("[Paradis][Config] Objets sans configuration d'économie:", table.concat(missingEconomy, ", "))
else
    TestService:Message("[Paradis] Tous les objets ont une configuration d'économie.")
end

for econName in pairs(EconomyConfig.Objects) do
    if not ObjectsConfig[econName] then
        TestService:Message("[Paradis] Entrée économie inutilisée: " .. econName)
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="35">
        <Properties>
          <string name="Name">DataService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    DataService
    Responsable de la persistance simple des aménagements en DataStore.
    Les autres scripts y accèdent via shared.ParadisDataService.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local CampConfig = require(configFolder:WaitForChild("CampConfig"))
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))

local STORE_NAME = "ParadisPlots_v2"
local cache = {}
local store

local DEFAULT_CASH = (EconomyConfig.General and EconomyConfig.General.StartingCash) or 0

local DEFAULT_DATA = {
    Objects = {},
    TrailerParts = {},
    Cash = DEFAULT_CASH,
    FishingGear = {
        CurrentRod = "Basic",
        CurrentBait = "Standard",
        BaitUses = 5,
        OwnedRods = {Basic = true},
        FishInventory = {Common = 0, rare = 0, legendaire = 0},
    },
}

local function deepCopyTable(tbl)
    local clone = {}
    for key, value in pairs(tbl) do
        if type(value) == "table" then
            clone[key] = deepCopyTable(value)
        else
            clone[key] = value
        end
    end
    return clone
end

local function logDataStoreError(action, userId, err)
    warn(string.format("[Paradis][DataStore][%s][User:%s] %s", action, tostring(userId), tostring(err)))
end

local STUDIO_READ_ONLY = RunService:IsStudio()
local success, result = pcall(function()
    if STUDIO_READ_ONLY then return nil end -- On ne crée pas de DataStore effectif en Studio si API désactivé
    return DataStoreService:GetDataStore(STORE_NAME)
end)
if success then
    store = result
    if STUDIO_READ_ONLY then
        warn("[Paradis][DataStore] Mode Studio détecté: lecture/écriture DataStore désactivées (utilisation cache seulement).")
    end
else
    logDataStoreError("Init", "-", result)
end

local function normalizeData(data)
    if type(data) ~= "table" then
        data = deepCopyTable(DEFAULT_DATA)
    end
    data.Objects = type(data.Objects) == "table" and data.Objects or {}
    data.TrailerParts = type(data.TrailerParts) == "table" and data.TrailerParts or {}
    local cash = tonumber(data.Cash)
    if cash == nil then
        cash = DEFAULT_CASH
    end
    data.Cash = cash
    
    -- Normaliser FishingGear
    if type(data.FishingGear) ~= "table" then
        data.FishingGear = deepCopyTable(DEFAULT_DATA.FishingGear)
    else
        data.FishingGear.CurrentRod = data.FishingGear.CurrentRod or "Basic"
        data.FishingGear.CurrentBait = data.FishingGear.CurrentBait or "Standard"
        data.FishingGear.BaitUses = tonumber(data.FishingGear.BaitUses) or 5
        if type(data.FishingGear.OwnedRods) ~= "table" then
            data.FishingGear.OwnedRods = {Basic = true}
        end
        if type(data.FishingGear.FishInventory) ~= "table" then
            data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
        end
    end
    
    return data
end

local function loadPlayerData(userId)
    if cache[userId] then
        return cache[userId]
    end

    local data
    if store and not STUDIO_READ_ONLY then
        local ok, resultData = pcall(function()
            return store:GetAsync(tostring(userId))
        end)
        if ok then
            data = normalizeData(resultData)
        else
            logDataStoreError("Load", userId, resultData)
            data = deepCopyTable(DEFAULT_DATA)
        end
    else
        data = deepCopyTable(DEFAULT_DATA)
    end

    cache[userId] = data
    return data
end

local function savePlayerData(userId, data)
    data = normalizeData(data)
    cache[userId] = data
    if not store or STUDIO_READ_ONLY then
        return
    end

    local ok, err = pcall(function()
        store:SetAsync(tostring(userId), data)
    end)
    if not ok then
        logDataStoreError("Save", userId, err)
    end
end

local function getDefaultData()
    return deepCopyTable(DEFAULT_DATA)
end

shared.ParadisDataService = {
    LoadPlayerData = loadPlayerData,
    SavePlayerData = savePlayerData,
    GetDefaultData = getDefaultData,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="36">
        <Properties>
          <string name="Name">EconomyService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    EconomyService
    Gère la monnaie des campeurs, les déblocages, les boosts et la persistance.
    Les autres scripts y accèdent via shared.ParadisEconomyService.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local EconomyConfig = require(configFolder:WaitForChild("EconomyConfig"))
local EconomyRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EconomyRemotes"))

local STARTING_CASH = (EconomyConfig.General and EconomyConfig.General.StartingCash) or 500
local CASH_CAP = (EconomyConfig.General and EconomyConfig.General.CashCap) or math.huge
local MAINTENANCE_RATE = (EconomyConfig.General and EconomyConfig.General.MaintenanceTaxRate) or 0
local MAINTENANCE_INTERVAL = (EconomyConfig.General and EconomyConfig.General.MaintenanceIntervalSeconds) or 0
local AUTOSAVE_INTERVAL = 120

if CASH_CAP <= 0 then
    CASH_CAP = math.huge
end

local BOOST_SETTINGS = EconomyConfig.Boosts or {}

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local DataService = waitForShared("ParadisDataService")
local PlotService
task.spawn(function()
    PlotService = waitForShared("ParadisPlotService")
end)

local playerEconomy = {}

local boostState = {
    Active = false,
    Name = nil,
    Multiplier = 1,
    EndsAt = 0,
    NextStart = os.clock() + ((BOOST_SETTINGS.IntervalSeconds or 420)),
}

local function getBoostPayload()
    return {
        Active = boostState.Active,
        Name = boostState.Name,
        Multiplier = boostState.Multiplier,
        TimeLeft = boostState.Active and math.max(0, boostState.EndsAt - os.clock()) or 0,
    }
end

local function broadcastBoost()
    local payload = getBoostPayload()
    for _, player in ipairs(Players:GetPlayers()) do
        EconomyRemotes.BoostUpdated:FireClient(player, payload)
    end
end

local function ensureLeaderstats(player)
    local stats = player:FindFirstChild("leaderstats")
    if not stats then
        stats = Instance.new("Folder")
        stats.Name = "leaderstats"
        stats.Parent = player
    end

    local cashValue = stats:FindFirstChild("Cash")
    if not cashValue then
        cashValue = Instance.new("NumberValue")
        cashValue.Name = "Cash"
        cashValue.Value = 0
        cashValue.Parent = stats
    end

    local incomeValue = stats:FindFirstChild("IncomePerSecond")
    if not incomeValue then
        incomeValue = Instance.new("NumberValue")
        incomeValue.Name = "IncomePerSecond"
        incomeValue.Value = 0
        incomeValue.Parent = stats
    end

    return cashValue, incomeValue
end

local function roundCurrency(amount)
    return math.floor((amount or 0) * 100 + 0.5) / 100
end

local function ensureState(player)
    local state = playerEconomy[player]
    if state then
        return state
    end

    local data = DataService.LoadPlayerData(player.UserId)
    local currentCash = tonumber(data.Cash)
    if currentCash == nil then
        currentCash = STARTING_CASH
        data.Cash = currentCash
    end

    state = {
        Cash = currentCash,
        IncomePerSecond = 0,
        Data = data,
        LastMaintenance = os.clock(),
    }
    playerEconomy[player] = state
    return state
end

local function syncLeaderstats(player, state)
    local cashValue, incomeValue = ensureLeaderstats(player)
    cashValue.Value = roundCurrency(state.Cash)
    incomeValue.Value = roundCurrency(state.IncomePerSecond)
end

local function broadcastEconomy(player, state)
    EconomyRemotes.CashUpdated:FireClient(player, roundCurrency(state.Cash))
    EconomyRemotes.IncomeUpdated:FireClient(player, roundCurrency(state.IncomePerSecond))
end

local function persistPlayer(player, state)
    if not state or not state.Data then
        return
    end
    state.Data.Cash = roundCurrency(state.Cash)
    DataService.SavePlayerData(player.UserId, state.Data)
end

local function getEconomyEntry(catalog, objectId)
    catalog = catalog == "Construction" and "Construction" or "Objects"
    return EconomyConfig.Resolve(catalog, objectId)
end

local function resolveRecordIncome(record)
    if type(record) ~= "table" then
        return 0
    end
    local catalog = record.Catalog
    local objectId

    if catalog == "Construction" or record.Type == "Construction" then
        catalog = "Construction"
        objectId = record.ConstructionId or record.ObjectId or record.Type
    else
        catalog = "Objects"
        objectId = record.Type or record.ObjectId
    end

    if not objectId then
        return tonumber(record.IncomePerSecond) or 0
    end

    local entry = getEconomyEntry(catalog, objectId)
    if (entry.IncomePerSecond or 0) == 0 then
        return tonumber(record.IncomePerSecond) or 0
    end
    return entry.IncomePerSecond
end

local EconomyAPI = {}

function EconomyAPI.GetEconomyForObject(catalog, objectId)
    if not objectId then
        return EconomyConfig.Defaults or { Cost = 0, IncomePerSecond = 0, UnlockAtIncome = 0 }
    end
    return EconomyConfig.Resolve(catalog == "Construction" and "Construction" or "Objects", objectId)
end

function EconomyAPI.GetCash(player)
    local state = ensureState(player)
    return state.Cash
end

function EconomyAPI.GetIncomePerSecond(player)
    local state = ensureState(player)
    return state.IncomePerSecond
end

function EconomyAPI.HasEnoughCash(player, cost)
    local state = ensureState(player)
    return state.Cash >= (cost or 0)
end

function EconomyAPI.GetUnlockRequirement(catalog, objectId)
    local entry = EconomyAPI.GetEconomyForObject(catalog, objectId)
    return entry.UnlockAtIncome or 0
end

function EconomyAPI.CanUseObject(player, catalog, objectId)
    local required = EconomyAPI.GetUnlockRequirement(catalog, objectId)
    local state = ensureState(player)
    return state.IncomePerSecond >= required, required
end

function EconomyAPI.AddCash(player, amount)
    if not player or not amount or amount == 0 then
        return 0
    end
    local state = ensureState(player)
    local target = roundCurrency(state.Cash + amount)
    target = math.clamp(target, 0, CASH_CAP)
    local applied = roundCurrency(target - state.Cash)
    if applied == 0 and amount ~= 0 then
        return 0
    end
    state.Cash = target
    state.Data.Cash = state.Cash
    syncLeaderstats(player, state)
    broadcastEconomy(player, state)
    return applied
end

function EconomyAPI.AddIncomeSource(player, amount)
    if not player or not amount or amount == 0 then
        return
    end
    local state = ensureState(player)
    state.IncomePerSecond = roundCurrency(math.max(0, state.IncomePerSecond + amount))
    syncLeaderstats(player, state)
    EconomyRemotes.IncomeUpdated:FireClient(player, state.IncomePerSecond)
end

function EconomyAPI.RemoveIncomeSource(player, amount)
    if not amount or amount == 0 then
        return
    end
    EconomyAPI.AddIncomeSource(player, -amount)
end

function EconomyAPI.RecalculateIncome(player, objectList)
    local state = ensureState(player)
    local total = 0

    local list = objectList
    if not list and PlotService and PlotService.GetPlotForPlayer then
        local plot = PlotService.GetPlotForPlayer(player)
        list = plot and plot.PlacedObjects
    end

    if type(list) == "table" then
        for _, record in ipairs(list) do
            total += resolveRecordIncome(record)
        end
    end

    state.IncomePerSecond = roundCurrency(total)
    syncLeaderstats(player, state)
    EconomyRemotes.IncomeUpdated:FireClient(player, state.IncomePerSecond)
    return state.IncomePerSecond
end

function EconomyAPI.GetBoost()
    return getBoostPayload()
end

EconomyRemotes.RequestSnapshot.OnServerInvoke = function(player)
    local state = ensureState(player)
    return {
        Cash = roundCurrency(state.Cash),
        IncomePerSecond = roundCurrency(state.IncomePerSecond),
        Boost = getBoostPayload(),
    }
end

EconomyRemotes.RequestManualSave.OnServerInvoke = function(player)
    local state = ensureState(player)
    persistPlayer(player, state)
    return {
        Success = true,
        Cash = roundCurrency(state.Cash),
        Timestamp = os.time(),
    }
end

local function handlePlayerAdded(player)
    local state = ensureState(player)
    syncLeaderstats(player, state)
    broadcastEconomy(player, state)
    EconomyRemotes.BoostUpdated:FireClient(player, getBoostPayload())
end

local function handlePlayerRemoving(player)
    local state = playerEconomy[player]
    if state then
        persistPlayer(player, state)
        playerEconomy[player] = nil
    end
end

Players.PlayerAdded:Connect(handlePlayerAdded)
Players.PlayerRemoving:Connect(handlePlayerRemoving)

local function triggerPassiveGain(player, amount)
    if amount == 0 then
        return
    end
    EconomyRemotes.PassiveTick:FireClient(player, amount, boostState.Active and boostState.Name or nil, boostState.Multiplier)
end

local function tryApplyMaintenance(player, state)
    if MAINTENANCE_RATE <= 0 or MAINTENANCE_INTERVAL <= 0 then
        return
    end
    local now = os.clock()
    if now - (state.LastMaintenance or now) < MAINTENANCE_INTERVAL then
        return
    end
    state.LastMaintenance = now
    local tax = roundCurrency(state.Cash * MAINTENANCE_RATE)
    if tax > 0 then
        local applied = EconomyAPI.AddCash(player, -tax)
        if applied ~= 0 then
            EconomyRemotes.PassiveTick:FireClient(player, applied, "Taxe d'entretien", 1)
        end
    end
end

task.spawn(function()
    local lastTick = os.clock()
    while true do
        task.wait(1)
        local now = os.clock()
        local delta = now - lastTick
        lastTick = now
        local multiplier = boostState.Multiplier or 1
        for player, state in pairs(playerEconomy) do
            if state.IncomePerSecond > 0 then
                -- Appliquer le multiplicateur du feu (pénalité si feu < 10)
                local firePenalty = player:GetAttribute("FirePenaltyMultiplier") or 1.0
                local earned = state.IncomePerSecond * multiplier * firePenalty * delta
                local applied = EconomyAPI.AddCash(player, earned)
                if applied ~= 0 then
                    triggerPassiveGain(player, applied)
                end
            end
            tryApplyMaintenance(player, state)
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(AUTOSAVE_INTERVAL)
        for player, state in pairs(playerEconomy) do
            persistPlayer(player, state)
        end
    end
end)

local function scheduleNextBoost()
    local interval = BOOST_SETTINGS.IntervalSeconds or 420
    local jitter = BOOST_SETTINGS.RandomJitterSeconds or 0
    if jitter > 0 then
        interval += math.random(-jitter, jitter)
    end
    boostState.NextStart = os.clock() + math.max(60, interval)
end

local function activateBoost()
    if not BOOST_SETTINGS.Enabled then
        return
    end
    local events = BOOST_SETTINGS.Events or {}
    if #events == 0 then
        return
    end
    local event = events[math.random(1, #events)]
    boostState.Active = true
    boostState.Name = event.Name or "Boost"
    boostState.Multiplier = event.Multiplier or 1.5
    local duration = event.DurationSeconds or 45
    boostState.EndsAt = os.clock() + duration
    broadcastBoost()
end

local function clearBoost()
    if not boostState.Active then
        return
    end
    boostState.Active = false
    boostState.Name = nil
    boostState.Multiplier = 1
    boostState.EndsAt = 0
    broadcastBoost()
    scheduleNextBoost()
end

scheduleNextBoost()

task.spawn(function()
    while true do
        task.wait(1)
        local now = os.clock()
        if boostState.Active then
            if now >= boostState.EndsAt then
                clearBoost()
            end
        elseif BOOST_SETTINGS.Enabled and now >= (boostState.NextStart or now + 9999) then
            activateBoost()
        end
    end
end)

shared.ParadisEconomyService = EconomyAPI
]]></string>
        </Properties>
      </Item>
