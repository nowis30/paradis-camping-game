      </Item>
      <Item class="Script" referent="38">
        <Properties>
          <string name="Name">FishingShopService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    FishingShopService
    Gère les achats de cannes à pêche et d'appâts dans le Pro Shop.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local FishingGearConfig = require(ConfigFolder:WaitForChild("FishingGearConfig"))
local FishPrices = require(ConfigFolder:WaitForChild("FishPricesConfig"))
local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local FishingShopRemotes = require(RemotesFolder:WaitForChild("FishingShopRemotes"))

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local DataApi = waitForShared("ParadisDataService")
local EconomyService = waitForShared("ParadisEconomyService")

local FishingShopService = {}

-- Acheter une canne
FishingShopRemotes.BuyRod.OnServerEvent:Connect(function(player, rodId)
    local rodDef = FishingGearConfig.Rods[rodId]
    if not rodDef then
        warn("[FishingShop] Canne inconnue:", rodId)
        return
    end
    
    -- Si achat Robux uniquement, bloquer ici (achat via MarketplaceService côté client)
    if rodDef.RobuxPrice and rodDef.RobuxPrice > 0 then
        warn("[FishingShop] Canne Robux, achat doit passer par MarketplaceService:", rodId)
        return
    end
    
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    
    -- Vérifier si déjà possédée
    if data.FishingGear.OwnedRods[rodId] then
        warn("[FishingShop] Canne déjà possédée:", rodId)
        return
    end
    
    -- Vérifier le cash
    local cost = rodDef.Cost
    if data.Cash < cost then
        warn("[FishingShop] Pas assez de cash pour la canne:", rodId)
        return
    end
    
    -- Déduire et ajouter la canne
    data.Cash = data.Cash - cost
    data.FishingGear.OwnedRods[rodId] = true
    data.FishingGear.CurrentRod = rodId
    DataApi.SavePlayerData(userId, data)
    
    -- Mettre à jour le HUD
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local cashValue = leaderstats:FindFirstChild("Cash")
        if cashValue then
            cashValue.Value = data.Cash
        end
    end
    
    print(string.format("[FishingShop] %s a acheté la canne %s pour %d$", player.Name, rodDef.DisplayName, cost))
end)

-- Équiper une canne déjà possédée
FishingShopRemotes.SetCurrentRod.OnServerEvent:Connect(function(player, rodId)
    local rodDef = FishingGearConfig.Rods[rodId]
    if not rodDef then
        warn("[FishingShop] SetCurrentRod: canne inconnue:", rodId)
        return
    end
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not (data.FishingGear.OwnedRods and data.FishingGear.OwnedRods[rodId]) then
        warn("[FishingShop] SetCurrentRod: non possédée:", rodId)
        return
    end
    data.FishingGear.CurrentRod = rodId
    DataApi.SavePlayerData(userId, data)
    print(string.format("[FishingShop] %s a équipé la canne %s", player.Name, rodDef.DisplayName))
end)

-- Acheter un appât
FishingShopRemotes.BuyBait.OnServerEvent:Connect(function(player, baitId)
    local baitDef = FishingGearConfig.Baits[baitId]
    if not baitDef then
        warn("[FishingShop] Appât inconnu:", baitId)
        return
    end
    
    if baitId == "None" then
        return -- aucun achat nécessaire
    end
    
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    
    -- Vérifier le cash
    local cost = baitDef.Cost
    if data.Cash < cost then
        warn("[FishingShop] Pas assez de cash pour l'appât:", baitId)
        return
    end
    
    -- Déduire et ajouter les utilisations
    data.Cash = data.Cash - cost
    data.FishingGear.CurrentBait = baitId
    data.FishingGear.BaitUses = (data.FishingGear.BaitUses or 0) + baitDef.UsesPerPurchase
    DataApi.SavePlayerData(userId, data)
    
    -- Mettre à jour le HUD
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local cashValue = leaderstats:FindFirstChild("Cash")
        if cashValue then
            cashValue.Value = data.Cash
        end
    end
    
    print(string.format("[FishingShop] %s a acheté %s pour %d$ (%d utilisations)", player.Name, baitDef.DisplayName, cost, baitDef.UsesPerPurchase))
end)

-- Obtenir l'équipement actuel
FishingShopRemotes.GetGear.OnServerInvoke = function(player)
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
    end
    return {
        CurrentRod = data.FishingGear.CurrentRod,
        CurrentBait = data.FishingGear.CurrentBait,
        BaitUses = data.FishingGear.BaitUses,
        OwnedRods = data.FishingGear.OwnedRods,
        Cash = data.Cash,
        FishInventory = data.FishingGear.FishInventory,
    }
end

FishingShopService.GetPlayerGear = function(userId)
    local data = DataApi.LoadPlayerData(userId)
    return {
        CurrentRod = data.FishingGear.CurrentRod,
        CurrentBait = data.FishingGear.CurrentBait,
        BaitUses = data.FishingGear.BaitUses,
    }
end

FishingShopService.ConsumeBait = function(userId)
    local data = DataApi.LoadPlayerData(userId)
    if data.FishingGear.CurrentBait == "None" or data.FishingGear.CurrentBait == "Standard" then
        return
    end
    
    data.FishingGear.BaitUses = math.max(0, (data.FishingGear.BaitUses or 0) - 1)
    
    -- Si plus d'utilisations, revenir à "Standard"
    if data.FishingGear.BaitUses <= 0 then
        data.FishingGear.CurrentBait = "Standard"
        data.FishingGear.BaitUses = 5
    end
    
    DataApi.SavePlayerData(userId, data)
end

FishingShopService.AddFishToInventory = function(userId, fishType)
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
    end
    
    data.FishingGear.FishInventory[fishType] = (data.FishingGear.FishInventory[fishType] or 0) + 1
    -- Marquer comme vu dans le codex
    data.FishingGear.CodexSeen = data.FishingGear.CodexSeen or {}
    data.FishingGear.CodexSeen[fishType] = true
    DataApi.SavePlayerData(userId, data)
    return data.FishingGear.FishInventory[fishType]
end

FishingShopService.UseFishAsBait = function(userId, fishType)
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        data.FishingGear.FishInventory = {Common = 0, rare = 0, legendaire = 0}
    end
    
    local count = data.FishingGear.FishInventory[fishType] or 0
    if count <= 0 then
        return false
    end
    
    -- Consommer le poisson et équiper l'appât correspondant
    data.FishingGear.FishInventory[fishType] = count - 1
    
    local baitId = "Fish" .. fishType
    local baitDef = FishingGearConfig.Baits[baitId]
    if baitDef then
        data.FishingGear.CurrentBait = baitId
        data.FishingGear.BaitUses = baitDef.UsesPerPurchase
    end
    
    DataApi.SavePlayerData(userId, data)
    return true
end

-- Remote pour utiliser un poisson comme appât
FishingShopRemotes.UseFishAsBait.OnServerEvent:Connect(function(player, fishType)
    local userId = player.UserId
    local success = FishingShopService.UseFishAsBait(userId, fishType)
    
    if success then
        print(string.format("[FishingShop] %s utilise un poisson %s comme appât", player.Name, fishType))
    else
        warn(string.format("[FishingShop] %s n'a pas de poisson %s en stock", player.Name, fishType))
    end
end)

-- Vente poissonnerie: vendre une quantité d'une rareté (par défaut tout)
FishingShopRemotes.SellFish.OnServerEvent:Connect(function(player, fishType, amount)
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then
        return
    end
    if FishPrices[fishType] == nil then
        warn("[FishingShop] SellFish: type inconnu:", fishType)
        return
    end
    local have = data.FishingGear.FishInventory[fishType] or 0
    amount = math.clamp(tonumber(amount) or have, 0, have)
    if amount <= 0 then return end
    local gain = amount * (FishPrices[fishType] or 0)
    data.FishingGear.FishInventory[fishType] = have - amount
    data.Cash = (data.Cash or 0) + gain
    DataApi.SavePlayerData(userId, data)
    -- Mettre à jour leaderstats
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local cash = ls:FindFirstChild("Cash")
        if cash then cash.Value = data.Cash end
    end
    print(string.format("[FishingShop] %s a vendu %d x %s pour %d$", player.Name, amount, fishType, gain))
end)

-- Vente tout
FishingShopRemotes.SellAllFish.OnServerEvent:Connect(function(player)
    local userId = player.UserId
    local data = DataApi.LoadPlayerData(userId)
    if not data.FishingGear.FishInventory then return end
    local total = 0
    for t, cnt in pairs(data.FishingGear.FishInventory) do
        local price = FishPrices[t] or 0
        total = total + (cnt or 0) * price
        data.FishingGear.FishInventory[t] = 0
    end
    if total > 0 then
        data.Cash = (data.Cash or 0) + total
        DataApi.SavePlayerData(userId, data)
        local ls = player:FindFirstChild("leaderstats")
        if ls then
            local cash = ls:FindFirstChild("Cash")
            if cash then cash.Value = data.Cash end
        end
        print(string.format("[FishingShop] %s a vendu tout pour %d$", player.Name, total))
    end
end)

-- Codex: renvoyer flags vus
FishingShopRemotes.GetCodex.OnServerInvoke = function(player)
    local data = DataApi.LoadPlayerData(player.UserId)
    data.FishingGear.CodexSeen = data.FishingGear.CodexSeen or {}
    return data.FishingGear.CodexSeen
end

-- Fonction appelée après achat Robux réussi (Developer Product callback)
function FishingShopService.GrantMasterRod(userId)
    local data = DataApi.LoadPlayerData(userId)
    if data.FishingGear.OwnedRods.Master then
        return true -- Déjà possédée
    end
    data.FishingGear.OwnedRods.Master = true
    data.FishingGear.CurrentRod = "Master"
    DataApi.SavePlayerData(userId, data)
    print("[FishingShop] Canne Master accordée via Robux pour userId:", userId)
    return true
end

shared.ParadisFishingShopService = FishingShopService
print("[Paradis][FishingShop] Service initialisé")

return FishingShopService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="39">
        <Properties>
          <string name="Name">FishingSystem</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- FishingSystem.server.lua

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local FishingGearConfig = require(ConfigFolder:WaitForChild("FishingGearConfig"))

-- Nom du dossier qui contient tes 5 spots dans Workspace
local FISHING_FOLDER_NAME = "FishingArea"

-- Animation IDs - Animations de pêche Roblox par défaut
local CAST_ANIMATION_ID = "rbxassetid://3541114300"   -- animation lancer la ligne
local REEL_ANIMATION_ID = "rbxassetid://3541114300"   -- animation remonter le poisson (même anim pour l'instant)

-- Types de poissons et récompenses
local fishTypes = {
    { name = "Common", reward = 10, weight = 50 },
    { name = "rare", reward = 25, weight = 35 },
    { name = "legendaire", reward = 100, weight = 15 },
}

-- Assure qu'on a leaderstats.Money pour un joueur
-- Utilise le service d’économie central pour ajouter du cash
local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local EconomyService = shared.ParadisEconomyService or waitForShared("ParadisEconomyService")
local FishingShopService = waitForShared("ParadisFishingShopService")
local PlayerProgressService = shared.PlayerProgressService or waitForShared("PlayerProgressService")

-- Joue une animation sur le personnage (si un ID est fourni)
local function playAnimation(character, animationId)
    if not animationId or animationId == "" then
        return nil
    end

    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = animationId

    local track = humanoid:LoadAnimation(anim)
    track:Play()
    return track
end

-- Petit texte au-dessus de la tête du joueur (style Money GUI)
local function showFloatingText(character, text)
    if not character then return end

    local head = character:FindFirstChild("Head")
    if not head then return end

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(4, 0, 1, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 24
    label.TextColor3 = Color3.fromRGB(150, 240, 150)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Text = text
    label.Parent = billboard

    Debris:AddItem(billboard, 2.5)
end

-- Empêche un joueur de lancer 40 pêches en même temps
local activeFishing = {} -- [player] = true pendant la pêche

-- Création ou clonage d'un modèle de poisson depuis ReplicatedStorage/FishModels
local FISH_MODELS_ROOT = "FishModels"
local fishModelMap = {
    ["Common"] = "Common",
    ["rare"] = "Rare",
    ["legendaire"] = "Legendaire",
}

local function pickModelFromFolder(folder)
    if not folder then return nil end
    local modelCandidates = {}
    local partCandidates = {}
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            table.insert(modelCandidates, child)
        elseif child:IsA("Folder") then
            -- Cherche d'abord un Model
            local m = child:FindFirstChildWhichIsA("Model")
            if m then
                table.insert(modelCandidates, m)
            end
            -- Sinon, accepte un BasePart/MeshPart à l'intérieur
            local p = child:FindFirstChildWhichIsA("BasePart", true)
            if p then
                table.insert(partCandidates, p)
            end
        elseif child:IsA("BasePart") then
            table.insert(partCandidates, child)
        end
    end
    if #modelCandidates > 0 then
        return modelCandidates[math.random(1, #modelCandidates)]
    end
    if #partCandidates > 0 then
        return partCandidates[math.random(1, #partCandidates)]
    end
    return nil
end

local function getFishModelsRoot()
    local replicated = game:GetService("ReplicatedStorage")
    local root = replicated:FindFirstChild(FISH_MODELS_ROOT)
    if root then return root end
    local ok, waited = pcall(function()
        return replicated:WaitForChild(FISH_MODELS_ROOT, 3)
    end)
    if ok then return waited end
    return nil
end

local function createFishVisual(fishInfo)
    print("[FishingSystem] Création visuelle pour:", fishInfo.name)
    local root = getFishModelsRoot()
    if not root then
        warn("[FishingSystem] ❌ Dossier FishModels introuvable après attente !")
    else
        print("[FishingSystem] ✅ FishModels disponible")
    end
    
    local groupName = fishModelMap[fishInfo.name]
    print("[FishingSystem] Recherche du dossier:", groupName)
    local groupFolder = root and root:FindFirstChild(groupName)
    -- Recherche insensible à la casse si non trouvé exactement
    if root and not groupFolder then
        for _, child in ipairs(root:GetChildren()) do
            if string.lower(child.Name) == string.lower(groupName) then
                groupFolder = child
                break
            end
        end
    end
    if root and not groupFolder then
        -- Essayer une attente courte si la réplication du dossier est tardive
        local ok, gf = pcall(function()
            return root:WaitForChild(groupName, 1)
        end)
        if ok then groupFolder = gf end
    end
    if not groupFolder and root then
        warn("[FishingSystem] ❌ Dossier", groupName, "introuvable (après retry). Contenu de FishModels:")
        for _, child in ipairs(root:GetChildren()) do
            warn("  -", child.Name, "(", child.ClassName, ")")
        end
    elseif groupFolder then
        print("[FishingSystem] ✅ Dossier prêt:", groupFolder.Name, "—", #groupFolder:GetChildren(), "enfants")
    end
    
    local template = pickModelFromFolder(groupFolder)
    if template then
        print("[FishingSystem] ✅ Modèle sélectionné:", template.Name)
        local clone
        if template:IsA("Model") then
            clone = template:Clone()
        else
            -- Si c'est un MeshPart/BasePart, l'envelopper dans un Model
            local partClone = template:Clone()
            clone = Instance.new("Model")
            clone.Name = template.Name .. "_Model"
            partClone.Anchored = true
            partClone.CanCollide = false
            partClone.Parent = clone
            clone.PrimaryPart = partClone
        end
        -- Assurer une PrimaryPart, y compris si les pièces sont imbriquées (recherche récursive)
        if not clone.PrimaryPart then
            local primary = clone:FindFirstChildWhichIsA("BasePart", true)
            if primary then
                clone.PrimaryPart = primary
            else
                warn("[FishingSystem] ⚠️ Aucun BasePart trouvé dans le modèle:", clone.Name, "— création d'un Root invisible")
                local root = Instance.new("Part")
                root.Name = "Root"
                root.Size = Vector3.new(1, 1, 1)
                root.Transparency = 1
                root.Anchored = true
                root.CanCollide = false
                root.Parent = clone
                clone.PrimaryPart = root
            end
        end
        -- Rendre toutes les parties non collidables pour l’animation de sortie
        for _, desc in ipairs(clone:GetDescendants()) do
            if desc:IsA("BasePart") then
                desc.Anchored = true
                desc.CanCollide = false
            end
        end
        -- Effets brillants si légendaire
        if fishInfo.name == "legendaire" then
            for _, part in ipairs(clone:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Material = Enum.Material.Neon
                    part.Color = Color3.fromRGB(255, 215, 80)
                end
            end
            if clone.PrimaryPart then
                local glow = Instance.new("PointLight")
                glow.Range = 12
                glow.Brightness = 2.5
                glow.Color = Color3.fromRGB(255, 230, 120)
                glow.Parent = clone.PrimaryPart
                local sparkle = Instance.new("ParticleEmitter")
                sparkle.Texture = "rbxassetid://258128463"
                sparkle.Rate = 18
                sparkle.Lifetime = NumberRange.new(0.5, 1)
                sparkle.Speed = NumberRange.new(0.2, 0.6)
                sparkle.Size = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.25),
                    NumberSequenceKeypoint.new(0.5, 0.35),
                    NumberSequenceKeypoint.new(1, 0)
                })
                sparkle.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.05),
                    NumberSequenceKeypoint.new(0.8, 0.4),
                    NumberSequenceKeypoint.new(1, 1)
                })
                sparkle.Parent = clone.PrimaryPart
            end
        end
        return clone, 1
    end
    -- Fallback procédural si aucun modèle
    warn("[FishingSystem] ⚠️ Utilisation du fallback procédural pour:", fishInfo.name)
    local sizeScale
    local color
    if fishInfo.name == "Common" then
        sizeScale = 1.0
        color = Color3.fromRGB(180, 200, 220)
    elseif fishInfo.name == "rare" then
        sizeScale = 1.4
        color = Color3.fromRGB(255, 165, 80)
    else
        sizeScale = 2.2
        color = Color3.fromRGB(255, 215, 0)
    end

    local model = Instance.new("Model")
    model.Name = "FishVisual"

    local body = Instance.new("Part")
    body.Name = "Body"
    body.Size = Vector3.new(1.6 * sizeScale, 0.8 * sizeScale, 0.9 * sizeScale)
    body.Material = Enum.Material.SmoothPlastic
    body.Color = color
    body.Anchored = true
    body.CanCollide = false
    body.Parent = model
    if fishInfo.name == "legendaire" then
        body.Material = Enum.Material.Neon
        body.Color = Color3.fromRGB(255, 215, 80)
        local glow = Instance.new("PointLight")
        glow.Range = 12
        glow.Brightness = 2.5
        glow.Color = body.Color
        glow.Parent = body
        local sparkle = Instance.new("ParticleEmitter")
        sparkle.Texture = "rbxassetid://258128463"
        sparkle.Rate = 16
        sparkle.Lifetime = NumberRange.new(0.5, 0.9)
        sparkle.Speed = NumberRange.new(0.3, 0.7)
        sparkle.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.22),
            NumberSequenceKeypoint.new(0.5, 0.3),
            NumberSequenceKeypoint.new(1, 0)
        })
        sparkle.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.05),
            NumberSequenceKeypoint.new(0.7, 0.45),
            NumberSequenceKeypoint.new(1, 1)
        })
        sparkle.Parent = body
    end

    local tail = Instance.new("WedgePart")
    tail.Name = "Tail"
    tail.Size = Vector3.new(0.8 * sizeScale, 0.6 * sizeScale, 0.2 * sizeScale)
    tail.Material = Enum.Material.SmoothPlastic
    tail.Color = color:Lerp(Color3.fromRGB(250, 250, 250), 0.2)
    tail.Anchored = true
    tail.CanCollide = false
    tail.Parent = model

    local finTop = Instance.new("WedgePart")
    finTop.Name = "TopFin"
    finTop.Size = Vector3.new(0.5 * sizeScale, 0.3 * sizeScale, 0.2 * sizeScale)
    finTop.Material = Enum.Material.SmoothPlastic
    finTop.Color = color:Lerp(Color3.fromRGB(255, 255, 255), 0.3)
    finTop.Anchored = true
    finTop.CanCollide = false
    finTop.Parent = model

    local finBottom = Instance.new("WedgePart")
    finBottom.Name = "BottomFin"
    finBottom.Size = Vector3.new(0.5 * sizeScale, 0.3 * sizeScale, 0.2 * sizeScale)
    finBottom.Material = Enum.Material.SmoothPlastic
    finBottom.Color = color:Lerp(Color3.fromRGB(255, 255, 255), 0.3)
    finBottom.Anchored = true
    finBottom.CanCollide = false
    finBottom.Parent = model

    model.PrimaryPart = body
    return model, sizeScale
end

local function positionFishParts(model)
    local body = model:FindFirstChild("Body")
    local tail = model:FindFirstChild("Tail")
    local finTop = model:FindFirstChild("TopFin")
    local finBottom = model:FindFirstChild("BottomFin")
    if not body then return end
    local cf = body.CFrame
    if tail then tail.CFrame = cf * CFrame.new(0.9, 0, 0) end
    if finTop then finTop.CFrame = cf * CFrame.new(0, 0.4, 0) end
    if finBottom then finBottom.CFrame = cf * CFrame.new(0, -0.35, 0) end
end

local function startFishing(player)
    if activeFishing[player] then
        return
    end
    activeFishing[player] = true

    local character = player.Character
    if not character then
        activeFishing[player] = nil
        return
    end

    -- Création visuelle de la canne à pêche (couleur selon le niveau)
    local fishingRod = Instance.new("Tool")
    fishingRod.Name = "CannePeche"
    fishingRod.RequiresHandle = true
    fishingRod.CanBeDropped = false
    fishingRod.Grip = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(90), 0, 0)
    
    -- Manche de la canne (partie basse)
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.2, 3, 0.2)
    handle.Material = Enum.Material.Wood
    -- Couleur par défaut (Basic) avant application réelle
    handle.Color = Color3.fromRGB(101, 67, 33)
    handle.Parent = fishingRod
    
    -- Partie haute de la canne (plus fine)
    local rodTop = Instance.new("Part")
    rodTop.Name = "RodTop"
    rodTop.Size = Vector3.new(0.15, 2.5, 0.15)
    rodTop.Material = Enum.Material.SmoothPlastic
    rodTop.Color = Color3.fromRGB(150, 150, 150)
    rodTop.CanCollide = false
    rodTop.Parent = fishingRod
    
    local weld1 = Instance.new("WeldConstraint")
    weld1.Part0 = handle
    weld1.Part1 = rodTop
    weld1.Parent = rodTop
    
    rodTop.CFrame = handle.CFrame * CFrame.new(0, 2.75, 0)
    
    -- Moulinet
    local reel = Instance.new("Part")
    reel.Name = "Reel"
    reel.Size = Vector3.new(0.4, 0.4, 0.4)
    reel.Shape = Enum.PartType.Cylinder
    reel.Material = Enum.Material.Metal
    reel.Color = Color3.fromRGB(192, 192, 192)
    reel.CanCollide = false
    reel.Parent = fishingRod
    
    local weld2 = Instance.new("WeldConstraint")
    weld2.Part0 = handle
    weld2.Part1 = reel
    weld2.Parent = reel
    
    reel.CFrame = handle.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90))
    
    fishingRod.Parent = character
    character.Humanoid:EquipTool(fishingRod)

    -- Appliquer la couleur spécifique de la canne choisie (après Equip pour éviter latence)
    local gearForColor = FishingShopService.GetPlayerGear(player.UserId)
    local rodDefColor = FishingGearConfig.Rods[gearForColor.CurrentRod]
    if rodDefColor and rodDefColor.Color then
        local col = rodDefColor.Color
        -- Appliquer sur toutes les parties (on laisse le moulinet métallique mais on peut teinter légèrement)
        handle.Color = col
        rodTop.Color = col:lerp(Color3.new(1,1,1), 0.25) -- partie haute légèrement éclaircie
        -- Moulinet : conserver métal, option : teinte légère
        reel.Color = col:lerp(Color3.fromRGB(192,192,192), 0.6)
    end

    -- Effets spéciaux pour canne Master brillante
    if rodDefColor and rodDefColor.Shiny then
        -- Ajuster dimensions
        handle.Size = Vector3.new(0.25, 3.3, 0.25)
        rodTop.Size = Vector3.new(0.18, 3.1, 0.18)
        rodTop.Material = Enum.Material.Neon
        -- Lumière
        local light = Instance.new("PointLight")
        light.Name = "MasterGlow"
        light.Range = 10
        light.Brightness = 2.2
        light.Color = rodTop.Color
        light.Parent = rodTop
        -- Particules scintillantes
        local sparkles = Instance.new("ParticleEmitter")
        sparkles.Name = "MasterSparkle"
        sparkles.LightEmission = 0.7
        sparkles.Texture = "rbxassetid://258128463"
        sparkles.Rate = 12
        sparkles.Lifetime = NumberRange.new(0.4, 0.8)
        sparkles.Speed = NumberRange.new(0.5, 1.2)
        sparkles.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.15),
            NumberSequenceKeypoint.new(0.4, 0.25),
            NumberSequenceKeypoint.new(1, 0)
        })
        sparkles.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.1),
            NumberSequenceKeypoint.new(0.8, 0.4),
            NumberSequenceKeypoint.new(1, 1)
        })
        sparkles.Parent = rodTop
    end

    -- Animation de lancer
    local castTrack = playAnimation(character, CAST_ANIMATION_ID)
    task.wait(1.2)

    -- Récupérer l'équipement du joueur pour le temps d'attente
    local gear = FishingShopService.GetPlayerGear(player.UserId)
    local rodDef = FishingGearConfig.Rods[gear.CurrentRod] or FishingGearConfig.Rods.Basic
    
    -- Temps d'attente modifié par la canne (1.5 à 3.5 secondes * speedMultiplier)
    local baseWaitTime = math.random(15, 35) / 10
    local waitTime = baseWaitTime * rodDef.SpeedMultiplier
    task.wait(waitTime)
    
    local baitDef = FishingGearConfig.Baits[gear.CurrentBait] or FishingGearConfig.Baits.None
    
    -- Consommer un appât si utilisé
    if gear.CurrentBait ~= "None" and gear.BaitUses > 0 then
        FishingShopService.ConsumeBait(player.UserId)
    end
    
    -- Calculer les chances avec bonus de canne et appât
    local legendaryChance = rodDef.LegendaryChance + baitDef.LegendaryBoost
    local rareBonus = rodDef.RareBonus
    
    -- Déterminer le type de poisson avec chances modifiées
    local fishInfo
    local roll = math.random(1, 100)
    
    if roll <= (legendaryChance * 100) then
        -- Légendaire
        fishInfo = fishTypes[3]
    elseif roll <= (legendaryChance * 100 + 35 + rareBonus) then
        -- Rare
        fishInfo = fishTypes[2]
    else
        -- Common
        fishInfo = fishTypes[1]
    end
    
    -- Appliquer multiplicateur de récompense de l'appât
    local reward = math.floor(fishInfo.reward * baitDef.RewardMultiplier)

    -- ===== MINI-JEU DE TENSION DE LIGNE (côté client) =====
    local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
    local startMiniGameEvent = remotesFolder:WaitForChild("StartFishingMiniGame")
    local resultEvent = remotesFolder:WaitForChild("FishingMiniGameResult")
    
    -- Envoie au client pour démarrer le mini-jeu
    startMiniGameEvent:FireClient(player, fishInfo.name)
    
    -- Attente du résultat (timeout 60s)
    local miniGameSuccess = false
    local resultReceived = false
    
    local connection
    connection = resultEvent.OnServerEvent:Connect(function(plr, success)
        if plr == player and not resultReceived then
            resultReceived = true
            miniGameSuccess = success
            connection:Disconnect()
        end
    end)
    
    local timeoutTask = task.delay(60, function()
        if not resultReceived then
            resultReceived = true
            miniGameSuccess = false
            connection:Disconnect()
        end
    end)
    
    -- Attend résultat
    while not resultReceived do
        task.wait(0.1)
    end
    
    if not miniGameSuccess then
        -- Échec du mini-jeu : ligne cassée, pas de poisson
        if castTrack then castTrack:Stop() end
        if fishingRod and fishingRod.Parent then
            fishingRod:Destroy()
        end
        activeFishing[player] = nil
        showFloatingText(character, "💔 La ligne a cassé!")
        return
    end
    
    -- Incrémente les stats de pêche pour les achievements
    if PlayerProgressService then
        PlayerProgressService.IncrementStat(player, "FishCaught", 1)
        
        if fishInfo.name == "legendaire" then
            PlayerProgressService.IncrementStat(player, "LegendaryFishCaught", 1)
        elseif fishInfo.name == "rare" then
            PlayerProgressService.IncrementStat(player, "RareFishCaught", 1)
        end
    end
    
    -- Animation de remonter avec effet visuel du poisson
    local reelTrack = playAnimation(character, REEL_ANIMATION_ID)
    task.wait(0.5)
    
    -- Crée un poisson visuel "réaliste" sortant de l'eau
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if fishingRod then fishingRod:Destroy() end
        activeFishing[player] = nil
        return
    end
    
    local fishModel, scale = createFishVisual(fishInfo)
    local body = fishModel.PrimaryPart
    
    -- Trouver la surface de l'eau (lac généré)
    local lake
    local terrainFolder = workspace:FindFirstChild("CampingTerrain")
    if terrainFolder then
        lake = terrainFolder:FindFirstChild("Lake")
    end
    lake = lake or workspace:FindFirstChild("Lake")

    local surfaceY
    if lake and lake:IsA("BasePart") then
        surfaceY = lake.Position.Y + (lake.Size.Y / 2)
    else
        surfaceY = hrp.Position.Y - 2 -- fallback
    end

    -- Point d’émergence devant le joueur, à la surface de l’eau
    local emergePos = (hrp.CFrame * CFrame.new(0, 0, -6)).Position
    emergePos = Vector3.new(emergePos.X, surfaceY - 0.8, emergePos.Z)
    body.CFrame = CFrame.new(emergePos) * CFrame.Angles(0, math.rad(180), 0)
    fishModel.Parent = workspace
    positionFishParts(fishModel)

    -- Effet d’éclaboussure
    local splash = Instance.new("ParticleEmitter")
    splash.Texture = "rbxassetid://241876227"
    splash.Speed = NumberRange.new(6, 10)
    splash.Lifetime = NumberRange.new(0.3, 0.7)
    splash.Rate = 150
    splash.EmissionDirection = Enum.NormalId.Top
    splash.Parent = body
    
    -- Tween d’émergence (monte puis arc vers le joueur)
    local infoRise = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local targetRise = { CFrame = body.CFrame * CFrame.new(0, 2.2, 0) }
    local tweenRise = TweenService:Create(body, infoRise, targetRise)
    tweenRise:Play()
    tweenRise.Completed:Wait()

    positionFishParts(fishModel)
    local infoArc = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local arcTargetPos = (hrp.CFrame * CFrame.new(0, 2.5, -2)).Position
    local tweenArc = TweenService:Create(body, infoArc, { CFrame = CFrame.new(arcTargetPos) * CFrame.Angles(0, math.rad(160), 0) })
    tweenArc:Play()
    tweenArc.Completed:Wait()
    positionFishParts(fishModel)

    -- Arrêt des particules
    splash.Enabled = false
    Debris:AddItem(splash, 1)

    -- Donne l'argent au joueur via le service d'économie (met à jour le GUI Cash)
    EconomyService.AddCash(player, reward)
    
    -- Ajouter le poisson à l'inventaire pour utilisation future comme appât
    local fishCount = FishingShopService.AddFishToInventory(player.UserId, fishInfo.name)

    -- Feedback visuel
    local message = string.format("%s (+%d$) [%d en stock]", fishInfo.name, reward, fishCount)
    showFloatingText(character, message)
    
    -- Nettoyage
    fishModel:Destroy()
    
    task.wait(0.5)
    
    if castTrack then castTrack:Stop() end
    if reelTrack then reelTrack:Stop() end
    
    if fishingRod and fishingRod.Parent then
        fishingRod:Destroy()
    end

    activeFishing[player] = nil
end

-- Ajoute leaderstats/Money pour les nouveaux joueurs
-- La création des leaderstats (Cash/Income) est gérée par EconomyService

-- Ajoute un ProximityPrompt "Pêcher" à chaque spot dans Workspace.FishingSpots
local function setupFishingSpots()
    local fishingFolder = workspace:FindFirstChild(FISHING_FOLDER_NAME)
    if not fishingFolder then
        print("[FishingSystem] Dossier '" .. FISHING_FOLDER_NAME .. "' introuvable, attente...")
        fishingFolder = workspace:WaitForChild(FISHING_FOLDER_NAME, 10)
        if not fishingFolder then
            print("[FishingSystem] Création du dossier '" .. FISHING_FOLDER_NAME .. "' vide.")
            fishingFolder = Instance.new("Folder")
            fishingFolder.Name = FISHING_FOLDER_NAME
            fishingFolder.Parent = workspace
        end
    end

    for _, spot in ipairs(fishingFolder:GetChildren()) do
        if spot:IsA("Model") or spot:IsA("BasePart") then
            local targetPart
            if spot:IsA("BasePart") then
                targetPart = spot
            else
                targetPart = spot.PrimaryPart or spot:FindFirstChildWhichIsA("BasePart")
            end

            if targetPart then
                local prompt = targetPart:FindFirstChildOfClass("ProximityPrompt")
                if not prompt then
                    prompt = Instance.new("ProximityPrompt")
                    prompt.ObjectText = "Pêche"
                    prompt.ActionText = "Pêcher"
                    prompt.HoldDuration = 0.5
                    prompt.MaxActivationDistance = 10
                    prompt.Parent = targetPart
                end

                prompt.Triggered:Connect(function(player)
                    startFishing(player)
                end)
            else
                warn("Impossible de trouver une partie cible pour un spot de pêche: " .. spot.Name)
            end
        end
    end
end

setupFishingSpots()
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="40">
        <Properties>
          <string name="Name">GolfKartSystem</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- FILE: GolfKartSystem.server.lua

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Pads
local startPad = workspace:WaitForChild("DragStartPad")
local finishPad = workspace:WaitForChild("DragFinishPad")
-- Note: Pas de pad de magasin, on utilise le ProShop existant côté jeu

-- Kart template (ton kart dans Workspace)
local kartTemplate = workspace:WaitForChild("Kart")
print("✅ Kart template trouvé:", kartTemplate.Name)

-- Kart folder
local kartFolder = Instance.new("Folder")
kartFolder.Name = "GolfKarts"
kartFolder.Parent = workspace

-- Remotes
local remotesFolder = ReplicatedStorage:FindFirstChild("GolfKartRemotes")
if not remotesFolder then
    remotesFolder = Instance.new("Folder")
    remotesFolder.Name = "GolfKartRemotes"
    remotesFolder.Parent = ReplicatedStorage
end

local function getOrCreateRemote(name, className)
    local remote = remotesFolder:FindFirstChild(name)
    if not remote then
        remote = Instance.new(className)
        remote.Name = name
        remote.Parent = remotesFolder
    end
    return remote
end

local ShiftGear = getOrCreateRemote("ShiftGear", "RemoteEvent")
local SetThrottle = getOrCreateRemote("SetThrottle", "RemoteEvent")
local SetBrake = getOrCreateRemote("SetBrake", "RemoteEvent")
local SetSteering = getOrCreateRemote("SetSteering", "RemoteEvent")
local RequestKartSpawn = getOrCreateRemote("RequestKartSpawn", "RemoteEvent")
local RequestKartDespawn = getOrCreateRemote("RequestKartDespawn", "RemoteEvent")
local RequestKartPurchase = getOrCreateRemote("RequestKartPurchase", "RemoteEvent")
local NotifyKartStatus = getOrCreateRemote("NotifyKartStatus", "RemoteEvent")
local RequestKartUpgrade = getOrCreateRemote("RequestKartUpgrade", "RemoteEvent") -- {type="engine|battery|tires", levels=1}

-- Constants
local RPM_MIN = 1000
local RPM_MAX = 7000
local RPM_YELLOW = 5000
local RPM_GREEN = 6000
local RPM_RED = 6500

local EARLY_SHIFT_THRESHOLD = 4000

local BOOST_YELLOW = 1.15
local BOOST_GREEN = 1.35
local BOOST_RED_PENALTY = 0.85
local BOOST_EARLY = 1.0

local BASE_SPEED = 40
local KART_COST = 200

local GEAR_RATIOS = {
    [1] = 0.4,
    [2] = 0.6,
    [3] = 0.8,
    [4] = 1.0,
    [5] = 1.2,
}

-- Torque curve
local function getTorqueFactor(rpm)
    if rpm < 1000 then
        return 0.2
    elseif rpm < 3000 then
        return 0.6
    elseif rpm < 5000 then
        return 0.9
    elseif rpm < 6000 then
        return 1.1
    elseif rpm < 6500 then
        return 1.3
    else
        return 0
    end
end

-- Player state
local playerState = {}

-- Create kart model (clone ton kart existant)
local function createKartModel(player)
    -- Clone ton kart
    local model = kartTemplate:Clone()
    model.Name = player.Name .. "_GolfKart"
    
    -- Trouve ou crée le PrimaryPart
    local base = model.PrimaryPart or model:FindFirstChild("Base") or model:FindFirstChildWhichIsA("BasePart")
    if not base then
        warn("Aucune part principale trouvée dans le kart!")
        return nil
    end
    
    -- S'assure que c'est le PrimaryPart
    if not model.PrimaryPart then
        model.PrimaryPart = base
    end
    
    -- Trouve le siège
    local seat = model:FindFirstChild("VehicleSeat", true) or model:FindFirstChild("Seat", true) or model:FindFirstChild("DriveSeat", true)
    if not seat then
        warn("Aucun siège trouvé dans le kart!")
        return nil
    end
    
    -- Configure le siège pour notre système
    if seat:IsA("VehicleSeat") then
        seat.MaxSpeed = 0
        seat.Torque = 0
        seat.TurnSpeed = 0
    end
    
    -- Ajoute BodyVelocity et BodyGyro si pas déjà présents
    local bodyVelocity = base:FindFirstChildOfClass("BodyVelocity")
    if not bodyVelocity then
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(500000, 0, 500000)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.P = 1250
        bodyVelocity.Parent = base
    end
    
    local bodyGyro = base:FindFirstChildOfClass("BodyGyro")
    if not bodyGyro then
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(0, 5000, 0)
        bodyGyro.P = 1000
        bodyGyro.D = 100
        bodyGyro.Parent = base
    end
    
    -- Attributes pour le système
    base:SetAttribute("Gear", 1)
    base:SetAttribute("RPM", RPM_MIN)
    base:SetAttribute("IsRacing", false)
    
    model.Parent = kartFolder
    
    print("✅ Kart cloné pour", player.Name)
    return model
end

-- Spawn kart
local function spawnKartForPlayer(player, cframe)
    local state = playerState[player]
    if not state then return end
    
    if state.kartModel then
        state.kartModel:Destroy()
        state.kartModel = nil
    end
    
    -- Orientation: calculer direction vers la ligne d'arrivée
    local startPos = cframe.Position
    local finishPos = finishPad:GetPivot().Position
    local direction = (finishPos - startPos).Unit
    local lookCFrame = CFrame.lookAt(startPos, startPos + direction)
    
    local model = createKartModel(player)
    model:SetPrimaryPartCFrame(lookCFrame)
    state.kartModel = model
    
    task.wait(0.1)
    
    local character = player.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        local seat = model:FindFirstChild("DriverSeat", true)
        if humanoid and seat and hrp then
            -- Téléporter le personnage dans le kart
            hrp.CFrame = lookCFrame * CFrame.new(0, 3, 0)
            task.wait(0.1)
            seat:Sit(humanoid)
        end
    end
end

-- Handle gear shift
local function handleShiftGear(player)
    local state = playerState[player]
    if not state then return end
    if not state.hasKart or not state.kartModel then return end
    if state.gear >= 5 then return end
    
    local rpm = state.rpm
    local boost = 1.0
    
    if rpm >= RPM_GREEN and rpm < RPM_RED then
        boost = BOOST_GREEN
    elseif rpm >= RPM_YELLOW and rpm < RPM_GREEN then
        boost = BOOST_YELLOW
    elseif rpm >= RPM_RED then
        boost = BOOST_RED_PENALTY
    elseif rpm < EARLY_SHIFT_THRESHOLD then
        boost = BOOST_EARLY
    end
    
    state.shiftBoost = boost
    state.gear += 1
    state.rpm = math.clamp(rpm * 0.6, RPM_MIN, RPM_RED - 100)
end

-- Handle throttle
local function handleSetThrottle(player, isDown)
    local state = playerState[player]
    if not state then return end
    if not state.hasKart or not state.kartModel then return end
    state.throttle = isDown and 1 or 0
end

-- Handle brake
local function handleSetBrake(player, isDown)
    local state = playerState[player]
    if not state then return end
    if not state.hasKart or not state.kartModel then return end
    state.brake = isDown and 1 or 0
end

-- Handle steering
local function handleSetSteering(player, value)
    local state = playerState[player]
    if not state then return end
    if not state.hasKart or not state.kartModel then return end
    state.steering = math.clamp(value, -1, 1)
end

-- Handle kart purchase
local function handleKartPurchase(player)
    local state = playerState[player]
    if not state then return end
    if state.hasKart then
        NotifyKartStatus:FireClient(player, "Vous avez déjà un kart!")
        return
    end
    
    local leaderstats = player:FindFirstChild("leaderstats")
    local coins = leaderstats and leaderstats:FindFirstChild("Coins")
    if not coins then return end
    
    if coins.Value >= KART_COST then
        coins.Value -= KART_COST
        state.hasKart = true
        NotifyKartStatus:FireClient(player, "Kart acheté pour " .. KART_COST .. "$!")
        
        -- Spawn immédiat du kart sur la ligne de départ
        local spawnCFrame = startPad:GetPivot() * CFrame.new(0, 1, -5)
        spawnKartForPlayer(player, spawnCFrame)
    else
        NotifyKartStatus:FireClient(player, "Pas assez d'argent! Coût: " .. KART_COST .. "$")
    end
end

-- Handle kart spawn
local function handleKartSpawn(player)
    local state = playerState[player]
    if not state then return end
    if not state.hasKart then
        NotifyKartStatus:FireClient(player, "Vous devez acheter un kart d'abord!")
        return
    end
    -- Toujours spawn à la ligne de départ du drag
    local spawnCFrame = startPad:GetPivot() * CFrame.new(0, 1, -5)
    spawnKartForPlayer(player, spawnCFrame)
end

-- Handle kart despawn
local function handleKartDespawn(player)
    local state = playerState[player]
    if not state then return end
    
    if state.kartModel then
        state.kartModel:Destroy()
        state.kartModel = nil
        NotifyKartStatus:FireClient(player, "Kart rangé")
    end
end

-- Player added
Players.PlayerAdded:Connect(function(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        leaderstats.Parent = player
    end
    
    local coins = leaderstats:FindFirstChild("Coins")
    if not coins then
        coins = Instance.new("IntValue")
        coins.Name = "Coins"
        coins.Value = 500
        coins.Parent = leaderstats
    end
    
    playerState[player] = {
        hasKart = false,
        kartModel = nil,
        gear = 1,
        rpm = RPM_MIN,
        throttle = 0,
        brake = 0,
        steering = 0,
        shiftBoost = 1.0,
        isRacing = false,
        raceStartTime = 0,
        bestDragTime = nil,
        upgrades = {engine=0, battery=0, tires=0},
    }
end)

-- Player removing
Players.PlayerRemoving:Connect(function(player)
    local state = playerState[player]
    if state and state.kartModel then
        state.kartModel:Destroy()
    end
    playerState[player] = nil
end)

-- Connect remotes
ShiftGear.OnServerEvent:Connect(handleShiftGear)
SetThrottle.OnServerEvent:Connect(handleSetThrottle)
SetBrake.OnServerEvent:Connect(handleSetBrake)
SetSteering.OnServerEvent:Connect(handleSetSteering)
RequestKartPurchase.OnServerEvent:Connect(handleKartPurchase)
RequestKartSpawn.OnServerEvent:Connect(handleKartSpawn)
RequestKartDespawn.OnServerEvent:Connect(handleKartDespawn)
RequestKartUpgrade.OnServerEvent:Connect(function(player, upgrade)
    -- upgrade = {type="engine"|"battery"|"tires", levels = number}
    local state = playerState[player]
    if not state then return end
    if not state.hasKart then
        NotifyKartStatus:FireClient(player, "Achetez un kart avant les améliorations.")
        return
    end
    local utype = typeof(upgrade) == "table" and upgrade.type or nil
    local levels = typeof(upgrade) == "table" and tonumber(upgrade.levels) or 0
    if not utype or levels == 0 then return end
    if utype ~= "engine" and utype ~= "battery" and utype ~= "tires" then return end
    
    local leaderstats = player:FindFirstChild("leaderstats")
    local coins = leaderstats and leaderstats:FindFirstChild("Coins")
    if not coins then return end
    
    -- Coût simple: 150$ par niveau d'upgrade
    local costPerLevel = 150
    local cost = costPerLevel * math.abs(levels)
    if coins.Value < cost then
        NotifyKartStatus:FireClient(player, "Pas assez d'argent pour l'upgrade ("..cost.."$)")
        return
    end
    coins.Value -= cost
    state.upgrades[utype] = (state.upgrades[utype] or 0) + levels
    NotifyKartStatus:FireClient(player, string.format("Upgrade %s %+d (reste %d$)", utype, levels, coins.Value))
end)


-- Drag start pad
local startPadPart = startPad:IsA("BasePart") and startPad or startPad:FindFirstChildWhichIsA("BasePart", true)
if not startPadPart then
    warn("[GolfKartSystem] DragStartPad n'a pas de BasePart, système de course désactivé")
else
    startPadPart.Touched:Connect(function(hit)
    local character = hit.Parent
    local player = Players:GetPlayerFromCharacter(character)
    if not player then return end
    
    local state = playerState[player]
    if not state or not state.hasKart then return end
    if state.isRacing then return end
    
    if not state.kartModel or not state.kartModel.Parent then
        local spawnCFrame = startPadPart.CFrame * CFrame.new(0, 1, -5)
        spawnKartForPlayer(player, spawnCFrame)
        task.wait(0.2)
    end
    
    state.gear = 1
    state.rpm = RPM_MIN
    state.shiftBoost = 1.0
    state.isRacing = true
    state.raceStartTime = tick()
    
    if state.kartModel then
        state.kartModel.PrimaryPart:SetAttribute("IsRacing", true)
    end
    
    NotifyKartStatus:FireClient(player, "Course lancée! Go!")
    end)
end

-- Drag finish pad (handle Model or BasePart)
local finishPadPart = finishPad:IsA("BasePart") and finishPad or finishPad:FindFirstChildWhichIsA("BasePart", true)
if not finishPadPart then
    warn("[GolfKartSystem] DragFinishPad n'a pas de BasePart, arrivée désactivée")
else
finishPadPart.Touched:Connect(function(hit)
    local character = hit.Parent
    local player = Players:GetPlayerFromCharacter(character)
    if not player then return end
    
    local state = playerState[player]
    if not state or not state.isRacing then return end
    
    local elapsed = tick() - state.raceStartTime
    state.isRacing = false
    
    if state.kartModel then
        state.kartModel.PrimaryPart:SetAttribute("IsRacing", false)
    end
    
    local reward = math.max(10, math.floor(200 - elapsed * 10))
    local leaderstats = player:FindFirstChild("leaderstats")
    local coins = leaderstats and leaderstats:FindFirstChild("Coins")
    if coins then
        coins.Value += reward
    end
    
    if not state.bestDragTime or elapsed < state.bestDragTime then
        state.bestDragTime = elapsed
        NotifyKartStatus:FireClient(player, string.format("🏁 Nouveau record: %.2fs! +%d$", elapsed, reward))
    else
        NotifyKartStatus:FireClient(player, string.format("🏁 Temps: %.2fs! +%d$", elapsed, reward))
    end
end)
end

-- Main engine loop
RunService.Heartbeat:Connect(function(dt)
    for player, state in pairs(playerState) do
        if state.kartModel and state.kartModel.Parent then
            -- Gestion RPM
            if state.throttle > 0 then
                state.rpm = state.rpm + (800 * state.gear) * dt
            elseif state.brake > 0 then
                state.rpm = state.rpm - 300 * dt
            else
                state.rpm = state.rpm - 600 * dt
            end
            
            state.rpm = math.clamp(state.rpm, RPM_MIN, RPM_MAX)
            
            local torque = getTorqueFactor(state.rpm)
            local gearRatio = GEAR_RATIOS[state.gear] or 1.0
            local upgradeMultiplier = 1 + state.upgrades.engine * 0.1 + state.upgrades.battery * 0.05 + state.upgrades.tires * 0.03
            
            local speed = BASE_SPEED * gearRatio * torque * state.shiftBoost * upgradeMultiplier
            
            -- Si brake, vitesse négative (marche arrière)
            if state.brake > 0 and state.throttle == 0 then
                speed = -BASE_SPEED * 0.3
            end
            
            local base = state.kartModel.PrimaryPart
            local seat = state.kartModel:FindFirstChild("DriverSeat", true)
            
            if seat and seat.Occupant then
                local forward = seat.CFrame.LookVector
                local bodyVel = base:FindFirstChildOfClass("BodyVelocity")
                if bodyVel then
                    -- Mouvement: throttle = avant, brake = arrière
                    if state.throttle > 0 then
                        bodyVel.Velocity = forward * speed
                    elseif state.brake > 0 then
                        bodyVel.Velocity = forward * speed  -- speed est déjà négatif si brake
                    else
                        bodyVel.Velocity = Vector3.zero
                    end
                end
                
                local bodyGyro = base:FindFirstChildOfClass("BodyGyro")
                if bodyGyro then
                    -- Rotation basée sur steering et vitesse
                    if state.steering ~= 0 then
                        local currentSpeed = bodyVel.Velocity.Magnitude
                        local turnRate = state.steering * 3 * dt * (currentSpeed / 10 + 0.5)
                        local currentCFrame = bodyGyro.CFrame
                        bodyGyro.CFrame = currentCFrame * CFrame.Angles(0, turnRate, 0)
                    else
                        bodyGyro.CFrame = seat.CFrame
                    end
                end
            else
                local bodyVel = base:FindFirstChildOfClass("BodyVelocity")
                if bodyVel then
                    bodyVel.Velocity = Vector3.zero
                end
            end
            
            state.shiftBoost = state.shiftBoost + (1 - state.shiftBoost) * math.min(5 * dt, 1)
            
            base:SetAttribute("Gear", state.gear)
            base:SetAttribute("RPM", math.floor(state.rpm))
            base:SetAttribute("IsRacing", state.isRacing)
        end
    end
end)

print("✅ GolfKartSystem chargé")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="41">
        <Properties>
          <string name="Name">Leaderstats</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Leaderstats for Paradis
-- Creates leaderstats/Money for each player and reuses the same value for all game systems

local Players = game:GetService("Players")

local function setupLeaderstats(player: Player)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local money = leaderstats:FindFirstChild("Money")
	if not money then
		money = Instance.new("IntValue")
		money.Name = "Money"
		money.Value = 0
		money.Parent = leaderstats
	end
end

Players.PlayerAdded:Connect(setupLeaderstats)
for _, plr in ipairs(Players:GetPlayers()) do
	setupLeaderstats(plr)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="42">
        <Properties>
          <string name="Name">MazeRewardService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- MazeRewardService.server.lua
-- Système de récompense pour le labyrinthe

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Attendre le service d'économie
local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local EconomyService = shared.ParadisEconomyService or waitForShared("ParadisEconomyService")
local PlayerProgressService = shared.PlayerProgressService or waitForShared("PlayerProgressService")

-- ⚙️ CONFIGURATION
local MAZE_REWARD = 100 -- Argent gagné en complétant le labyrinthe
local COOLDOWN_TIME = 300 -- Cooldown de 5 minutes (300 secondes) avant de pouvoir recommencer
local MAZE_FOLDER_NAME = "Maze" -- Nom du dossier du labyrinthe dans Workspace
local START_PART_NAME = "MazeStart" -- Nom de la zone de départ
local END_PART_NAME = "MazeEnd" -- Nom de la zone d'arrivée

-- Suivre les joueurs qui ont complété récemment
local playerCooldowns = {} -- [UserId] = tick() du dernier succès
local playersInMaze = {} -- [UserId] = true si le joueur est entré dans le labyrinthe

-- Afficher un texte flottant au-dessus du joueur
local function showFloatingText(character, text, color)
    if not character then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(6, 0, 1, 0)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 28
    label.TextColor3 = color or Color3.fromRGB(255, 220, 0)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Text = text
    label.Parent = billboard
    
    game:GetService("Debris"):AddItem(billboard, 3)
end

-- Vérifier si le joueur est en cooldown
local function isOnCooldown(userId)
    local lastTime = playerCooldowns[userId]
    if not lastTime then
        return false
    end
    
    local elapsed = tick() - lastTime
    return elapsed < COOLDOWN_TIME
end

-- Obtenir le temps restant de cooldown
local function getCooldownRemaining(userId)
    local lastTime = playerCooldowns[userId]
    if not lastTime then
        return 0
    end
    
    local elapsed = tick() - lastTime
    local remaining = COOLDOWN_TIME - elapsed
    return math.max(0, remaining)
end

-- Formater le temps en minutes:secondes
local function formatTime(seconds)
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%d:%02d", mins, secs)
end

-- Gérer l'entrée dans le labyrinthe (zone de départ)
local function onStartTouched(hit, startPart)
    local character = hit.Parent
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local player = Players:GetPlayerFromCharacter(character)
    if not player then return end
    
    local userId = player.UserId
    
    -- Marquer que le joueur est entré dans le labyrinthe
    if not playersInMaze[userId] then
        playersInMaze[userId] = true
        
        if isOnCooldown(userId) then
            local remaining = getCooldownRemaining(userId)
            showFloatingText(character, "⏰ Cooldown: " .. formatTime(remaining), Color3.fromRGB(255, 100, 100))
            print("[MazeReward]", player.Name, "est en cooldown pour", formatTime(remaining))
        else
            showFloatingText(character, "🏁 Trouve la sortie du labyrinthe!", Color3.fromRGB(100, 200, 255))
            print("[MazeReward]", player.Name, "entre dans le labyrinthe")
        end
    end
end

-- Gérer l'arrivée à la fin du labyrinthe
local function onEndTouched(hit, endPart)
    local character = hit.Parent
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    
    local player = Players:GetPlayerFromCharacter(character)
    if not player then return end
    
    local userId = player.UserId
    
    -- Vérifier que le joueur est entré par le début
    if not playersInMaze[userId] then
        showFloatingText(character, "⚠️ Tu dois commencer par l'entrée!", Color3.fromRGB(255, 150, 0))
        return
    end
    
    -- Vérifier le cooldown
    if isOnCooldown(userId) then
        local remaining = getCooldownRemaining(userId)
        showFloatingText(character, "⏰ Cooldown: " .. formatTime(remaining), Color3.fromRGB(255, 100, 100))
        return
    end
    
    -- Donner la récompense
    local success = EconomyService.AddMoney(player, MAZE_REWARD)
    
    if success then
        showFloatingText(character, "🎉 +" .. MAZE_REWARD .. " $!", Color3.fromRGB(50, 255, 50))
        print("[MazeReward]", player.Name, "a complété le labyrinthe! Récompense:", MAZE_REWARD .. "$")
        
        -- Incrémente les stats de maze pour les achievements
        if PlayerProgressService then
            PlayerProgressService.IncrementStat(player, "MazesCompleted", 1)
        end
        
        -- Ajouter au cooldown
        playerCooldowns[userId] = tick()
        
        -- Retirer du labyrinthe
        playersInMaze[userId] = nil
        
        -- Effet de particules
        local sparkles = Instance.new("Sparkles")
        sparkles.SparkleColor = Color3.fromRGB(255, 215, 0)
        sparkles.Parent = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
        game:GetService("Debris"):AddItem(sparkles, 2)
    else
        warn("[MazeReward] Échec de l'ajout d'argent pour", player.Name)
    end
end

-- Nettoyer quand un joueur quitte
local function onPlayerRemoving(player)
    local userId = player.UserId
    playersInMaze[userId] = nil
    -- On garde le cooldown même après déconnexion (dans cette session serveur)
end

Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Initialisation
wait(3)

local maze = workspace:FindFirstChild(MAZE_FOLDER_NAME)
if not maze then
    warn("[MazeReward] ⚠️ Dossier '" .. MAZE_FOLDER_NAME .. "' introuvable dans Workspace!")
    warn("[MazeReward] Créez un dossier 'Maze' et ajoutez-y deux Parts:")
    warn("[MazeReward]   - 'MazeStart' à l'entrée (toucher = début)")
    warn("[MazeReward]   - 'MazeEnd' à la sortie (toucher = récompense)")
    return
end

-- Trouver la zone de départ
local startPart = maze:FindFirstChild(START_PART_NAME)
if startPart and startPart:IsA("BasePart") then
    startPart.Touched:Connect(function(hit)
        onStartTouched(hit, startPart)
    end)
    startPart.Color = Color3.fromRGB(100, 255, 100) -- Vert pour l'entrée
    startPart.Material = Enum.Material.Neon
    print("[MazeReward] ✅ Zone de départ connectée:", startPart.Name)
else
    warn("[MazeReward] ⚠️ Part '" .. START_PART_NAME .. "' introuvable dans le dossier Maze!")
end

-- Trouver la zone d'arrivée
local endPart = maze:FindFirstChild(END_PART_NAME)
if endPart and endPart:IsA("BasePart") then
    endPart.Touched:Connect(function(hit)
        onEndTouched(hit, endPart)
    end)
    endPart.Color = Color3.fromRGB(255, 215, 0) -- Doré pour la sortie
    endPart.Material = Enum.Material.Neon
    print("[MazeReward] ✅ Zone d'arrivée connectée:", endPart.Name)
else
    warn("[MazeReward] ⚠️ Part '" .. END_PART_NAME .. "' introuvable dans le dossier Maze!")
end

print("[MazeReward] ✅ Système de récompense du labyrinthe initialisé!")
print("[MazeReward] 💰 Récompense:", MAZE_REWARD .. "$")
print("[MazeReward] ⏰ Cooldown:", formatTime(COOLDOWN_TIME))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">MiniGamesConfigDefaults.module</string>
          <string name="Source"><![CDATA[local MiniGamesConfigDefaults = {}

MiniGamesConfigDefaults.SwingGame = {
    PivotPosition = Vector3.new(-120, 8, 60),
    SeatOffset = Vector3.new(0, -6, 0),
    RewardPerFullLoop = 5,
    MinRadius = 3,
    PushAngularImpulse = 4,
    ForwardKeys = { Enum.KeyCode.W, Enum.KeyCode.Up },
    BackwardKeys = { Enum.KeyCode.S, Enum.KeyCode.Down },
    ModelName = "Swing",
    PivotName = "SwingPivot",
    SeatName = "Seat",
    AutoCreateModel = false,
    Swings = {
        {
            ModelName = "Swing",
            PivotName = "SwingPivot",
            SeatName = "Seat",
        },
        {
            ModelName = "Swing2",
            PivotName = "SwingPivot",
            SeatName = "Seat",
        },
    },
    ComboWindowSeconds = 3,
    ComboBonusPerLoop = 2,
}

MiniGamesConfigDefaults.FishingGame = {
    Spots = {
        { Name = "FishingSpot1", Position = Vector3.new(-60, 1, -150) },
        { Name = "FishingSpot2", Position = Vector3.new(-20, 1, -170) },
        { Name = "FishingSpot3", Position = Vector3.new(20, 1, -180) },
        { Name = "FishingSpot4", Position = Vector3.new(60, 1, -170) },
        { Name = "FishingSpot5", Position = Vector3.new(100, 1, -160) },
    },

    FishRewards = {
        Small = { Label = "Petit poisson", MinReward = 3, MaxReward = 7 },
        Medium = { Label = "Poisson moyen", MinReward = 8, MaxReward = 15 },
        Large = { Label = "Gros poisson", MinReward = 16, MaxReward = 30 },
        Rare = { Label = "Poisson rare", MinReward = 31, MaxReward = 60 },
    },

    FishProbabilities = {
        Small = 0.45,
        Medium = 0.30,
        Large = 0.20,
        Rare = 0.05,
    },

    CooldownSeconds = 5,
}

return MiniGamesConfigDefaults
]]></string>
