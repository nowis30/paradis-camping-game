      <Item class="LocalScript" referent="84">
        <Properties>
          <string name="Name">CampingDetailsClient</string>
          <string name="Source"><![CDATA[--[[
    CampingDetailsClient.client.lua
    Gère l'interaction avec les pancartes des parcelles et affiche l'interface des détails
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Attendre les remotes
local CampingDetailsRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CampingDetailsRemotes"))
local GetCampingDetails = CampingDetailsRemotes.GetCampingDetails
local RequestPurchaseItem = CampingDetailsRemotes.RequestPurchaseItem
local CampingDetailsUpdated = CampingDetailsRemotes.CampingDetailsUpdated

-- Attendre la GUI
local campingDetailsGui = playerGui:WaitForChild("CampingDetailsGui")
local mainFrame = campingDetailsGui:WaitForChild("MainFrame")
local closeButton = mainFrame:WaitForChild("CloseButton")
local titleLabel = mainFrame:WaitForChild("TitleLabel")
local incomeLabel = mainFrame:WaitForChild("IncomeLabel")
local cashLabel = mainFrame:WaitForChild("CashLabel")
local ownedItemsFrame = mainFrame:WaitForChild("OwnedItemsFrame")
local upgradesFrame = mainFrame:WaitForChild("UpgradesFrame")
local statusLabel = mainFrame:WaitForChild("StatusLabel")

local currentCampingData = nil

-- Fonction pour créer un élément d'objet possédé
local function createOwnedItemElement(itemData)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 30)
    frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    frame.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = string.format("✅ %s (Niv. %d) - +%d $/tick", 
        itemData.DisplayName, 
        itemData.Level, 
        itemData.Income)
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(200, 255, 200)
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    return frame
end

-- Fonction pour créer un élément d'upgrade
local function createUpgradeElement(upgradeData)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 90)
    frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    frame.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame
    
    -- Titre de l'upgrade
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -100, 0, 20)
    titleLabel.Position = UDim2.new(0, 8, 0, 5)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = string.format("%s (Niv. %d)", upgradeData.DisplayName, upgradeData.Level)
    titleLabel.TextSize = 14
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = frame
    
    -- Income de l'upgrade
    local incomeLabel = Instance.new("TextLabel")
    incomeLabel.Size = UDim2.new(1, -100, 0, 15)
    incomeLabel.Position = UDim2.new(0, 8, 0, 25)
    incomeLabel.BackgroundTransparency = 1
    incomeLabel.Text = string.format("💰 +%d $/tick", upgradeData.Income)
    incomeLabel.TextSize = 12
    incomeLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    incomeLabel.Font = Enum.Font.Gotham
    incomeLabel.TextXAlignment = Enum.TextXAlignment.Left
    incomeLabel.Parent = frame
    
    -- Achievements requis
    local achievementsText = ""
    for i, achievement in ipairs(upgradeData.Achievements) do
        local icon = achievement.Completed and "✅" or "❌"
        achievementsText = achievementsText .. icon .. " " .. achievement.Name
        if i < #upgradeData.Achievements then
            achievementsText = achievementsText .. ", "
        end
    end
    
    local achievementsLabel = Instance.new("TextLabel")
    achievementsLabel.Size = UDim2.new(1, -100, 0, 15)
    achievementsLabel.Position = UDim2.new(0, 8, 0, 42)
    achievementsLabel.BackgroundTransparency = 1
    achievementsLabel.Text = achievementsText
    achievementsLabel.TextSize = 11
    achievementsLabel.TextColor3 = upgradeData.HasAllAchievements and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(255, 150, 150)
    achievementsLabel.Font = Enum.Font.Gotham
    achievementsLabel.TextXAlignment = Enum.TextXAlignment.Left
    achievementsLabel.TextWrapped = true
    achievementsLabel.Parent = frame
    
    -- Coût
    local costLabel = Instance.new("TextLabel")
    costLabel.Size = UDim2.new(1, -100, 0, 15)
    costLabel.Position = UDim2.new(0, 8, 0, 60)
    costLabel.BackgroundTransparency = 1
    costLabel.Text = string.format("💵 Coût : %d $", upgradeData.Cost)
    costLabel.TextSize = 12
    costLabel.TextColor3 = upgradeData.CanAfford and Color3.fromRGB(255, 255, 150) or Color3.fromRGB(255, 100, 100)
    costLabel.Font = Enum.Font.Gotham
    costLabel.TextXAlignment = Enum.TextXAlignment.Left
    costLabel.Parent = frame
    
    -- Bouton améliorer
    local buyButton = Instance.new("TextButton")
    buyButton.Size = UDim2.new(0, 80, 0, 30)
    buyButton.Position = UDim2.new(1, -88, 0, 30)
    buyButton.Text = "Améliorer"
    buyButton.TextSize = 13
    buyButton.Font = Enum.Font.GothamBold
    buyButton.Parent = frame
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 6)
    buttonCorner.Parent = buyButton
    
    -- Déterminer si le bouton est actif
    local canPurchase = upgradeData.CanAfford and upgradeData.HasAllAchievements
    
    if canPurchase then
        buyButton.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        buyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        buyButton.MouseButton1Click:Connect(function()
            buyButton.Text = "..."
            buyButton.Enabled = false
            RequestPurchaseItem:FireServer(upgradeData.ItemId)
            
            -- Attendre un peu puis réactualiser
            task.wait(0.5)
            refreshCampingDetails()
        end)
    else
        buyButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        buyButton.TextColor3 = Color3.fromRGB(150, 150, 150)
        buyButton.Enabled = false
        
        if not upgradeData.HasAllAchievements then
            buyButton.Text = "🔒 Succès"
        elseif not upgradeData.CanAfford then
            buyButton.Text = "🔒 Argent"
        end
    end
    
    return frame
end

-- Fonction pour rafraîchir les détails du camping
function refreshCampingDetails()
    local success, campingData = pcall(function()
        return GetCampingDetails:InvokeServer()
    end)
    
    if not success or not campingData then
        statusLabel.Text = "❌ Erreur lors du chargement des données"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    currentCampingData = campingData
    
    -- Mettre à jour le titre
    titleLabel.Text = string.format("Camping de %s", campingData.PlayerName)
    
    -- Mettre à jour l'income
    incomeLabel.Text = string.format("💰 Revenue : +%d $ / tick", campingData.TotalIncome)
    
    -- Mettre à jour le cash
    cashLabel.Text = string.format("💵 Argent disponible : %d $", campingData.Cash)
    
    -- Nettoyer les anciennes listes
    for _, child in ipairs(ownedItemsFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    for _, child in ipairs(upgradesFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Afficher les objets possédés
    if #campingData.OwnedItems == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, 0, 0, 30)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "Aucun objet pour l'instant"
        emptyLabel.TextSize = 14
        emptyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        emptyLabel.Font = Enum.Font.GothamItalic
        emptyLabel.TextXAlignment = Enum.TextXAlignment.Center
        emptyLabel.Parent = ownedItemsFrame
    else
        for _, item in ipairs(campingData.OwnedItems) do
            local element = createOwnedItemElement(item)
            element.Parent = ownedItemsFrame
        end
    end
    
    -- Afficher les upgrades disponibles
    if #campingData.AvailableUpgrades == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, 0, 0, 40)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "Aucune amélioration disponible\nVotre camping est au maximum !"
        emptyLabel.TextSize = 14
        emptyLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        emptyLabel.Font = Enum.Font.GothamItalic
        emptyLabel.TextXAlignment = Enum.TextXAlignment.Center
        emptyLabel.Parent = upgradesFrame
    else
        for _, upgrade in ipairs(campingData.AvailableUpgrades) do
            local element = createUpgradeElement(upgrade)
            element.Parent = upgradesFrame
        end
    end
    
    statusLabel.Text = ""
end

-- Fonction pour ouvrir la GUI
local function openCampingDetailsGui()
    campingDetailsGui.Enabled = true
    refreshCampingDetails()
end

-- Fonction pour fermer la GUI
local function closeCampingDetailsGui()
    campingDetailsGui.Enabled = false
    currentCampingData = nil
end

-- Connecter le bouton fermer
closeButton.MouseButton1Click:Connect(closeCampingDetailsGui)

-- Écouter les mises à jour du serveur
CampingDetailsUpdated.OnClientEvent:Connect(function()
    if campingDetailsGui.Enabled then
        refreshCampingDetails()
    end
end)

-- Fonction pour connecter les ProximityPrompts
local function connectProximityPrompts()
    local workspace = game:GetService("Workspace")
    
    -- Surveiller tous les ProximityPrompts dans le workspace
    local function onDescendantAdded(descendant)
        if descendant:IsA("ProximityPrompt") and descendant.Name == "CampingDetailsPrompt" then
            descendant.Triggered:Connect(function()
                openCampingDetailsGui()
            end)
        end
    end
    
    -- Connecter les prompts existants
    for _, descendant in ipairs(workspace:GetDescendants()) do
        onDescendantAdded(descendant)
    end
    
    -- Surveiller les nouveaux prompts
    workspace.DescendantAdded:Connect(onDescendantAdded)
end

-- Initialiser
connectProximityPrompts()

print("[CampingDetailsClient] ✅ Client initialisé")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="85">
        <Properties>
          <string name="Name">EconomyClient</string>
          <string name="Source"><![CDATA[--[[
    EconomyClient
    Affiche l'argent et le revenu passif du joueur via un petit HUD.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

local EconomyRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("EconomyRemotes"))
local HudEconomy = require(playerGui:WaitForChild("ParadisGui"):WaitForChild("HudEconomy"))
local EconomyFeedback = require(playerGui:WaitForChild("ParadisGui"):WaitForChild("EconomyFeedback"))

local hud = HudEconomy.create(playerGui)
local feedback = EconomyFeedback.new(hud.ScreenGui)
local currentBoostMultiplier = 1
local latestIncomeValue = 0

local function formatNumber(value)
    value = tonumber(value) or 0
    return math.floor(value * 100 + 0.5) / 100
end

local function formatText(value)
    return string.format("%.2f", formatNumber(value))
end

local function updateCash(value)
    hud.CashLabel.Text = string.format("Argent : %s $", formatText(value))
end

local function updateIncome(value)
    latestIncomeValue = tonumber(value) or 0
    local baseText = string.format("+%s $ / sec", formatText(latestIncomeValue))
    if currentBoostMultiplier and currentBoostMultiplier > 1.01 then
        baseText = string.format("%s (x%.2f)", baseText, currentBoostMultiplier)
    end
    hud.IncomeLabel.Text = baseText
end

local function updateBoost(payload)
    payload = payload or {}
    currentBoostMultiplier = payload.Multiplier or 1
    if payload.Active then
        local label = payload.Name or "Boost actif"
        local timeLeft = payload.TimeLeft or 0
        hud.BoostLabel.Text = string.format("Boost : %s (%.0fs)", label, math.max(0, math.floor(timeLeft)))
    else
        hud.BoostLabel.Text = "Boost : Aucun"
    end
    updateIncome(latestIncomeValue)
end

local success, snapshot = pcall(function()
    return EconomyRemotes.RequestSnapshot:InvokeServer()
end)
if success and snapshot then
    updateCash(snapshot.Cash)
    updateIncome(snapshot.IncomePerSecond)
    updateBoost(snapshot.Boost)
else
    updateCash(0)
    updateIncome(0)
end

EconomyRemotes.CashUpdated.OnClientEvent:Connect(updateCash)
EconomyRemotes.IncomeUpdated.OnClientEvent:Connect(updateIncome)
EconomyRemotes.BoostUpdated.OnClientEvent:Connect(updateBoost)
EconomyRemotes.PassiveTick.OnClientEvent:Connect(function(amount, reason, multiplier)
    feedback:Show(amount, reason, multiplier)
end)

if hud.SaveButton then
    local saving = false
    hud.SaveButton.MouseButton1Click:Connect(function()
        if saving then
            return
        end
        saving = true
        hud.SaveButton.Text = "Sauvegarde..."
        local ok, result = pcall(function()
            return EconomyRemotes.RequestManualSave:InvokeServer()
        end)
        if ok and result and result.Success then
            feedback:Show(0, "Sauvegarde réussie")
        else
            feedback:Show(0, "Erreur de sauvegarde")
        end
        task.delay(2, function()
            hud.SaveButton.Text = "Sauvegarder"
            saving = false
        end)
    end)
end

local function bindLeaderstat(statName, callback)
    local function attach(stat)
        callback(stat.Value)
        stat:GetPropertyChangedSignal("Value"):Connect(function()
            callback(stat.Value)
        end)
    end

    local function inspect(folder)
        local stat = folder:FindFirstChild(statName)
        if stat then
            attach(stat)
        end
        folder.ChildAdded:Connect(function(child)
            if child.Name == statName then
                attach(child)
            end
        end)
    end

    local existing = LocalPlayer:FindFirstChild("leaderstats")
    if existing then
        inspect(existing)
    end

    LocalPlayer.ChildAdded:Connect(function(child)
        if child.Name == "leaderstats" then
            inspect(child)
        end
    end)
end

bindLeaderstat("Cash", updateCash)
bindLeaderstat("IncomePerSecond", updateIncome)

-- Afficher le nombre de bûches transportées
local function updateLogs()
    local logs = LocalPlayer:GetAttribute("Logs") or 0
    if hud.LogsLabel then
        hud.LogsLabel.Text = string.format("🪵 Bûches : %d", logs)
    end
end

-- Mise à jour initiale
updateLogs()

-- Écouter les changements d'attribut Logs
LocalPlayer:GetAttributeChangedSignal("Logs"):Connect(updateLogs)

-- NOUVEAU: Écouter l'événement GrantIncome pour afficher feedback visuel
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local grantIncomeEvent = remotesFolder:WaitForChild("GrantIncome")

grantIncomeEvent.OnClientEvent:Connect(function(amount)
    print("[EconomyClient] 💰 Revenu TIC reçu:", amount, "$")
    -- Afficher feedback visuel
    if amount > 0 then
        feedback:Show(amount, "Revenu camping", 1)
    end
end)

print("[EconomyClient] ✅ Client d'économie initialisé avec listener GrantIncome")
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="86">
        <Properties>
          <string name="Name">FishingCodexClient</string>
          <string name="Source"><![CDATA[-- FishingCodexClient.client.lua
-- Petit codex affichant les poissons vus et à découvrir

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Config = ReplicatedStorage:WaitForChild("Config")
local FishingGearConfig = require(Config:WaitForChild("FishingGearConfig"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local FishingShopRemotes = require(Remotes:WaitForChild("FishingShopRemotes"))

local gui

local function buildUI(seen)
    if gui then gui:Destroy() end
    gui = Instance.new("ScreenGui")
    gui.Name = "FishingCodexGui"
    gui.ResetOnSpawn = false
    gui.Enabled = false
    gui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0.88, 0, 0.68, 0)
    frame.Position = UDim2.new(0.5, 0, 0.5, 0)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BackgroundColor3 = Color3.fromRGB(35,40,46)
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 32)
    title.Position = UDim2.new(0, 10, 0, 8)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextScaled = true
    title.TextColor3 = Color3.fromRGB(255,255,255)
    title.Text = "📖 Codex des poissons"
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, -20, 1, -56)
    list.Position = UDim2.new(0, 10, 0, 48)
    list.BackgroundTransparency = 1
    list.Parent = frame

    local function addEntry(idx, name, key)
        local row = Instance.new("TextLabel")
        row.Size = UDim2.new(1, 0, 0, 30)
        row.Position = UDim2.new(0, 0, 0, (idx-1)*32)
        row.BackgroundTransparency = 1
        row.Font = Enum.Font.Gotham
        row.TextSize = 18
        row.TextXAlignment = Enum.TextXAlignment.Left
        local discovered = seen[key] == true
        row.TextColor3 = discovered and Color3.fromRGB(200,255,200) or Color3.fromRGB(200,200,200)
        row.Text = string.format("%s %s", discovered and "✓" or "?", name)
        row.Parent = list
    end

    local i = 1
    addEntry(i, "Poisson commun", "Common"); i = i + 1
    addEntry(i, "Poisson rare", "rare"); i = i + 1
    addEntry(i, "Poisson légendaire", "legendaire"); i = i + 1

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 36, 0, 36)
    close.Position = UDim2.new(1, -46, 0, 10)
    close.BackgroundColor3 = Color3.fromRGB(200,60,60)
    close.Font = Enum.Font.GothamBold
    close.TextSize = 18
    close.TextColor3 = Color3.fromRGB(255,255,255)
    close.Text = "✕"
    close.Parent = frame
    close.MouseButton1Click:Connect(function()
        gui.Enabled = false
    end)
end

local function refresh()
    local ok, seen = pcall(function()
        return FishingShopRemotes.GetCodex:InvokeServer()
    end)
    if not ok then seen = {} end
    buildUI(seen or {})
end

local function toggle()
    if not gui then refresh() end
    gui.Enabled = not gui.Enabled
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.C then
        toggle()
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="87">
        <Properties>
          <string name="Name">FishingMiniGameClient</string>
          <string name="Source"><![CDATA[-- FishingMiniGameClient.client.lua
-- Gère le mini-jeu de pêche côté client : UI, input E, et animation du bras levé

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local startMiniGameEvent = remotesFolder:WaitForChild("StartFishingMiniGame")
local resultEvent = remotesFolder:WaitForChild("FishingMiniGameResult")

-- Animation de lever le bras (ID d'animation de pêche Roblox ou custom)
local REEL_ARM_ANIMATION_ID = "rbxassetid://0" -- Remplace par une vraie animation si disponible
local reelArmTrack

-- Charge l'animation de lever le bras
local function loadReelAnimation()
	if REEL_ARM_ANIMATION_ID == "rbxassetid://0" then
		return nil -- Pas d'animation disponible
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = REEL_ARM_ANIMATION_ID
	return humanoid:LoadAnimation(anim)
end

-- Démarre le mini-jeu quand le serveur l'ordonne
startMiniGameEvent.OnClientEvent:Connect(function(fishRarity)
	print("[FishingMiniGameClient] Démarrage mini-jeu pour rareté:", fishRarity)
	
	-- Charge le module du mini-jeu
	local TensionMiniGame = require(ReplicatedStorage:WaitForChild("FishingTensionMiniGame"))
	
	-- Charge l'animation du bras
	reelArmTrack = loadReelAnimation()
	
	-- Hook le mini-jeu pour jouer l'animation quand le joueur tire
	local originalRun = TensionMiniGame.Run
	TensionMiniGame.Run = function(plr, rarity)
		-- Lance le mini-jeu original avec animation du bras
		local gui -- référence à l'UI créée
		local isPulling = false
		
		-- Patch le comportement d'input pour ajouter l'animation
		local UserInputService = game:GetService("UserInputService")
		local inputConnection
		
		inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if input.KeyCode == Enum.KeyCode.E then
				isPulling = true
				-- Joue l'animation du bras levé
				if reelArmTrack then
					reelArmTrack:Play(0.1, 1, 1.2) -- Joue en boucle plus rapide
				end
			end
		end)
		
		local inputEndConnection
		inputEndConnection = UserInputService.InputEnded:Connect(function(input, processed)
			if input.KeyCode == Enum.KeyCode.E then
				isPulling = false
				-- Arrête l'animation du bras
				if reelArmTrack then
					reelArmTrack:Stop(0.2)
				end
			end
		end)
		
		-- Lance le mini-jeu
		local success = originalRun(plr, rarity)
		
		-- Nettoie les connections
		if inputConnection then inputConnection:Disconnect() end
		if inputEndConnection then inputEndConnection:Disconnect() end
		if reelArmTrack then reelArmTrack:Stop(0.1) end
		
		return success
	end
	
	-- Exécute le mini-jeu
	local success = TensionMiniGame.Run(player, fishRarity)
	
	-- Envoie le résultat au serveur
	resultEvent:FireServer(success)
	print("[FishingMiniGameClient] Résultat envoyé:", success)
end)

-- Recharge l'animation si le personnage respawn
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = character:WaitForChild("Humanoid")
	reelArmTrack = loadReelAnimation()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="88">
        <Properties>
          <string name="Name">FishingShopClient</string>
          <string name="Source"><![CDATA[--[[
    FishingShopClient
    Interface du Pro Shop pour acheter cannes et appâts
]]

print("[FishingShopClient] Script démarré!")

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

print("[FishingShopClient] Services chargés")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config", 10)
if not ConfigFolder then
    warn("[FishingShopClient] Config folder non trouvé!")
    return
end

local FishingGearConfig = require(ConfigFolder:WaitForChild("FishingGearConfig", 10))
if not FishingGearConfig then
    warn("[FishingShopClient] FishingGearConfig non trouvé!")
    return
end
print("[FishingShopClient] FishingGearConfig chargé")

local RemotesFolder = ReplicatedStorage:WaitForChild("Remotes", 10)
if not RemotesFolder then
    warn("[FishingShopClient] Remotes folder non trouvé!")
    return
end

local FishingShopRemotes = require(RemotesFolder:WaitForChild("FishingShopRemotes", 10))
if not FishingShopRemotes then
    warn("[FishingShopClient] FishingShopRemotes non trouvé!")
    return
end
print("[FishingShopClient] Remotes chargés")

-- Remotes de construction pour connaître l'état d'aménagement (build mode)
local BuildRemotes = require(RemotesFolder:WaitForChild("BuildRemotes", 10))
local buildModeActive = false
local proShopPrompts = {}

local function setShopActive(active)
    -- Active/Désactive les prompts et ferme le panneau si désactivé
    for _, prompt in ipairs(proShopPrompts) do
        if prompt and prompt.Parent then
            prompt.Enabled = active
        end
    end
    if not active then
        panel.Visible = false
    end
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FishingShopGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = PlayerGui

-- Panel principal
local panel = Instance.new("Frame")
panel.Name = "ShopPanel"
panel.Size = UDim2.new(0.92, 0, 0.82, 0)
panel.Position = UDim2.new(0.5, 0, 0.5, 0)
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = screenGui

local panelCorner = Instance.new("UICorner")
panelCorner.CornerRadius = UDim.new(0, 10)
panelCorner.Parent = panel

-- Titre
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -55, 0, 42)
title.Position = UDim2.new(0, 8, 0, 8)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(100, 200, 255)
title.Text = "🎣 PRO SHOP - Équipement de pêche"
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = panel

-- Bouton fermer
local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 38, 0, 38)
closeButton.Position = UDim2.new(1, -44, 0, 8)
closeButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
closeButton.Text = "✖"
closeButton.Font = Enum.Font.GothamBold
closeButton.TextScaled = true
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.Parent = panel

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeButton

-- Section Cannes
local rodsSection = Instance.new("Frame")
rodsSection.Size = UDim2.new(0.48, 0, 1, -64)
rodsSection.Position = UDim2.new(0.01, 0, 0, 56)
rodsSection.BackgroundColor3 = Color3.fromRGB(30, 36, 46)
rodsSection.BorderSizePixel = 0
rodsSection.Parent = panel

local rodsSectionCorner = Instance.new("UICorner")
rodsSectionCorner.CornerRadius = UDim.new(0, 8)
rodsSectionCorner.Parent = rodsSection

local rodsTitle = Instance.new("TextLabel")
rodsTitle.Size = UDim2.new(1, -10, 0, 30)
rodsTitle.Position = UDim2.new(0, 5, 0, 4)
rodsTitle.BackgroundTransparency = 1
rodsTitle.Font = Enum.Font.GothamBold
rodsTitle.TextScaled = true
rodsTitle.TextColor3 = Color3.fromRGB(255, 220, 100)
rodsTitle.Text = "🎣 Cannes à pêche"
rodsTitle.TextXAlignment = Enum.TextXAlignment.Left
rodsTitle.Parent = rodsSection

local rodsScroll = Instance.new("ScrollingFrame")
rodsScroll.Size = UDim2.new(1, -10, 1, -40)
rodsScroll.Position = UDim2.new(0, 5, 0, 36)
rodsScroll.BackgroundTransparency = 1
rodsScroll.BorderSizePixel = 0
rodsScroll.ScrollBarThickness = 8
rodsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
rodsScroll.Parent = rodsSection

local rodsLayout = Instance.new("UIListLayout")
rodsLayout.Padding = UDim.new(0, 8)
rodsLayout.Parent = rodsScroll

-- Section Appâts
local baitsSection = Instance.new("Frame")
baitsSection.Size = UDim2.new(0.48, 0, 0, 350)
baitsSection.Position = UDim2.new(0.51, 0, 0, 70)
baitsSection.BackgroundColor3 = Color3.fromRGB(30, 36, 46)
baitsSection.BorderSizePixel = 0
baitsSection.Parent = panel

local baitsSectionCorner = Instance.new("UICorner")
baitsSectionCorner.CornerRadius = UDim.new(0, 8)
baitsSectionCorner.Parent = baitsSection

local baitsTitle = Instance.new("TextLabel")
baitsTitle.Size = UDim2.new(1, -10, 0, 35)
baitsTitle.Position = UDim2.new(0, 5, 0, 5)
baitsTitle.BackgroundTransparency = 1
baitsTitle.Font = Enum.Font.GothamBold
baitsTitle.TextSize = 22
baitsTitle.TextColor3 = Color3.fromRGB(255, 220, 100)
baitsTitle.Text = "🪱 Appâts"
baitsTitle.TextXAlignment = Enum.TextXAlignment.Left
baitsTitle.Parent = baitsSection

local baitsScroll = Instance.new("ScrollingFrame")
baitsScroll.Size = UDim2.new(1, -10, 1, -45)
baitsScroll.Position = UDim2.new(0, 5, 0, 40)
baitsScroll.BackgroundTransparency = 1
baitsScroll.BorderSizePixel = 0
baitsScroll.ScrollBarThickness = 6
baitsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
baitsScroll.Parent = baitsSection

local baitsLayout = Instance.new("UIListLayout")
baitsLayout.Padding = UDim.new(0, 8)
baitsLayout.Parent = baitsScroll

-- Status bar
local statusBar = Instance.new("Frame")
statusBar.Size = UDim2.new(1, -20, 0, 60)
statusBar.Position = UDim2.new(0, 10, 1, -70)
statusBar.BackgroundColor3 = Color3.fromRGB(40, 50, 65)
statusBar.BorderSizePixel = 0
statusBar.Parent = panel

local statusCorner = Instance.new("UICorner")
statusCorner.CornerRadius = UDim.new(0, 8)
statusCorner.Parent = statusBar

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 1, 0)
statusLabel.Position = UDim2.new(0, 10, 0, 0)
statusLabel.BackgroundTransparency = 1
statusLabel.Font = Enum.Font.GothamSemibold
statusLabel.TextSize = 18
statusLabel.TextColor3 = Color3.fromRGB(200, 255, 200)
statusLabel.TextWrapped = true
statusLabel.TextXAlignment = Enum.TextXAlignment.Left
statusLabel.Text = "Canne: Basic | Appât: Aucun (0 restant) | Cash: 0$"
statusLabel.Parent = statusBar

local currentGear = {
    CurrentRod = "Basic",
    CurrentBait = "Standard",
    BaitUses = 5,
    OwnedRods = {Basic = true},
    Cash = 0,
    FishInventory = {Common = 0, rare = 0, legendaire = 0},
}

local function updateStatusBar()
    local rodName = FishingGearConfig.Rods[currentGear.CurrentRod].DisplayName or currentGear.CurrentRod
    local baitName = FishingGearConfig.Baits[currentGear.CurrentBait].DisplayName or "Aucun"
    local inv = currentGear.FishInventory or {Common = 0, rare = 0, legendaire = 0}
    statusLabel.Text = string.format("🎣 Canne: %s | 🪱 Appât: %s (%d) | 🐟 Stock: C:%d R:%d L:%d | 💰 %d$", 
        rodName, baitName, currentGear.BaitUses, inv.Common or 0, inv.rare or 0, inv.legendaire or 0, currentGear.Cash)
end

local function refreshGear()
    local gear = FishingShopRemotes.GetGear:InvokeServer()
    if gear then
        currentGear = gear
        updateStatusBar()
        buildUI()
    end
end

local function createRodButton(rodId, rodDef)
    local owned = currentGear.OwnedRods[rodId] == true
    local isCurrent = currentGear.CurrentRod == rodId
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 100)
    btn.BackgroundColor3 = isCurrent and Color3.fromRGB(50, 120, 80) or Color3.fromRGB(50, 60, 70)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = not owned
    btn.Parent = rodsScroll
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -10, 0, 24)
    nameLabel.Position = UDim2.new(0, 5, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 18
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Text = rodDef.DisplayName
    nameLabel.Parent = btn
    
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -10, 0, 16)
    descLabel.Position = UDim2.new(0, 5, 0, 30)
    descLabel.BackgroundTransparency = 1
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextSize = 14
    descLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.Text = rodDef.Description
    descLabel.Parent = btn
    
    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, -10, 0, 32)
    statsLabel.Position = UDim2.new(0, 5, 0, 48)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Font = Enum.Font.GothamMedium
    statsLabel.TextSize = 13
    statsLabel.TextColor3 = Color3.fromRGB(150, 220, 255)
    statsLabel.TextXAlignment = Enum.TextXAlignment.Left
    statsLabel.TextWrapped = true
    statsLabel.Text = string.format("Vitesse: x%.1f | Légendaire: +%d%% | Bonus rare: +%d", 
        rodDef.SpeedMultiplier, rodDef.LegendaryChance * 100, rodDef.RareBonus)
    statsLabel.Parent = btn
    
    local priceLabel = Instance.new("TextLabel")
    priceLabel.Size = UDim2.new(0, 100, 0, 20)
    priceLabel.Position = UDim2.new(1, -105, 1, -25)
    priceLabel.BackgroundTransparency = 1
    priceLabel.Font = Enum.Font.GothamBold
    priceLabel.TextSize = 16
    priceLabel.TextColor3 = owned and Color3.fromRGB(100, 255, 100) or (rodDef.RobuxPrice and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 220, 80))
    priceLabel.TextXAlignment = Enum.TextXAlignment.Right
    if owned then
        priceLabel.Text = "✓ Possédée"
    elseif rodDef.RobuxPrice then
        priceLabel.Text = "🔶 " .. rodDef.RobuxPrice .. " R$"
    else
        priceLabel.Text = rodDef.Cost .. " $"
    end
    priceLabel.Parent = btn
    
    if not owned then
        btn.MouseButton1Click:Connect(function()
            if rodDef.RobuxPrice then
                warn("[FishingShopClient] Achat Robux pour Master: fonctionnalité à implémenter (Developer Product ID requis)")
                -- TODO: game:GetService("MarketplaceService"):PromptProductPurchase(LocalPlayer, MASTER_ROD_PRODUCT_ID)
            else
                FishingShopRemotes.BuyRod:FireServer(rodId)
                task.wait(0.2)
                refreshGear()
            end
        end)
    end
end

local function createBaitButton(baitId, baitDef)
    -- Vérifier si c'est un appât poisson et si le joueur en a en stock
    local isFishBait = baitDef.RequiredFish ~= nil
    local fishCount = 0
    if isFishBait and currentGear.FishInventory then
        fishCount = currentGear.FishInventory[baitDef.RequiredFish] or 0
    end
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 100)
    btn.BackgroundColor3 = Color3.fromRGB(50, 60, 70)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = true
    btn.Parent = baitsScroll
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -10, 0, 24)
    nameLabel.Position = UDim2.new(0, 5, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextSize = 18
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Text = baitDef.DisplayName
    nameLabel.Parent = btn
    
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -10, 0, 16)
    descLabel.Position = UDim2.new(0, 5, 0, 30)
    descLabel.BackgroundTransparency = 1
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextSize = 14
    descLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.Text = baitDef.Description
    descLabel.Parent = btn
    
    local statsLabel = Instance.new("TextLabel")
    statsLabel.Size = UDim2.new(1, -10, 0, 32)
    statsLabel.Position = UDim2.new(0, 5, 0, 48)
    statsLabel.BackgroundTransparency = 1
    statsLabel.Font = Enum.Font.GothamMedium
    statsLabel.TextSize = 13
    statsLabel.TextColor3 = Color3.fromRGB(150, 220, 255)
    statsLabel.TextXAlignment = Enum.TextXAlignment.Left
    statsLabel.TextWrapped = true
    statsLabel.Text = string.format("Récompense: x%.1f | Légendaire: +%d%% | %d utilisations", 
        baitDef.RewardMultiplier, baitDef.LegendaryBoost * 100, baitDef.UsesPerPurchase)
    statsLabel.Parent = btn
    
    local priceLabel = Instance.new("TextLabel")
    priceLabel.Size = UDim2.new(0, 120, 0, 20)
    priceLabel.Position = UDim2.new(1, -125, 1, -25)
    priceLabel.BackgroundTransparency = 1
    priceLabel.Font = Enum.Font.GothamBold
    priceLabel.TextSize = 16
    priceLabel.TextXAlignment = Enum.TextXAlignment.Right
    
    if isFishBait then
        if fishCount > 0 then
            priceLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            priceLabel.Text = string.format("🐟 Stock: %d", fishCount)
        else
            priceLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
            priceLabel.Text = "Aucun en stock"
            btn.AutoButtonColor = false
        end
    else
        priceLabel.TextColor3 = Color3.fromRGB(255, 220, 80)
        priceLabel.Text = baitId == "None" and "Gratuit" or (baitDef.Cost .. " $")
    end
    priceLabel.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        if baitId == "None" then
            return
        end
        
        if isFishBait then
            -- Utiliser un poisson comme appât
            if fishCount > 0 then
                FishingShopRemotes.UseFishAsBait:FireServer(baitDef.RequiredFish)
                task.wait(0.2)
                refreshGear()
            end
        else
            -- Acheter un appât normal
            FishingShopRemotes.BuyBait:FireServer(baitId)
            task.wait(0.2)
            refreshGear()
        end
    end)
end

function buildUI()
    for _, child in ipairs(rodsScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    for _, child in ipairs(baitsScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    -- Créer boutons cannes triés par coût
    local rodsList = {}
    for id, def in pairs(FishingGearConfig.Rods) do
        table.insert(rodsList, {id = id, def = def})
    end
    table.sort(rodsList, function(a, b) return a.def.Cost < b.def.Cost end)
    
    for _, rod in ipairs(rodsList) do
        createRodButton(rod.id, rod.def)
    end
    
    -- Créer boutons appâts triés par coût
    local baitsList = {}
    for id, def in pairs(FishingGearConfig.Baits) do
        table.insert(baitsList, {id = id, def = def})
    end
    table.sort(baitsList, function(a, b) return a.def.Cost < b.def.Cost end)
    
    for _, bait in ipairs(baitsList) do
        createBaitButton(bait.id, bait.def)
    end
    
    rodsScroll.CanvasSize = UDim2.new(0, 0, 0, rodsLayout.AbsoluteContentSize.Y + 10)
    baitsScroll.CanvasSize = UDim2.new(0, 0, 0, baitsLayout.AbsoluteContentSize.Y + 10)
end

closeButton.MouseButton1Click:Connect(function()
    panel.Visible = false
end)

-- Détecter les ProShop dans le workspace
local function setupProShop(proShop)
    -- Chercher une Part : d'abord PrimaryPart, sinon n'importe quelle BasePart
    local targetPart = proShop.PrimaryPart
    if not targetPart then
        -- Chercher récursivement dans le modèle
        for _, descendant in ipairs(proShop:GetDescendants()) do
            if descendant:IsA("BasePart") then
                targetPart = descendant
                break
            end
        end
    end
    
    if not targetPart then
        warn("[FishingShopClient] Aucune Part trouvée dans:", proShop.Name)
        return
    end
    
    local prompt = targetPart:FindFirstChildOfClass("ProximityPrompt")
    if not prompt then
        prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Ouvrir le Pro Shop"
        prompt.ObjectText = "🎣 Pro Shop"
        prompt.KeyboardKeyCode = Enum.KeyCode.E
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = 15
        prompt.RequiresLineOfSight = false
        prompt.Style = Enum.ProximityPromptStyle.Default
        prompt.Enabled = not buildModeActive
        prompt.Parent = targetPart
        print("[FishingShopClient] ProximityPrompt créé sur:", targetPart.Name, "dans", proShop.Name)
    else
        print("[FishingShopClient] ProximityPrompt existant trouvé sur:", targetPart.Name)
        prompt.Enabled = not buildModeActive
    end
    table.insert(proShopPrompts, prompt)
    
    prompt.Triggered:Connect(function(player)
        if player == LocalPlayer then
            print("[FishingShopClient] Pro Shop ouvert par:", player.Name)
            if shared.ParadisOpenProShop then
                shared.ParadisOpenProShop()
            else
                -- Fallback: ancienne UI (désactivée par défaut)
                panel.Visible = true
                refreshGear()
            end
        end
    end)
end

-- Fonction pour scanner le workspace et setup les ProShop
local function scanForProShops()
    local found = 0
    for _, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("Model") and (descendant.Name == "ProShop" or descendant.Name == "Pro Shop" or descendant.Name == "ProShop_Cabin") then
            setupProShop(descendant)
            print("[FishingShopClient] Pro Shop trouvé:", descendant.Name)
            found = found + 1
        end
    end
    if found == 0 then
        warn("[FishingShopClient] Aucun Pro Shop trouvé dans le workspace!")
    end
    return found
end

-- Écouter les nouveaux ProShop
workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("Model") and (descendant.Name == "ProShop" or descendant.Name == "Pro Shop" or descendant.Name == "ProShop_Cabin") then
        task.wait(0.1)
        setupProShop(descendant)
        print("[FishingShopClient] Nouveau Pro Shop détecté:", descendant.Name)
    end
end)

-- Attendre que le personnage soit chargé puis chercher les ProShop
local function initializeProShop()
    task.wait(2)
    print("[FishingShopClient] Scan du workspace pour les ProShop...")
    scanForProShops()
    refreshGear()
end

-- Démarrer l'initialisation
task.spawn(initializeProShop)

-- Re-scanner quand le personnage respawn
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    scanForProShops()
end)

print("[Paradis][FishingShopClient] Interface Pro Shop chargée")

-- Écouter les changements de mode d'aménagement pour masquer la boutique
if BuildRemotes and BuildRemotes.ToggleBuildMode then
    BuildRemotes.ToggleBuildMode.OnClientEvent:Connect(function(state)
        buildModeActive = state and true or false
        setShopActive(not buildModeActive)
    end)
end
]]></string>
