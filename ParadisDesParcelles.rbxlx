            UnlockAtIncome = 0,
        },
        MurBoisFenetre = {
            Cost = 12,
            IncomePerSecond = 0.12,
            UnlockAtIncome = 0.1,
        },
        PlancherBois = {
            Cost = 10,
            IncomePerSecond = 0.12,
            UnlockAtIncome = 0.1,
        },
        ToitBois = {
            Cost = 25,
            IncomePerSecond = 0.35,
            UnlockAtIncome = 0.5,
        },
        CabanePleine = {
            Cost = 180,
