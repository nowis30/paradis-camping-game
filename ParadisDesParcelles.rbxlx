            IncomePerSecond = 0.08,
            UnlockAtIncome = 0,
        },
        TentSmall = {
            Cost = 60,
            IncomePerSecond = 0.5,
            UnlockAtIncome = 0.3,
        },
        TentLarge = {
            Cost = 90,
            IncomePerSecond = 0.8,
            UnlockAtIncome = 0.5,
        },
        FlowerPot = {
            Cost = 8,
            IncomePerSecond = 0.05,
            UnlockAtIncome = 0,
        },
        Bush = {
            Cost = 10,
            IncomePerSecond = 0.06,
            UnlockAtIncome = 0,
        },
        SignWood = {
            Cost = 12,
            IncomePerSecond = 0.02,
            UnlockAtIncome = 0,
        },
        Campfire = {
            Cost = 45,
            IncomePerSecond = 0.35,
            UnlockAtIncome = 0.2,
        },
        TravelTrailer1961 = {
            Cost = 250,
            IncomePerSecond = 2.2,
            UnlockAtIncome = 1.2,
        },
        ArbreVert = {
            Cost = 35,
            IncomePerSecond = 0.5,
            UnlockAtIncome = 0.25,
        },
        ArbreRose = {
            Cost = 40,
            IncomePerSecond = 0.55,
            UnlockAtIncome = 0.3,
        },
        Arbre_Gros = {
            Cost = 55,
            IncomePerSecond = 0.9,
            UnlockAtIncome = 0.5,
        },
        Arbre_Petit = {
            Cost = 20,
            IncomePerSecond = 0.25,
            UnlockAtIncome = 0.15,
        },
        -- Arbre à bois (LogNode) avec revenus; le coût réel est calculé dynamiquement
        LogNode = {
            Cost = 1000, -- Coût de base affiché; le placement calculera 1000 x10 par arbre supplémentaire
            IncomePerSecond = 1.0, -- Revenu par seconde par arbre
            UnlockAtIncome = 0.0,
        },
        -- Poissons décoratifs (aucun revenu, coût nul)
        Common = {
            Cost = 0,
            IncomePerSecond = 0,
            UnlockAtIncome = 0,
        },
        rare = {
