local function clearGhost()
    if ghostModel then
        ghostModel:Destroy()
        ghostModel = nil
    end
    placementCFrame = nil
end

local function applyGhostAppearance(model)
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.Anchored = true
            desc.CanCollide = false
            desc.CastShadow = false
            desc.Material = Enum.Material.ForceField
            desc.Color = Color3.fromRGB(120, 220, 255)
            desc.Transparency = 0.5
        elseif desc:IsA("Decal") or desc:IsA("Texture") then
            desc.Transparency = 0.5
        end
    end
end

local function selectItem(itemId)
    local def = ShopConfig.Items[itemId]
    selectedItemId = def and def.Id or nil
    selectedItemDef = def
    currentRotation = 0
    placementCFrame = nil
    clearGhost()

    if not def then
        selectedLabel.Text = "Aucun objet sélectionné"
        return
    end

    local template = ShopObjects:FindFirstChild(def.ModelName)
    if not template then
        selectedLabel.Text = "Modèle introuvable"
        warn("[Paradis][ShopClient] Modèle introuvable:", def.ModelName)
        return
    end

    ghostModel = template:Clone()
    applyGhostAppearance(ghostModel)
    ghostModel.Parent = workspace
    local _, size = ghostModel:GetBoundingBox()
    ghostHalfHeight = size.Y / 2
    selectedLabel.Text = string.format("%s - %d$", def.DisplayName or def.Id, def.Cost or 0)
end

local function buildItemButtons()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local bucket = {}
    for _, def in pairs(ShopConfig.Items or {}) do
        table.insert(bucket, def)
    end
    table.sort(bucket, function(a, b)
        if a.Category == b.Category then
            return (a.DisplayName or a.Id) < (b.DisplayName or b.Id)
        end
        return (a.Category or "") < (b.Category or "")
    end)

    local currentCategory
    local order = 0
    for _, def in ipairs(bucket) do
        if def.Category ~= currentCategory then
            currentCategory = def.Category
            order += 1
            local header = Instance.new("TextLabel")
            header.Name = "CategoryHeader"
            header.Size = UDim2.new(1, -4, 0, 26)
            header.BackgroundTransparency = 1
            header.TextColor3 = Color3.fromRGB(200, 220, 230)
            header.Font = Enum.Font.GothamSemibold
            header.TextXAlignment = Enum.TextXAlignment.Left
            header.TextSize = 18
            header.Text = string.upper(currentCategory or "Autre")
            header.LayoutOrder = order
            header.Parent = list
        end

        order += 1
        local button = Instance.new("TextButton")
        button.Name = "ItemButton"
        button.Size = UDim2.new(1, -4, 0, 56)
        button.BackgroundColor3 = Color3.fromRGB(50, 60, 70)
        button.TextColor3 = Color3.new(1, 1, 1)
        button.Font = Enum.Font.Gotham
        button.TextSize = 16
        button.TextWrapped = true
        button.LayoutOrder = order
        button.AutoButtonColor = true
        button.Text = string.format("%s\n%d $", def.DisplayName or def.Id, def.Cost or 0)
        button.Parent = list

        button.MouseButton1Click:Connect(function()
            selectItem(def.Id)
        end)
    end

    updateListCanvas()
end

buildItemButtons()

local function clampToPlot(position)
    if not currentPlot then
        return nil
    end
    local center = currentPlot.Center
    local size = currentPlot.Size
    if not center or not size then
        return nil
    end
    local halfX = size.X / 2 - 1
    local halfZ = size.Y / 2 - 1
    if halfX <= 0 or halfZ <= 0 then
        return nil
    end
    local dx = math.clamp(position.X - center.X, -halfX, halfX)
    local dz = math.clamp(position.Z - center.Z, -halfZ, halfZ)
    local snappedX = math.round(dx / gridSize) * gridSize
    local snappedZ = math.round(dz / gridSize) * gridSize
    snappedX = math.clamp(snappedX, -halfX, halfX)
    snappedZ = math.clamp(snappedZ, -halfZ, halfZ)
    local baseHeight = currentPlot.BaseHeight or center.Y
    local y = baseHeight + ghostHalfHeight
    return Vector3.new(center.X + snappedX, y, center.Z + snappedZ)
end

local function updateGhostPosition()
    if not (ghostModel and currentPlot and selectedItemId) then
        placementCFrame = nil
        if ghostModel then
            ghostModel:PivotTo(CFrame.new(0, -1000, 0))
        end
        return
    end

    local hit = mouse.Hit
    if not hit then
        return
    end
    local clamped = clampToPlot(hit.Position)
    if not clamped then
        placementCFrame = nil
        ghostModel:PivotTo(CFrame.new(0, -1000, 0))
        return
    end

    placementCFrame = CFrame.new(clamped) * CFrame.Angles(0, math.rad(currentRotation), 0)
    ghostModel:PivotTo(placementCFrame)
end

local function attemptPlacement()
    if not (selectedItemId and placementCFrame and currentPlot) then
        return
    end
    if tick() - lastPlacement < placementCooldown then
        return
    end
    lastPlacement = tick()
    PlaceShopItem:FireServer(selectedItemId, placementCFrame)
end

local function setPanelVisible(state)
    panel.Visible = state
    if not state then
        clearGhost()
    elseif selectedItemId then
        selectItem(selectedItemId)
    end
end

toggleButton.MouseButton1Click:Connect(function()
    setPanelVisible(not panel.Visible)
end)

BuildRemotes.PlotAssigned.OnClientEvent:Connect(function(plotData)
    currentPlot = plotData
    toggleButton.Visible = true
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end
    if input.KeyCode == Enum.KeyCode.R and panel.Visible and selectedItemId then
        currentRotation = (currentRotation + 45) % 360
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 and panel.Visible and selectedItemId then
        attemptPlacement()
    end
end)

RunService.RenderStepped:Connect(function()
    if panel.Visible then
        updateGhostPosition()
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    clearGhost()
    placementCFrame = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="94">
        <Properties>
          <string name="Name">SwingClient</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local swingFolder = remotesFolder:WaitForChild("SwingGame")
local pushEvent = swingFolder:WaitForChild("PushSwing")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")
local MiniGamesConfig = require(ConfigFolder:WaitForChild("MiniGamesConfig"))
local swingCfg = MiniGamesConfig.SwingGame or {}
local swingSeatNames = {}

local function registerSeatName(name)
    if name and name ~= "" then
        swingSeatNames[name] = true
    end
end

if typeof(swingCfg.Swings) == "table" then
    for _, cfg in ipairs(swingCfg.Swings) do
        registerSeatName(cfg.SeatName)
    end
end

if not next(swingSeatNames) then
    registerSeatName(swingCfg.SeatName)
end

if not next(swingSeatNames) then
    swingSeatNames["SwingSeat"] = true
end

local forwardKeys = {}
for _, keyCode in ipairs(swingCfg.ForwardKeys or {}) do
    forwardKeys[keyCode] = true
end

local backwardKeys = {}
for _, keyCode in ipairs(swingCfg.BackwardKeys or {}) do
    backwardKeys[keyCode] = true
end

local function isOnSwingSeat()
    local character = player.Character
    if not character then
        return false
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end
    local seatPart = humanoid.SeatPart
    return seatPart ~= nil and swingSeatNames[seatPart.Name]
end

UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end
    if not isOnSwingSeat() then
        return
    end

    local keyCode = input.KeyCode
    if forwardKeys[keyCode] then
        pushEvent:FireServer(1)
    elseif backwardKeys[keyCode] then
        pushEvent:FireServer(-1)
    end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="95">
        <Properties>
          <string name="Name">SwingCombo</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local swingFolder = remotesFolder:WaitForChild("SwingGame")
local comboEvent = swingFolder:WaitForChild("SwingComboUpdate")

-- ScreenGui setup
local gui = Instance.new("ScreenGui")
gui.Name = "SwingComboGui"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame")
frame.Name = "Container"
frame.BackgroundTransparency = 0.25
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.AnchorPoint = Vector2.new(0.5, 0)
frame.Size = UDim2.fromOffset(220, 42)
frame.Position = UDim2.new(0.5, 0, 0, 20)
frame.Parent = gui

local label = Instance.new("TextLabel")
label.Name = "ComboLabel"
label.Size = UDim2.fromScale(1, 1)
label.BackgroundTransparency = 1
label.TextColor3 = Color3.fromRGB(240, 240, 240)
label.Font = Enum.Font.GothamBold
label.TextScaled = true
label.Text = "" -- hidden until first combo
label.Parent = frame

local function showCombo(comboCount, reward)
    label.Text = string.format("Combo x%d  +%d$", comboCount, reward)
    gui.Parent = player:WaitForChild("PlayerGui")
    frame.BackgroundColor3 = comboCount > 1 and Color3.fromRGB(45, 90, 180) or Color3.fromRGB(25,25,25)
    frame.Visible = true
    label.TextTransparency = 0
    frame.BackgroundTransparency = 0.25

    local fadeDelay = 2.5
    task.delay(fadeDelay, function()
        if not label.Parent then return end
        local tween = TweenService:Create(label, TweenInfo.new(0.5), {TextTransparency = 1})
        tween:Play()
        local tween2 = TweenService:Create(frame, TweenInfo.new(0.5), {BackgroundTransparency = 1})
        tween2:Play()
        tween.Completed:Connect(function()
            frame.Visible = false
        end)
    end)
end

comboEvent.OnClientEvent:Connect(showCombo)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="96">
        <Properties>
          <string name="Name">WoodcuttingAnimations</string>
          <string name="Source"><![CDATA[-- WoodcuttingAnimations.client.lua
-- Joue une animation de "coup de hache" quand le joueur interagit avec un tronc (ProximityPrompt).
-- Nécessite un AnimationId valide (remplacer PLACEHOLDER_ANIMATION_ID). Utilise une animation basique si non fourni.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local currentHumanoid
local loadedAnimation

-- ID de l'animation à REMPLACER par ta propre animation (format rbxassetid://1234567890)
local SWING_ANIMATION_ID = "rbxassetid://0" -- 0 = aucun; remplace par une vraie ID
local CHOP_SOUND_ID = "rbxassetid://0" -- Remplace par un son de hache (ex: impact bois)
local BREAK_SOUND_ID = "rbxassetid://0" -- Remplace par un son plus fort (craquement)
local CHOP_SOUND_VOLUME = 0.8
local CHOP_SOUND_PITCH = 1
local PARTICLE_ENABLED = true
local PARTICLE_COLOR = ColorSequence.new(Color3.fromRGB(160,120,80), Color3.fromRGB(90,60,40))
local PARTICLE_TEXTURE = "" -- Optionnel: ajoute un asset de sprite de copeaux
local PARTICLE_LIFETIME = NumberRange.new(0.3,0.45)
local PARTICLE_SPEED = NumberRange.new(6,9)
local PARTICLE_EMIT_MIN = 8
local PARTICLE_EMIT_MAX = 12
local CARRY_LOG_MODEL_NAME = "CarryLogVisual" -- Nom interne du modèle visuel transporté
local LOG_ATTACH_OFFSET = Vector3.new(0, -0.5, -1.2) -- Position relative sur le torse

-- RemoteEvents (créés côté serveur dans WoodcutRemotes.lua)
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local woodcutHitEvent = remotesFolder:FindFirstChild("WoodcutHit")
local woodcutBreakEvent = remotesFolder:FindFirstChild("WoodcutBreak")
local campfireFedEvent = remotesFolder:FindFirstChild("CampfireFed")
local logsUpdatedEvent = remotesFolder:FindFirstChild("LogsUpdated")

-- Récupère le Humanoid actuel du joueur
local function getHumanoid()
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid
end

-- Charge l'animation si possible
local function ensureAnimationLoaded()
	if loadedAnimation then return end
	local humanoid = getHumanoid()
	if not humanoid then return end
	currentHumanoid = humanoid
	if SWING_ANIMATION_ID ~= "rbxassetid://0" then
		local anim = Instance.new("Animation")
		anim.AnimationId = SWING_ANIMATION_ID
		loadedAnimation = humanoid:LoadAnimation(anim)
	end
end

-- Joue l'animation courte de swing si chargée; sinon petite fallback: change la vitesse de marche brièvement
local function playSwing()
	ensureAnimationLoaded()
	if loadedAnimation then
		loadedAnimation:Play(0.1, 1, 1)
	end
end

-- Crée / met à jour l'affichage visuel des bûches transportées
local function updateCarryVisual(logCount)
	local character = player.Character
	if not character then return end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then return end

	local existing = character:FindFirstChild(CARRY_LOG_MODEL_NAME)
	if logCount <= 0 then
		if existing then existing:Destroy() end
		return
	end

	if not existing then
		existing = Instance.new("Model")
		existing.Name = CARRY_LOG_MODEL_NAME
		local part = Instance.new("Part")
		part.Name = "LogChunk"
		part.Size = Vector3.new(0.6, 0.6, 1.6)
		part.Color = Color3.fromRGB(92, 64, 51)
		part.Material = Enum.Material.Wood
		part.CanCollide = false
		part.Anchored = false
		part.Parent = existing
		existing.Parent = character

		-- Weld au torse
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = part
		weld.Parent = part
		part.CFrame = torso.CFrame * CFrame.new(LOG_ATTACH_OFFSET)
	end

	-- Ajuste transparence / petite animation quand le nombre change
	local part = existing:FindFirstChild("LogChunk")
	if part then
		part.Transparency = 0
		-- Ajoute un SurfaceGui simple qui montre le nombre
		local gui = part:FindFirstChild("CountGui")
		if not gui then
			gui = Instance.new("SurfaceGui")
			gui.Name = "CountGui"
			gui.Face = Enum.NormalId.Right
			gui.Adornee = part
			gui.Parent = part
			local label = Instance.new("TextLabel")
			label.Name = "Label"
			label.Size = UDim2.fromScale(1,1)
			label.BackgroundTransparency = 1
			label.TextScaled = true
			label.Font = Enum.Font.GothamBold
			label.TextColor3 = Color3.fromRGB(255, 225, 200)
			label.Parent = gui
		end
		local label = gui:FindFirstChild("Label")
		if label then
			label.Text = tostring(logCount)
		end
		-- Petit tween d'échelle pour feedback
		local tween = TweenService:Create(part, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = Vector3.new(0.7,0.7,1.8)})
		tween:Play()
		task.delay(0.2, function()
			if part then
				part.Size = Vector3.new(0.6,0.6,1.6)
			end
		end)
	end
end

-- Effet visuel sur coup de tronc
local function playHitEffect(node)
	if not node or not node:IsA("Model") then return end
	local part = node:FindFirstChild("LogPart")
	if not part then
		for _, c in ipairs(node:GetChildren()) do
			if c:IsA("BasePart") then part = c; break end
		end
	end
	if not part then return end
	-- Flash de couleur
	local originalColor = part.Color
	part.Color = Color3.fromRGB(160,120,80)
	task.delay(0.1, function()
		if part then
			part.Color = originalColor
		end
	end)

	-- Son d'impact
	if CHOP_SOUND_ID ~= "rbxassetid://0" then
		local sound = part:FindFirstChild("ChopSound")
		if not sound then
			sound = Instance.new("Sound")
			sound.Name = "ChopSound"
			sound.SoundId = CHOP_SOUND_ID
			sound.Volume = CHOP_SOUND_VOLUME
			sound.PlaybackSpeed = CHOP_SOUND_PITCH
			sound.Parent = part
		end
		sound:Play()
	end

	-- Particules de copeaux
	if PARTICLE_ENABLED then
		local emitter = part:FindFirstChild("ChipsEmitter")
		if not emitter then
			emitter = Instance.new("ParticleEmitter")
			emitter.Name = "ChipsEmitter"
			emitter.Texture = PARTICLE_TEXTURE
			emitter.Color = PARTICLE_COLOR
			emitter.Lifetime = PARTICLE_LIFETIME
			emitter.Rate = 0 -- On utilisera Emit
			emitter.Speed = PARTICLE_SPEED
			emitter.Rotation = NumberRange.new(0,360)
			emitter.RotSpeed = NumberRange.new(-80,80)
			emitter.SpreadAngle = Vector2.new(45,45)
			emitter.LightEmission = 0
			emitter.Size = NumberSequence.new{
				NumberSequenceKeypoint.new(0, 0.2),
				NumberSequenceKeypoint.new(1, 0.05)
			}
			emitter.Parent = part
		end
			local axePower = player:GetAttribute("AxePower") or 1
			local baseCount = math.random(PARTICLE_EMIT_MIN, PARTICLE_EMIT_MAX)
			local scaled = math.clamp(math.floor(baseCount * (0.7 + axePower * 0.3)), PARTICLE_EMIT_MIN, PARTICLE_EMIT_MAX * 4)
			emitter:Emit(scaled)
	end
end

-- Effet final de casse (sons + particules boostées + shake caméra)
local function playBreakEffect(node)
	if not node or not node:IsA("Model") then return end
	local part = node:FindFirstChild("LogPart")
	if not part then
		for _, c in ipairs(node:GetChildren()) do
			if c:IsA("BasePart") then part = c; break end
		end
	end
	if not part then return end

	-- Son de casse
	if BREAK_SOUND_ID ~= "rbxassetid://0" then
		local breakSound = part:FindFirstChild("BreakSound")
		if not breakSound then
			breakSound = Instance.new("Sound")
			breakSound.Name = "BreakSound"
			breakSound.SoundId = BREAK_SOUND_ID
			breakSound.Volume = CHOP_SOUND_VOLUME + 0.2
			breakSound.PlaybackSpeed = CHOP_SOUND_PITCH * 0.9
			breakSound.Parent = part
		end
		breakSound:Play()
	end

	-- Burst particules plus intense
	local emitter = part:FindFirstChild("ChipsEmitter")
	if emitter then
		local axePower = player:GetAttribute("AxePower") or 1
		local burst = math.clamp( math.floor( (PARTICLE_EMIT_MAX * 2) * (0.6 + axePower * 0.4) ), PARTICLE_EMIT_MAX, PARTICLE_EMIT_MAX * 6)
		emitter:Emit(burst)
	end

	-- Secousse caméra forte
	cameraShake(true)
end

-- Shake caméra (léger ou fort)
local shaking = false
function cameraShake(isFinal)
	if shaking then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	shaking = true
	local duration = isFinal and 0.35 or 0.18
	local magnitude = isFinal and 0.4 or 0.15
	local startTime = tick()
	local originalCFrame = cam.CFrame
	while tick() - startTime < duration do
		local offset = Vector3.new( (math.random()-0.5)*magnitude, (math.random()-0.5)*magnitude, (math.random()-0.5)*magnitude )
		cam.CFrame = originalCFrame * CFrame.new(offset)
		game:GetService("RunService").RenderStepped:Wait()
	end
	cam.CFrame = originalCFrame
	shaking = false
end

-- Effet visuel quand feu alimenté
local function playCampfireFed(playerWho, remainingLogs)
	-- Peut être étendu: chat message ou particules
	if playerWho == player then
		print("Feu alimenté. Logs restants: " .. tostring(remainingLogs))
	end
end

-- Connexion des RemoteEvents
if woodcutHitEvent then
	woodcutHitEvent.OnClientEvent:Connect(function(node, who)
		if who == player then
			playSwing()
			cameraShake(false)
		end
		playHitEffect(node)
	end)
end

if woodcutBreakEvent then
	woodcutBreakEvent.OnClientEvent:Connect(function(node, who)
		playBreakEffect(node)
	end)
end

if logsUpdatedEvent then
	logsUpdatedEvent.OnClientEvent:Connect(function(p, newCount)
		if p == player then
			updateCarryVisual(newCount or 0)
		end
	end)
end

if campfireFedEvent then
	campfireFedEvent.OnClientEvent:Connect(function(p, logsAfter)
		playCampfireFed(p, logsAfter)
	end)
end

-- Détermine si le prompt appartient à un tronc de WoodcuttingNodes
local function isLogPrompt(prompt)
	local parentPart = prompt.Parent
	if not parentPart or not parentPart:IsA("BasePart") then return false end
	local model = parentPart.Parent
	if not model or not model:IsA("Model") then return false end
	local nodesFolder = workspace:FindFirstChild("WoodcuttingNodes")
	if not nodesFolder then return false end
	return model.Parent == nodesFolder
end

-- Événement : quand un ProximityPrompt est déclenché par ce joueur
ProximityPromptService.PromptTriggered:Connect(function(prompt, triggeringPlayer)
	if triggeringPlayer ~= player then return end
	if isLogPrompt(prompt) then
		playSwing()
		-- Déclenche aussi un effet d'impact local même si le serveur n'a pas encore émis l'event
		local parentPart = prompt.Parent
		local model = parentPart and parentPart.Parent
		if model and model:IsA("Model") then
			playHitEffect(model)
		end
	end
end)

-- Recharge l'animation si le personnage respawn
player.CharacterAdded:Connect(function()
	loadedAnimation = nil
	currentHumanoid = nil
	ensureAnimationLoaded()
	updateCarryVisual(player:GetAttribute("Logs") or 0)
end)

-- Initial update if character already exists
if player.Character then
	updateCarryVisual(player:GetAttribute("Logs") or 0)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>