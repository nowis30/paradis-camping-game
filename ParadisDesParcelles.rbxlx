            MinCash = 600,
            Achievements = { "WoodMaster", "CaughtLegendaryFish" },
        },
    },
}

-- Catégories d'objets et leurs slots par défaut
CampingItemsConfig.Categories = {
    Trailer = {
        SlotName = "TrailerSlot",
        DefaultOffset = CFrame.new(0, 0, -8),
        Description = "Roulotte de camping",
    },
    BBQ = {
        SlotName = "BBQSlot",
        DefaultOffset = CFrame.new(-5, 0, 2),
        Description = "Barbecue",
    },
    PicnicTable = {
        SlotName = "PicnicTableSlot",
        DefaultOffset = CFrame.new(5, 0, 2),
        Description = "Table de pique-nique",
    },
    TreesGroup = {
        SlotName = "TreesSlot",
        DefaultOffset = CFrame.new(-8, 0, -5),
        Description = "Groupe d'arbres",
    },
    DecorRock = {
        SlotName = "RockSlot",
        DefaultOffset = CFrame.new(7, 0, -4),
        Description = "Rocher décoratif",
    },
    Campfire = {
        SlotName = "CampfireSlot",
        DefaultOffset = CFrame.new(0, 0, 4),
        Description = "Feu de camp",
    },
}

-- Liste des achievements disponibles
CampingItemsConfig.Achievements = {
    CaughtRareFish = {
        Id = "CaughtRareFish",
        DisplayName = "Pêcheur chanceux",
        Description = "Attraper un poisson rare",
        Icon = "🐟",
    },
    CaughtLegendaryFish = {
        Id = "CaughtLegendaryFish",
        DisplayName = "Maître pêcheur",
        Description = "Attraper un poisson légendaire",
        Icon = "🏆",
    },
    CompletedMaze = {
        Id = "CompletedMaze",
        DisplayName = "Explorateur du labyrinthe",
        Description = "Terminer le labyrinthe",
        Icon = "🗺️",
    },
    CompletedSwingLoops = {
        Id = "CompletedSwingLoops",
        DisplayName = "Acrobate",
        Description = "Faire 10 tours complets sur la balançoire",
        Icon = "🎪",
    },
    WoodMaster = {
        Id = "WoodMaster",
        DisplayName = "Bûcheron expert",
        Description = "Couper 50 bûches",
        Icon = "🪓",
    },
}

-- Fonctions utilitaires
function CampingItemsConfig.GetItem(itemId)
    return CampingItemsConfig.Items[itemId]
end

function CampingItemsConfig.GetItemsByCategory(category)
    local items = {}
    for itemId, itemData in pairs(CampingItemsConfig.Items) do
        if itemData.Category == category then
            table.insert(items, itemData)
        end
    end
    -- Trier par niveau
    table.sort(items, function(a, b) return a.Level < b.Level end)
    return items
end

function CampingItemsConfig.GetNextLevel(currentItemId)
    local current = CampingItemsConfig.GetItem(currentItemId)
    if not current then return nil end
    
    local categoryItems = CampingItemsConfig.GetItemsByCategory(current.Category)
    for i, item in ipairs(categoryItems) do
        if item.Level == current.Level + 1 then
            return item
        end
    end
    return nil
end

return CampingItemsConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CampsiteDefaultsConfig</string>
          <string name="Source"><![CDATA[--[[
    CampsiteDefaultsConfig
    Définit les objets par défaut qui sont automatiquement placés sur chaque parcelle
    quand un joueur la claim.
]]

local CampsiteDefaultsConfig = {}

-- Offsets relatifs au centre de la parcelle
-- Ces objets seront créés automatiquement et ne pourront pas être déplacés
CampsiteDefaultsConfig.DefaultObjects = {
    {
        Id = "Trailer",
        ModelName = "Trailer_Default",
        Offset = CFrame.new(0, 0, -8),  -- Roulotte au fond de la parcelle
        Description = "Roulotte de camping"
    },
    {
        Id = "PicnicTable",
        ModelName = "PicnicTable_Default",
        Offset = CFrame.new(5, 0, 2),  -- Table à droite
        Description = "Table de pique-nique"
    },
    {
        Id = "BBQ",
        ModelName = "BBQ_Default",
        Offset = CFrame.new(-5, 0, 2),  -- BBQ à gauche
        Description = "Barbecue"
    },
    {
        Id = "TreesGroup",
        ModelName = "TreesGroup_Default",
        Offset = CFrame.new(-8, 0, -5),  -- Groupe d'arbres coin gauche
        Description = "Groupe d'arbres"
    },
    {
        Id = "DecorRock",
        ModelName = "Rock_Default",
        Offset = CFrame.new(7, 0, -4),  -- Rocher décoratif coin droit
        Description = "Rocher décoratif"
    },
    {
        Id = "Campfire",
        ModelName = "Campfire_Default",
        Offset = CFrame.new(0, 0, 4),  -- Feu de camp devant
        Description = "Feu de camp"
    },
}

-- Tailles par défaut pour les placeholders (si le modèle n'existe pas)
CampsiteDefaultsConfig.PlaceholderSizes = {
    Trailer = Vector3.new(8, 4, 12),
    PicnicTable = Vector3.new(4, 2, 6),
    BBQ = Vector3.new(2, 3, 2),
    TreesGroup = Vector3.new(6, 8, 6),
    DecorRock = Vector3.new(3, 2, 3),
    Campfire = Vector3.new(3, 1, 3),
}

-- Couleurs par défaut pour les placeholders
CampsiteDefaultsConfig.PlaceholderColors = {
    Trailer = Color3.fromRGB(180, 180, 200),
    PicnicTable = Color3.fromRGB(120, 80, 40),
    BBQ = Color3.fromRGB(60, 60, 60),
    TreesGroup = Color3.fromRGB(50, 120, 50),
    DecorRock = Color3.fromRGB(120, 120, 120),
    Campfire = Color3.fromRGB(100, 50, 20),
}

-- Matériaux par défaut pour les placeholders
CampsiteDefaultsConfig.PlaceholderMaterials = {
    Trailer = Enum.Material.Metal,
    PicnicTable = Enum.Material.Wood,
    BBQ = Enum.Material.Metal,
    TreesGroup = Enum.Material.Grass,
    DecorRock = Enum.Material.Rock,
    Campfire = Enum.Material.Wood,
}

return CampsiteDefaultsConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">CampsiteUpgradesConfig</string>
          <string name="Source"><![CDATA[--[[
    CampsiteUpgradesConfig
    Configuration des upgrades pour les objets de camping
    (À implémenter complètement plus tard)
]]

local CampsiteUpgradesConfig = {}

-- Structure pour les upgrades futurs
-- Chaque objet peut avoir plusieurs niveaux d'upgrade
CampsiteUpgradesConfig.Upgrades = {
    Trailer = {
        MaxLevel = 5,
        Levels = {
            [1] = { ModelName = "Trailer_Default", Cost = 0, Description = "Roulotte basique" },
            [2] = { ModelName = "Trailer_Upgraded1", Cost = 500, Description = "Roulotte améliorée" },
            [3] = { ModelName = "Trailer_Upgraded2", Cost = 1500, Description = "Roulotte confortable" },
            [4] = { ModelName = "Trailer_Upgraded3", Cost = 3000, Description = "Roulotte luxueuse" },
            [5] = { ModelName = "Trailer_Upgraded4", Cost = 5000, Description = "Roulotte de luxe" },
        }
    },
    PicnicTable = {
        MaxLevel = 3,
        Levels = {
            [1] = { ModelName = "PicnicTable_Default", Cost = 0, Description = "Table basique" },
            [2] = { ModelName = "PicnicTable_Upgraded1", Cost = 300, Description = "Table en bon bois" },
            [3] = { ModelName = "PicnicTable_Upgraded2", Cost = 800, Description = "Table premium" },
        }
    },
    BBQ = {
        MaxLevel = 3,
        Levels = {
            [1] = { ModelName = "BBQ_Default", Cost = 0, Description = "BBQ simple" },
            [2] = { ModelName = "BBQ_Upgraded1", Cost = 400, Description = "BBQ amélioré" },
            [3] = { ModelName = "BBQ_Upgraded2", Cost = 1000, Description = "BBQ professionnel" },
        }
    },
    TreesGroup = {
        MaxLevel = 3,
        Levels = {
            [1] = { ModelName = "TreesGroup_Default", Cost = 0, Description = "Jeunes arbres" },
            [2] = { ModelName = "TreesGroup_Upgraded1", Cost = 200, Description = "Arbres matures" },
            [3] = { ModelName = "TreesGroup_Upgraded2", Cost = 600, Description = "Beaux arbres" },
        }
    },
    DecorRock = {
        MaxLevel = 2,
        Levels = {
            [1] = { ModelName = "Rock_Default", Cost = 0, Description = "Rocher simple" },
            [2] = { ModelName = "Rock_Upgraded1", Cost = 150, Description = "Rocher sculpté" },
        }
    },
    Campfire = {
        MaxLevel = 3,
        Levels = {
            [1] = { ModelName = "Campfire_Default", Cost = 0, Description = "Feu simple" },
            [2] = { ModelName = "Campfire_Upgraded1", Cost = 250, Description = "Foyer aménagé" },
            [3] = { ModelName = "Campfire_Upgraded2", Cost = 700, Description = "Foyer de pierre" },
        }
    },
}

-- Fonction helper pour obtenir les infos d'un niveau d'upgrade
function CampsiteUpgradesConfig.GetUpgradeInfo(objectId, level)
    local upgrades = CampsiteUpgradesConfig.Upgrades[objectId]
    if not upgrades then
        return nil
    end
    return upgrades.Levels[level]
end

-- Fonction helper pour obtenir le niveau max
function CampsiteUpgradesConfig.GetMaxLevel(objectId)
    local upgrades = CampsiteUpgradesConfig.Upgrades[objectId]
    if not upgrades then
        return 1
    end
    return upgrades.MaxLevel
end

return CampsiteUpgradesConfig
]]></string>
