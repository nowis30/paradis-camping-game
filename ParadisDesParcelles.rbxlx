      <Item class="Script" referent="44">
        <Properties>
          <string name="Name">MiniGamesService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local ConfigFolder = ReplicatedStorage:WaitForChild("Config")

local function buildDefaultMiniGamesConfig()
    return {
        SwingGame = {
            PivotPosition = Vector3.new(-120, 8, 60),
            SeatOffset = Vector3.new(0, -6, 0),
            RewardPerFullLoop = 5,
            MinRadius = 3,
            PushAngularImpulse = 4,
            ForwardKeys = { Enum.KeyCode.W, Enum.KeyCode.Up },
            BackwardKeys = { Enum.KeyCode.S, Enum.KeyCode.Down },
            ModelName = "Swing",
            PivotName = "SwingPivot",
            SeatName = "Seat",
            AutoCreateModel = false,
            Swings = {
                {
                    ModelName = "Swing",
                    PivotName = "SwingPivot",
                    SeatName = "Seat",
                },
                {
                    ModelName = "Swing2",
                    PivotName = "SwingPivot",
                    SeatName = "Seat",
                },
            },
            ComboWindowSeconds = 3,
            ComboBonusPerLoop = 2,
        },
        FishingGame = {
            Spots = {
                { Name = "FishingSpot1", Position = Vector3.new(-60, 1, -150) },
                { Name = "FishingSpot2", Position = Vector3.new(-20, 1, -170) },
                { Name = "FishingSpot3", Position = Vector3.new(20, 1, -180) },
                { Name = "FishingSpot4", Position = Vector3.new(60, 1, -170) },
                { Name = "FishingSpot5", Position = Vector3.new(100, 1, -160) },
            },
            FishRewards = {
                Small = { Label = "Petit poisson", MinReward = 3, MaxReward = 7 },
                Medium = { Label = "Poisson moyen", MinReward = 8, MaxReward = 15 },
                Large = { Label = "Gros poisson", MinReward = 16, MaxReward = 30 },
                Rare = { Label = "Poisson rare", MinReward = 31, MaxReward = 60 },
            },
            FishProbabilities = {
                Small = 0.45,
                Medium = 0.30,
                Large = 0.20,
                Rare = 0.05,
            },
            CooldownSeconds = 5,
        },
    }
end

local function loadMiniGamesDefaults()
    local paradisFolder = ServerScriptService:FindFirstChild("ParadisServer") or script.Parent
    local module = paradisFolder and paradisFolder:FindFirstChild("MiniGamesConfigDefaults")
    if module and module:IsA("ModuleScript") then
        local ok, data = pcall(require, module)
        if ok and type(data) == "table" then
            return data
        end
        warn("[Paradis][MiniGames] MiniGamesConfigDefaults require a échoué, utilisation des valeurs par défaut locales.", data)
    else
        warn("[Paradis][MiniGames] MiniGamesConfigDefaults absent, utilisation des valeurs par défaut locales.")
    end
    return buildDefaultMiniGamesConfig()
end

local MiniGamesDefaults = loadMiniGamesDefaults()
-- Log réduit: config chargée

local function resolveConfigModule(folder, childName, contextLabel)
    local container = folder:WaitForChild(childName)
    local className = container.ClassName
    -- Module localisé (log silencieux)
    if container:IsA("ModuleScript") then
        return container
    end

    if className == "ModuleScript" then
        return container
    end

    local descendant = container:FindFirstChildWhichIsA("ModuleScript", true)
    if descendant then
        print(string.format("[Paradis][%s] ModuleScript imbriqué utilisé (%s)", contextLabel, descendant:GetFullName()))
        return descendant
    end

    error(string.format("[Paradis][%s] %s doit contenir un ModuleScript", contextLabel, childName))
end

local miniGamesModule = resolveConfigModule(ConfigFolder, "MiniGamesConfig", "MiniGames")
local moduleClone = miniGamesModule
if not miniGamesModule:IsDescendantOf(ServerScriptService) then
    moduleClone = miniGamesModule:Clone()
    moduleClone.Name = "MiniGamesConfig_ServerCopy"
    moduleClone.Parent = ServerScriptService
end

local success, moduleResult = pcall(require, moduleClone)
if moduleClone ~= miniGamesModule then
    moduleClone:Destroy()
end
if not success then
    warn("[Paradis][MiniGames] Impossible de require MiniGamesConfig:", moduleResult)
end
local MiniGamesConfig = success and moduleResult or MiniGamesDefaults

local function waitForShared(key)
    while not shared[key] do
        task.wait()
    end
    return shared[key]
end

local EconomyService = shared.ParadisEconomyService
if not EconomyService then
    task.spawn(function()
        EconomyService = waitForShared("ParadisEconomyService")
    end)
end

local function addCash(player, amount)
    if not player or amount == 0 then
        return
    end

    if EconomyService and typeof(EconomyService.AddCash) == "function" then
        EconomyService.AddCash(player, amount)
        return
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    local cashValue = leaderstats and leaderstats:FindFirstChild("Cash")
    if cashValue then
        cashValue.Value += amount
    else
        warn("[Paradis][MiniGames] Impossible d'ajouter de l'argent à", player and player.Name)
    end
end
-- Fishing game -----------------------------------------------------------
local fishingCfg = MiniGamesConfig.FishingGame or {}
local fishingCooldowns = {}
local fishingConnections = {}

local fishProbabilityOrder = {}
for fishType in pairs(fishingCfg.FishProbabilities or {}) do
    table.insert(fishProbabilityOrder, fishType)
end
if #fishProbabilityOrder == 0 then
    fishProbabilityOrder = { "Small", "Medium", "Large", "Rare" }
else
    table.sort(fishProbabilityOrder)
end

local function chooseFishType()
    local r = math.random()
    local cumulative = 0
    for _, fishType in ipairs(fishProbabilityOrder) do
        local prob = fishingCfg.FishProbabilities and fishingCfg.FishProbabilities[fishType] or 0
        cumulative += prob
        if r <= cumulative then
            return fishType
        end
    end
    return fishProbabilityOrder[#fishProbabilityOrder] or "Small"
end

local function handleFishing(player)
    local now = os.time()
    local nextAllowed = fishingCooldowns[player] or 0
    if now < nextAllowed then
        return
    end

    fishingCooldowns[player] = now + (fishingCfg.CooldownSeconds or 5)

    local fishType = chooseFishType()
    local rewards = fishingCfg.FishRewards or {}
    local fishInfo = rewards[fishType] or rewards.Small
    if not fishInfo then
        return
    end

    local reward = math.random(fishInfo.MinReward, fishInfo.MaxReward)
    addCash(player, reward)
    print(string.format("[Paradis][MiniGames] %s a pêché un %s (+%d $)", player.Name, fishInfo.Label, reward))
end

local function bindPrompt(prompt)
    if fishingConnections[prompt] then
        return
    end
    fishingConnections[prompt] = prompt.Triggered:Connect(handleFishing)
end

local function scanFishingArea()
    local folder = Workspace:FindFirstChild("FishingArea")
    if not folder then
        return
    end
    for _, descendant in ipairs(folder:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Name == "FishPrompt" then
            bindPrompt(descendant)
        end
    end
end

-- Système de pêche désactivé : remplacé par FishingSystem.server.lua
--[[
scanFishingArea()
Workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("ProximityPrompt") and descendant.Name == "FishPrompt" then
        bindPrompt(descendant)
    elseif descendant.Name == "FishingArea" then
        task.defer(scanFishingArea)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    fishingCooldowns[player] = nil
end)
]]

print("[Paradis][MiniGames] Mini-jeu de pêche désactivé (voir FishingSystem.server.lua).")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="45">
        <Properties>
          <string name="Name">MoveDecorToReplicatedStorage</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    MoveDecorToReplicatedStorage.server.lua
    Déplace automatiquement les modèles de décor du Workspace vers ReplicatedStorage
    pour qu'ils soient accessibles par le système de progression
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Créer le dossier AmenagementCamping s'il n'existe pas
local amenagementFolder = ReplicatedStorage:FindFirstChild("AmenagementCamping")
if not amenagementFolder then
    amenagementFolder = Instance.new("Folder")
    amenagementFolder.Name = "AmenagementCamping"
    amenagementFolder.Parent = ReplicatedStorage
    print("[MoveDecor] ✅ Dossier AmenagementCamping créé dans ReplicatedStorage")
end

-- Fonction pour nettoyer les scripts indésirables dans un modèle
local function cleanModel(model)
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("Script") or desc:IsA("LocalScript") then
            desc:Destroy()
        end
    end
end

-- Liste des modèles à déplacer
local modelNames = {
    -- Trailers
    "Trailer_1", "Trailer_2", "Trailer_3",
    -- BBQ
    "BBQ_1", "BBQ_2", "BBQ_3",
    -- Tables
    "PicnicTable_1", "PicnicTable_2", "PicnicTable_3",
    -- Arbres
    "Tree_1", "Tree_2", "Tree_3",
    -- Rochers
    "DecorRock_2", "DecorRock_3",
    -- Feux de camp
    "Campfire_1", "Campfire_2", "Campfire_3",
}

local movedCount = 0
local alreadyExistsCount = 0

-- Chercher dans Workspace et Workspace.AmenagementCamping
local searchLocations = {
    Workspace,
    Workspace:FindFirstChild("AmenagementCamping")
}

for _, modelName in ipairs(modelNames) do
    -- Vérifier si le modèle existe déjà dans ReplicatedStorage
    if amenagementFolder:FindFirstChild(modelName) then
        alreadyExistsCount = alreadyExistsCount + 1
    else
        local found = false
        
        -- Chercher dans chaque emplacement
        for _, location in ipairs(searchLocations) do
            if location then
                local model = location:FindFirstChild(modelName)
                if model and model:IsA("Model") then
                    -- Nettoyer les scripts problématiques
                    cleanModel(model)
                    
                    -- Déplacer vers ReplicatedStorage
                    model.Parent = amenagementFolder
                    movedCount = movedCount + 1
                    found = true
                    print("[MoveDecor] ✅", modelName, "déplacé vers ReplicatedStorage")
                    break
                end
            end
        end
        
        if not found then
            warn("[MoveDecor] ⚠️", modelName, "introuvable dans Workspace")
        end
    end
end

print(string.format("[MoveDecor] 📦 Résumé: %d modèles déplacés, %d déjà présents", movedCount, alreadyExistsCount))
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="46">
        <Properties>
          <string name="Name">ParkourService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ParkourRemotes = ReplicatedStorage:WaitForChild("ParkourRemotes")
local StartParkour = ParkourRemotes:WaitForChild("StartParkour")
local FinishParkour = ParkourRemotes:WaitForChild("FinishParkour")
local CancelParkour = ParkourRemotes:WaitForChild("CancelParkour")
local UpdateTimer = ParkourRemotes:WaitForChild("UpdateTimer")
local ParkourResult = ParkourRemotes:WaitForChild("ParkourResult")

-- État des joueurs en parcours
local activePlayers = {}

-- Configuration du parcours aérien difficile
local CHECKPOINT_CONFIG = {
    -- Départ au sol
    {Position = Vector3.new(50, 3, 50), Size = Vector3.new(10, 1, 10), Color = Color3.fromRGB(50, 255, 50), Name = "DÉPART"},
    
    -- Première montée (plateformes en escalier)
    {Position = Vector3.new(60, 8, 60), Size = Vector3.new(6, 1, 6), Color = Color3.fromRGB(255, 200, 50), Name = "Point 1"},
    {Position = Vector3.new(70, 13, 65), Size = Vector3.new(5, 1, 5), Color = Color3.fromRGB(255, 200, 50), Name = "Point 2"},
    {Position = Vector3.new(75, 18, 75), Size = Vector3.new(4, 1, 4), Color = Color3.fromRGB(255, 200, 50), Name = "Point 3"},
    
    -- Saut long en hauteur
    {Position = Vector3.new(85, 23, 85), Size = Vector3.new(5, 1, 5), Color = Color3.fromRGB(255, 150, 50), Name = "Point 4"},
    
    -- Plateformes étroites en zigzag
    {Position = Vector3.new(95, 25, 80), Size = Vector3.new(3, 1, 3), Color = Color3.fromRGB(255, 150, 50), Name = "Point 5"},
    {Position = Vector3.new(100, 27, 90), Size = Vector3.new(3, 1, 3), Color = Color3.fromRGB(255, 150, 50), Name = "Point 6"},
    {Position = Vector3.new(105, 29, 85), Size = Vector3.new(3, 1, 3), Color = Color3.fromRGB(255, 150, 50), Name = "Point 7"},
    
    -- Point culminant
    {Position = Vector3.new(115, 35, 95), Size = Vector3.new(6, 1, 6), Color = Color3.fromRGB(255, 100, 50), Name = "Point 8"},
    
    -- Descente avec sauts précis
    {Position = Vector3.new(120, 30, 105), Size = Vector3.new(4, 1, 4), Color = Color3.fromRGB(255, 100, 50), Name = "Point 9"},
    {Position = Vector3.new(125, 25, 110), Size = Vector3.new(4, 1, 4), Color = Color3.fromRGB(255, 100, 50), Name = "Point 10"},
    {Position = Vector3.new(130, 20, 115), Size = Vector3.new(5, 1, 5), Color = Color3.fromRGB(255, 100, 50), Name = "Point 11"},
    
    -- Sprint final sur plateformes mobiles (simulé par petites plateformes)
    {Position = Vector3.new(135, 15, 125), Size = Vector3.new(3, 1, 3), Color = Color3.fromRGB(255, 50, 50), Name = "Point 12"},
    {Position = Vector3.new(140, 12, 130), Size = Vector3.new(3, 1, 3), Color = Color3.fromRGB(255, 50, 50), Name = "Point 13"},
    {Position = Vector3.new(145, 10, 135), Size = Vector3.new(4, 1, 4), Color = Color3.fromRGB(255, 50, 50), Name = "Point 14"},
    
    -- Arrivée
    {Position = Vector3.new(150, 5, 145), Size = Vector3.new(10, 1, 10), Color = Color3.fromRGB(255, 50, 50), Name = "ARRIVÉE"}
}

-- Récompenses ajustées pour la difficulté
local REWARD_TIERS = {
    {maxTime = 60, cash = 2000, medal = "🥇 OR"},
    {maxTime = 90, cash = 1200, medal = "🥈 ARGENT"},
    {maxTime = 120, cash = 700, medal = "🥉 BRONZE"},
    {maxTime = math.huge, cash = 300, medal = "✅ PARTICIPATION"}
}

local checkpointParts = {}
local startZone = nil
local finishZone = nil

-- Créer toutes les plateformes
local function createCheckpoints()
    local parkourFolder = Instance.new("Folder")
    parkourFolder.Name = "ParkourCourse"
    parkourFolder.Parent = workspace
    
    for i, config in ipairs(CHECKPOINT_CONFIG) do
        local part = Instance.new("Part")
        part.Name = config.Name
        part.Position = config.Position
        part.Size = config.Size
        part.Anchored = true
        part.CanCollide = true
        part.Material = Enum.Material.Neon
        part.Color = config.Color
        part.TopSurface = Enum.SurfaceType.Smooth
        part.BottomSurface = Enum.SurfaceType.Smooth
        
        -- Ajouter un billboard pour le nom
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "Label"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = part
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = config.Name
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = billboard
        
        part.Parent = parkourFolder
        
        -- Stocker les zones spéciales
        if i == 1 then
            startZone = part
        elseif i == #CHECKPOINT_CONFIG then
            finishZone = part
        else
            table.insert(checkpointParts, part)
        end
    end
end

-- Calculer la récompense selon le temps
local function calculateReward(elapsedTime)
    for _, tier in ipairs(REWARD_TIERS) do
        if elapsedTime <= tier.maxTime then
            return tier.maxTime, tier.cash, tier.medal
        end
    end
    return REWARD_TIERS[#REWARD_TIERS].maxTime, REWARD_TIERS[#REWARD_TIERS].cash, REWARD_TIERS[#REWARD_TIERS].medal
end

-- Démarrer le parcours
StartParkour.OnServerInvoke = function(player)
    if activePlayers[player.UserId] then
        return false, "Vous êtes déjà en parcours!"
    end
    
    activePlayers[player.UserId] = {
        startTime = tick(),
        checkpoints = {},
        player = player
    }
    
    -- Countdown
    for i = 3, 1, -1 do
        UpdateTimer:FireClient(player, "DÉPART DANS " .. i .. "...")
        task.wait(1)
    end
    
    UpdateTimer:FireClient(player, "GO!")
    task.wait(0.5)
    
    -- Démarrer le timer
    activePlayers[player.UserId].startTime = tick()
    
    return true, "Parcours démarré!"
end

-- Annuler le parcours
CancelParkour.OnServerInvoke = function(player)
    if activePlayers[player.UserId] then
        activePlayers[player.UserId] = nil
        return true, "Parcours annulé"
    end
    return false, "Aucun parcours en cours"
end

-- Finir le parcours
FinishParkour.OnServerInvoke = function(player)
    local data = activePlayers[player.UserId]
    if not data then
        return false, "Aucun parcours en cours"
    end
    
    local elapsedTime = tick() - data.startTime
    local _, cash, medal = calculateReward(elapsedTime)
    
    -- Donner la récompense
    local currentCash = player:GetAttribute("Cash") or 0
    player:SetAttribute("Cash", currentCash + cash)
    
    -- Sauvegarder le meilleur temps
    local bestTime = player:GetAttribute("BestParkourTime")
    if not bestTime or elapsedTime < bestTime then
        player:SetAttribute("BestParkourTime", elapsedTime)
    end
    
    -- Notifier le client
    ParkourResult:FireClient(player, {
        success = true,
        time = elapsedTime,
        medal = medal,
        cash = cash,
        newRecord = not bestTime or elapsedTime < bestTime
    })
    
    activePlayers[player.UserId] = nil
    return true, "Parcours terminé!"
end

-- Détection automatique des zones
if startZone then
    startZone.Touched:Connect(function(hit)
        local char = hit.Parent
        local player = Players:GetPlayerFromCharacter(char)
        if player and not activePlayers[player.UserId] then
            StartParkour:InvokeClient(player)
        end
    end)
end

if finishZone then
    finishZone.Touched:Connect(function(hit)
        local char = hit.Parent
        local player = Players:GetPlayerFromCharacter(char)
        if player and activePlayers[player.UserId] then
            FinishParkour:InvokeClient(player)
        end
    end)
end

-- Boucle de mise à jour du timer
RunService.Heartbeat:Connect(function()
    for userId, data in pairs(activePlayers) do
        local elapsed = tick() - data.startTime
        if data.player and data.player.Parent then
            UpdateTimer:FireClient(data.player, string.format("⏱️ %.2f s", elapsed))
        else
            activePlayers[userId] = nil
        end
    end
end)

-- Créer le parcours au démarrage
createCheckpoints()

print("✅ ParkourService chargé - Parcours aérien difficile créé avec " .. #CHECKPOINT_CONFIG .. " plateformes")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="47">
        <Properties>
          <string name="Name">PlacementService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
    PlacementService
    Vérifie et applique les placements d'objets demandés par les joueurs.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local configFolder = ReplicatedStorage:WaitForChild("Config")
local ObjectsConfig = require(configFolder:WaitForChild("ObjectsConfig"))
local CampConfig = require(configFolder:WaitForChild("CampConfig"))
local ConstructionRuntime = require(configFolder:WaitForChild("ConstructionObjectsRuntime"))
local BuildRemotes = require(ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("BuildRemotes"))
local BUILD_GRID_SIZE = CampConfig.BUILD_GRID_SIZE or 0

local constructionFolder

local function getConstructionFolder()
    if constructionFolder and constructionFolder.Parent then
        return constructionFolder
    end
    local folder = ReplicatedStorage:FindFirstChild("ConstructionObjet")
        or ReplicatedStorage:FindFirstChild("Construction Objet")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "ConstructionObjet"
        folder.Parent = ReplicatedStorage
        warn("[Paradis][Construction] Dossier 'ConstructionObjet' introuvable, dossier vide créé par défaut.")
    end
    constructionFolder = folder
    return constructionFolder
end

local function getModelFolder(name)
    if not name then
        return nil
    end
    if name == "ConstructionObjet" or name == "Construction Objet" then
        return getConstructionFolder()
    end
    return ReplicatedStorage:FindFirstChild(name)
end

local function waitForShared(key)
    while not shared[key] do
        RunService.Heartbeat:Wait()
    end
    return shared[key]
end

local PlotApi = waitForShared("ParadisPlotService")
local DataApi = waitForShared("ParadisDataService")
local EconomyService = waitForShared("ParadisEconomyService")

-- ✅ NOUVEAU : Service pour gérer les objets de camping par défaut
-- Accès au service de kit camping via 'shared' (évite require d'un Script)
local CampsiteDefaultsService = waitForShared("ParadisCampsiteDefaultsService")

local builders = {}

local function setAnchored(model, value)
    if model:IsA("BasePart") then
        model.Anchored = value
        model.CanCollide = true
    end
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.Anchored = value
            descendant.CanCollide = true
        end
    end
end

local function applyObjectId(model, objectId)
    if not objectId then
        return
    end
    model:SetAttribute("PlotObjectId", objectId)
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant:SetAttribute("PlotObjectId", objectId)
        end
    end
end

local function pivotModelToCFrame(model, targetCFrame)
    if model:IsA("BasePart") then
        model.CFrame = targetCFrame
    else
        model:PivotTo(targetCFrame)
    end
end

local function getPlotBaseHeight(plot)
    if plot then
        if plot.BasePart then
            local base = plot.BasePart
            return base.Position.Y + (base.Size.Y / 2)
        end
        if plot.Center then
            return plot.Center.Y
        end
    end
    return 0
end

local function snapPositionToPlotGrid(plot, position)
    if not plot or BUILD_GRID_SIZE <= 0 then
        return position
    end
    local plotSize = plot.Size
    if not plotSize then
        return position
    end
    local halfX = (plotSize.X / 2) - (BUILD_GRID_SIZE / 2)
    local halfZ = (plotSize.Y / 2) - (BUILD_GRID_SIZE / 2)
    if halfX <= 0 or halfZ <= 0 then
        return Vector3.new(plot.Center.X, plot.Center.Y + 1, plot.Center.Z)
    end
    local relativeX = math.clamp(position.X - plot.Center.X, -halfX, halfX)
    local relativeZ = math.clamp(position.Z - plot.Center.Z, -halfZ, halfZ)
    local snappedX = math.round(relativeX / BUILD_GRID_SIZE) * BUILD_GRID_SIZE
    local snappedZ = math.round(relativeZ / BUILD_GRID_SIZE) * BUILD_GRID_SIZE
    snappedX = math.clamp(snappedX, -halfX, halfX)
    snappedZ = math.clamp(snappedZ, -halfZ, halfZ)
    local baseY = getPlotBaseHeight(plot)
    local rawY = position and position.Y or (baseY + (BUILD_GRID_SIZE / 2))
    local y = math.clamp(rawY, baseY, baseY + 100)
    return Vector3.new(plot.Center.X + snappedX, y, plot.Center.Z + snappedZ)
end

local function putOnGround(part)
    part.CFrame = CFrame.new(0, part.Size.Y / 2, 0)
end

local function createPlate(def, material)
    local model = Instance.new("Model")
    model.Name = def.Label or "Plaque"
    local plate = Instance.new("Part")
    plate.Name = "Plate"
    plate.Size = def.Size or Vector3.new(8, 1, 8)
    plate.Color = def.PrimaryColor or Color3.fromRGB(100, 180, 100)
    plate.Material = material or Enum.Material.Plastic
    plate.TopSurface = Enum.SurfaceType.Smooth
    plate.BottomSurface = Enum.SurfaceType.Smooth
    putOnGround(plate)
    plate.Parent = model
    model.PrimaryPart = plate
    return model
end

local function cloneConfiguredModel(def)
    local folder = getModelFolder(def.ModelFolder)
    if not folder then
        warn("[Paradis][Placement] Dossier de modèle introuvable:", tostring(def.ModelFolder))
        return nil, "Dossier de modèle introuvable"
    end
    local template = folder:FindFirstChild(def.ModelName)
    if not template then
        warn("[Paradis][Placement] Modèle introuvable:", tostring(def.ModelName), "dans", folder:GetFullName())
        return nil, "Modèle introuvable"
    end
    return template:Clone()
end

function builders.GrassTile(def)
    return createPlate(def, Enum.Material.Grass)
end

function builders.GravelTile(def)
    return createPlate(def, Enum.Material.Pebble)
end

function builders.TreeBlock(def)
    local model = Instance.new("Model")
    model.Name = def.Label or "TreeBlock"

    local trunk = Instance.new("Part")
    trunk.Name = "Trunk"
    trunk.Size = Vector3.new(1.75, 6, 1.75)
    trunk.Color = def.SecondaryColor or Color3.fromRGB(120, 70, 35)
    trunk.Material = Enum.Material.Wood
    putOnGround(trunk)
    trunk.Parent = model

    local leaves = Instance.new("Part")
    leaves.Name = "Leaves"
    leaves.Size = Vector3.new(4, 4, 4)
    leaves.Color = def.PrimaryColor or Color3.fromRGB(70, 160, 90)
    leaves.Material = Enum.Material.Grass
    leaves.CFrame = CFrame.new(0, trunk.Size.Y + (leaves.Size.Y / 2), 0)
    leaves.Parent = model

    model.PrimaryPart = trunk
    return model
end

function builders.RockBlock(def)
    local model = Instance.new("Model")
    model.Name = def.Label or "RockBlock"

    local rock = Instance.new("Part")
    rock.Name = "Rock"
    rock.Size = Vector3.new(5, 3, 4)
    rock.Color = def.PrimaryColor or Color3.fromRGB(110, 110, 120)
    rock.Material = Enum.Material.Slate
    putOnGround(rock)
    rock.Parent = model

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = Vector3.new(1.3, 0.8, 1.1)
    mesh.Parent = rock

    model.PrimaryPart = rock
    return model
end

function builders.FenceSegment(def)
    local model = Instance.new("Model")
    model.Name = def.Label or "FenceSegment"
    local size = def.Size or Vector3.new(10, 3, 1)

    local rail = Instance.new("Part")
    rail.Name = "Rail"
    rail.Size = Vector3.new(size.X, 0.4, size.Z)
    rail.Color = def.SecondaryColor or Color3.fromRGB(180, 150, 110)
    rail.Material = Enum.Material.WoodPlanks
    rail.CFrame = CFrame.new(0, size.Y - 0.6, 0)
    rail.Parent = model

    local base = Instance.new("Part")
    base.Name = "Base"
    base.Size = Vector3.new(size.X, 0.4, size.Z)
    base.Color = def.SecondaryColor or Color3.fromRGB(180, 150, 110)
    base.Material = Enum.Material.WoodPlanks
    putOnGround(base)
    base.Parent = model

    for _, offset in ipairs({ -size.X / 2 + 0.4, size.X / 2 - 0.4 }) do
        local post = Instance.new("Part")
        post.Name = "Post"
        post.Size = Vector3.new(0.6, size.Y, 0.6)
        post.Color = def.PrimaryColor or Color3.fromRGB(210, 190, 150)
        post.Material = Enum.Material.Wood
        post.CFrame = CFrame.new(offset, size.Y / 2, 0)
        post.Parent = model
    end

    model.PrimaryPart = base
    return model
end

function builders.LightPost(def)
    local model = Instance.new("Model")
    model.Name = def.Label or "LightPost"

    local pole = Instance.new("Part")
    pole.Name = "Pole"
    pole.Size = Vector3.new(0.8, 10, 0.8)
    pole.Color = def.SecondaryColor or Color3.fromRGB(60, 60, 70)
    pole.Material = Enum.Material.Metal
    putOnGround(pole)
    pole.Parent = model

    local lamp = Instance.new("Part")
    lamp.Name = "Lamp"
    lamp.Size = Vector3.new(2, 1.5, 2)
    lamp.Color = def.PrimaryColor or Color3.fromRGB(230, 230, 230)
    lamp.Material = Enum.Material.Neon
    lamp.CFrame = CFrame.new(0, pole.Size.Y + (lamp.Size.Y / 2), 0)
    lamp.Parent = model

    local light = Instance.new("PointLight")
    light.Range = 18
    light.Brightness = 2
    light.Color = lamp.Color
    light.Parent = lamp

    model.PrimaryPart = pole
    return model
end

-- Décorations simples (fallback visuel minimal)
local function setBase(part, color, material)
    part.Color = color
    part.Material = material or Enum.Material.Wood
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
end

function builders.Bench(def)
    local model = Instance.new("Model")
    model.Name = def.Label or "Bench"
    local seat = Instance.new("Part")
    seat.Name = "Seat"
    seat.Size = Vector3.new(5, 0.4, 2)
    putOnGround(seat)
    setBase(seat, Color3.fromRGB(150, 110, 70), Enum.Material.WoodPlanks)
    seat.Parent = model
    for _, x in ipairs({-2.2, 2.2}) do
        local leg = Instance.new("Part")
        leg.Name = "Leg"
        leg.Size = Vector3.new(0.4, 1.4, 0.4)
        leg.CFrame = CFrame.new(x, 0.7, -0.6)
        setBase(leg, Color3.fromRGB(120, 80, 50), Enum.Material.Wood)
        leg.Parent = model
    end
    model.PrimaryPart = seat
    return model
end

function builders.TablePicnic(def)
    local model = Instance.new("Model")
    model.Name = def.Label or "TablePicnic"
    local top = Instance.new("Part")
    top.Name = "Top"
    top.Size = Vector3.new(6, 0.5, 4)
    top.CFrame = CFrame.new(0, 1.5, 0)
    setBase(top, Color3.fromRGB(160, 120, 80), Enum.Material.WoodPlanks)
    top.Parent = model
    for _, x in ipairs({-2.5, 2.5}) do
        local leg = Instance.new("Part")
        leg.Name = "Leg"
        leg.Size = Vector3.new(0.5, 1.5, 0.5)
        leg.CFrame = CFrame.new(x, 0.75, -1.5)
        setBase(leg, Color3.fromRGB(120, 90, 60), Enum.Material.Wood)
        leg.Parent = model
        local leg2 = leg:Clone()
        leg2.CFrame = CFrame.new(x, 0.75, 1.5)
        leg2.Parent = model
    end
    model.PrimaryPart = top
    return model
end

