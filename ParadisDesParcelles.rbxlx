      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">BuildScreenGui</string>
          <string name="Source"><![CDATA[--[[
    BuildScreenGui
    Module responsable de la création de l'interface de construction côté client.
    
    ⚠️ DÉSACTIVÉ - Ce module a été remplacé par CampingDetailsGui
    Les objets sont maintenant gérés automatiquement via le système de progression
    et l'interface se trouve sur les pancartes des parcelles.
]]

local GuiFactory = {}

-- Module désactivé mais conservé pour référence
return GuiFactory

local function getOrderedKeys(config, orderProperty, labelProperty)
    local keys = {}
    for key in pairs(config) do
        table.insert(keys, key)
    end
    table.sort(keys, function(a, b)
        local dataA = config[a] or {}
        local dataB = config[b] or {}
        local orderA = dataA[orderProperty] or math.huge
        local orderB = dataB[orderProperty] or math.huge
        if orderA == orderB then
            local labelA = dataA[labelProperty] or a
            local labelB = dataB[labelProperty] or b
            return labelA < labelB
        end
        return orderA < orderB
    end)
    return keys
end

function GuiFactory.create(playerGui, objectsConfig, trailerConfig)
    trailerConfig = trailerConfig or {}
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ParadisBuildGui"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 5
    screenGui.Parent = playerGui

    local buildButton = Instance.new("TextButton")
    buildButton.Name = "BuildToggle"
    buildButton.Size = UDim2.new(0.4, 0, 0, 45)
    buildButton.Position = UDim2.new(0.5, 0, 1, -55)
    buildButton.AnchorPoint = Vector2.new(0.5, 1)
    buildButton.BackgroundColor3 = Color3.fromRGB(37, 115, 74)
    buildButton.TextColor3 = Color3.new(1, 1, 1)
    buildButton.Font = Enum.Font.GothamBold
    buildButton.TextScaled = true
    buildButton.Text = "🎨 Décorer le terrain"
    buildButton.Visible = false
    buildButton.Parent = screenGui

    local toolbar = Instance.new("Frame")
    toolbar.Name = "BuildToolbar"
    toolbar.Size = UDim2.new(0.95, 0, 0, 130)
    toolbar.Position = UDim2.new(0.025, 0, 1, -140)
    toolbar.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    toolbar.BackgroundTransparency = 0.1
    toolbar.BorderSizePixel = 0
    toolbar.Visible = false
    toolbar.Parent = screenGui

    local buttonScroll = Instance.new("ScrollingFrame")
    buttonScroll.Name = "ButtonScroll"
    buttonScroll.Size = UDim2.new(1, -10, 0, 65)
    buttonScroll.Position = UDim2.new(0, 5, 0, 50)
    buttonScroll.BackgroundTransparency = 1
    buttonScroll.BorderSizePixel = 0
    buttonScroll.ScrollBarThickness = 6
    buttonScroll.AutomaticCanvasSize = Enum.AutomaticSize.XY
    buttonScroll.ScrollingDirection = Enum.ScrollingDirection.X
    buttonScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    buttonScroll.Parent = toolbar

    local buttonContainer = Instance.new("Frame")
    buttonContainer.Name = "ButtonContainer"
    buttonContainer.BackgroundTransparency = 1
    buttonContainer.Size = UDim2.new(1, 0, 1, 0)
    buttonContainer.Parent = buttonScroll

    local uiList = Instance.new("UIListLayout")
    uiList.FillDirection = Enum.FillDirection.Horizontal
    uiList.HorizontalAlignment = Enum.HorizontalAlignment.Left
    uiList.VerticalAlignment = Enum.VerticalAlignment.Center
    uiList.Padding = UDim.new(0, 8)
    uiList.SortOrder = Enum.SortOrder.LayoutOrder
    uiList.Parent = buttonContainer

    local buttons = {}
    local orderedObjects = getOrderedKeys(objectsConfig, "Order", "Label")
    for index, objectType in ipairs(orderedObjects) do
        local data = objectsConfig[objectType]
        local btn = Instance.new("TextButton")
        btn.Name = objectType .. "Button"
        btn.Size = UDim2.new(0, 120, 0, 60)
        btn.Text = data.Label or objectType
        btn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
        btn.BorderSizePixel = 0
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextScaled = true
        btn.TextWrapped = true
        btn.TextYAlignment = Enum.TextYAlignment.Top
        btn.LayoutOrder = data.Order or index
        btn.AutoButtonColor = false
        btn.Parent = buttonContainer
        
        -- Coins arrondis
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = btn
        
        -- Bordure décorative
        local btnStroke = Instance.new("UIStroke")
        btnStroke.Color = Color3.fromRGB(70, 80, 100)
        btnStroke.Thickness = 2
        btnStroke.Transparency = 0.5
        btnStroke.Parent = btn
        
        -- Gradient subtil
        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(55, 60, 75)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(35, 40, 55))
        }
        gradient.Rotation = 90
        gradient.Parent = btn
        
        -- Padding du texte
        local textPadding = Instance.new("UIPadding")
        textPadding.PaddingLeft = UDim.new(0, 6)
        textPadding.PaddingRight = UDim.new(0, 6)
        textPadding.PaddingTop = UDim.new(0, 6)
        textPadding.PaddingBottom = UDim.new(0, 6)
        textPadding.Parent = btn
        
        -- Effet hover
        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(60, 70, 90)
            btnStroke.Color = Color3.fromRGB(100, 140, 180)
            btnStroke.Transparency = 0.2
        end)
        
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
            btnStroke.Color = Color3.fromRGB(70, 80, 100)
            btnStroke.Transparency = 0.5
        end)
        
        buttons[objectType] = btn
    end

    local trailerButtons = {}

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(0.45, 0, 0, 35)
    statusLabel.Position = UDim2.new(0, 8, 0, 8)
    statusLabel.BackgroundTransparency = 1
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextScaled = true
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.Text = "Sélectionnez un objet"
    statusLabel.Parent = toolbar

    local cancelButton = Instance.new("TextButton")
    cancelButton.Name = "CancelPlacement"
    cancelButton.Size = UDim2.new(0.22, 0, 0, 35)
    cancelButton.Position = UDim2.new(1, -8, 0, 8)
    cancelButton.BackgroundColor3 = Color3.fromRGB(120, 50, 50)
    cancelButton.TextColor3 = Color3.new(1, 1, 1)
    cancelButton.Font = Enum.Font.GothamBold
    cancelButton.TextScaled = true
    cancelButton.Text = "Annuler"
    cancelButton.AnchorPoint = Vector2.new(1, 0)
    cancelButton.Parent = toolbar

    local deleteButton = Instance.new("TextButton")
    deleteButton.Name = "DeleteToggle"
    deleteButton.Size = UDim2.new(0.22, 0, 0, 35)
    deleteButton.Position = UDim2.new(1, -8, 0, 8)
    deleteButton.BackgroundColor3 = Color3.fromRGB(200, 120, 40)
    deleteButton.TextColor3 = Color3.new(1, 1, 1)
    deleteButton.Font = Enum.Font.GothamBold
    deleteButton.TextScaled = true
    deleteButton.Text = "Supprimer"
    deleteButton.AnchorPoint = Vector2.new(1, 0)
    deleteButton.Parent = toolbar

    local tutorialFrame = Instance.new("Frame")
    tutorialFrame.Name = "TutorialFrame"
    tutorialFrame.Size = UDim2.new(0.9, 0, 0, 160)
    tutorialFrame.Position = UDim2.new(0.05, 0, 0, 100)
    tutorialFrame.BackgroundColor3 = Color3.fromRGB(22, 24, 32)
    tutorialFrame.BackgroundTransparency = 0.1
    tutorialFrame.BorderSizePixel = 0
    tutorialFrame.Visible = true
    tutorialFrame.Parent = screenGui

    local tutorialTitle = Instance.new("TextLabel")
    tutorialTitle.Size = UDim2.new(1, -50, 0, 28)
    tutorialTitle.Position = UDim2.new(0, 12, 0, 10)
    tutorialTitle.BackgroundTransparency = 1
    tutorialTitle.Font = Enum.Font.GothamBold
    tutorialTitle.TextScaled = true
    tutorialTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    tutorialTitle.TextXAlignment = Enum.TextXAlignment.Left
    tutorialTitle.Text = "🏕️ Bienvenue au Paradis du Camping!"
    tutorialTitle.Parent = tutorialFrame

    local tutorialBody = Instance.new("TextLabel")
    tutorialBody.Size = UDim2.new(1, -24, 0, 100)
    tutorialBody.Position = UDim2.new(0, 12, 0, 42)
    tutorialBody.BackgroundTransparency = 1
    tutorialBody.Font = Enum.Font.Gotham
    tutorialBody.TextScaled = true
    tutorialBody.TextColor3 = Color3.fromRGB(235, 235, 235)
    tutorialBody.TextWrapped = true
    tutorialBody.TextXAlignment = Enum.TextXAlignment.Left
    tutorialBody.TextYAlignment = Enum.TextYAlignment.Top
    tutorialBody.Text = "🎯 Joue aux mini-jeux (pêche, labyrinthe, coupe de bois) pour gagner de l'argent et débloquer des achievements!\n💰 Clique sur 'Camping' pour améliorer tes objets (roulottes, BBQ...) qui génèrent du revenu passif.\n🏆 Plus tu joues, plus tu débloques d'améliorations puissantes!"
    tutorialBody.Parent = tutorialFrame

    local tutorialClose = Instance.new("TextButton")
    tutorialClose.Size = UDim2.new(0, 32, 0, 32)
    tutorialClose.Position = UDim2.new(1, -38, 0, 6)
    tutorialClose.BackgroundColor3 = Color3.fromRGB(200, 80, 80)
    tutorialClose.TextColor3 = Color3.new(1, 1, 1)
    tutorialClose.Font = Enum.Font.GothamBold
    tutorialClose.TextScaled = true
    tutorialClose.Text = "X"
    tutorialClose.Parent = tutorialFrame

    return {
        ScreenGui = screenGui,
        BuildButton = buildButton,
        Toolbar = toolbar,
        ButtonContainer = buttonContainer,
        ButtonScroll = buttonScroll,
        Buttons = buttons,
        TrailerButtons = trailerButtons,
        StatusLabel = statusLabel,
        CancelButton = cancelButton,
        DeleteButton = deleteButton,
        TutorialFrame = tutorialFrame,
        TutorialClose = tutorialClose,
    }
end

return GuiFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="77">
        <Properties>
          <string name="Name">CampingProgressionUI</string>
          <string name="Source"><![CDATA[-- CampingProgressionUI.lua
-- Interface client pour acheter et améliorer les objets de camping

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Config et remotes
local CampingItemsConfig = require(ReplicatedStorage:WaitForChild("Config"):WaitForChild("CampingItemsConfig"))
local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local campingRemote = remotesFolder:WaitForChild("CampingProgressionRemote")

-- UI principale
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CampingProgressionUI"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

-- Bouton pour ouvrir/fermer le menu
local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ToggleButton"
toggleButton.Size = UDim2.new(0, 120, 0, 50)
toggleButton.Position = UDim2.new(1, -130, 0.5, -100)
toggleButton.BackgroundColor3 = Color3.fromRGB(40, 120, 180)
toggleButton.BorderSizePixel = 0
toggleButton.Font = Enum.Font.GothamBold
toggleButton.Text = "🏕️ Camping"
toggleButton.TextColor3 = Color3.new(1, 1, 1)
toggleButton.TextSize = 18
toggleButton.Parent = screenGui

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(0, 10)
toggleCorner.Parent = toggleButton

-- Frame principale (cachée par défaut)
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 700, 0, 500)
mainFrame.Position = UDim2.new(0.5, -350, 0.5, -250)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
mainFrame.BorderSizePixel = 0
mainFrame.Visible = false
mainFrame.Parent = screenGui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 15)
mainCorner.Parent = mainFrame

-- Header
local header = Instance.new("TextLabel")
header.Name = "Header"
header.Size = UDim2.new(1, 0, 0, 50)
header.BackgroundColor3 = Color3.fromRGB(40, 120, 180)
header.BorderSizePixel = 0
header.Font = Enum.Font.GothamBold
header.Text = "🏕️ Amélioration du Camping"
header.TextColor3 = Color3.new(1, 1, 1)
header.TextSize = 24
header.Parent = mainFrame

local headerCorner = Instance.new("UICorner")
headerCorner.CornerRadius = UDim.new(0, 15)
headerCorner.Parent = header

-- Bouton fermer
local closeButton = Instance.new("TextButton")
closeButton.Name = "CloseButton"
closeButton.Size = UDim2.new(0, 40, 0, 40)
closeButton.Position = UDim2.new(1, -45, 0, 5)
closeButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeButton.BorderSizePixel = 0
closeButton.Font = Enum.Font.GothamBold
closeButton.Text = "✕"
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.TextSize = 20
closeButton.Parent = header

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 8)
closeCorner.Parent = closeButton

-- ScrollingFrame pour les catégories d'objets
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Name = "ScrollFrame"
scrollFrame.Size = UDim2.new(1, -20, 1, -70)
scrollFrame.Position = UDim2.new(0, 10, 0, 60)
scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 8
scrollFrame.Parent = mainFrame

local scrollLayout = Instance.new("UIListLayout")
scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
scrollLayout.Padding = UDim.new(0, 10)
scrollLayout.Parent = scrollFrame

-- Fonction pour créer une carte d'objet
local function createItemCard(itemData)
	local card = Instance.new("Frame")
	card.Name = itemData.Id
	card.Size = UDim2.new(1, -10, 0, 120)
	card.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
	card.BorderSizePixel = 0
	
	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 10)
	cardCorner.Parent = card
	
	-- Nom de l'objet
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(0, 300, 0, 30)
	nameLabel.Position = UDim2.new(0, 15, 0, 10)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Text = itemData.DisplayName
	nameLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
	nameLabel.TextSize = 20
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = card
	
	-- Niveau
	local levelLabel = Instance.new("TextLabel")
	levelLabel.Name = "LevelLabel"
	levelLabel.Size = UDim2.new(0, 100, 0, 25)
	levelLabel.Position = UDim2.new(0, 15, 0, 45)
	levelLabel.BackgroundTransparency = 1
	levelLabel.Font = Enum.Font.Gotham
	levelLabel.Text = "Niveau " .. itemData.Level
	levelLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	levelLabel.TextSize = 16
	levelLabel.TextXAlignment = Enum.TextXAlignment.Left
	levelLabel.Parent = card
	
	-- Revenu
	local incomeLabel = Instance.new("TextLabel")
	incomeLabel.Name = "IncomeLabel"
	incomeLabel.Size = UDim2.new(0, 250, 0, 25)
	incomeLabel.Position = UDim2.new(0, 15, 0, 70)
	incomeLabel.BackgroundTransparency = 1
	incomeLabel.Font = Enum.Font.Gotham
	incomeLabel.Text = "💰 Revenu: +" .. itemData.BaseIncome .. " $/tick"
	incomeLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
	incomeLabel.TextSize = 16
	incomeLabel.TextXAlignment = Enum.TextXAlignment.Left
	incomeLabel.Parent = card
	
	-- Coût
	local costLabel = Instance.new("TextLabel")
	costLabel.Name = "CostLabel"
	costLabel.Size = UDim2.new(0, 200, 0, 25)
	costLabel.Position = UDim2.new(0, 15, 0, 92)
	costLabel.BackgroundTransparency = 1
	costLabel.Font = Enum.Font.Gotham
	costLabel.Text = "💵 Coût: " .. itemData.Cost .. " $"
	costLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
	costLabel.TextSize = 16
	costLabel.TextXAlignment = Enum.TextXAlignment.Left
	costLabel.Parent = card
	
	-- Prérequis
	local prereqLabel = Instance.new("TextLabel")
	prereqLabel.Name = "PrereqLabel"
	prereqLabel.Size = UDim2.new(0.5, -100, 0, 60)
	prereqLabel.Position = UDim2.new(0, 280, 0, 45)
	prereqLabel.BackgroundTransparency = 1
	prereqLabel.Font = Enum.Font.Gotham
	prereqLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	prereqLabel.TextSize = 14
	prereqLabel.TextXAlignment = Enum.TextXAlignment.Left
	prereqLabel.TextYAlignment = Enum.TextYAlignment.Top
	prereqLabel.TextWrapped = true
	prereqLabel.Parent = card
	
	local prereqText = "🔓 Prérequis:\n"
	if itemData.Prerequisites.MinCash and itemData.Prerequisites.MinCash > 0 then
		prereqText = prereqText .. "• " .. itemData.Prerequisites.MinCash .. " $ minimum\n"
	end
	if itemData.Prerequisites.Achievements and #itemData.Prerequisites.Achievements > 0 then
		for _, achId in ipairs(itemData.Prerequisites.Achievements) do
			local achInfo = CampingItemsConfig.Achievements[achId]
			prereqText = prereqText .. "• " .. (achInfo and achInfo.DisplayName or achId) .. "\n"
		end
	end
	if prereqText == "🔓 Prérequis:\n" then
		prereqText = prereqText .. "Aucun"
	end
	prereqLabel.Text = prereqText
	
	-- Bouton acheter
	local buyButton = Instance.new("TextButton")
	buyButton.Name = "BuyButton"
	buyButton.Size = UDim2.new(0, 120, 0, 40)
	buyButton.Position = UDim2.new(1, -135, 0.5, -20)
	buyButton.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
	buyButton.BorderSizePixel = 0
	buyButton.Font = Enum.Font.GothamBold
	buyButton.Text = "ACHETER"
	buyButton.TextColor3 = Color3.new(1, 1, 1)
	buyButton.TextSize = 18
	buyButton.Parent = card
	
	local buyCorner = Instance.new("UICorner")
	buyCorner.CornerRadius = UDim.new(0, 8)
	buyCorner.Parent = buyButton
	
	-- Action du bouton
	buyButton.MouseButton1Click:Connect(function()
		campingRemote:FireServer("PurchaseItem", itemData.Id)
		buyButton.Text = "⏳ Achat..."
		buyButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
		task.wait(1)
		buyButton.Text = "ACHETER"
		buyButton.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
	end)
	
	return card
end

-- Fonction pour créer une section de catégorie
local function createCategorySection(categoryName, items)
	local section = Instance.new("Frame")
	section.Name = categoryName
	section.Size = UDim2.new(1, 0, 0, 50)
	section.BackgroundColor3 = Color3.fromRGB(50, 130, 200)
	section.BorderSizePixel = 0
	section.AutomaticSize = Enum.AutomaticSize.Y
	
	local sectionCorner = Instance.new("UICorner")
	sectionCorner.CornerRadius = UDim.new(0, 10)
	sectionCorner.Parent = section
	
	-- Titre de catégorie
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, -20, 0, 40)
	titleLabel.Position = UDim2.new(0, 10, 0, 5)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.Text = "📦 " .. categoryName
	titleLabel.TextColor3 = Color3.new(1, 1, 1)
	titleLabel.TextSize = 22
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = section
	
	-- Container pour les items
	local itemsContainer = Instance.new("Frame")
	itemsContainer.Name = "ItemsContainer"
	itemsContainer.Size = UDim2.new(1, -10, 0, 0)
	itemsContainer.Position = UDim2.new(0, 5, 0, 50)
	itemsContainer.BackgroundTransparency = 1
	itemsContainer.AutomaticSize = Enum.AutomaticSize.Y
	itemsContainer.Parent = section
	
	local itemsLayout = Instance.new("UIListLayout")
	itemsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	itemsLayout.Padding = UDim.new(0, 8)
	itemsLayout.Parent = itemsContainer
	
	-- Ajouter les items
	for _, itemData in ipairs(items) do
		local card = createItemCard(itemData)
		card.Parent = itemsContainer
	end
	
	return section
end

-- Initialiser l'UI avec toutes les catégories
local function initializeUI()
	-- Organiser les items par catégorie
	local categories = {}
	for _, itemData in pairs(CampingItemsConfig.Items) do
		local catName = itemData.Category
		if not categories[catName] then
			categories[catName] = {}
		end
		table.insert(categories[catName], itemData)
	end
	
	-- Trier les items par niveau dans chaque catégorie
	for catName, items in pairs(categories) do
		table.sort(items, function(a, b)
			return a.Level < b.Level
		end)
	end
	
	-- Créer les sections dans l'ordre
	local orderedCategories = {"Trailer", "BBQ", "PicnicTable", "Campfire", "TreesDecor", "DecorRock"}
	for _, catName in ipairs(orderedCategories) do
		if categories[catName] then
			local section = createCategorySection(catName, categories[catName])
			section.Parent = scrollFrame
		end
	end
	
	-- Ajuster la taille du scroll
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y + 10)
	scrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y + 10)
	end)
end

-- Toggle l'UI
local function toggleUI()
	mainFrame.Visible = not mainFrame.Visible
end

toggleButton.MouseButton1Click:Connect(toggleUI)
closeButton.MouseButton1Click:Connect(function()
	mainFrame.Visible = false
end)

-- Initialiser
initializeUI()

print("[CampingProgressionUI] Interface initialisée")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">EconomyFeedback</string>
          <string name="Source"><![CDATA[--[[
    EconomyFeedback
    Affiche des popups et joue un son léger pour les gains/pertes passifs.
]]

local TweenService = game:GetService("TweenService")

local EconomyFeedback = {}
EconomyFeedback.__index = EconomyFeedback

function EconomyFeedback.new(parent)
    local self = setmetatable({}, EconomyFeedback)
    self.Parent = parent

    local container = Instance.new("Folder")
    container.Name = "EconomyFeedback"
    container.Parent = parent
    self.Container = container

    local sound = Instance.new("Sound")
    sound.Name = "PassiveGainSound"
    sound.SoundId = "rbxassetid://3398620867" -- Son de pièce valide
    sound.Volume = 0.4
    sound.PlayOnRemove = false
    sound.Parent = container
    self.Sound = sound

    return self
end

local function formatAmount(amount)
    local prefix = amount >= 0 and "+" or "-"
    return string.format("%s%.2f $", prefix, math.abs(amount))
end

function EconomyFeedback:Show(amount, reason, multiplier)
    amount = tonumber(amount) or 0
    reason = reason or (amount >= 0 and "Revenu passif" or "Taxe")

    local label = Instance.new("TextLabel")
    label.Name = "EconomyPopup"
    label.Size = UDim2.new(0, 200, 0, 40)
    label.Position = UDim2.new(0, 20, 0, 140)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextWrapped = true
    label.TextStrokeTransparency = 0.6
    label.Parent = self.Parent

    if amount == 0 then
        label.Text = reason
        label.TextColor3 = Color3.fromRGB(230, 230, 255)
    else
        local text = formatAmount(amount)
        if multiplier and multiplier > 1.01 then
            text = string.format("%s (x%.2f)", text, multiplier)
        end
        label.Text = string.format("%s\n%s", text, reason)
        if amount >= 0 then
            label.TextColor3 = Color3.fromRGB(150, 255, 170)
            self.Sound:Stop()
            self.Sound.TimePosition = 0
            self.Sound:Play()
        else
            label.TextColor3 = Color3.fromRGB(255, 130, 130)
        end
    end

    local goal = { Position = label.Position + UDim2.new(0, 0, 0, -40), TextTransparency = 1 }
    local tween = TweenService:Create(label, TweenInfo.new(1.2), goal)
    tween:Play()
    tween.Completed:Connect(function()
        label:Destroy()
    end)
end

return EconomyFeedback
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
